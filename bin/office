#!/usr/bin/env bash
# office: builds and keeps offices. See doctrine/OFFICE.md in the install.
#
# Everything the command reads about itself (templates, doctrine, space
# catalog, profile shape, migrations) comes from the install this script
# sits in, found through its own path, so an upgraded install upgrades
# every office's tools without touching any office.

set -uo pipefail

OFFICE_SRC="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)"
HELPER="$OFFICE_SRC/lib/office_helper.py"
# The read side: the only code that runs bale, through the --json
# surfaces share/bale-consumption.toml declares.
READER="$OFFICE_SRC/lib/office_bale.py"
CATALOG="$OFFICE_SRC/share/spaces.toml"
VERBS="$OFFICE_SRC/share/verbs.toml"
SHAPE="$OFFICE_SRC/share/profile-shape.toml"
TEMPLATES="$OFFICE_SRC/templates"
MIGRATIONS="$OFFICE_SRC/migrations"
DOCTRINE_DIR="$OFFICE_SRC/doctrine"
CONFIG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/office-src"
DEFAULT_FILE="$CONFIG_DIR/default-office"
MANIFEST_REL="floor-plan/manifest.toml"
SURVEY_REL="floor-plan/survey.md"
PROFILE_REL="profile.md"
BALE_TOML_REL="bale.toml"
STEP_TIMEOUT="${OFFICE_STEP_TIMEOUT:-10}"
VERSION_TIMEOUT=5

log()   { printf '[office] %s\n' "$*" >&2; }
warn()  { printf '[office] warning: %s\n' "$*" >&2; }
die()   { printf '[office] error: %s\n' "$*" >&2; exit 1; }
debug() { [ "${OFFICE_DEBUG:-0}" = "1" ] && printf '[office] debug: %s\n' "$*" >&2; return 0; }

helper() { python3 "$HELPER" "$@"; }
# -B: the reader imports the helper, and an install is never written to.
reader() { python3 -B "$READER" "$@"; }

# Single-quote a word for a printed command line.
shq() { printf "'%s'" "$(printf '%s' "$1" | sed "s/'/'\\\\''/g")"; }

# Escape a value for the right-hand side of a sed s|||.
sed_rhs() { printf '%s' "$1" | sed 's/[&|\\]/\\&/g'; }

# --- asking --------------------------------------------------------------------
#
# A verb is a wizard on a terminal (doctrine section 7): it asks for what
# it was not given, every question names its flag twin, `?` explains the
# field rather than refusing it, and an answer the field does not take is
# explained and asked again. Piped input is never asked anything; the
# verb refuses what it was not given and names the flag.

can_ask() { [ -t 0 ]; }

# ask VAR PROMPT DEFAULT REQUIRED HELP [FIELD]
# PROMPT names the flag twin. DEFAULT is taken on a plain return; with no
# default a plain return skips, unless REQUIRED is 1. HELP is what `?`
# prints; FIELD, when given, is the folder field the answer is checked
# and normalized as (the helper's closed vocabularies).
ask() {
  local __var="$1" prompt="$2" def="$3" required="$4" help="$5" field="${6:-}" answer norm shown="$2"
  if [ -n "$def" ]; then shown="$shown [$def]"
  elif [ "$required" != "1" ]; then shown="$shown [return skips]"; fi
  while :; do
    IFS= read -r -p "$shown: " answer || die "no answer given to: $prompt"
    answer="$(printf '%s' "$answer" | sed 's/^[[:space:]]*//; s/[[:space:]]*$//')"
    if [ "$answer" = "?" ]; then printf '%s\n' "$help" | fold -s -w 76 | sed 's/^/  /' >&2; continue; fi
    if [ -z "$answer" ]; then
      if [ -n "$def" ]; then answer="$def"
      elif [ "$required" = "1" ]; then printf '  an answer is needed here; ? explains it\n' >&2; continue
      else printf -v "$__var" '%s' ""; return 0; fi
    fi
    if [ -z "$field" ]; then printf -v "$__var" '%s' "$answer"; return 0; fi
    if norm="$(helper normalize-field "$field" -- "$answer" 2>&1)"; then printf -v "$__var" '%s' "$norm"; return 0; fi
    printf '  %s\n' "${norm#\[office\] error: }" >&2
  done
}

field_help() { helper field-help "$1" 2>/dev/null | sed 's/^[^:]*: //'; }

# ask_field VAR FIELD FLAG QUESTION [DEFAULT] [REQUIRED]
ask_field() {
  ask "$1" "$4 ($3)" "${5:-}" "${6:-0}" "$(field_help "$2")" "$2"
}

# check_field VAR FIELD FLAG: normalize a value given as a flag. A value
# the field does not take is explained; on a terminal the field is then
# asked (the return is 2, so the caller asks), piped it refuses.
check_field() {
  local __var="$1" field="$2" flag="$3" norm
  [ -n "${!__var}" ] || return 0
  if norm="$(helper normalize-field "$field" -- "${!__var}" 2>&1)"; then printf -v "$__var" '%s' "$norm"; return 0; fi
  norm="${norm#\[office\] error: }"
  if can_ask; then
    printf '[office] %s %s: %s\n' "$flag" "$(shq "${!__var}")" "$norm" >&2
    printf -v "$__var" '%s' ""
    return 2
  fi
  die "$flag: $norm"
}

TMP_PATHS=()
cleanup_tmp() { [ "${#TMP_PATHS[@]}" -gt 0 ] && rm -rf "${TMP_PATHS[@]}"; return 0; }
trap cleanup_tmp EXIT

install_version() {
  local v
  v="$(head -n 1 "$OFFICE_SRC/VERSION" 2>/dev/null)" || die "install has no VERSION file: $OFFICE_SRC"
  [ -n "$v" ] || die "install VERSION is empty: $OFFICE_SRC/VERSION"
  printf '%s' "$v"
}

require_tools() {
  local t
  for t in "$@"; do
    command -v "$t" >/dev/null 2>&1 || die "$t is required and not on PATH"
  done
}

# --- finding the office ----------------------------------------------------

# Walk up from a directory to the nearest office, the way git finds .git.
find_office_from() {
  local dir
  dir="$(readlink -f "$1" 2>/dev/null)" || return 1
  while :; do
    if [ -f "$dir/$MANIFEST_REL" ]; then printf '%s' "$dir"; return 0; fi
    [ "$dir" = "/" ] && return 1
    dir="$(dirname "$dir")"
  done
}

# OFFICE_ROOT, then the office around the working directory, then this
# machine's default. Each source is reported so a surprise is traceable.
resolve_office() {
  local root
  if [ -n "${OFFICE_ROOT:-}" ]; then
    [ -f "$OFFICE_ROOT/$MANIFEST_REL" ] || die "OFFICE_ROOT is not an office (no $MANIFEST_REL): $OFFICE_ROOT"
    debug "office from OFFICE_ROOT: $OFFICE_ROOT"
    readlink -f "$OFFICE_ROOT"; return 0
  fi
  if root="$(find_office_from "$PWD")"; then
    debug "office found above the working directory: $root"
    printf '%s' "$root"; return 0
  fi
  if [ -f "$DEFAULT_FILE" ]; then
    root="$(head -n 1 "$DEFAULT_FILE")"
    [ -f "$root/$MANIFEST_REL" ] || die "this machine's default office is gone or not an office: $root (set another with: office default PATH)"
    log "not inside an office; using this machine's default, $root"
    printf '%s' "$root"; return 0
  fi
  die "not inside an office and this machine has no default office (set one with: office default PATH)"
}

# --- version skew ----------------------------------------------------------

# Prints the skew state and any pending migrations (helper format).
skew_report() {
  local root="$1" office_v
  office_v="$(helper stamp "$root/$MANIFEST_REL" migrated_to)" || die "cannot read the version stamp in $root/$MANIFEST_REL"
  helper skew "$office_v" "$(install_version)" "$MIGRATIONS" || die "cannot plan migrations from $MIGRATIONS"
}

# Refuse loudly on skew in either direction; commands that act on the
# office's shape call this before touching it.
require_current() {
  local root="$1" report state office_v
  report="$(skew_report "$root")" || exit 1
  state="$(printf '%s\n' "$report" | head -n 1)"
  office_v="$(helper stamp "$root/$MANIFEST_REL" migrated_to)"
  case "$state" in
    current) return 0 ;;
    ahead) die "this office was migrated to $office_v, past the installed office-src $(install_version); install $office_v or later before using it" ;;
    behind)
      log "this office is at $office_v and office-src $(install_version) has breaking releases it has not taken:"
      printf '%s\n' "$report" | tail -n +2 | cut -f1,4 | sed 's/\t/: /; s/^/[office]   /' >&2
      die "run: office upgrade" ;;
    *) die "unexpected skew state: $state" ;;
  esac
}

warn_if_unfounded() {
  local root="$1" out
  out="$(helper profile-check "$root/$PROFILE_REL" "$SHAPE")"
  case $? in
    0) return 0 ;;
    3) warn "this office is unfounded: its profile is incomplete (office status)" ;;
    *) warn "could not check the profile against the required shape" ;;
  esac
}

# --- survey ----------------------------------------------------------------

fact() { printf '%s\t%s\t%s\n' "$1" "$2" "$3"; }

tool_version() {
  local t="$1" out
  if ! command -v "$t" >/dev/null 2>&1; then printf 'not found'; return; fi
  case "$t" in
    R) out="$(timeout "$VERSION_TIMEOUT" R --version 2>&1 | head -n 1)" ;;
    *) out="$(timeout "$VERSION_TIMEOUT" "$t" --version 2>&1 | head -n 1)" ;;
  esac
  [ -n "$out" ] || out="no version output (or timed out after ${VERSION_TIMEOUT}s)"
  printf '%s (%s)' "$out" "$(command -v "$t")"
}

gather_facts() {
  local root="$1" os tz mounts n step name out
  fact Survey surveyed_at "$(date -u +%Y-%m-%dT%H:%M:%SZ)"
  fact Survey office_root "$root"

  os="$(. /etc/os-release 2>/dev/null && printf '%s' "${PRETTY_NAME:-unknown}")"
  fact Machine hostname "$(hostname 2>/dev/null || printf 'unknown')"
  fact Machine os "${os:-unknown (no /etc/os-release)}"
  fact Machine kernel "$(uname -srm 2>/dev/null)"
  if grep -qi microsoft /proc/version 2>/dev/null; then fact Machine class "WSL"
  elif [ -f /.dockerenv ]; then fact Machine class "container"
  else fact Machine class "host (not WSL, no container marker)"; fi
  fact Machine login_shell "${SHELL:-unset}"
  fact Machine bash "$BASH_VERSION"

  for t in bale git python3 R quarto node; do fact Tools "$t" "$(tool_version "$t")"; done

  tz="$(cat /etc/timezone 2>/dev/null || readlink /etc/localtime 2>/dev/null | sed 's#.*/zoneinfo/##')"
  fact Timezone system "${tz:-unknown}"
  fact Timezone TZ "${TZ:-unset}"
  fact Timezone zone_offset "$(date '+%Z %z')"

  # Mount points by name only: /proc/mounts is a list, never a walk.
  mounts="$(awk '$3 !~ /^(proc|sysfs|devtmpfs|devpts|tmpfs|cgroup2?|mqueue|securityfs|debugfs|tracefs|pstore|bpf|hugetlbfs|configfs|fusectl|autofs|binfmt_misc|nsfs|rpc_pipefs|efivarfs|ramfs|squashfs)$/ {print $2 "\t" $3}' /proc/mounts 2>/dev/null | sort -u)"
  n="$(printf '%s\n' "$mounts" | grep -c . || true)"
  if [ "$n" -eq 0 ]; then
    fact Mounts none "no /proc/mounts or no real filesystems listed"
  else
    printf '%s\n' "$mounts" | head -n 40 | while IFS=$'\t' read -r target fstype; do fact Mounts "$target" "$fstype"; done
    [ "$n" -gt 40 ] && fact Mounts truncated "$n mount points, showing 40"
  fi

  if command -v bale >/dev/null 2>&1; then
    fact bale on_path "$(command -v bale)"
    fact bale install "$(readlink -f "$(command -v bale)")"
  else
    fact bale on_path "not found"
  fi
  fact office-src install "$OFFICE_SRC"
  fact office-src version "$(install_version)"
  fact office-src on_path "$(command -v office 2>/dev/null || printf 'not on PATH')"

  if [ -d "$root/drawer/survey" ]; then
    for step in "$root"/drawer/survey/*; do
      [ -f "$step" ] || continue
      name="$(basename "$step")"
      if [ ! -x "$step" ]; then fact "Office step: $name" skipped "not executable"; continue; fi
      out="$(cd "$root" && timeout "$STEP_TIMEOUT" "$step" 2>&1)"
      case $? in
        0) ;;
        124) fact "Office step: $name" error "timed out after ${STEP_TIMEOUT}s" ;;
        *) fact "Office step: $name" error "exited nonzero" ;;
      esac
      n=0
      while IFS= read -r line && [ "$n" -lt 40 ]; do
        n=$((n + 1))
        if [[ "$line" =~ ^([^:]+):[[:space:]]*(.*)$ ]]; then
          fact "Office step: $name" "${BASH_REMATCH[1]}" "${BASH_REMATCH[2]}"
        elif [ -n "$line" ]; then
          fact "Office step: $name" "line $n" "$line"
        fi
      done <<< "$out"
      [ "$(printf '%s\n' "$out" | wc -l)" -gt 40 ] && fact "Office step: $name" truncated "output capped at 40 lines"
    done
  fi
}

# Write the survey page; print the change report on stdout.
write_survey() {
  local root="$1" facts
  facts="$(mktemp)" || die "cannot make a temp file for the survey"
  gather_facts "$root" > "$facts"
  if ! helper survey-render --facts "$facts" --previous "$root/$SURVEY_REL" --out "$root/$SURVEY_REL"; then
    rm -f "$facts"; die "could not write $root/$SURVEY_REL"
  fi
  rm -f "$facts"
}

# --- pack lines --------------------------------------------------------------

slugify() { printf '%s' "$1" | tr '[:upper:]' '[:lower:]' | tr -c 'a-z0-9' '-' | sed 's/--*/-/g; s/^-//; s/-$//'; }

# The doctrine rides as a context tarball made in the install; include
# groups only pull paths inside the repo being packed.
doctrine_context_cmd() {
  printf '(cd %s && bale pack --context)' "$(shq "$DOCTRINE_DIR")"
}

# The founding session is scoped, so one trip lands the profile, the
# occupant's words from the founding conversation as a notepad page, and
# the office's real timezone. The include group in bale.toml pulls the
# hung items (profile.md, the survey) once floor-plan is included.
founding_line() {
  local root="$1" name="$2" slug
  slug="$(slugify "$name")-founding"
  printf '%s && cd %s && bale pack --slug %s --include floor-plan --write %s notepad floor-plan --no-readme %s\n' \
    "$(doctrine_context_cmd)" "$(shq "$root")" "$slug" "$PROFILE_REL" \
    "$(shq "Found the $name office: write its profile with the occupant section by section, file the occupant's words from this conversation as a notepad page, and set the office's real timezone in the floor plan and the profile's Site section, asking the occupant rather than trusting the machine clock")"
}

# Only office upgrade writes the version stamp. The renovation session
# does the work; a re-run of office upgrade checks the migration's
# declaration and stamps the office when it holds.
renovation_line() {
  local root="$1" version="$2" goal="$3" landed="$4" slug
  slug="upgrade-$(slugify "$version")"
  printf '%s && cd %s && bale pack --slug %s --no-readme %s\n' \
    "$(doctrine_context_cmd)" "$(shq "$root")" "$slug" \
    "$(shq "Renovate this office for office-src $version: $goal Done means $landed. Leave the version stamp alone; office upgrade checks this and stamps the office.")"
}

# --- verbs -------------------------------------------------------------------

# The install's own catalogs, checked before anything is built from
# them: office status reports a defect and exits 0, office init refuses.
require_sound_install() {
  local defects rc
  defects="$(helper catalog-check "$VERBS" "$CATALOG" 2>/dev/null)"; rc=$?
  case $rc in
    0) debug "the install's catalogs hold: $VERBS, $CATALOG" ;;
    3) log "the install at $OFFICE_SRC has a defect in its catalogs (share/verbs.toml, share/spaces.toml):"
       printf '%s\n' "$defects" | sed 's/^/[office]   /' >&2
       die "refusing to build an office from a defective install; fix office-src and run install.sh again" ;;
    *) die "could not check the install's catalogs ($VERBS, $CATALOG); refusing to build an office from them" ;;
  esac
}

cmd_init() {
  local path="" name="" set_default=1 parent root anc ask_projects=1 project_specs=() checked="" pname ppath
  while [ $# -gt 0 ]; do
    case "$1" in
      --name) [ $# -ge 2 ] || die "--name needs a value"; name="$2"; shift 2 ;;
      --project) [ $# -ge 2 ] || die "--project needs a project's repo: --project PATH, or --project NAME=PATH"
                 project_specs+=("$2"); shift 2 ;;
      --no-projects) ask_projects=0; shift ;;
      --path) [ $# -ge 2 ] || die "--path needs a value"; [ -z "$path" ] || die "init takes one path"; path="$2"; shift 2 ;;
      --no-default) set_default=0; shift ;;
      -h|--help) usage_init; return 0 ;;
      -*) usage_init >&2; die "office init does not know $1; it takes a path, --name, --no-default, --project and --no-projects" ;;
      *) [ -z "$path" ] || die "init takes one path"; path="$1"; shift ;;
    esac
  done
  require_tools git python3 timeout
  require_sound_install
  if [ -z "$path" ]; then
    can_ask || { usage_init >&2; die "init needs a path: office init PATH (or --path PATH); piped input is never asked"; }
    ask path "Where to build the office, a new or empty directory (--path)" "" 1 \
      "The directory the office is built in: new, or empty. It becomes its own git repo, so it may not sit inside another repo or another office, and it may not be your home directory itself."
    case "$path" in "~"|"~/"*) path="$HOME${path#\~}" ;; esac
    if [ -z "$name" ]; then
      ask name "Name for the office (--name)" "$(basename "$(readlink -m "$path")")" 0 \
        "What the office is called on the walk-in and in its founding session's slug: letters, digits, dot, dash or underscore."
    fi
  fi

  root="$(readlink -m "$path")"
  [ "$root" != "/" ] || die "refusing to make an office of /"
  [ "$root" != "$(readlink -m "$HOME")" ] || die "refusing to make an office of the home directory itself; bale refuses it too"
  if [ -f "$root/$MANIFEST_REL" ]; then die "already an office: $root"; fi
  anc="$root"; while [ ! -e "$anc" ]; do anc="$(dirname "$anc")"; done
  [ -d "$anc" ] || die "not a directory: $anc"
  if parent="$(find_office_from "$anc")"; then die "$root would sit inside the office at $parent"; fi
  if git -C "$anc" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
    die "$root is inside the git repo at $(git -C "$anc" rev-parse --show-toplevel); an office is its own repo"
  fi
  if [ -e "$root" ] && [ -n "$(ls -A "$root" 2>/dev/null)" ]; then
    die "$root exists and is not empty; init builds into an empty or new directory, and things move in after"
  fi
  git var GIT_COMMITTER_IDENT >/dev/null 2>&1 || die "git has no identity to commit with; set it once with: git config --global user.name 'Your Name' && git config --global user.email you@example.com"
  # The projects given as flags are checked before anything is built, so
  # one that is not a repo bale runs in builds nothing.
  if [ "${#project_specs[@]}" -gt 0 ]; then
    checked="$(helper project-spec "${project_specs[@]}")" || die "nothing was built; fix the --project above, or leave it out and add it later with office projects add"
  fi

  [ -n "$name" ] || name="$(basename "$root")"
  [[ "$name" =~ ^[A-Za-z0-9][A-Za-z0-9._-]*$ ]] || die "office name must be letters, digits, dot, dash or underscore: $name"
  local version built_at tz sp
  version="$(install_version)"
  built_at="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
  tz="$(cat /etc/timezone 2>/dev/null || readlink /etc/localtime 2>/dev/null | sed 's#.*/zoneinfo/##')"
  tz="${tz:-UTC}"

  log "building office '$name' at $root from office-src $version"
  mkdir -p "$root/floor-plan" || die "cannot create $root"
  helper render-manifest "$CATALOG" --name "$name" --version "$version" --built-at "$built_at" --timezone "$tz" > "$root/$MANIFEST_REL" \
    || die "could not write the floor plan; $root is partial, remove it with: rm -rf $(printf '%q' "$root")"
  while IFS= read -r sp; do
    case "$sp" in
      "$PROFILE_REL"|floor-plan) ;;
      *) mkdir -p "$root/$sp" && : > "$root/$sp/.keep" || die "cannot create space $sp" ;;
    esac
    debug "space: $sp"
  done < <(helper base-spaces "$CATALOG")
  sed -e "s|{{name}}|$(sed_rhs "$name")|g" -e "s|{{root}}|$(sed_rhs "$root")|g" -e "s|{{timezone}}|$(sed_rhs "$tz")|g" \
      -e "s|{{machine}}|$(sed_rhs "$(hostname 2>/dev/null || printf unknown)")|g" -e "s|{{date}}|${built_at%%T*}|g" \
      "$TEMPLATES/profile.md" > "$root/$PROFILE_REL" || die "could not write the profile stub"
  printf '.bale/\n' > "$root/.gitignore"

  log "first survey"
  write_survey "$root" | sed 's/^/[office] survey: /' >&2
  # After the survey, so the survey page is on disk to be a pull.
  helper render-bale-toml "$root/$MANIFEST_REL" --root "$root" > "$root/$BALE_TOML_REL" || die "could not write $BALE_TOML_REL"
  debug "wrote $BALE_TOML_REL: the include group that pulls the hung items"

  git -C "$root" init -q -b main || die "git init failed in $root"
  git -C "$root" add -A && git -C "$root" commit -q -m "office init: $name (office-src $version)" \
    || die "the first commit failed; $root is partial, remove it with: rm -rf $(printf '%q' "$root")"
  log "committed the skeleton, the profile stub, bale.toml and the first survey"

  if [ "$set_default" = "1" ] && [ ! -f "$DEFAULT_FILE" ]; then
    mkdir -p "$CONFIG_DIR" && printf '%s\n' "$root" > "$DEFAULT_FILE" && log "made $root this machine's default office"
  fi
  # Which projects the office watches: the flags', then, on a terminal,
  # asked one at a time through office projects add's own questions until
  # a plain return.
  while IFS=$'\t' read -r pname ppath; do
    [ -n "$pname" ] || continue
    # stdout stays the founding line's alone.
    ( OFFICE_ROOT="$root" cmd_projects_add --name "$pname" --path "$ppath" ) >&2 \
      || die "the office is built, but $pname could not be added; office projects add $pname $(shq "$ppath") tries again"
  done <<< "$checked"
  if [ "${#project_specs[@]}" -eq 0 ] && [ "$ask_projects" = 1 ] && can_ask; then
    init_ask_projects "$root"
  fi
  log "the office is unfounded until its profile is written; the line below packs the founding session"
  log "attach $DOCTRINE_DIR/.bale/outbox/context-doctrine.tar.gz beside the request it opens"
  founding_line "$root" "$name"
}

usage_survey() {
  cat <<'USAGE'
usage: office survey [--no-commit | --before-pack]
Rewrites floor-plan/survey.md with facts about this machine (the system,
tools and their versions, the timezone, mounts by name, the bale and
office-src installs, and the office's own drawer/survey steps), says what
changed since the last survey, and commits the page. Facts only.
--before-pack is how office start runs it, once its checks have passed
and before it packs: never fatal, and left alone while an open session's
forecast holds the page.
Examples:
  office survey
  office survey --no-commit
USAGE
}

# project_dir_ok PATH: is it the top of a git repo bale runs in? When it
# is not, the reason, indented, for a wizard to ask again.
project_dir_ok() {
  local why
  if why="$(helper check-project-dir -- "$1" 2>&1 >/dev/null)"; then return 0; fi
  printf '  %s\n' "${why#\[office\] error: }" >&2
  return 1
}

# On a terminal, after building: which projects the office watches, one
# at a time through office projects add's own questions (the path, the
# name, what rides, what runs after it lands), until a plain return. A
# path that does not check is said and asked again at once; nothing here
# stops the office being built.
init_ask_projects() {
  local root="$1" p n=0 q
  log "which projects does this office watch? Each is the top of a git repo bale runs in; office start packs its sessions and office land brings them back. A plain return ends the list, and office projects add adds one any time"
  while :; do
    if [ "$n" -eq 0 ]; then q="A project this office watches: the path to its repo (--project PATH)"
    else q="Another project's path (--project PATH)"; fi
    ask p "$q" "" 0 \
      "The top of a project's git repo on this machine, absolute or ~/..., where bale has run (a .bale/ directory) or is set up (a bale.toml). The office reads what bale records there, packs that project's sessions there, and keeps what rides with it in its own floor plan, never in the repo. A plain return ends the list."
    [ -n "$p" ] || break
    case "$p" in "~"|"~/"*) p="$HOME${p#\~}" ;; esac
    project_dir_ok "$p" || continue
    if ( OFFICE_ROOT="$root" cmd_projects_add --path "$p" ) >&2; then
      n=$((n + 1))
    else
      printf '  that one was not added (the line above says why); give another path, or a plain return\n' >&2
    fi
  done
  if [ "$n" -eq 0 ]; then log "no projects yet; office projects add adds one when you want it"
  else log "this office watches $n project(s); office projects lists them"; fi
  return 0
}

cmd_survey() {
  local commit=1 root before_pack=0
  while [ $# -gt 0 ]; do
    case "$1" in
      --no-commit) commit=0; shift ;;
      --before-pack) before_pack=1; shift ;;
      -h|--help) usage_survey; return 0 ;;
      *) die "unknown option for survey: $1" ;;
    esac
  done
  require_tools python3 timeout
  root="$(resolve_office)" || exit 1
  if [ "$before_pack" = 1 ]; then
    [ "$commit" = 1 ] || die "--before-pack commits the page; it takes no --no-commit"
    refresh_survey "$root"; return 0
  fi
  require_current "$root"
  warn_if_unfounded "$root"
  log "surveying $(hostname 2>/dev/null) for $root"
  local report
  report="$(write_survey "$root")" || exit 1
  printf '%s\n' "$report"
  if [ "$commit" = "1" ] && git -C "$root" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
    commit_survey "$root" "$report" "office survey" || die "could not commit $SURVEY_REL"
  fi
}

# commit_survey ROOT REPORT WHO: commit the survey page alone, its
# subject counting the facts that changed.
commit_survey() {
  local root="$1" report="$2" who="$3" n
  git -C "$root" add -- "$SURVEY_REL" || return 1
  if git -C "$root" diff --cached --quiet -- "$SURVEY_REL"; then
    log "survey page unchanged in git"; return 0
  fi
  n="$(printf '%s\n' "$report" | grep -c '^\(added\|removed\|changed\) ' || true)"
  git -C "$root" commit -q -m "$who: $n facts changed" -- "$SURVEY_REL" || return 1
  log "committed $SURVEY_REL ($n facts changed)"
}

# Before office start packs anything (office survey --before-pack, which
# the start in lib/office_bale.py runs once its checks have passed, so a
# refused start commits nothing): survey the machine again, so the hung
# survey every session reads first is never older than its pack
# (doctrine section 13). One commit, the page alone. Never fails a
# start: a survey that cannot run, or a page an open session's forecast
# holds (the one-writer rule), leaves the page as it is and says how old
# it is and which office-src it records.
refresh_survey() {
  local root="$1" held rc report age
  age="$(helper survey-age "$root/$SURVEY_REL" --install "$(install_version)" 2>/dev/null || printf 'unreadable')"
  held="$(reader writers "$root" "$SURVEY_REL" 2>/dev/null)"; rc=$?
  case $rc in
    0) ;;
    3) warn "an open session holds $SURVEY_REL (the one-writer rule), so office start leaves the survey as it is: $age"
       printf '%s\n' "$held" | sed 's/^/[office]   /' >&2
       return 0 ;;
    *) warn "bale's registry in this office could not be read, so office start leaves the survey as it is: $age"
       return 0 ;;
  esac
  if ! report="$( (write_survey "$root") 2>/dev/null )"; then
    warn "the survey could not run, so the session reads the survey as it was: $age (office survey says why)"
    return 0
  fi
  if git -C "$root" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
    commit_survey "$root" "$report" "office start: survey" \
      || warn "the survey was refreshed but not committed; $SURVEY_REL is changed on disk"
  fi
  log "surveyed this machine again for the session ($(helper survey-age "$root/$SURVEY_REL" --install "$(install_version)" 2>/dev/null))"
}

usage_status() {
  cat <<'USAGE'
usage: office status
Says whether the office matches the installed tool, read-only: the version
stamp and any skew, whether the install is level with the working copy it
was installed from, whether the profile is complete, the survey's age and
the office-src it records, whether the floor plan's timezone resolves (and
what fixes it when it does not), whether bale.toml's include group matches
the floor plan, the install's catalogs, folders against their History,
filed pages against git, the drafting table against the catalog and each
ratified charter against git from its ratifying commit on, and the
installed bale and the projects. It reports and exits 0.
Examples:
  office status
  OFFICE_ROOT=~/offices/work office status
USAGE
}

# The install against the working copy it was installed from, as
# install.sh stamped it in INSTALLED: an install that is not the
# source's HEAD says so, with the line that brings it level. An install
# moves only when install.sh runs (office land runs it for office-src as
# an after-land action, when office land lands the session); this line
# is how an install left behind is seen.
install_source_line() {
  local stamp="$OFFICE_SRC/INSTALLED" src commit head have v
  if [ ! -f "$stamp" ]; then
    printf 'source:     none recorded (no INSTALLED stamp: this office-src runs from a working copy, not an install)\n'
    return 0
  fi
  src="$(sed -n 's/^source: //p' "$stamp" | head -n 1)"
  commit="$(sed -n 's/^commit: //p' "$stamp" | head -n 1)"
  if [ -z "$src" ] || ! git -C "$src" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
    printf 'source:     %s, which is not a git work tree here, so the install cannot be compared with it\n' "${src:-(unrecorded)}"
    return 0
  fi
  head="$(git -C "$src" rev-parse HEAD 2>/dev/null)"
  have="$(git -C "$src" rev-parse --verify --quiet "${commit}^{commit}" 2>/dev/null)"
  if [ -n "$have" ] && [ "$have" = "$head" ]; then
    printf 'source:     %s at %s, as installed\n' "$src" "$commit"
  else
    v="$(git -C "$src" show HEAD:VERSION 2>/dev/null | head -n 1)"
    printf 'source:     BEHIND: the install is %s, and %s is now at %s (office-src %s); (cd %s && ./install.sh) brings the install level\n' \
      "$commit" "$src" "$(git -C "$src" rev-parse --short HEAD)" "${v:-?}" "$(shq "$src")"
  fi
}

cmd_status() {
  local root report state office_v built profile rc
  case "${1:-}" in -h|--help) usage_status; return 0 ;; esac
  [ $# -eq 0 ] || { usage_status >&2; die "office status takes no arguments"; }
  root="$(resolve_office)" || exit 1
  report="$(skew_report "$root")" || exit 1
  state="$(printf '%s\n' "$report" | head -n 1)"
  office_v="$(helper stamp "$root/$MANIFEST_REL" migrated_to)"
  built="$(helper stamp "$root/$MANIFEST_REL" built_from)"
  printf 'office:     %s\n' "$root"
  printf 'name:       %s\n' "$(helper get "$root/$MANIFEST_REL" office.name --default "(unnamed)")"
  printf 'install:    office-src %s at %s\n' "$(install_version)" "$OFFICE_SRC"
  install_source_line
  printf 'built from: %s\n' "$built"
  printf 'migrated:   %s\n' "$office_v"
  case "$state" in
    current) printf 'skew:       none\n' ;;
    ahead)   printf 'skew:       AHEAD; office migrated past this install; install %s or later\n' "$office_v" ;;
    behind)  printf 'skew:       BEHIND; run: office upgrade\n'
             printf '%s\n' "$report" | tail -n +2 | cut -f1,2,4 | sed 's/\t/ (/; s/\t/): /; s/^/  pending:  /' ;;
  esac
  profile="$(helper profile-check "$root/$PROFILE_REL" "$SHAPE")"; rc=$?
  case $rc in
    0) printf 'profile:    complete\n' ;;
    3) printf 'profile:    INCOMPLETE; this office is unfounded\n'
       printf '%s\n' "$profile" | sed 's/^/  /' ;;
    *) printf 'profile:    could not be checked\n' ;;
  esac
  printf 'survey:     %s\n' "$(helper survey-age "$root/$SURVEY_REL" --install "$(install_version)" 2>/dev/null || printf 'unreadable')"
  local tz_named
  tz_named="$(office_tz_named "$root")"
  if zone_resolves "$tz_named"; then
    printf 'timezone:   %s\n' "$tz_named"
  else
    printf 'timezone:   PROBLEM: the floor plan names %s, which is not in %s, so the office runs on UTC\n' "$tz_named" "$(zoneinfo_dir)"
    printf '  %s\n' "$(zone_remedy "$tz_named")"
  fi
  local drift
  drift="$(helper include-group-check "$root/$MANIFEST_REL" "$root/$BALE_TOML_REL" "$root")"
  case $? in
    0) printf 'hung items: bale.toml include group matches the floor plan\n' ;;
    3) printf 'hung items: bale.toml differs from the floor plan\n'; printf '%s\n' "$drift" | sed 's/^/  /' ;;
    *) printf 'hung items: could not compare bale.toml with the floor plan\n' ;;
  esac
  # The install's catalogs, not the office's: a verb declared unattended
  # with no landing, or a hung page that is also filed, is a defect in
  # office-src that every office on this install should hear about.
  local defects
  defects="$(helper catalog-check "$VERBS" "$CATALOG" 2>/dev/null)"
  case $? in
    0) printf 'catalogs:   every unattended session kind declares a landing; no hung page is filed\n' ;;
    3) printf 'catalogs:   DEFECT in the install at %s (share/verbs.toml, share/spaces.toml)\n' "$OFFICE_SRC"
       printf '%s\n' "$defects" | sed 's/^/  /' ;;
    *) printf 'catalogs:   could not be checked\n' ;;
  esac
  # The desk's facts: every folder's status agrees with its History's
  # last state-changing line, and the numbers are minted once each.
  helper folder-check "$root" 2>/dev/null
  case $? in 0|3) ;; *) printf 'folders:    could not be checked\n' ;; esac
  # Filed pages only grow at their end: git's history of every filed
  # page the floor plan lists, the net for a hand edit that went
  # through neither bale nor a script.
  helper filed-check "$root" 2>/dev/null
  case $? in 0|3) ;; *) printf 'filed:      could not be checked (is the office a git repo?)\n' ;; esac
  # The drafting table, when it exists, against the install's catalog;
  # and every ratified charter's bytes against git from its ratifying
  # commit on.
  drafting table-check "$root" 2>/dev/null
  case $? in 0|3) ;; *) printf 'drafting:   could not be checked\n' ;; esac
  # The read side: which bale is installed against the version the
  # office's reads were written for, and whether each project in scope
  # can be read. Lines, never a refusal.
  reader status-lines "$root" || printf 'bale:       the read side could not be checked\n'
}

# Run planned migrations in a target office. Arguments: target, plan file.
# Prints the applied lines to stdout. Returns 0 when every migration ran,
# 10 when it stopped at a renovation (whose line is the last printed),
# 1 on failure.
run_migrations() {
  local target="$1" plan="$2" version kind action summary landed filed changed
  # Filed paper, one pathspec per line: a whole space, or the paths a
  # part-filed space lists (a path may hold a glob, which git expands;
  # a path that does not exist yet matches nothing and refuses nothing).
  mapfile -t filed < <(helper spaces "$target/$MANIFEST_REL" filed)
  while IFS=$'\t' read -r version kind action summary landed; do
    [ -n "$version" ] || continue
    if [ "$kind" = "renovation" ]; then
      local unmet
      if unmet="$(helper landed "$version" "$MIGRATIONS" "$(install_version)" "$target")"; then
        log "migration $version is a renovation and its declaration holds: $landed"
        helper set-migrated "$target/$MANIFEST_REL" "$version" || return 1
        printf 'verified\t%s\t%s (renovation, checked)\n' "$version" "$summary"
        continue
      fi
      [ -n "$unmet" ] || { log "could not check renovation $version"; return 1; }
      printf '%s\n' "$unmet" | sed "s/^/[office]   $version not landed yet: /" >&2
      printf 'renovation\t%s\t%s\t%s\t%s\n' "$version" "$action" "$summary" "$landed"
      return 10
    fi
    log "migration $version: $summary"
    if ! (cd "$target" && OFFICE_ROOT="$target" OFFICE_MIGRATION="$version" OFFICE_SRC="$OFFICE_SRC" timeout 300 bash "$MIGRATIONS/$action") >&2; then
      log "migration $version failed in $target"
      return 1
    fi
    if [ "${#filed[@]}" -gt 0 ]; then
      changed="$(git -C "$target" status --porcelain -- "${filed[@]}")"
      if [ -n "$changed" ]; then
        log "migration $version touched filed paper, which is never rewritten:"
        printf '%s\n' "$changed" | sed 's/^/[office]   /' >&2
        return 1
      fi
    fi
    helper set-migrated "$target/$MANIFEST_REL" "$version" || return 1
    printf 'applied\t%s\t%s\n' "$version" "$summary"
  done < "$plan"
  return 0
}

usage_upgrade() {
  cat <<'USAGE'
usage: office upgrade [--dry-run]
Runs the migrations a breaking release of office-src ships, after a dry run
on a scratch clone, and lands them as one commit. A migration that needs
judgment stops at a renovation: upgrade prints its pack line, and the next
run checks the renovation landed and stamps the office. Additive releases
need nothing; upgrade says so.
Examples:
  office upgrade --dry-run
  office upgrade
USAGE
}

cmd_upgrade() {
  local dry=0 root report state office_v plan scratch rc applied msg
  while [ $# -gt 0 ]; do
    case "$1" in
      --dry-run) dry=1; shift ;;
      -h|--help) usage_upgrade; return 0 ;;
      *) die "unknown option for upgrade: $1" ;;
    esac
  done
  require_tools git python3 timeout
  root="$(resolve_office)" || exit 1
  report="$(skew_report "$root")" || exit 1
  state="$(printf '%s\n' "$report" | head -n 1)"
  office_v="$(helper stamp "$root/$MANIFEST_REL" migrated_to)"
  case "$state" in
    ahead) die "this office was migrated to $office_v, past the installed office-src $(install_version); install $office_v or later" ;;
    current) log "nothing to upgrade: office at $office_v, office-src $(install_version), no migrations pending"; return 0 ;;
  esac
  git -C "$root" rev-parse --is-inside-work-tree >/dev/null 2>&1 || die "$root is not a git repo; an upgrade lands as a commit"
  [ -z "$(git -C "$root" status --porcelain)" ] || die "$root has uncommitted changes; commit them first so the upgrade is one clean commit"

  plan="$(mktemp)" && scratch="$(mktemp -d)" || die "cannot make temp space for the upgrade"
  TMP_PATHS+=("$plan" "$scratch")
  printf '%s\n' "$report" | tail -n +2 > "$plan"
  log "upgrading $root from $office_v to office-src $(install_version); pending:"
  cut -f1,2,4 "$plan" | sed 's/\t/ (/; s/\t/): /; s/^/[office]   /' >&2

  log "dry run on a scratch clone"
  git clone -q "$root" "$scratch/office" || die "could not clone $root for the dry run"
  run_migrations "$scratch/office" "$plan" > "$scratch/dry.out"; rc=$?
  [ "$rc" -eq 1 ] && die "the dry run failed; $root was not touched"
  log "dry run passed"
  if [ "$dry" = "1" ]; then
    log "dry run only; nothing changed in $root"
    return 0
  fi

  run_migrations "$root" "$plan" > "$scratch/real.out"; rc=$?
  if [ "$rc" -eq 1 ]; then
    git -C "$root" reset -q --hard HEAD && git -C "$root" clean -qfd
    die "the upgrade failed after the dry run passed; $root was reset to its last commit"
  fi
  applied="$(grep -E '^(applied|verified)' "$scratch/real.out" || true)"
  if [ -n "$applied" ]; then
    msg="$scratch/msg"
    {
      printf 'office upgrade: %s to %s\n\n' "$office_v" "$(helper stamp "$root/$MANIFEST_REL" migrated_to)"
      printf '%s\n' "$applied" | cut -f2,3 | sed 's/\t/: /; s/^/- /'
    } > "$msg"
    git -C "$root" add -A && git -C "$root" commit -q -F "$msg" || die "could not commit the upgrade in $root"
    log "committed the upgrade:"
    sed 's/^/[office]   /' "$msg" >&2
  fi
  if [ "$rc" -eq 10 ]; then
    local line version goal landed
    line="$(grep '^renovation' "$scratch/real.out" | head -n 1)"
    version="$(printf '%s' "$line" | cut -f2)"; goal="$(printf '%s' "$line" | cut -f3)"; landed="$(printf '%s' "$line" | cut -f5)"
    log "migration $version needs judgment, so it is a renovation session, not a script; the line below packs it"
    log "when that session has landed, run office upgrade again: it checks the renovation and stamps the office"
    log "attach $DOCTRINE_DIR/.bale/outbox/context-doctrine.tar.gz beside the request it opens"
    renovation_line "$root" "$version" "$goal" "$landed"
  fi
}

# --- the everyday verbs --------------------------------------------------------
#
# Script verbs: the office command alone, in seconds, no session and no
# network. Each commits exactly the paths it touched, so the occupant's
# other work in progress is never swept into a verb's commit.

# The zone database the office checks a timezone against: TZDIR when it
# is set (the variable the C library reads too), else the usual place.
zoneinfo_dir() { printf '%s' "${TZDIR:-/usr/share/zoneinfo}"; }

# The timezone the floor plan names, as written (UTC when it names none).
office_tz_named() {
  helper get "$1/$MANIFEST_REL" office.timezone --default UTC 2>/dev/null || printf 'UTC'
}

# zone_resolves NAME: is NAME a zone file under the zone database?
zone_resolves() {
  local tz="$1"
  [ "$tz" = UTC ] && return 0
  case "$tz" in ""|/*|*..*) return 1 ;; esac
  [ -f "$(zoneinfo_dir)/$tz" ]
}

# zone_remedy NAME: what makes a zone that does not resolve resolve.
# Ubuntu 24.04 moved the legacy names (America/Indianapolis among them)
# to the tzdata-legacy package; the canonical spelling is found by the
# zone's last name (Indianapolis -> America/Indiana/Indianapolis).
zone_remedy() {
  local tz="$1" dir base found
  dir="$(zoneinfo_dir)"; base="${tz##*/}"
  found="$(cd "$dir" 2>/dev/null && find . \( -path ./posix -o -path ./right \) -prune -o -type f -name "$base" -print 2>/dev/null \
    | sed 's#^\./##' | sort | head -n 3 | paste -sd, - | sed 's/,/, /g')"
  if [ -n "$found" ]; then
    printf 'this zone database spells it %s: the floor plan'"'"'s timezone line can name that, or the package that keeps the legacy names (tzdata-legacy on Debian and Ubuntu) brings %s back' "$found" "$tz"
  else
    printf 'no zone here is named %s: install the package that keeps the legacy names (tzdata-legacy on Debian and Ubuntu), or name a zone %s holds in the floor plan'"'"'s timezone line' "$base" "$dir"
  fi
}

# The office's timezone from its floor plan, checked against the zone
# database; a bad or missing zone falls back to UTC, loudly, with what
# fixes it.
office_tz() {
  local root="$1" tz
  tz="$(office_tz_named "$root")"
  if ! zone_resolves "$tz"; then
    warn "the floor plan's timezone '$tz' is not in $(zoneinfo_dir), so the office runs on UTC; $(zone_remedy "$tz")"
    tz="UTC"
  fi
  printf '%s' "$tz"
}

office_date() { TZ="$1" date +%F; }
office_time() { TZ="$1" date +%H:%M; }

# Commit only the named paths. Returns 1 (after a warning) when there is
# no repo or git refuses; the change on disk stands either way. While
# DEFER_COMMITS names a file (office moves, applying a sitting's moves
# through the verbs' own code), the paths are written there instead, and
# the caller commits them all at once.
commit_paths() {
  local root="$1" msg="$2"; shift 2
  if [ -n "${DEFER_COMMITS:-}" ]; then
    printf '%s\n' "$@" >> "$DEFER_COMMITS" || die "could not keep the paths to commit in $DEFER_COMMITS"
    debug "deferred to office moves' commit: $msg"
    return 0
  fi
  if ! git -C "$root" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
    warn "$root is not a git repo; nothing committed"; return 1
  fi
  git -C "$root" add -A -- "$@" 2>/dev/null || { warn "git add failed for: $*"; return 1; }
  if git -C "$root" diff --cached --quiet -- "$@"; then debug "nothing to commit for: $*"; return 0; fi
  if ! git -C "$root" commit -q -m "$msg" -- "$@" >/dev/null 2>&1; then
    warn "git could not commit ($msg); the change is on disk, uncommitted"; return 1
  fi
  debug "committed: $msg"
}

# Skew for capture: warn, never refuse. Capture is instant and dumb.
warn_on_skew() {
  local root="$1" report state
  report="$(skew_report "$root" 2>/dev/null)" || { warn "could not read this office's version stamp"; return 0; }
  state="$(printf '%s\n' "$report" | head -n 1)"
  case "$state" in
    behind) warn "this office is behind office-src $(install_version) (run: office upgrade); noting anyway" ;;
    ahead) warn "this office was migrated past office-src $(install_version); noting anyway" ;;
  esac
  return 0
}

has_space() {  # has_space ROOT KEY: is the space in this office's floor plan?
  helper get "$1/$MANIFEST_REL" "spaces.$2.path" >/dev/null 2>&1
}

# A folder by exact name, by a unique part of its name, or by its number
# (`folder N`, or N alone when no folder has that number and the digits
# are part of a name), in one space.
find_folder() {
  local root="$1" space="$2" want="$3" d rel matches=()
  [ -n "$want" ] || die "name a folder"
  if [ -d "$root/$space/$want" ]; then printf '%s' "$want"; return 0; fi
  if [[ "$want" =~ ^(folder[[:space:]]+|#)?[0-9]+$ ]]; then
    if rel="$(helper folder-by-number "$root" "$want" 2>/dev/null)"; then
      [ "${rel%%/*}" = "$space" ] || die "$want is $rel, not in $space/"
      printf '%s' "${rel#*/}"; return 0
    fi
    [[ "$want" =~ ^[0-9]+$ ]] || die "no $want on the desk or in the filing cabinet"
  fi
  for d in "$root/$space"/*/; do
    [ -d "$d" ] || continue
    d="$(basename "$d")"
    case "$d" in *"$want"*) matches+=("$d") ;; esac
  done
  case "${#matches[@]}" in
    1) printf '%s' "${matches[0]}" ;;
    0) die "no folder matching '$want' in $space/" ;;
    *) die "'$want' matches ${#matches[@]} folders in $space/: ${matches[*]}" ;;
  esac
}

# On a terminal, a folder a verb was not given: the folders it could
# mean, then the question. Piped, the verb refuses before this.
ask_folder() {
  local __var="$1" root="$2" space="$3" verb="$4" d n=0 number
  printf 'Folders in %s/:\n' "$space" >&2
  for d in "$root/$space"/*/; do
    [ -d "$d" ] || continue
    n=$((n + 1))
    number=""
    [ -f "$d/folder.md" ] && number="$(helper folder-facts "$d/folder.md" 2>/dev/null | sed -n 's/^number\t//p')"
    printf '  %s%s\n' "${number:+folder $number  }" "$(basename "$d")" >&2
  done
  [ "$n" -gt 0 ] || die "nothing in $space/ to $verb"
  ask "$__var" "Which folder: a unique part of its name, or folder N (office $verb FOLDER)" "" 1 \
    "The folder to $verb: its directory name, any part of it that names only one folder, or its number as folder N."
}

usage_note() {
  cat <<'USAGE'
usage: office note TEXT...   (or lines on stdin)
Appends a timed line to today's notepad page, notepad/DATE.md, and commits
that page alone. Capture is instant: it works in an unfounded office and in
one behind or ahead of the installed tool, and only warns. Each line of
stdin is its own note.
Examples:
  office note called the bank; rate locks Friday
  office note "decided: the porch light waits until spring"
  printf '%s\n' "rate locks Friday" "lawyer on Monday" | office note
USAGE
}

cmd_note() {
  local root tz day now page text line n=0
  case "${1:-}" in -h|--help) usage_note; return 0 ;; esac
  root="$(resolve_office)" || exit 1
  warn_on_skew "$root"
  warn_if_unfounded "$root"
  if [ $# -gt 0 ]; then text="$*"
  elif [ ! -t 0 ]; then text="$(cat)"
  else die "nothing to note: give the text as arguments or on stdin"; fi
  [ -n "${text//[[:space:]]/}" ] || die "nothing to note: the text is empty"
  tz="$(office_tz "$root")"; day="$(office_date "$tz")"; now="$(office_time "$tz")"
  page="notepad/$day.md"
  mkdir -p "$root/notepad" || die "cannot create $root/notepad"
  if [ ! -f "$root/$page" ]; then
    helper render-template "$TEMPLATES/notepad-page.md" "date=$day" "title=notes" > "$root/$page" \
      || die "could not start $page"
    printf '\n' >> "$root/$page"
  fi
  text="$(printf '%s' "$text" | helper ascii-escape)"
  while IFS= read -r line; do
    [ -n "${line//[[:space:]]/}" ] || continue
    printf -- '- %s %s\n' "$now" "$line" >> "$root/$page" || die "could not append to $page"
    n=$((n + 1))
  done <<< "$text"
  log "noted $n line(s) in $page"
  # The notepad is filed paper: before committing, the page must be its
  # committed bytes with lines added at the end (doctrine section 15).
  # The words stay on disk either way; nothing is lost, only not filed.
  local why
  why="$(helper append-check "$root" "$page")"
  case $? in
    0) ;;
    3) die "$page differs from its committed bytes other than at its end ($why); the line is on disk but not committed, and office status names the page" ;;
    *) die "could not check $page against its committed bytes; the line is on disk but not committed" ;;
  esac
  commit_paths "$root" "office note: $day $now" "$page" || true
}

usage_slip() {
  cat <<'USAGE'
usage: office slip [TEXT...] [--about WHAT]   (or the text on stdin)
Drops a friction slip in the suggestion box: one new page,
suggestion-box/DATE-SLUG.md, committed on its own. --about names what the
slip is about: the office, a tool (bale, office-src) or one of the
office's projects, so it can be carried to that tool's project. On a
terminal it asks for what it was not told; piped, it never asks. Like
office note, it works in an unfounded office and one behind or ahead of
the installed tool, and only warns.
Examples:
  office slip                                  (asks what caused friction, and about what)
  office slip --about bale pack needs too many flags
  office slip --about office-src the desk does not say why a folder waits
USAGE
}

# A title from words as typed: a leading list marker (1. 2) - * +) and
# emphasis markers (** __ *) taken out, so a slip lifted from a numbered
# Markdown list is titled by its words. The text itself stays as typed.
title_words() {
  sed -E 's/^[[:space:]]*([0-9]+[.)]|[-*+])[[:space:]]+//; s/\*\*|__//g; s/(^|[^[:alnum:]])\*+/\1/g; s/\*+([^[:alnum:]]|$)/\1/g'
}

# A slip is about the office, a tool or a project: one word, the way a
# project is named.
slip_about_choices() {
  local root="$1" names
  names="$(helper project-names "$root/$MANIFEST_REL" 2>/dev/null | paste -sd, - | sed 's/,/, /g')"
  printf 'office, bale, office-src%s' "${names:+, $names}"
}

cmd_slip() {
  local about="" text="" words=() root tz day now title slug page n=1 base
  while [ $# -gt 0 ]; do
    case "$1" in
      --about) [ $# -ge 2 ] || die "--about needs what the slip is about: office, a tool or a project"; about="$2"; shift 2 ;;
      -h|--help) usage_slip; return 0 ;;
      --) shift; words+=("$@"); break ;;
      -*) usage_slip >&2; die "office slip does not know $1; it takes the text and --about" ;;
      *) words+=("$1"); shift ;;
    esac
  done
  root="$(resolve_office)" || exit 1
  warn_on_skew "$root"
  warn_if_unfounded "$root"
  if [ "${#words[@]}" -gt 0 ]; then text="${words[*]}"
  elif [ ! -t 0 ]; then text="$(cat)"
  else
    ask text "What caused friction, in a line or two (office slip TEXT)" "" 1 \
      "Where it hurt and what would remove it, in your words. It lands as its own page in the suggestion box; cleanup and renovation sessions read the box."
  fi
  [ -n "${text//[[:space:]]/}" ] || die "nothing to slip: the text is empty"
  if [ -z "$about" ] && can_ask; then
    ask about "What it is about: $(slip_about_choices "$root") (--about)" "office" 0 \
      "The office itself, a tool the office uses (bale, office-src), or one of this office's projects. A slip about a tool says so, so it can be carried to that tool's project."
  fi
  if [ -n "$about" ] && [[ ! "$about" =~ ^[A-Za-z0-9][A-Za-z0-9._-]*$ ]]; then
    die "--about takes one word, the office, a tool or a project ($(slip_about_choices "$root")), not $(shq "$about")"
  fi
  [ -n "$about" ] || log "the slip does not say what it is about (--about office, a tool or a project says so)"
  tz="$(office_tz "$root")"; day="$(office_date "$tz")"; now="$(office_time "$tz")"
  # The slug from the words as typed, as office open makes one: an
  # escape is no part of a file name.
  slug="$(short_slug "$(printf '%s\n' "$text" | grep -m 1 '[^[:space:]]' | title_words)")"; [ -n "$slug" ] || slug="slip"
  text="$(printf '%s' "$text" | helper ascii-escape)"
  title="$(printf '%s\n' "$text" | grep -m 1 '[^[:space:]]' | title_words | tr -s '[:space:]' ' ' | sed 's/^ //; s/ $//')"
  [ "${#title}" -le 72 ] || title="${title:0:69}..."
  base="suggestion-box/$day-$slug"; page="$base.md"
  while [ -e "$root/$page" ]; do n=$((n + 1)); page="$base-$n.md"; done
  mkdir -p "$root/suggestion-box" || die "cannot create $root/suggestion-box"
  helper render-template "$TEMPLATES/suggestion-slip.md" "title=$title" "about=$about" "dropped=$day $now" "text=$text" \
    > "$root/$page" || { rm -f "$root/$page"; die "could not write $page"; }
  log "slipped $page${about:+ (about $about)}"
  commit_paths "$root" "office slip: $(basename "$page" .md)${about:+ (about $about)}" "$page" || true
  printf '%s\n' "$page"
}

usage_open() {
  cat <<'USAGE'
usage: office open [SLUG] [--title TITLE] [--size SIZE] [--lane LANE] [--source SOURCE]
                   [--class CLASS] [--blueprint ID] [--linked GATE]... [--after GATE]...
                   [--serializes-after GATE]... [--consumer GATE]...
                   [--candidate | --filed --sid SID] [--thread < pasted-thread]
Starts a folder on the desk: numbered one more than the highest number on
the desk and in the filing cabinet, status queued, the day it was queued,
and every field it is given. --candidate opens it as a candidate; --filed
--sid SID files it straight into the filing cabinet, done at that session.
On a terminal it asks for the title, size, lane and source it was not
given: a plain return skips one, and ? explains it. Piped, it never asks.
Examples:
  office open                                  (asks for the title, size, lane, source)
  office open fix-login --title "Fix the login" --size small --lane "office-src: bin/"
  office open house-hunt --thread < thread.txt (keeps the pasted thread as thread.md)
  office open paint-fence --after "folder 3"   (waits until folder 3 is done)
  office open build-a-shed --candidate         (an idea on the desk, not queued yet)
The fields, and what each takes:
USAGE
  helper field-help all | grep -v -e '^status:' -e '^queued:' -e '^number:' -e '^sid:' | fold -s -w 76 | sed 's/^/  /'
}

# The one-writer rule: a verb that mints a folder number refuses while
# the office's own bale registry shows an open session whose forecast
# holds where the number lands. An office bale has never run in has no
# registry, and nothing to refuse; a registry that cannot be read is
# said loudly and does not stop capture.
require_one_writer() {
  local root="$1" target="$2" out rc
  out="$(reader writers "$root" "$target")"; rc=$?
  case $rc in
    0) debug "one-writer rule: no open session in this office's registry holds $target" ;;
    3) printf '%s\n' "$out" | sed 's/^/[office]   /' >&2
       die "an open session holds $target, so no folder number is minted beside it (the one-writer rule); open the folder once that session is applied or closed" ;;
    *) warn "bale's registry in this office could not be read (the line above says why); minting without the one-writer check" ;;
  esac
}

# A slug made from a title: at most 40 characters, cut at a word.
short_slug() {
  local s
  s="$(slugify "$1")"
  if [ "${#s}" -gt 40 ]; then
    s="${s:0:41}"; s="${s%-*}"; s="${s:0:40}"
  fi
  printf '%s' "$s"
}

cmd_open() {
  local slug="" title="" thread=0 candidate=0 filed=0 sid="" size="" lane="" source="" class="" blueprint=""
  local after=() serializes=() consumer=() linked=() root tz day name folder number space status verb text asked=0
  local raw_title=""
  local v i
  while [ $# -gt 0 ]; do
    case "$1" in
      --title|--size|--lane|--source|--class|--blueprint|--sid|--after|--serializes-after|--consumer|--linked)
        [ $# -ge 2 ] || die "$1 needs a value (office open --help explains it)"
        case "$1" in
          --title) title="$2" ;; --size) size="$2" ;; --lane) lane="$2" ;; --source) source="$2" ;;
          --class) class="$2" ;; --blueprint) blueprint="$2" ;; --sid) sid="$2" ;;
          --after) after+=("$2") ;; --serializes-after) serializes+=("$2") ;;
          --consumer) consumer+=("$2") ;; --linked) linked+=("$2") ;;
        esac
        shift 2 ;;
      --thread) thread=1; shift ;;
      --candidate) candidate=1; shift ;;
      --filed) filed=1; shift ;;
      -h|--help) usage_open; return 0 ;;
      -*) usage_open >&2; die "office open does not know $1; the flags above are what it takes" ;;
      *) [ -z "$slug" ] || die "open takes one slug (quote a title with --title)"; slug="$1"; shift ;;
    esac
  done
  [ "$candidate" = 0 ] || [ "$filed" = 0 ] || die "--candidate and --filed are two different births; give one"
  [ -z "$sid" ] || [ "$filed" = 1 ] || die "--sid goes with --filed: a folder born done at that session"
  root="$(resolve_office)" || exit 1
  require_current "$root"
  warn_if_unfounded "$root"

  # Flags first: a value a field does not take is explained, then asked
  # on a terminal and refused when piped.
  raw_title="$title"
  check_field title title --title; check_field size size --size; check_field lane lane --lane
  check_field source source --source; check_field sid sid --sid
  check_field class class --class || ask_field class class --class "Class: bale's work class for its sessions" "" 1
  check_field blueprint blueprint --blueprint || ask_field blueprint blueprint --blueprint "Blueprint id, YYYY-MM-DD-slug" "" 1
  for i in "${!after[@]}"; do v="${after[$i]}"; check_field v after --after || ask_field v after --after "Gate: what must be done first" "" 1; after[$i]="$v"; done
  for i in "${!serializes[@]}"; do v="${serializes[$i]}"; check_field v serializes-after --serializes-after || ask_field v serializes-after --serializes-after "Serializes after which folder" "" 1; serializes[$i]="$v"; done
  for i in "${!consumer[@]}"; do v="${consumer[$i]}"; check_field v consumer --consumer || ask_field v consumer --consumer "Consumer that will carry it" "" 1; consumer[$i]="$v"; done
  for i in "${!linked[@]}"; do v="${linked[$i]}"; check_field v linked --linked || ask_field v linked --linked "Linked folder" "" 1; linked[$i]="$v"; done

  if can_ask && [ "$thread" = 0 ]; then
    # The wizard: what matters to the desk, in four answers at most.
    if [ -z "$title" ]; then
      ask raw_title "Title, in a few words (--title)" "$slug" 1 "$(field_help title)"; asked=1
      title="$(helper normalize-field title -- "$raw_title")" || die "--title: the title is empty"
    fi
    if [ -z "$size" ]; then ask_field size size --size "Size: small, medium or high"; asked=1; fi
    if [ -z "$lane" ]; then ask_field lane lane --lane "Lane: the project and paths, as project: paths"; asked=1; fi
    if [ -z "$source" ]; then ask_field source source --source "Source: where the job came from"; asked=1; fi
    if [ "$filed" = 1 ] && [ -z "$sid" ]; then ask_field sid sid --sid "Session id it was done in" "" 1; asked=1; fi
    [ "$asked" = 0 ] || log "other fields take flags: --class, --blueprint, --after, --serializes-after, --consumer, --linked (office open --help explains each)"
  else
    [ -n "$slug" ] || [ -n "$title" ] || die "open needs a slug or a title: office open SLUG, or --title TITLE; piped input is never asked"
    [ "$filed" = 0 ] || [ -n "$sid" ] || die "--filed needs --sid SID, the session the job was done in; piped input is never asked"
  fi
  [ -n "$title" ] || title="$slug"
  # The slug comes from the words as typed, before the title was kept
  # as one ASCII line: an escape is no part of a directory name.
  [ -n "$slug" ] || slug="$(short_slug "${raw_title:-$title}")"
  slug="$(slugify "$slug")"; [ -n "$slug" ] || die "the slug has no letters or digits (give one: office open SLUG)"

  tz="$(office_tz "$root")"; day="$(office_date "$tz")"
  name="$day-$slug"
  [ ! -e "$root/desk/$name" ] || die "already on the desk: desk/$name"
  [ ! -e "$root/filing-cabinet/$name" ] || die "already filed: filing-cabinet/$name (office reopen $name)"
  if [ "$filed" = 1 ]; then
    space=filing-cabinet; status=done; verb=done; text="office open --filed, done at $sid"
  elif [ "$candidate" = 1 ]; then
    space=desk; status=candidate; verb=candidate; text="${MOVE_TEXT:-office open --candidate}"
  else
    space=desk; status=queued; verb=queued; text="${MOVE_TEXT:-office open}"
  fi
  folder="$space/$name"
  require_one_writer "$root" "$space"
  number="$(helper next-number "$root")" || die "no folder number could be minted; the line above says why"

  local args=("title=$title" "number=$number" "status=$status" "queued=$day" "class=$class" "size=$size"
              "lane=$lane" "source=$source" "blueprint=$blueprint" "history=$day $verb: $text")
  for v in "${linked[@]}"; do args+=("linked=$v"); done
  for v in "${after[@]}"; do args+=("after=$v"); done
  for v in "${serializes[@]}"; do args+=("serializes_after=$v"); done
  for v in "${consumer[@]}"; do args+=("consumer=$v"); done
  mkdir -p "$root/$folder" || die "cannot create $folder"
  helper render-template "$TEMPLATES/folder.md" "${args[@]}" > "$root/$folder/folder.md" \
    || { rm -rf "${root:?}/$folder"; die "could not write $folder/folder.md"; }
  if [ "$filed" = 1 ]; then
    helper record-session "$root/$folder/folder.md" "$sid" >/dev/null || die "could not record $sid in $folder/folder.md"
  fi
  if [ "$thread" = "1" ]; then
    [ ! -t 0 ] || die "--thread reads the pasted thread on stdin"
    { printf '# Thread that started this job\n\nPasted when the folder was opened, verbatim.\n\n'; helper ascii-escape; } > "$root/$folder/thread.md" \
      || die "could not write $folder/thread.md"
    log "seeded $folder/thread.md from stdin"
  fi
  log "opened $folder as folder $number, $status"
  commit_paths "$root" "office open: $name (folder $number)" "$folder" || true
  printf '%s\n' "$folder"
}

usage_desk() {
  cat <<'USAGE'
usage: office desk [--blueprint ID]
Shows the desk in order, computed from what the folders say: In flight (the
folders a session is open for), Ready (queued folders whose gates are met:
by serializes after, then small first, then number), Parked (under what each
waits for), Candidates, then the riders orphaned in a closed folder and the
desk moves a sitting wrote that office moves has not applied yet. A gate
names a folder, a blueprint (met when its close report exists), an agenda
item (met when a sitting ruled on it) or a ruling (met when it is on the
ledger); one that names nothing is an error line. A gate that cleared
since you last walked in says so. --blueprint ID shows only that arc's
folders, in the same order, then the ones already filed and the
decomposition lines with no folder yet. It only reads.
Examples:
  office desk
  office desk --blueprint 2026-10-05-rider-verbs
  office desk | grep -A3 Parked
USAGE
}

# The desk's groups: In flight, Ready, Parked, Candidates (doctrine
# section 5). A gate that cleared since the last walk-in says so.
cmd_desk() {
  local root tz since rc bp=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --blueprint) [ $# -ge 2 ] || die "--blueprint needs the blueprint's id"; bp="${2#blueprint }"; shift 2 ;;
      -h|--help) usage_desk; return 0 ;;
      *) usage_desk >&2; die "office desk does not know $1" ;;
    esac
  done
  root="$(resolve_office)" || exit 1
  tz="$(office_tz "$root")"
  since="$(last_walk_in "$root")"
  reader desk "$root" --today "$(office_date "$tz")" ${since:+--since "$since"} ${bp:+--blueprint "$bp"}; rc=$?
  case $rc in
    0) return 0 ;;
    3) warn "some of this office's projects could not be read; In flight says which"; return 0 ;;
    *) die "could not render the desk" ;;
  esac
}

# The day of the last walk-in, kept on this machine outside the office
# (the walk-in only reads the office), so the desk can say which gates
# cleared since. Empty when there is none.
walk_in_file() {
  printf '%s/office-src/walk-ins/%s' "${XDG_STATE_HOME:-$HOME/.local/state}" "$(printf '%s' "$1" | sha256sum | cut -c1-16)"
}

last_walk_in() {
  local f
  f="$(walk_in_file "$1")"
  [ -f "$f" ] || { debug "no walk-in recorded for $1 on this machine"; return 0; }
  head -n 1 "$f" | grep -E '^[0-9]{4}-[0-9]{2}-[0-9]{2}$' || debug "unreadable walk-in record: $f"
  return 0
}

record_walk_in() {
  local f
  f="$(walk_in_file "$1")"
  { mkdir -p "$(dirname "$f")" && printf '%s\n' "$2" > "$f"; } 2>/dev/null || debug "could not record this walk-in in $f"
  return 0
}

usage_week() {
  cat <<'USAGE'
usage: office week
Lays this week's plan (calendar/plan.md) against what happened
(calendar/record.md), in the office's timezone: a planned item in the past
with no record that day is a gap. An office without a calendar is told
which renovation adds one. It only reads.
Examples:
  office week
  office tour                                  (a throwaway office with a calendar gap to look at)
USAGE
}

cmd_week() {
  local root tz
  case "${1:-}" in -h|--help) usage_week; return 0 ;; esac
  root="$(resolve_office)" || exit 1
  if ! has_space "$root" calendar; then
    printf 'this office has no calendar. A renovation adds one: an office session that adds the calendar space to the floor plan (doctrine section 5).\n'
    return 0
  fi
  tz="$(office_tz "$root")"
  helper week "$root/calendar" --today "$(office_date "$tz")" --now "$(office_time "$tz")" --tz "$tz" \
    || die "could not read the calendar in $root/calendar"
}

# Moving a folder is not rewriting it: the bytes move, git keeps the
# history, and anything uncommitted in the folder moves with it.
move_folder_dir() {
  local root="$1" from="$2" to="$3" name="$4"
  [ ! -e "$root/$to/$name" ] || die "$to/$name already exists; not overwriting it"
  mkdir -p "$root/$to" || die "cannot create $to"
  mv "$root/$from/$name" "$root/$to/$name" || die "could not move $from/$name to $to/"
  log "moved $from/$name to $to/"
}

# folder_fact FOLDER_MD KEY: status, number, history (1 or 0) or sids.
folder_fact() {
  helper folder-facts "$1" 2>/dev/null | sed -n "s/^$2\t//p"
}

# One History line, and the status line when given, in a folder; each
# says what it did, and a folder from before the field block is left
# as it is and said so at debug.
folder_event() {
  local md="$1" day="$2" verb="$3" text="$4" status="${5:-}" out
  out="$(helper folder-event "$md" --day "$day" --verb "$verb" --text "$text" ${status:+--status "$status"})" \
    || die "could not write the $verb line in $md"
  while IFS= read -r line; do
    case "$line" in
      no\ *) debug "$(basename "$(dirname "$md")"): $line" ;;
      *) log "$(basename "$(dirname "$md")"): $line" ;;
    esac
  done <<< "$out"
}

# The folder a closing job lives on in: an existing folder other than
# the one closing, whose own job has not ended elsewhere (an absorbed,
# split or retired folder carries nothing further).
successor_folder() {
  local root="$1" closing="$2" ref="$3" rel status
  rel="$(helper folder-by-number "$root" "$ref")" || return 1
  [ "${rel#*/}" != "$closing" ] || die "a folder is not absorbed or split into itself"
  status="$(folder_fact "$root/$rel/folder.md" status)"
  case "$status" in
    absorbed|split|retired) die "$(helper normalize-field linked -- "$ref") is $status itself, so the job cannot live on in it; name the folder it went to" ;;
  esac
  printf '%s' "$rel"
}

usage_close() {
  cat <<'USAGE'
usage: office close [FOLDER] [--into N | --split A,B | --retired WHY]
Moves a folder from the desk to the filing cabinet, writing its status and
a History line. Plain close is done. --into N: absorbed into folder N;
--split A,B: split into those folders; --retired WHY: retired, and why.
Each successor gets a note line pointing back. FOLDER is its name, a
unique part of it, or folder N; on a terminal it is asked for when
missing.
Examples:
  office close fix-login
  office close "folder 12" --into 14
  office close fix-login --split 14,15
  office close fix-login --retired "the premise was wrong"
USAGE
}

cmd_close() {
  local want="" into="" split="" retired="" set=0 root name md tz day status verb text number me
  local succ=() rels=() paths=() parts=() s rel i label
  while [ $# -gt 0 ]; do
    case "$1" in
      --into|--split|--retired)
        [ $# -ge 2 ] || die "$1 needs a value (office close --help)"
        set=$((set + 1))
        case "$1" in --into) into="$2" ;; --split) split="$2" ;; --retired) retired="$2" ;; esac
        shift 2 ;;
      -h|--help) usage_close; return 0 ;;
      -*) usage_close >&2; die "office close does not know $1" ;;
      *) [ -z "$want" ] || die "close takes one folder"; want="$1"; shift ;;
    esac
  done
  [ "$set" -le 1 ] || die "--into, --split and --retired are three different endings; give one"
  root="$(resolve_office)" || exit 1
  require_current "$root"
  if [ -z "$want" ]; then
    can_ask || { usage_close >&2; die "name a folder: office close FOLDER; piped input is never asked"; }
    ask_folder want "$root" desk close
  fi
  name="$(find_folder "$root" desk "$want")" || exit 1
  md="$root/desk/$name/folder.md"
  [ -f "$md" ] || die "desk/$name has no folder.md"
  status="$(folder_fact "$md" status)"; number="$(folder_fact "$md" number)"
  case "$status" in done|absorbed|split|retired) die "desk/$name says status $status, which belongs in the filing cabinet; office status names what disagrees" ;; esac
  me="${number:+folder $number}"; me="${me:-$name}"
  [ ! -e "$root/filing-cabinet/$name" ] || die "filing-cabinet/$name already exists; not overwriting it, and nothing was written"
  if [ -n "$into" ]; then
    rel="$(successor_folder "$root" "$name" "$into")" || exit 1
    succ=("$(helper normalize-field linked -- "$into")"); rels=("$rel")
    verb=absorbed; status=absorbed; text="into ${succ[0]}"
  elif [ -n "$split" ]; then
    IFS=',' read -r -a parts <<< "$split"
    [ "${#parts[@]}" -ge 2 ] || die "--split names the two or more folders the job was cut into, as A,B"
    for s in "${parts[@]}"; do
      rel="$(successor_folder "$root" "$name" "$s")" || exit 1
      case " ${rels[*]} " in *" $rel "*) die "--split names $(helper normalize-field linked -- "$s") twice" ;; esac
      succ+=("$(helper normalize-field linked -- "$s")"); rels+=("$rel")
    done
    verb=split; status=split
    text="into folders $(printf '%s\n' "${succ[@]}" | sed 's/^folder //' | paste -sd, - | sed 's/,/, /g')"
  elif [ -n "$retired" ]; then
    [ -n "${retired//[[:space:]]/}" ] || die "--retired needs the reason, in a few words"
    verb=retired; status=retired; text="$(printf '%s' "$retired" | helper ascii-escape)"
  else
    verb=done; status=done; text="${MOVE_TEXT:-office close}"
  fi
  tz="$(office_tz "$root")"; day="$(office_date "$tz")"
  # The status and History lines go in while the folder is on the desk,
  # which is live; the filing cabinet only ever gains lines.
  folder_event "$md" "$day" "$verb" "$text" "$status"
  move_folder_dir "$root" desk filing-cabinet "$name"
  paths=("desk/$name" "filing-cabinet/$name")
  label="$me"; [ -z "$number" ] || label="$me ($name)"
  for i in "${!rels[@]}"; do
    if [ "$verb" = absorbed ]; then
      folder_event "$root/${rels[$i]}/folder.md" "$day" note "absorbed $label"
    else
      folder_event "$root/${rels[$i]}/folder.md" "$day" note "split from $label"
    fi
    paths+=("${rels[$i]}/folder.md")
  done
  if [ "$verb" = done ]; then
    commit_paths "$root" "office close: $name (done)" "${paths[@]}" || true
  else
    commit_paths "$root" "office close: $name ($verb: $text)" "${paths[@]}" || true
  fi
}

usage_reopen() {
  cat <<'USAGE'
usage: office reopen [FOLDER]
Brings a done folder back to the desk, history and all: status open, and a
reopened line. A folder absorbed, split or retired is not reopened; its
History names where the job went. On a terminal FOLDER is asked for.
Examples:
  office reopen fix-login
  office reopen "folder 12"
USAGE
}

cmd_reopen() {
  local want="" root name md status tz day
  case "${1:-}" in -h|--help) usage_reopen; return 0 ;; esac
  want="${1:-}"
  [ $# -le 1 ] || die "reopen takes one folder"
  root="$(resolve_office)" || exit 1
  require_current "$root"
  if [ -z "$want" ]; then
    can_ask || die "name a folder: office reopen FOLDER; piped input is never asked"
    ask_folder want "$root" filing-cabinet reopen
  fi
  name="$(find_folder "$root" filing-cabinet "$want")" || exit 1
  md="$root/filing-cabinet/$name/folder.md"
  status=""
  [ -f "$md" ] && status="$(folder_fact "$md" status)"
  case "$status" in
    absorbed|split|retired)
      die "filing-cabinet/$name was $status; the job lives on elsewhere or not at all, so it is not reopened (its History names where; office open starts a new folder)" ;;
  esac
  move_folder_dir "$root" filing-cabinet desk "$name"
  if [ -f "$root/desk/$name/folder.md" ]; then
    tz="$(office_tz "$root")"; day="$(office_date "$tz")"
    folder_event "$root/desk/$name/folder.md" "$day" reopened "office reopen" open
  fi
  commit_paths "$root" "office reopen: $name" "filing-cabinet/$name" "desk/$name" || true
}

# Record which sessions worked on a folder's job. The id comes from
# bale, never typed: `bale pack --json ... | office sessions FOLDER -`
# reads the pack report. With the first id a candidate or queued folder
# records, the folder is open: status open and an opened line.
record_session() {
  local root="$1" folder="$2" sid="$3" words="$4" day="$5" out rc
  out="$(helper record-session "$root/$folder/folder.md" "$sid" ${words:+--words "$words"} ${day:+--day "$day"})"; rc=$?
  case $rc in
    0) log "recorded $sid in $folder"
       printf '%s\n' "$out" | tail -n +2 | sed "s|^|[office] $(basename "$folder"): |" >&2
       commit_paths "$root" "office sessions: $sid in $(basename "$folder")" "$folder/folder.md" || true ;;
    4) log "$sid is already recorded in $folder" ;;
    *) die "could not record $sid in $folder/folder.md" ;;
  esac
}

usage_sessions() {
  cat <<'USAGE'
usage: office sessions [FOLDER] [SID | -] [-m WORDS] [--ratified [--except TEXT]]
  office sessions FOLDER               list the recorded sessions, with what bale records
  office sessions FOLDER SID|-         record one; - reads a bale pack --json report on stdin.
                                       The first one a candidate or queued folder records opens it.
  office sessions FOLDER SID|- --ratified [--except TEXT]
                                       the planner ratified that session's judgment calls,
                                       except TEXT (what was corrected, and where it went)
office start and office land record sessions and ratifications themselves;
this is for a session packed by hand, and for reading how each one went.
Examples:
  office sessions fix-login
  office sessions fix-login 2026-10-05-fix-login-001 --ratified
  bale pack --json --include desk/2026-10-05-fix-login "Fix it" | office sessions fix-login -
USAGE
}

cmd_sessions() {
  local want="" source="" words="" ratified=0 except="" has_except=0 root space name sid tz day out
  while [ $# -gt 0 ]; do
    case "$1" in
      -m) [ $# -ge 2 ] || die "-m needs a few words"; words="$2"; shift 2 ;;
      --ratified) ratified=1; shift ;;
      --except) [ $# -ge 2 ] || die "--except needs what was corrected, and where it went"; except="$2"; has_except=1; shift 2 ;;
      -h|--help) usage_sessions; return 0 ;;
      -?*) [ "$1" = "-" ] || { usage_sessions >&2; die "office sessions does not know $1"; }
           if [ -z "$want" ]; then die "name the folder before -"; elif [ -z "$source" ]; then source="-"; else die "too many arguments"; fi; shift ;;
      *) if [ -z "$want" ]; then want="$1"; elif [ -z "$source" ]; then source="$1"; else die "too many arguments"; fi; shift ;;
    esac
  done
  [ "$has_except" = 0 ] || [ "$ratified" = 1 ] || die "--except goes with --ratified"
  root="$(resolve_office)" || exit 1
  if [ -z "$want" ]; then
    can_ask || { usage_sessions >&2; die "name a folder: office sessions FOLDER; piped input is never asked"; }
    ask_folder want "$root" desk "record sessions in"
  fi
  space=desk
  if ! name="$( (find_folder "$root" desk "$want") 2>/dev/null)"; then
    space=filing-cabinet; name="$(find_folder "$root" filing-cabinet "$want")" || exit 1
  fi
  [ -f "$root/$space/$name/folder.md" ] || die "$space/$name has no folder.md"
  if [ -z "$source" ] && [ "$ratified" = 1 ]; then
    can_ask || die "--ratified needs the session: office sessions FOLDER SID --ratified; piped input is never asked"
    ask_field source sid "SID" "Session id to ratify" "" 1
  fi
  if [ -z "$source" ]; then
    helper folder-summary "$root/$space/$name/folder.md" "$TEMPLATES/folder.md" >/dev/null || die "could not read $space/$name/folder.md"
    # Each recorded id, then what bale's records say about it: outcome,
    # dates, claims beside verdicts, exchange rounds. Rendered on every
    # run and never written into the folder.
    reader folder-sessions "$root" "$root/$space/$name/folder.md"
    case $? in
      0) return 0 ;;
      3) die "some of this office's projects could not be read; the lines above say why" ;;
      *) die "could not render the sessions of $space/$name" ;;
    esac
  fi
  if [ "$source" = "-" ]; then
    sid="$(helper pack-sid)" || die "no session id recorded in $space/$name"
  else
    sid="$source"
  fi
  tz="$(office_tz "$root")"; day="$(office_date "$tz")"
  if [ "$ratified" = 1 ]; then
    [ -z "$words" ] || die "-m goes with recording a session, not with --ratified"
    if [ "$has_except" = 1 ]; then
      out="$(helper ratify "$root/$space/$name/folder.md" "$sid" --day "$day" --except "$except")" || exit 1
    else
      out="$(helper ratify "$root/$space/$name/folder.md" "$sid" --day "$day")" || exit 1
    fi
    log "$name: $out"
    commit_paths "$root" "office sessions: $sid ratified in $name" "$space/$name/folder.md" || true
    return 0
  fi
  record_session "$root" "$space/$name" "$sid" "$words" "$day"
}

# --- the drafting table -----------------------------------------------------------
#
# Blueprints for work too big for one folder, and the pages a sitting
# rules in (doctrine section 5). The space arrives in an office with the
# first verb that writes it: drafting-table/README.md from the install's
# template, the floor plan's entry and bale.toml's trigger, and each page
# from its template on its first write, committed with the write that
# asked for it. lib/office_drafting.py reads and writes the pages; these
# verbs ask, hold the one-writer rule, check what they append, and commit
# exactly what they touched.

DRAFTING="$OFFICE_SRC/lib/office_drafting.py"
drafting() { python3 -B "$DRAFTING" "$@"; }

# one_writer ROOT VERB TARGET...: a script that mints a number or appends
# to a page refuses while an open session in the office's own registry
# forecasts what it writes, and names the session (the blueprint's
# section 5.4). An office bale has never run in has no registry and
# nothing to refuse; a registry that cannot be read is said loudly.
one_writer() {
  local root="$1" verb="$2" out rc; shift 2
  out="$(reader writers "$root" "$@")"; rc=$?
  case $rc in
    0) debug "one-writer rule: no open session in this office's registry holds $*" ;;
    3) printf '%s\n' "$out" | sed 's/^/[office]   /' >&2
       die "an open session holds what office $verb writes, so it waits (the one-writer rule); run it once that session is applied or closed" ;;
    *) warn "bale's registry in this office could not be read (the line above says why); office $verb runs without the one-writer check" ;;
  esac
}

# What the drafting table's arrival writes, when it has not arrived: the
# floor plan, bale.toml and the space's front page, for the rule above.
arrival_targets() {
  local root="$1"
  if helper get "$root/$MANIFEST_REL" "spaces.drafting-table.path" >/dev/null 2>&1 && [ -f "$root/drafting-table/README.md" ]; then
    return 0
  fi
  printf '%s\n' "$MANIFEST_REL" "$BALE_TOML_REL" "drafting-table/README.md"
}

# check_page ROOT PAGE [--insertion]: a page a verb added to, against its
# committed bytes, before the commit: appended at its end (or, with
# --insertion, one entry put in above its foot), nothing else changed.
check_page() {
  local root="$1" page="$2" why; shift 2
  why="$(helper append-check "$root" "$page" "$@")"
  case $? in
    0) return 0 ;;
    3) die "$page differs from its committed bytes other than by this entry ($why); the entry is on disk but not committed, and nothing else was" ;;
    *) die "could not check $page against its committed bytes; the entry is on disk but not committed" ;;
  esac
}

# run_drafting VAR ARGS...: run a writing subcommand; VAR gets what it
# printed (its citation first, then the paths it changed).
run_drafting() {
  local __var="$1" __out; shift
  __out="$(drafting "$@")" || exit 1
  printf -v "$__var" '%s' "$__out"
}

# A rider, agenda item or blueprint named as N, `rider N` and so on.
bare_number() {  # bare_number KIND WORD
  local w
  w="$(printf '%s' "$2" | sed -E "s/^[[:space:]]*($1[[:space:]]+)?//; s/[[:space:]]+\$//")"
  [[ "$w" =~ ^[0-9]+$ ]] || die "$1 takes a number ($1 N), not $(shq "$2")"
  printf '%s' "$((10#$w))"
}

usage_blueprint() {
  cat <<'USAGE'
usage: office blueprint open SLUG | ratify ID | close ID
A blueprint is work too big for one folder: one arc on the drafting table,
drafting-table/blueprints/DATE-SLUG/blueprint.md, with its charter, its
decomposition into folders, its watch list and its history.
  office blueprint open SLUG     draft one from the template
  office blueprint ratify ID     write the charter's ratified line
  office blueprint close ID      send out the sitting that writes its close report
office blueprint VERB --help explains each, with examples. office desk
--blueprint ID shows the arc's folders in the desk's order.
Examples:
  office blueprint open rider-verbs --title "The rider verbs"
  office blueprint ratify 2026-10-05-rider-verbs --words notepad/2026-10-05-plan.md
  office blueprint close 2026-10-05-rider-verbs
USAGE
}

cmd_blueprint() {
  local sub="${1:-}"
  case "$sub" in
    open) shift; cmd_blueprint_open "$@" ;;
    ratify) shift; cmd_blueprint_ratify "$@" ;;
    close) shift; cmd_blueprint_close "$@" ;;
    ""|-h|--help) usage_blueprint ;;
    *) usage_blueprint >&2; die "office blueprint does not know $sub; it takes open, ratify or close" ;;
  esac
}

usage_blueprint_open() {
  cat <<'USAGE'
usage: office blueprint open [SLUG] [--title TITLE] [--charter TEXT]   (or the charter on stdin)
Drafts a blueprint: drafting-table/blueprints/DATE-SLUG/blueprint.md from
the install's template, with a drafted History line, committed alone. The
blueprint's id is DATE-SLUG, in the office's timezone; it is cited as
blueprint DATE-SLUG. The charter says what the arc is for and what done
means; left out, it is marked not written yet, and ratify refuses it until
it is. The first blueprint brings the drafting table into the office (its
front page, the floor plan's entry and bale.toml's trigger), in the same
commit. On a terminal it asks for the slug, title and charter it was not
given; piped, it never asks. A sitting may equally draft a blueprint
itself; this is for the occupant drafting alone.
Examples:
  office blueprint open                        (asks for the slug, title and charter)
  office blueprint open rider-verbs --title "The rider verbs" --charter "Riders get verbs; done when ..."
  printf '%s\n' "What the arc is for ..." | office blueprint open rider-verbs --title "The rider verbs"
USAGE
}

cmd_blueprint_open() {
  local slug="" title="" charter="" have_charter=0 root tz day out tmp paths=() cite
  while [ $# -gt 0 ]; do
    case "$1" in
      --title|--charter) [ $# -ge 2 ] || die "$1 needs a value (office blueprint open --help)"
        case "$1" in --title) title="$2" ;; --charter) charter="$2"; have_charter=1 ;; esac; shift 2 ;;
      -h|--help) usage_blueprint_open; return 0 ;;
      -*) usage_blueprint_open >&2; die "office blueprint open does not know $1" ;;
      *) [ -z "$slug" ] || die "blueprint open takes one slug (quote a title with --title)"; slug="$1"; shift ;;
    esac
  done
  root="$(resolve_office)" || exit 1
  require_current "$root"
  if [ "$have_charter" = 0 ] && [ ! -t 0 ]; then charter="$(cat)"; fi
  if can_ask; then
    [ -n "$slug" ] || [ -n "$title" ] || ask title "Title, in a few words (--title)" "" 1 \
      "The blueprint's name in words, its first line. The slug, the id after the date, is made from it unless you give one."
    [ -n "$slug" ] || slug="$(short_slug "$title")"
    [ -n "$title" ] || ask title "Title, in a few words (--title)" "$(printf '%s' "$slug" | tr '-' ' ')" 1 \
      "The blueprint's name in words, its first line."
    [ "$have_charter" = 1 ] || ask charter "Charter: what the arc is for and what done means (--charter)" "" 0 \
      "In the asker's words where there are words to keep. It freezes once ratified. A plain return leaves it marked not written yet; ratify refuses it until it is."
  else
    [ -n "$slug" ] || [ -n "$title" ] || die "blueprint open needs a slug or a title: office blueprint open SLUG, or --title TITLE; piped input is never asked"
  fi
  [ -n "$slug" ] || slug="$(short_slug "$title")"
  slug="$(slugify "$slug")"; [ -n "$slug" ] || die "the slug has no letters or digits (give one: office blueprint open SLUG)"
  [ -n "$title" ] || title="$(printf '%s' "$slug" | tr '-' ' ')"
  mapfile -t paths < <(arrival_targets "$root")
  one_writer "$root" "blueprint open" "drafting-table/blueprints" "${paths[@]}"
  tz="$(office_tz "$root")"; day="$(office_date "$tz")"
  tmp="$(mktemp)" || die "cannot make a temp file"; TMP_PATHS+=("$tmp")
  printf '%s' "$charter" > "$tmp"
  run_drafting out blueprint-open "$root" "$slug" --day "$day" --title "$title" --charter-file "$tmp"
  cite="$(printf '%s\n' "$out" | head -n 1)"
  mapfile -t paths < <(printf '%s\n' "$out" | tail -n +2)
  commit_paths "$root" "office blueprint open: ${cite#blueprint }" "${paths[@]}" || true
  printf '%s\n' "$cite"
}

# The blueprints on the drafting table, then the question.
ask_blueprint() {
  local __var="$1" root="$2" verb="$3" list
  list="$(drafting blueprints "$root" 2>/dev/null)"
  [ -n "$list" ] || die "no blueprint on the drafting table to $verb (office blueprint open drafts one)"
  printf 'Blueprints:\n' >&2
  printf '%s\n' "$list" | awk -F'\t' '{printf "  %s  [%s]  %s\n", $1, $2, $3}' >&2
  ask "$__var" "Which blueprint: its id, DATE-SLUG (office blueprint $verb ID)" "" 1 \
    "The blueprint's id is its directory's name under drafting-table/blueprints/, the date and the slug."
}

usage_blueprint_ratify() {
  cat <<'USAGE'
usage: office blueprint ratify [ID] [--words notepad/PAGE | --sid SID]
Writes the charter's ratified line, last in its Charter section, and a
ratified History line, and commits the blueprint alone: that commit is the
one office status checks the charter's bytes against from then on. The
ratification names where its words are: the notepad page that carries
them (--words), or the session they were given in (--sid). It refuses a
blueprint already ratified or closed, and a charter not written yet. A
sitting can write the same two lines itself; this is for a ratification
given outside one (an "as assumed" reply). On a terminal it asks for what
it was not given; piped, it never asks.
Examples:
  office blueprint ratify 2026-10-05-rider-verbs --words notepad/2026-10-05-plan.md
  office blueprint ratify 2026-10-05-rider-verbs --sid 2026-10-05-plan-sitting-001
USAGE
}

cmd_blueprint_ratify() {
  local id="" words="" sid="" root tz day out paths=()
  while [ $# -gt 0 ]; do
    case "$1" in
      --words|--sid) [ $# -ge 2 ] || die "$1 needs a value (office blueprint ratify --help)"
        case "$1" in --words) words="$2" ;; --sid) sid="$2" ;; esac; shift 2 ;;
      -h|--help) usage_blueprint_ratify; return 0 ;;
      -*) usage_blueprint_ratify >&2; die "office blueprint ratify does not know $1" ;;
      *) [ -z "$id" ] || die "blueprint ratify takes one blueprint"; id="${1#blueprint }"; shift ;;
    esac
  done
  [ -z "$words" ] || [ -z "$sid" ] || die "--words and --sid are two places the words can be; give one"
  root="$(resolve_office)" || exit 1
  require_current "$root"
  if [ -z "$id" ]; then
    can_ask || { usage_blueprint_ratify >&2; die "name the blueprint: office blueprint ratify ID; piped input is never asked"; }
    ask_blueprint id "$root" ratify
  fi
  if [ -z "$words" ] && [ -z "$sid" ]; then
    can_ask || die "say where the ratifying words are: --words notepad/PAGE or --sid SID; piped input is never asked"
    ask words "The notepad page that carries the ratifying words, notepad/PAGE.md (--words; --sid SID for a session)" "" 1 \
      "Ratification points at the words that gave it, never copies them: a notepad page (office note writes the day's page), or a session id given as --sid."
    case "$words" in [0-9][0-9][0-9][0-9]-*-[0-9][0-9][0-9]) sid="$words"; words="" ;; esac
  fi
  one_writer "$root" "blueprint ratify" "drafting-table/blueprints/$id/blueprint.md"
  tz="$(office_tz "$root")"; day="$(office_date "$tz")"
  if [ -n "$words" ]; then
    run_drafting out blueprint-ratify "$root" "$id" --day "$day" --words "$words"
  else
    run_drafting out blueprint-ratify "$root" "$id" --day "$day" --sid "$sid"
  fi
  mapfile -t paths < <(printf '%s\n' "$out")
  commit_paths "$root" "office blueprint ratify: $id" "${paths[@]}" || true
}

usage_blueprint_close() {
  cat <<'USAGE'
usage: office blueprint close [ID] [--goal TEXT]
Sends out the sitting that closes a blueprint, the way office start sends
any session out: a folder born for the close (Close blueprint ID, source
blueprint ID), opened unless one is on the desk already; the session
packed in the office, forecasting that folder, the notepad and the
drafting table; the blueprint, its member folders, the rulings, evidence
and watches pages, and the close report's template from the install,
shipped; a brief saying what lands. The sitting writes close.md and its
notepad page, and puts the member folders' endings on the desk moves page
for office moves. You attach the out tray and paste the opener, as for
office start; office land brings it back.
Under the hood: office open, then office start's own code (bale pack --json,
bale pack --context for each context tarball).
Examples:
  office blueprint close 2026-10-05-rider-verbs
  office blueprint close                       (asks which blueprint)
USAGE
}

cmd_blueprint_close() {
  local id="" goal="" root plan tmp folder rel members=() m title close_folder includes=() ledgers=()
  while [ $# -gt 0 ]; do
    case "$1" in
      --goal) [ $# -ge 2 ] || die "--goal needs a sentence"; goal="$2"; shift 2 ;;
      -h|--help) usage_blueprint_close; return 0 ;;
      -*) usage_blueprint_close >&2; die "office blueprint close does not know $1" ;;
      *) [ -z "$id" ] || die "blueprint close takes one blueprint"; id="${1#blueprint }"; shift ;;
    esac
  done
  root="$(resolve_office)" || exit 1
  require_current "$root"
  if [ -z "$id" ]; then
    can_ask || { usage_blueprint_close >&2; die "name the blueprint: office blueprint close ID; piped input is never asked"; }
    ask_blueprint id "$root" close
  fi
  tmp="$(mktemp)" || die "cannot make a temp file"; TMP_PATHS+=("$tmp")
  plan="$(drafting blueprint-close-plan "$root" "$id" --brief "$tmp")" || exit 1
  title="$(printf '%s' "$plan" | python3 -c 'import json,sys; print(json.load(sys.stdin)["title"])')"
  close_folder="$(printf '%s' "$plan" | python3 -c 'import json,sys; print(json.load(sys.stdin)["close_folder"] or "")')"
  mapfile -t members < <(printf '%s' "$plan" | python3 -c 'import json,sys; print("\n".join(json.load(sys.stdin)["members"]))')
  mapfile -t ledgers < <(printf '%s' "$plan" | python3 -c 'import json,sys; print("\n".join(json.load(sys.stdin)["ledgers"]))')
  command -v bale >/dev/null 2>&1 || die "bale is not on PATH; office blueprint close sends the close sitting out with bale pack"
  if [ -n "$close_folder" ]; then
    rel="$close_folder"
    log "the close's folder is already on the desk: $rel"
  else
    rel="$(cmd_open "close-${id#[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]-}" --title "Close blueprint $id" \
      --source "blueprint $id" --blueprint "$id" --size small --class meta < /dev/null)" || exit 1
  fi
  includes=(--include "drafting-table/blueprints/$id")
  for m in "${members[@]}" "${ledgers[@]}"; do
    [ -n "$m" ] && [ "$m" != "$rel" ] && includes+=(--include "$m")
  done
  [ -n "$goal" ] || goal="Close blueprint $id ($title): write its close report and the sitting's notepad page, and put its member folders' endings on the desk moves page"
  START_INSTALL_FILES=("templates/close-report.md")
  cmd_start "${rel#desk/}" --in-office --goal "$goal" --write drafting-table "${includes[@]}" --brief "$tmp"
}

usage_moves() {
  cat <<'USAGE'
usage: office moves [--dry-run]
Applies the desk moves a sitting wrote on drafting-table/moves.md, every
pending line in order, through the same code as office open, office close
and the gate flags: open a folder, queue a candidate, gate a folder,
close, absorb, split or retire one. Each line applied is ticked with the
folder it acted on (- [x] ... -> folder N), an opened folder of a
blueprint has its number written onto the blueprint's decomposition line,
and everything is committed at once. A line that does not read is named
before anything is applied; a line that cannot be applied stops the run
there, named, with the lines before it applied and committed. Walking in
says how many moves are pending and which session wrote them.
--dry-run lists the pending moves and applies nothing.
Examples:
  office moves
  office moves --dry-run
USAGE
}

cmd_moves() {
  local dry=0 root plan tz day lineno verb folder mday bp dline argstr args=() rel number n=0 stopped="" paths=()
  local key i
  while [ $# -gt 0 ]; do
    case "$1" in
      --dry-run) dry=1; shift ;;
      -h|--help) usage_moves; return 0 ;;
      *) usage_moves >&2; die "office moves does not know $1" ;;
    esac
  done
  root="$(resolve_office)" || exit 1
  require_current "$root"
  [ -f "$root/drafting-table/moves.md" ] || { log "no drafting-table/moves.md in this office: no desk moves pending"; return 0; }
  plan="$(drafting moves-plan "$root" --shell)"
  case $? in
    0) ;;
    1) printf '%s\n' "$plan" | sed 's/^/[office]   /' >&2
       die "drafting-table/moves.md has line(s) that do not read (above); nothing was applied" ;;
    *) die "could not read drafting-table/moves.md" ;;
  esac
  if [ -z "$plan" ]; then log "no desk moves pending in drafting-table/moves.md"; return 0; fi
  if [ "$dry" = 1 ]; then
    printf 'Pending desk moves, in the order office moves applies them:\n'
    printf '%s\n' "$plan" | awk -F'\036' '{printf "  line %s: %s %s\n", $1, $4, $8}'
    return 0
  fi
  mapfile -t paths < <(arrival_targets "$root")
  one_writer "$root" moves desk filing-cabinet "drafting-table/moves.md" "drafting-table/blueprints" "${paths[@]}"
  tz="$(office_tz "$root")"; day="$(office_date "$tz")"
  DEFER_COMMITS="$(mktemp)" || die "cannot make a temp file"; TMP_PATHS+=("$DEFER_COMMITS")
  drafting arrive "$root" >> "$DEFER_COMMITS" || { DEFER_COMMITS=""; die "the drafting table could not arrive"; }
  while IFS=$'\x1e' read -r lineno verb folder mday bp dline argstr _ <&3; do
    IFS=$'\x1f' read -r -a args <<< "$argstr"
    MOVE_TEXT="office moves: drafting-table/moves.md line $lineno, decided $mday${bp:+; blueprint $bp, decomposition line $dline}"
    log "line $lineno: $verb${folder:+ folder $folder}"
    case "$verb" in
      open)
        if ! rel="$(cmd_open "${args[@]}" < /dev/null)"; then stopped="$lineno"; break; fi
        number="$(folder_fact "$root/$rel/folder.md" number)" ;;
      queue)
        if ! (move_queue "$root" "$folder" "$day") < /dev/null; then stopped="$lineno"; break; fi
        number="$folder" ;;
      gate)
        if ! (move_gate "$root" "$folder" "$day" "${args[@]}") < /dev/null; then stopped="$lineno"; break; fi
        number="$folder" ;;
      close|absorb|split|retire)
        if ! (cmd_close "${args[@]}") < /dev/null; then stopped="$lineno"; break; fi
        number="$folder" ;;
      *) stopped="$lineno"; warn "line $lineno: no such move: $verb"; break ;;
    esac
    if ! drafting moves-tick "$root" "$lineno" "$number" ${bp:+--blueprint "$bp" --decomposition "$dline"} >> "$DEFER_COMMITS"; then
      stopped="$lineno"; break
    fi
    n=$((n + 1))
  done 3< <(printf '%s\n' "$plan")
  mapfile -t paths < <(sort -u "$DEFER_COMMITS" | grep -v '^$')
  DEFER_COMMITS=""; MOVE_TEXT=""
  if [ "$n" -gt 0 ]; then
    commit_paths "$root" "office moves: $n desk move(s) from drafting-table/moves.md" "${paths[@]}" || true
    log "applied $n desk move(s)"
  elif [ "${#paths[@]}" -gt 0 ]; then
    commit_paths "$root" "office moves: the drafting table arrives" "${paths[@]}" || true
  fi
  if [ -n "$stopped" ]; then
    die "office moves stopped at drafting-table/moves.md line $stopped, which could not be applied (the lines above say why); $n move(s) before it are applied and committed, and nothing after it ran"
  fi
}

# A candidate folder becomes queued: the one move no other verb makes.
move_queue() {
  local root="$1" number="$2" day="$3" rel status
  rel="$(helper folder-by-number "$root" "folder $number")" || exit 1
  [ "${rel%%/*}" = desk ] || die "folder $number is in the filing cabinet; only a candidate on the desk is queued"
  status="$(folder_fact "$root/$rel/folder.md" status)"
  [ "$status" = candidate ] || die "folder $number is ${status:-without a status line}, not a candidate; only a candidate is queued"
  folder_event "$root/$rel/folder.md" "$day" queued "$MOVE_TEXT" queued
  commit_paths "$root" "office moves: folder $number queued" "$rel/folder.md"
}

# move_gate ROOT N DAY KEY VALUE [KEY VALUE]...: gates on a folder on the
# desk, each a field line and a gated History line.
move_gate() {
  local root="$1" number="$2" day="$3" rel out; shift 3
  rel="$(helper folder-by-number "$root" "folder $number")" || exit 1
  [ "${rel%%/*}" = desk ] || die "folder $number is in the filing cabinet; a gate goes on a folder on the desk"
  while [ $# -ge 2 ]; do
    out="$(helper folder-gate "$root/$rel/folder.md" --key "$1" --value "$2" --day "$day")" || exit 1
    log "$(basename "$rel"): $out"
    shift 2
  done
  commit_paths "$root" "office moves: folder $number gated" "$rel/folder.md"
}

usage_rider() {
  cat <<'USAGE'
usage: office rider add TITLE | carry N | consumed N SID
A rider is small work with a named carrier: on the drafting table's riders
page until a folder's next session carries it, then in that folder's
Riders section, never both. Numbers are minted across the page and every
folder, never reused.
  office rider add TITLE --source SRC    a rider on the riders page
  office rider carry N --folder M        moved into folder M; a pointer stays on the page
  office rider consumed N SID            consumed at a session, in the folder that carries it
office riders lists them; office rider VERB --help explains each.
Examples:
  office rider add "Name the sweep commit" --source "proposal 2026-10-04-x-001 #2" --rides bin/bale_apply.py
  office rider carry 3 --folder 12
  office rider consumed 3 2026-10-06-sweep-001
USAGE
}

cmd_rider() {
  local sub="${1:-}"
  case "$sub" in
    add) shift; cmd_rider_add "$@" ;;
    carry) shift; cmd_rider_carry "$@" ;;
    consumed) shift; cmd_rider_consumed "$@" ;;
    ""|-h|--help) usage_rider ;;
    *) usage_rider >&2; die "office rider does not know $sub; it takes add, carry or consumed (office riders lists them)" ;;
  esac
}

usage_rider_add() {
  cat <<'USAGE'
usage: office rider add [TITLE] --source SRC [--rides GLOB | --carrier "folder N"] [--text TEXT]
                        (or the rider's text on stdin)
Adds rider N to the drafting table's riders page, one more than the
highest rider number on the page and in every folder, status queued, with
a dated queued line, and commits the page alone. The rider's text, from
stdin or --text, is kept as given: for a worker's Proposal, its What, Why
and Scope hints byte for byte. A title not given is the text's first line,
without a list marker or emphasis. --rides names the path glob whose next
session carries it (office riders --forecast finds it when a pack touches
it); --carrier names the folder that will. The first rider brings the
drafting table into the office, in the same commit. On a terminal it asks
for the title, source and carrier it was not given; piped, it never asks.
Examples:
  office rider add "Name the sweep commit" --source "proposal 2026-10-04-x-001 #2" --rides bin/bale_apply.py
  office rider add --source "proposal 2026-10-04-x-001 #3" --carrier "folder 12" < proposal-3.txt
  office rider add                             (asks for the title, source and carrier)
USAGE
}

cmd_rider_add() {
  local words=() title="" source="" rides="" carrier="" text="" have_text=0 root tz day out tmp paths=() cite where=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --source|--rides|--carrier|--text|--title) [ $# -ge 2 ] || die "$1 needs a value (office rider add --help)"
        case "$1" in --source) source="$2" ;; --rides) rides="$2" ;; --carrier) carrier="$2" ;;
                     --text) text="$2"; have_text=1 ;; --title) title="$2" ;; esac; shift 2 ;;
      -h|--help) usage_rider_add; return 0 ;;
      -*) usage_rider_add >&2; die "office rider add does not know $1" ;;
      *) words+=("$1"); shift ;;
    esac
  done
  [ "${#words[@]}" -eq 0 ] || title="${words[*]}"
  [ -z "$rides" ] || [ -z "$carrier" ] || die "--rides and --carrier are two carriers; give one"
  root="$(resolve_office)" || exit 1
  require_current "$root"
  if [ "$have_text" = 0 ] && [ ! -t 0 ]; then text="$(cat)"; fi
  if can_ask; then
    [ -n "$title" ] || [ -n "$text" ] || ask title "Title, in a few words (office rider add TITLE)" "" 1 \
      "What the rider is, as the registry would write it. A rider is small work with a named carrier: it rides along with a folder's session rather than having a folder of its own."
    [ -n "$source" ] || ask source "Source: where it came from (--source)" "" 1 \
      "In one form: proposal SID #n (a worker's Proposal), ruling ID, folder N, a notepad page (notepad/...), or a person."
    if [ -z "$rides" ] && [ -z "$carrier" ]; then
      ask where "What carries it: a path glob, or folder N (--rides GLOB, --carrier \"folder N\")" "" 0 \
        "A path glob (bin/bale_apply.py, docs/*.md): the next session whose forecast touches it carries it. folder N: that folder's next session will. A plain return names no carrier yet."
      case "$where" in "") ;; folder\ *|[0-9]*) carrier="$where" ;; *) rides="$where" ;; esac
    fi
    if [ "$have_text" = 0 ] && [ -z "$text" ]; then
      ask text "Its text, in a line (--text; stdin carries a whole Proposal)" "" 0 \
        "Kept as given. For a worker's Proposal, pipe its What, Why and Scope hints on stdin instead, so they are kept byte for byte."
    fi
  else
    [ -n "$title" ] || [ -n "${text//[[:space:]]/}" ] || die "rider add needs a title (office rider add TITLE) or its text on stdin; piped input is never asked"
    [ -n "$source" ] || die "rider add needs --source SRC, where it came from; piped input is never asked"
  fi
  mapfile -t paths < <(arrival_targets "$root")
  one_writer "$root" "rider add" "drafting-table/riders.md" "${paths[@]}"
  tz="$(office_tz "$root")"; day="$(office_date "$tz")"
  tmp="$(mktemp)" || die "cannot make a temp file"; TMP_PATHS+=("$tmp")
  printf '%s' "$text" > "$tmp"
  run_drafting out rider-add "$root" --day "$day" --title "$title" --source "$source" \
    ${rides:+--rides "$rides"} ${carrier:+--carrier "$carrier"} --text-file "$tmp"
  cite="$(printf '%s\n' "$out" | head -n 1)"
  mapfile -t paths < <(printf '%s\n' "$out" | tail -n +2)
  check_page "$root" "drafting-table/riders.md"
  commit_paths "$root" "office rider add: $cite" "${paths[@]}" || true
  printf '%s\n' "$cite"
}

usage_rider_carry() {
  cat <<'USAGE'
usage: office rider carry [N] [--folder M]
Moves rider N from the riders page into folder M's Riders section, the
folder whose next session carries it: its text moves whole, its status
becomes carried with a dated line, the folder's History says carried, and
one pointer line stays on the page (- rider N -> folder M). A pointer is
not a copy. M is a folder on the desk. Commits the page and the folder.
On a terminal it asks for what it was not given; piped, it never asks.
Examples:
  office rider carry 3 --folder 12
  office rider carry "rider 3" --folder "folder 12"
USAGE
}

cmd_rider_carry() {
  local n="" want="" root name number tz day out paths=()
  while [ $# -gt 0 ]; do
    case "$1" in
      --folder) [ $# -ge 2 ] || die "--folder needs the folder that carries it"; want="$2"; shift 2 ;;
      -h|--help) usage_rider_carry; return 0 ;;
      -*) usage_rider_carry >&2; die "office rider carry does not know $1" ;;
      *) [ -z "$n" ] || die "rider carry takes one rider"; n="$1"; shift ;;
    esac
  done
  root="$(resolve_office)" || exit 1
  require_current "$root"
  if [ -z "$n" ]; then
    can_ask || { usage_rider_carry >&2; die "name the rider: office rider carry N --folder M; piped input is never asked"; }
    drafting riders "$root" >&2
    ask n "Which rider: its number (office rider carry N)" "" 1 "The rider's number, as office riders lists it."
  fi
  n="$(bare_number rider "$n")"
  if [ -z "$want" ]; then
    can_ask || die "name the folder that carries it: --folder M; piped input is never asked"
    ask_folder want "$root" desk "carry rider $n in"
  fi
  name="$(find_folder "$root" desk "$want")" || exit 1
  number="$(folder_fact "$root/desk/$name/folder.md" number)"
  [ -n "$number" ] || die "desk/$name has no number, so it cannot be cited as a rider's carrier; a folder from before numbers carries no rider"
  one_writer "$root" "rider carry" "drafting-table/riders.md" "desk/$name/folder.md"
  tz="$(office_tz "$root")"; day="$(office_date "$tz")"
  run_drafting out rider-carry "$root" "$n" --folder "folder $number" --day "$day"
  mapfile -t paths < <(printf '%s\n' "$out")
  commit_paths "$root" "office rider carry: rider $n -> folder $number" "${paths[@]}" || true
}

usage_rider_consumed() {
  cat <<'USAGE'
usage: office rider consumed [N] [SID]
Records that rider N was consumed at session SID, in the folder that
carries it: a dated consumed line under the rider and a consumed History
line. On the desk the rider's status line follows; in the filing cabinet
only lines are added, as for any filed folder. A rider still on the
riders page is carried first (office rider carry). A rider in a closed
folder that was never consumed is an orphan, and the desk says so.
Examples:
  office rider consumed 3 2026-10-06-sweep-001
USAGE
}

cmd_rider_consumed() {
  local n="" sid="" root rel tz day out paths=()
  while [ $# -gt 0 ]; do
    case "$1" in
      -h|--help) usage_rider_consumed; return 0 ;;
      -*) usage_rider_consumed >&2; die "office rider consumed does not know $1" ;;
      *) if [ -z "$n" ]; then n="$1"; elif [ -z "$sid" ]; then sid="$1"; else die "rider consumed takes a rider and a session id"; fi; shift ;;
    esac
  done
  root="$(resolve_office)" || exit 1
  require_current "$root"
  if [ -z "$n" ] || [ -z "$sid" ]; then
    can_ask || { usage_rider_consumed >&2; die "give the rider and the session: office rider consumed N SID; piped input is never asked"; }
    [ -n "$n" ] || ask n "Which rider: its number (office rider consumed N SID)" "" 1 "The rider's number, as office riders lists it."
    [ -n "$sid" ] || ask_field sid sid "SID" "Session id it was consumed at" "" 1
  fi
  n="$(bare_number rider "$n")"
  rel="$(drafting rider-home "$root" "$n")" || exit 1
  one_writer "$root" "rider consumed" "$rel/folder.md"
  tz="$(office_tz "$root")"; day="$(office_date "$tz")"
  run_drafting out rider-consumed "$root" "$n" "$sid" --day "$day"
  mapfile -t paths < <(printf '%s\n' "$out")
  commit_paths "$root" "office rider consumed: rider $n at $sid" "${paths[@]}" || true
}

usage_riders() {
  cat <<'USAGE'
usage: office riders [--forecast PATH...] [--orphans]
Lists the riders: on the drafting table's riders page (with the pointer
each carried one left), and in folders, each with its status and carrier.
--forecast PATH... lists the queued riders on the page whose path glob a
pack with that forecast touches, so the pack can carry them; a sitting
runs it when it writes a pack line. --orphans lists only the riders in a
closed folder that were never consumed. It only reads.
Examples:
  office riders
  office riders --forecast bin/ lib/office_bale.py
  office riders --orphans
USAGE
}

cmd_riders() {
  local args=() root
  while [ $# -gt 0 ]; do
    case "$1" in
      --forecast) shift; [ $# -gt 0 ] && [ "${1#-}" = "$1" ] || die "--forecast needs one or more paths"
        args+=(--forecast); while [ $# -gt 0 ] && [ "${1#-}" = "$1" ]; do args+=("$1"); shift; done ;;
      --orphans) args+=(--orphans); shift ;;
      -h|--help) usage_riders; return 0 ;;
      *) usage_riders >&2; die "office riders does not know $1" ;;
    esac
  done
  root="$(resolve_office)" || exit 1
  drafting riders "$root" "${args[@]}" || exit 1
}

usage_agenda() {
  cat <<'USAGE'
usage: office agenda add [TEXT...] --source SRC [--title TITLE] [--waiting "folder N"]...
                         (or the text on stdin)
Puts a question on the drafting table's agenda for a sitting to rule on,
so it can wait without a session: agenda N, one more than any agenda
number the page has held (disposed ones included), above the page's
Disposed list, with its source and the folders waiting on it. A folder
that must wait for the ruling gates on it: office open --after "agenda N".
Commits the page alone. The first item brings the drafting table into the
office, in the same commit. On a terminal it asks for the text and source
it was not given; piped, it never asks.
Examples:
  office agenda add "Where does a chat land?" --source notepad/2026-10-05.md
  office agenda add --source "folder 12" --waiting "folder 12" < question.txt
USAGE
}

cmd_agenda() {
  local sub="${1:-}" words=() text="" source="" title="" waiting=() have_text=0 root tz day out tmp paths=() cite
  case "$sub" in
    add) shift ;;
    ""|-h|--help) usage_agenda; return 0 ;;
    *) usage_agenda >&2; die "office agenda does not know $sub; it takes add (a sitting rules on the agenda; office desk shows what waits on it)" ;;
  esac
  while [ $# -gt 0 ]; do
    case "$1" in
      --source|--title|--waiting) [ $# -ge 2 ] || die "$1 needs a value (office agenda add --help)"
        case "$1" in --source) source="$2" ;; --title) title="$2" ;; --waiting) waiting+=(--waiting "$2") ;; esac; shift 2 ;;
      -h|--help) usage_agenda; return 0 ;;
      -*) usage_agenda >&2; die "office agenda add does not know $1" ;;
      *) words+=("$1"); shift ;;
    esac
  done
  root="$(resolve_office)" || exit 1
  require_current "$root"
  if [ "${#words[@]}" -gt 0 ]; then text="${words[*]}"; have_text=1
  elif [ ! -t 0 ]; then text="$(cat)"; have_text=1; fi
  if can_ask; then
    [ -n "${text//[[:space:]]/}" ] || ask text "The question, in a line or two (office agenda add TEXT)" "" 1 \
      "A decision a sitting will rule on, not work: the question, and what turns on it."
    [ -n "$source" ] || ask source "Source: where it came from (--source)" "" 1 \
      "In one form: a notepad page (notepad/...), folder N, a session id, ruling ID, or a person."
  else
    [ -n "${text//[[:space:]]/}" ] || die "agenda add needs the question: office agenda add TEXT, or on stdin; piped input is never asked"
    [ -n "$source" ] || die "agenda add needs --source SRC, where it came from; piped input is never asked"
  fi
  mapfile -t paths < <(arrival_targets "$root")
  one_writer "$root" "agenda add" "drafting-table/agenda.md" "${paths[@]}"
  tz="$(office_tz "$root")"; day="$(office_date "$tz")"
  tmp="$(mktemp)" || die "cannot make a temp file"; TMP_PATHS+=("$tmp")
  printf '%s' "$text" > "$tmp"
  run_drafting out agenda-add "$root" --day "$day" --text-file "$tmp" --source "$source" ${title:+--title "$title"} "${waiting[@]}"
  cite="$(printf '%s\n' "$out" | head -n 1)"
  mapfile -t paths < <(printf '%s\n' "$out" | tail -n +2)
  check_page "$root" "drafting-table/agenda.md" --insertion
  commit_paths "$root" "office agenda add: $cite" "${paths[@]}" || true
  printf '%s\n' "$cite"
}

usage_rulings() {
  cat <<'USAGE'
usage: office rulings [ID] [--check]
Lists the rulings ledger (drafting-table/rulings.md): each ruling by id
with its bold lead, how often it was amended, who supersedes it and where
it was derived. Given an ID, renders that ruling with its fields, its text,
its amendments in date order, its supersessions (forward, and back-pointers
derived from later records, never written) and the folders and sessions
it landed at. --check resolves every citation on the drafting table and
the desk against the citation grammar (folder N, blueprint ID, ruling ID,
evidence N, watch WN, rider N, agenda N, notepad pages, session ids) and
names each that does not resolve; it exits 1 when one does not. Only a
sitting writes a ruling; this only reads.
Examples:
  office rulings
  office rulings 2026-10-05-riders-home
  office rulings --check
USAGE
}

cmd_rulings() {
  local id="" check=0 root
  while [ $# -gt 0 ]; do
    case "$1" in
      --check) check=1; shift ;;
      -h|--help) usage_rulings; return 0 ;;
      -*) usage_rulings >&2; die "office rulings does not know $1" ;;
      *) [ -z "$id" ] || die "rulings takes one ruling id"; id="${1#ruling }"; shift ;;
    esac
  done
  [ "$check" = 0 ] || [ -z "$id" ] || die "--check reads every citation; it takes no ruling id"
  root="$(resolve_office)" || exit 1
  if [ "$check" = 1 ]; then
    drafting rulings "$root" --check
    case $? in 0) return 0 ;; 3) die "some citations do not resolve (above)" ;; *) die "could not check the citations" ;; esac
  fi
  drafting rulings "$root" ${id:+"$id"} || exit 1
}

usage_evidence() {
  cat <<'USAGE'
usage: office evidence [N]
Lists the evidence ledger (drafting-table/evidence.md): each entry by
number with its title, when and by whom it was filed, and its occurrence
count by attribution (planner, worker, operator, courier); then any record
the ledger should not hold (an entry naming no session and no notepad
page, a number used twice, an occurrence of no entry). Given N, renders
evidence N with its fields, its text, and every occurrence and derivation
pointing at it. Only a sitting writes evidence; this only reads.
Examples:
  office evidence
  office evidence 13
USAGE
}

cmd_evidence() {
  local n="" root
  while [ $# -gt 0 ]; do
    case "$1" in
      -h|--help) usage_evidence; return 0 ;;
      -*) usage_evidence >&2; die "office evidence does not know $1" ;;
      *) [ -z "$n" ] || die "evidence takes one entry number"; n="$(bare_number evidence "$1")"; shift ;;
    esac
  done
  root="$(resolve_office)" || exit 1
  drafting evidence "$root" ${n:+"$n"}
  case $? in 0|3) return 0 ;; *) exit 1 ;; esac
}

# --- the watches and the digest -----------------------------------------------
#
# A watch is a named re-trigger a sitting writes on the drafting table's
# watches register; its events are records on the watch log, filed
# paper. lib/office_watches.py reads them, evaluates each query watch
# through the install's share/watch-queries.toml and the reader, and
# appends the fired records; lib/office_digest.py writes the sitting-open
# page. These verbs hold the one-writer rule, check what they append, and
# commit exactly what they touched.

WATCHES="$OFFICE_SRC/lib/office_watches.py"
DIGEST="$OFFICE_SRC/lib/office_digest.py"
watches_py() { python3 -B "$WATCHES" "$@"; }
digest_py() { python3 -B "$DIGEST" "$@"; }

usage_watches() {
  cat <<'USAGE'
usage: office watches [--all]
       office watches check [--record]
Lists the watches on the drafting table's register (drafting-table/
watches.md): each open watch with what it evaluates (a query from the
install's share/watch-queries.toml, or eye), its threshold, scope and
source, and its last record on the watch log. --all lists the closed ones
too. A watch's state is read from the log, never from the entry. Only a
sitting writes a watch, re-arms, rewords or closes one; this only reads.
An office with no register says so and exits 0. office watches check
evaluates them (office help watches check).
Examples:
  office watches
  office watches --all
  office watches check
USAGE
}

usage_watches_check() {
  cat <<'USAGE'
usage: office watches check [--record]
Runs every open query watch over the window since its last fired record
(from the day after it; a watch never fired, from the day it was opened),
once for this office's own bale registry and once for each project it
scopes, and prints one line per watch and place: fired, not fired, or
cannot evaluate (a query bale cannot answer says "cannot evaluate: bale
does not stamp ... (slip)", never not fired). Every eye watch prints as
needs an eye, with the sittings since its last record; then the standing
lines, the catalog's observations over bale's whole corpus, as observed.
It reads bale's stats --json surfaces through the reader and nothing
else, and writes nothing. --record appends a fired record to the watch
log (drafting-table/watch-log.md) for each watch that fired, after the
one-writer rule and the filed-page check, and commits the log alone; the
log is made from its template on its first write. Re-arming, rewording,
closing and a not-fired record are a sitting's. Exits 0, or 3 when a
place could not be read or a record does not read (the lines say which).
Examples:
  office watches check
  office watches check --record
USAGE
}

cmd_watches() {
  local all=0 root
  if [ "${1:-}" = check ]; then shift; cmd_watches_check "$@"; return; fi
  while [ $# -gt 0 ]; do
    case "$1" in
      --all) all=1; shift ;;
      -h|--help) usage_watches; return 0 ;;
      *) usage_watches >&2; die "office watches does not know $1; it takes --all, or check" ;;
    esac
  done
  root="$(resolve_office)" || exit 1
  watches_py list "$root" $([ "$all" = 1 ] && printf -- --all)
  case $? in 0) return 0 ;; 3) warn "some records do not read (the lines above say which)"; return 3 ;; *) exit 1 ;; esac
}

cmd_watches_check() {
  local record=0 root tz day changed rc paths=() targets=()
  while [ $# -gt 0 ]; do
    case "$1" in
      --record) record=1; shift ;;
      -h|--help) usage_watches_check; return 0 ;;
      *) usage_watches_check >&2; die "office watches check does not know $1; it takes --record" ;;
    esac
  done
  root="$(resolve_office)" || exit 1
  tz="$(office_tz "$root")"; day="$(office_date "$tz")"
  if [ "$record" = 0 ]; then
    watches_py check "$root" --day "$day" --tz "$tz"
    rc=$?
    case $rc in 0|3) return "$rc" ;; *) exit 1 ;; esac
  fi
  require_current "$root"
  mapfile -t targets < <(arrival_targets "$root")
  one_writer "$root" "watches check --record" "drafting-table/watch-log.md" "${targets[@]}"
  changed="$(mktemp)" || die "cannot make a temp file"; TMP_PATHS+=("$changed")
  watches_py check "$root" --day "$day" --tz "$tz" --record --changed "$changed"
  rc=$?
  case $rc in 0|3) ;; *) exit 1 ;; esac
  mapfile -t paths < "$changed"
  if [ "${#paths[@]}" -gt 0 ]; then
    check_page "$root" "drafting-table/watch-log.md"
    commit_paths "$root" "office watches check --record: fired records on the watch log" "${paths[@]}" || true
  fi
  return "$rc"
}

usage_digest() {
  cat <<'USAGE'
usage: office digest
Writes the sitting-open page, drafting-table/digest.md, prints it, and
commits it alone. Every section is computed when it runs, never kept:
versions per project (each project's latest release and the bale docs
its latest sessions were packed under); since the last sitting (the
sessions applied, held, bailed and still open, read from bale's records,
the folders opened and closed and what was added to the drafting table,
read from git, since the latest sitting's notepad page was filed, and the
page says how it found that); the watches (office watches check's own
lines, never recorded); the standing lines; the desk (in flight, the first
five ready, parked by gate); the agenda (open items, oldest first); and the
open blueprints with their member folders. The page is overwritten on every
run and never edited by hand, like the survey; the first run brings the
drafting table into the office. office start runs it before it packs a
read-only office session (a sitting), and the drafting table rides with
the sitting. Exits 0, or 3 when a project could not be read (the page says
which).
Examples:
  office digest
  office digest | less
USAGE
}

cmd_digest() {
  local before_pack=0 root tz changed rc paths=() targets=()
  while [ $# -gt 0 ]; do
    case "$1" in
      --before-pack) before_pack=1; shift ;;
      -h|--help) usage_digest; return 0 ;;
      *) usage_digest >&2; die "office digest does not know $1; it takes no arguments" ;;
    esac
  done
  root="$(resolve_office)" || exit 1
  if [ "$before_pack" = 1 ]; then refresh_digest "$root"; return 0; fi
  require_current "$root"
  tz="$(office_tz "$root")"
  mapfile -t targets < <(arrival_targets "$root")
  one_writer "$root" "digest" "drafting-table/digest.md" "${targets[@]}"
  changed="$(mktemp)" || die "cannot make a temp file"; TMP_PATHS+=("$changed")
  digest_py "$root" --tz "$tz" --changed "$changed" --print
  rc=$?
  case $rc in 0|3) ;; *) die "the digest could not be written (the line above says why)" ;; esac
  mapfile -t paths < "$changed"
  [ "${#paths[@]}" -eq 0 ] || commit_paths "$root" "office digest: the sitting-open page" "${paths[@]}" || true
  return "$rc"
}

# Before office start packs a sitting (a read-only office session; office
# digest --before-pack, which the start in lib/office_bale.py runs once its
# checks and the survey have passed): the digest written again and
# committed alone, so the sitting opens on a page computed just before it
# was packed. Never fails a start: an open session holding the drafting
# table (the one-writer rule), or a digest that cannot be written, leaves
# the page as it was and says so.
refresh_digest() {
  local root="$1" held rc tz changed paths=() targets=()
  mapfile -t targets < <(arrival_targets "$root")
  held="$(reader writers "$root" "drafting-table/digest.md" "${targets[@]}" 2>/dev/null)"; rc=$?
  case $rc in
    0) ;;
    3) warn "an open session holds the drafting table (the one-writer rule), so office start leaves the digest as it is"
       printf '%s\n' "$held" | sed 's/^/[office]   /' >&2
       return 0 ;;
    *) warn "bale's registry in this office could not be read, so office start leaves the digest as it is"
       return 0 ;;
  esac
  tz="$(office_tz "$root")"
  changed="$(mktemp)" || { warn "cannot make a temp file, so the digest was not written"; return 0; }
  TMP_PATHS+=("$changed")
  digest_py "$root" --tz "$tz" --changed "$changed" >/dev/null
  rc=$?
  case $rc in
    0) ;;
    3) warn "the digest was written, but a project could not be read; the page says which" ;;
    *) warn "the digest could not be written, so the sitting reads the page as it was (office digest says why)"
       return 0 ;;
  esac
  mapfile -t paths < "$changed"
  if [ "${#paths[@]}" -gt 0 ]; then
    commit_paths "$root" "office start: digest" "${paths[@]}" \
      || warn "the digest was written but not committed; drafting-table/digest.md is changed on disk"
  fi
  log "wrote the digest for the sitting (drafting-table/digest.md); it rides with the drafting table"
}

# --- sending a session out ----------------------------------------------------
#
# office start: one command from a folder to an out tray. It asks which
# job, whether the work lands in the office or on a project, and the
# goal, and derives the rest: the slug from the folder, the forecast from
# its lane, the work class from its class. Then the read side packs the
# context that rides and the session itself, records the session id in
# the folder, and gathers every file to attach into one directory.

MACHINE_FILE="$CONFIG_DIR/machine.toml"
# Install files a session needs beside its request (a template it writes
# from), set by the verb that sends it out through cmd_start (office
# blueprint close): they ride as one context tarball made from a scratch
# copy, so the install is never written.
START_INSTALL_FILES=()

# A per-machine setting, outside every office: KEY from machine.toml, or
# the default given. An empty value in the file turns a desktop step off.
machine_setting() {
  if [ -f "$MACHINE_FILE" ]; then
    helper get "$MACHINE_FILE" "$1" --default "$2" 2>/dev/null && return 0
    warn "$MACHINE_FILE could not be read; using the default for $1"
  fi
  printf '%s\n' "$2"
}

on_wsl() { grep -qi microsoft /proc/version 2>/dev/null; }

usage_start() {
  cat <<'USAGE'
usage: office start [FOLDER] [--in-office | --on PROJECT] [--goal TEXT] [--slug SLUG]
                    [--write PATH]... [--include PATH]... [--brief FILE] [--read-only]
                    [--leave-out PATH]... [--no-rides]
       office start [FOLDER] [--in-office | --on PROJECT] --bundle FILE [--leave-out PATH]... [--no-rides]
Packs a session for a folder on the desk and gathers everything to attach
into one out tray: the request, the doctrine, and whatever rides with the
work (on a project, the office's context and the project's ride-alongs;
in the office, the project its lane names, when it names one). Records
the session id in the folder and prints the opener to paste. A page of a
sitting's words that the brief carries (between NOTEPAD PAGE markers) is
filed in the notepad. Before it packs, it surveys the machine again, so
the survey every session reads first is current; the doctrine rides once
(a project whose own tree carries the same doctrine/ ships it there; one
whose doctrine differs gets the install's beside it, named as the
install's).
  FOLDER         the job: its name, a unique part of it, or folder N;
                 on a terminal it is asked for, and new opens one through
                 office open's own questions
  --in-office    the work lands in the office (packed from the office,
                 forecasting the folder and the notepad)
  --on PROJECT   the work lands in one of the office's projects (packed
                 from the project, with the office's context beside it)
  --goal TEXT    the session's goal, one sentence
  --slug SLUG    default: the folder's name without its date, and
                 -office after it for a session in the office
  --write PATH   what the session will change, relative to where it is
                 packed; for a project, default: the paths in the folder's
                 lane, else the whole repo
  --include PATH more to ship as context (a project ships its whole repo
                 by default)
  --brief FILE   a brief to ship as the request's README.md
  --read-only    forecast nothing: a sitting that lands nothing itself
                 (office land SID ends it when the sitting is over)
  --leave-out PATH
                 a path that rides with the project (office projects
                 lists them) stays home for this session; repeatable. On
                 a terminal, start shows what rides and asks; piped,
                 everything declared rides
  --no-rides     every ride-along stays home for this session
  --bundle FILE  a planner's bundle (FILE.bale-bundle, a path or the bare
                 name bale's search finds; given as a word, it needs no
                 flag): bale open replays the bundle's own pack line, so
                 the goal, the forecast and the brief are the bundle's,
                 and the office adds nothing to it. Where defaults to the
                 one place whose tree holds every path the bundle names,
                 and a bundle whose paths no one place holds is refused
                 before bale runs
When the response comes back, office land brings it in.
Under the hood: bale pack --json (or bale open for a bundle) where the work
lands, and bale pack --context for each context tarball; OFFICE_DEBUG=1
shows each call.
Examples:
  office start                                 (asks which job, where, and the goal)
  office start fix-login --on office-src --goal "Fix the login redirect"
  office start plan-wave --in-office --read-only --goal "Plan the next wave"
  office start fix-login --on office-src 2026-10-05-fix-login.bale-bundle
  office start fix-login --on office-src --goal "Fix it" --leave-out ~/nisaba-src/blueprints
The out tray is ~/out-tray/SID unless this machine's
~/.config/office-src/machine.toml sets out_tray. On WSL the tray opens in
Explorer and the opener goes to the clipboard; clipboard_command and
open_command in the same file change that, and "" turns either off.
USAGE
}

# The folder a start is for: asked on a terminal, with new as a choice.
ask_start_folder() {
  local __var="$1" root="$2" d number n=0
  printf 'Folders on the desk:\n' >&2
  for d in "$root/desk"/*/; do
    [ -d "$d" ] || continue
    n=$((n + 1)); number=""
    [ -f "$d/folder.md" ] && number="$(folder_fact "$d/folder.md" number)"
    printf '  %s%s\n' "${number:+folder $number  }" "$(basename "$d")" >&2
  done
  [ "$n" -gt 0 ] || printf '  (none yet)\n' >&2
  ask "$__var" "Which job: a unique part of its name, folder N, or new to open one (office start FOLDER)" \
    "$([ "$n" -eq 0 ] && printf new)" 1 \
    "The folder the session works on. new opens one first, with office open's questions (title, size, lane, source)."
}

# ask_rides VAR PROJECT RIDE...: on a terminal, what rides with the
# project, each with its size, and which stay home this once. VAR gets
# the ones left out (the flag twin is --leave-out, repeatable, or
# --no-rides). The default is that everything rides, as declared.
ask_rides() {
  local __var="$1" project="$2" ans n i size picked=() w; shift 2
  local rides=("$@")
  printf 'What rides with %s (declared; office projects set %s changes it for good):\n' "$project" "$project" >&2
  i=0
  for w in "${rides[@]}"; do
    i=$((i + 1))
    size="$w"
    case "$size" in "~") size="$HOME" ;; "~/"*) size="$HOME/${size#\~/}" ;; esac
    size="$(timeout 3 du -sh "$size" 2>/dev/null | cut -f1)"
    printf '  %s. %s%s\n' "$i" "$w" "${size:+  ($size)}" >&2
  done
  while :; do
    ask ans "Which ride with this session: all, none, or the numbers to leave out (--leave-out PATH, --no-rides)" \
      "all" 1 \
      "Each declared ride-along is packed as context beside the request. Leave one out when this session does not need it: it stays home this once, and the declaration is unchanged. all rides everything; none leaves everything out; 1 3 leaves out the first and the third."
    case "$ans" in
      all|All|ALL) eval "$__var=()"; return 0 ;;
      none|None|NONE) eval "$__var=(\"\${rides[@]}\")"; return 0 ;;
    esac
    picked=(); n=0
    for w in ${ans//,/ }; do
      if [[ "$w" =~ ^[0-9]+$ ]] && [ "$w" -ge 1 ] && [ "$w" -le "${#rides[@]}" ]; then
        picked+=("${rides[$((w - 1))]}"); n=$((n + 1))
      else
        n=-1; break
      fi
    done
    if [ "$n" -gt 0 ]; then eval "$__var=(\"\${picked[@]}\")"; return 0; fi
    printf '  all, none, or numbers from the list above\n' >&2
  done
}

cmd_start() {
  local want="" where="" project="" goal="" slug="" brief="" read_only=0 includes=() writes=() set_w=0 bundle=""
  local leave_out=() no_rides=0
  local root name md status lane lane_project lane_paths names cls ans tz day out sid tray tray_root rel about="" args=() v
  local packed_flags=()
  while [ $# -gt 0 ]; do
    case "$1" in
      --in-office) [ -z "$where" ] || [ "$where" = office ] || die "--in-office and --on are two places; give one"; where=office; shift ;;
      --on) [ $# -ge 2 ] || die "--on needs the project's name"; [ "$where" != office ] || die "--in-office and --on are two places; give one"
            where=project; project="$2"; shift 2 ;;
      --goal|--slug|--brief|--write|--include)
        [ $# -ge 2 ] || die "$1 needs a value (office start --help explains it)"
        case "$1" in --goal) goal="$2" ;; --slug) slug="$2" ;; --brief) brief="$2" ;;
                     --write) writes+=("$2"); set_w=1 ;; --include) includes+=("$2") ;; esac
        packed_flags+=("$1"); shift 2 ;;
      --bundle) [ $# -ge 2 ] || die "--bundle needs the bundle: a path, or the name bale's search finds"
                [ -z "$bundle" ] || die "office start takes one bundle"; bundle="$2"; shift 2 ;;
      --read-only) read_only=1; packed_flags+=("$1"); shift ;;
      --leave-out) [ $# -ge 2 ] || die "--leave-out needs a path that rides with the project (office projects lists them)"
                   leave_out+=("$2"); shift 2 ;;
      --no-rides) no_rides=1; shift ;;
      -h|--help) usage_start; return 0 ;;
      -*) usage_start >&2; die "office start does not know $1; the flags above are what it takes" ;;
      *.bale-bundle) [ -z "$bundle" ] || die "office start takes one bundle"; bundle="$1"; shift ;;
      *) [ -z "$want" ] || die "office start takes one folder"; want="$1"; shift ;;
    esac
  done
  [ "$read_only" = 0 ] || [ "$set_w" = 0 ] || die "--read-only forecasts nothing, so it takes no --write"
  [ "$no_rides" = 0 ] || [ "${#leave_out[@]}" -eq 0 ] || die "--no-rides leaves every ride-along out, so it takes no --leave-out"
  if [ -n "$bundle" ]; then
    [ "${#packed_flags[@]}" -eq 0 ] || die "a bundle carries its own pack line (goal, forecast, brief), so it takes no ${packed_flags[*]}; give the folder and where the work lands, nothing else"
    # A file here is handed to bale by its full path; a bare name is
    # bale's to find, cwd first, then its search directories.
    if [ -f "$bundle" ]; then bundle="$(readlink -f "$bundle")"
    elif [[ "$bundle" == */* ]]; then die "--bundle $bundle: no such file"
    fi
  fi
  root="$(resolve_office)" || exit 1
  require_current "$root"
  warn_if_unfounded "$root"
  command -v bale >/dev/null 2>&1 || die "bale is not on PATH; office start runs bale pack"

  # Which job.
  if [ -z "$want" ]; then
    can_ask || { usage_start >&2; die "name the folder: office start FOLDER (office open makes one first); piped input is never asked"; }
    ask_start_folder want "$root"
  fi
  if [ "$want" = new ]; then
    can_ask || die "new opens a folder through office open's questions, which need a terminal; run office open first"
    rel="$(cmd_open)" || exit 1
    want="${rel#desk/}"
  fi
  name="$(find_folder "$root" desk "$want")" || exit 1
  md="$root/desk/$name/folder.md"
  [ -f "$md" ] || die "desk/$name has no folder.md"
  status="$(folder_fact "$md" status)"
  case "$status" in done|absorbed|split|retired) die "desk/$name says status $status, which belongs in the filing cabinet; office status names what disagrees" ;; esac

  # What the folder already says: its lane (project: paths) and class.
  lane="$(folder_fact "$md" lane)"; cls="$(folder_fact "$md" class)"
  lane_project=""; lane_paths=""
  case "$lane" in *:*) lane_project="$(printf '%s' "${lane%%:*}" | sed 's/^[[:space:]]*//; s/[[:space:]]*$//')"; lane_paths="${lane#*:}" ;; esac
  names="$(helper project-names "$root/$MANIFEST_REL" 2>/dev/null)"
  printf '%s\n' "$names" | grep -qxF -- "$lane_project" || lane_project=""

  # Where the work lands: two choices, the kind names behind the curtain.
  # For a bundle the office can read, the default is the one place whose
  # tree holds every path the bundle names, and a bundle whose paths no
  # one place holds is refused here, before bale runs.
  local where_default="${lane_project:-office}" where_why=""
  if [ -n "$bundle" ] && [ -f "$bundle" ]; then
    local found
    found="$(reader bundle-where "$root" --bundle "$bundle" ${lane_project:+--lane "$lane_project"})" || exit 1
    if [ -n "$found" ]; then
      where_default="${found%%$'\t'*}"; where_why="${found#*$'\t'}"
      debug "where defaults to $where_default for this bundle: $where_why"
    fi
  fi
  if [ -z "$where" ]; then
    can_ask || die "say where the work lands: --in-office, or --on PROJECT ($(printf '%s' "$names" | paste -sd, - | sed 's/,/, /g')); piped input is never asked"
    while :; do
      ask ans "Where the work lands: office, or the project it changes ($(printf '%s' "$names" | paste -sd, - | sed 's/,/, /g')) (--in-office or --on PROJECT)" \
        "$where_default" 1 \
        "office: the session works in this office (the folder, the notepad) and is packed here. A project's name: the session changes that project's repo and is packed there, with this office's context riding beside it, never inside it.${where_why:+ The default is $where_default because $where_why.}"
      if [ "$ans" = office ]; then where=office; break; fi
      if printf '%s\n' "$names" | grep -qxF -- "$ans"; then where=project; project="$ans"; break; fi
      printf '  office, or one of this office'"'"'s projects: %s\n' "$(printf '%s' "$names" | paste -sd, - | sed 's/,/, /g')" >&2
    done
  fi
  if [ "$where" = project ]; then
    printf '%s\n' "$names" | grep -qxF -- "$project" || die "--on $project: no such project in this office (it scopes: $(printf '%s' "$names" | paste -sd, - | sed 's/,/, /g'); office projects add adds one)"
  else
    about="$lane_project"
  fi

  # The goal: the one thing the pack cannot derive (a bundle carries its own).
  if [ -n "$bundle" ]; then
    goal="(the bundle's)"
  elif [ -z "$goal" ]; then
    can_ask || die "give the session's goal: --goal TEXT, one sentence; piped input is never asked"
    ask goal "The session's goal, in one sentence (--goal)" "" 1 \
      "What the session is for, in one sentence: it becomes the request's goal and the opener's first line. The folder, its lane and the project's ride-alongs go with it on their own."
  fi
  goal="$(printf '%s' "$goal" | tr '\n' ' ' | sed 's/^[[:space:]]*//; s/[[:space:]]*$//')"
  [ -n "$goal" ] || die "the goal is empty"
  case "$goal" in -*) die "a goal may not start with a dash (bale would read it as a flag)" ;; esac
  # bale numbers sessions per repo, so the same slug packed in the office
  # and in a project the same day would mint one id twice; an office
  # session's default slug says office.
  if [ -z "$slug" ]; then
    slug="$(short_slug "${name#[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]-}")"
    [ "$where" = project ] || slug="$slug-office"
  fi
  slug="$(slugify "$slug")"; [ -n "$slug" ] || die "the slug has no letters or digits (give one: --slug SLUG)"

  # A project session's forecast: the lane's paths when the lane names
  # this project, else asked, else the whole repo.
  if [ "$where" = project ] && [ "$set_w" = 0 ] && [ "$read_only" = 0 ] && [ -z "$bundle" ]; then
    if [ "$lane_project" = "$project" ] && [ -n "${lane_paths//[[:space:],]/}" ]; then
      IFS=',' read -r -a writes <<< "$lane_paths"
      for v in "${!writes[@]}"; do writes[$v]="$(printf '%s' "${writes[$v]}" | sed 's/^[[:space:]]*//; s/[[:space:]]*$//')"; done
      log "forecast from the folder's lane: ${writes[*]}"
    elif can_ask; then
      ask ans "Paths in $project the session will change, comma-separated (--write) [return: the whole repo]" "" 0 \
        "Its write forecast, relative to $project's top: what bale keeps other sessions off while this one is open. A directory covers what lands under it. The whole repo keeps every other $project session waiting."
      [ -z "$ans" ] || IFS=',' read -r -a writes <<< "$ans"
      for v in "${!writes[@]}"; do writes[$v]="$(printf '%s' "${writes[$v]}" | sed 's/^[[:space:]]*//; s/[[:space:]]*$//')"; done
    fi
    [ "${#writes[@]}" -gt 0 ] || log "no forecast given: bale forecasts the whole of $project, so no other session there runs beside this one"
  fi
  # What rides with the project: shown on a terminal, where a declared
  # ride-along can stay home for this session; piped, everything rides
  # as declared unless --leave-out or --no-rides says otherwise.
  local ride_project="" rides=() r
  if [ "$where" = project ]; then ride_project="$project"; else ride_project="$about"; fi
  if [ -n "$ride_project" ]; then
    mapfile -t rides < <(helper project-facts "$root/$MANIFEST_REL" "$ride_project" 2>/dev/null | awk -F'\t' '$1 == "rides" {print $2}')
  fi
  if [ "$no_rides" = 1 ]; then
    [ "${#rides[@]}" -gt 0 ] || log "nothing rides with ${ride_project:-this session}, so --no-rides changes nothing"
    leave_out=("${rides[@]}")
  elif [ "${#rides[@]}" -gt 0 ] && [ "${#leave_out[@]}" -eq 0 ] && can_ask; then
    ask_rides leave_out "$ride_project" "${rides[@]}"
  fi

  args=(--where "$where" --goal "$goal" --slug "$slug")
  [ "$where" = project ] && args+=(--project "$project")
  [ -z "$about" ] || args+=(--project "$about")
  for v in "${writes[@]}"; do [ -n "$v" ] && args+=(--write "${v%/}"); done
  for v in "${includes[@]}"; do args+=(--include "${v%/}"); done
  [ "$read_only" = 0 ] || args+=(--read-only)
  if [ -n "$brief" ]; then [ -f "$brief" ] || die "--brief $brief: no such file"; args+=(--brief "$brief"); fi
  [ -z "$cls" ] || [ -n "$bundle" ] || args+=(--work-class "$cls")
  [ -z "$bundle" ] || args+=(--bundle "$bundle")
  for v in "${START_INSTALL_FILES[@]}"; do args+=(--install-file "$v"); done
  for r in "${leave_out[@]}"; do args+=(--leave-out "$r"); done
  tray_root="$(machine_setting out_tray "$HOME/out-tray")"
  case "$tray_root" in "~"|"~/"*) tray_root="$HOME${tray_root#\~}" ;; esac

  log "$([ -n "$bundle" ] && printf 'opening the bundle %s' "$bundle" || printf 'packing') for desk/$name ($([ "$where" = office ] && printf 'in the office' || printf 'on %s' "$project"))"
  out="$(reader start "$root" "desk/$name" "${args[@]}" --tray-root "$tray_root")" || exit 1
  sid="$(printf '%s' "$out" | python3 -c 'import json,sys; print(json.load(sys.stdin)["sid"])')" || die "could not read what office start packed"
  tray="$(printf '%s' "$out" | python3 -c 'import json,sys; print(json.load(sys.stdin)["tray"])')"
  printf '%s' "$out" | python3 -c 'import json,sys
for w in json.load(sys.stdin)["warnings"]:
    print(w)' | while IFS= read -r v; do warn "$v"; done
  tz="$(office_tz "$root")"; day="$(office_date "$tz")"
  record_session "$root" "desk/$name" "$sid" "" "$day"
  local filed_rc=0 request
  request="$(printf '%s' "$out" | python3 -c 'import json,sys; print(json.load(sys.stdin)["request"])')"
  file_sitting_pages "$root" "$request" "$sid" || filed_rc=1

  printf 'Packed %s for desk/%s.\n\n' "$sid" "$name"
  printf 'Out tray: %s\n' "$tray"
  printf '%s' "$out" | python3 -c 'import json,sys
r = json.load(sys.stdin)
for line in r["carried"]:
    print("  " + line)'
  printf '\nAttach every file in the out tray to a fresh chat, then paste the opener:\n\n'
  local opener
  opener="$(printf '%s' "$out" | python3 -c 'import json,sys
r = json.load(sys.stdin)
if r["opener"] is not None:
    print("\n".join(r["opener"]))')"
  if [ -z "$opener" ]; then
    warn "bale printed no opener between its scissor lines; the session is open, and bale pack's own report (run it by hand) or bale status shows it"
    return "$filed_rc"
  fi
  printf -- '--8<-- session opener --8<--\n%s\n--8<-- end session opener --8<--\n' "$opener"
  if [ -n "$(printf '%s' "$out" | python3 -c 'import json,sys; print("yes" if json.load(sys.stdin).get("sitting") else "")')" ]; then
    printf '\nA read-only sitting lands nothing; when it is over: office land %s ends it\n' "$sid"
  else
    printf '\nWhen the response comes back: office land %s\n' "$sid"
  fi
  start_desktop "$tray" "$opener"
  [ "$filed_rc" = 0 ] || warn "the session is open and its tray is ready, but a page of the sitting's words was not filed (the lines above say why)"
  return "$filed_rc"
}

# The pages of a sitting's words the request's brief carries, filed in
# the office's notepad and committed alone (doctrine section 5). A page
# already filed with the same bytes is left as it is; a different page
# at its path is refused loudly and never overwritten.
file_sitting_pages() {
  local root="$1" request="$2" sid="$3" out rc state path why paths=()
  out="$(helper file-sitting-pages "$root" --request "$request")"; rc=$?
  [ "$rc" = 0 ] || [ "$rc" = 3 ] || { warn "could not read the brief in $request for a sitting's pages"; return 1; }
  while IFS=$'\t' read -r state path why; do
    [ -n "$state" ] || continue
    case "$state" in
      filed) log "filed $path, a page of the sitting's words from $sid's brief"; paths+=("$path") ;;
      same) log "$path is already filed with these words; left as it is" ;;
      refused) warn "NOT FILED: $path: $why" ;;
      malformed) warn "NOT FILED: the brief's notepad page markers: $why" ;;
    esac
  done <<< "$out"
  if [ "${#paths[@]}" -gt 0 ]; then
    commit_paths "$root" "office start: the sitting's words from $sid's brief" "${paths[@]}" || true
  fi
  return $([ "$rc" = 0 ] && echo 0 || echo 1)
}

# The two desktop steps, on a terminal only: copy the opener to the
# clipboard and open the out tray in the file manager. On WSL they
# default to clip.exe and explorer.exe; elsewhere they are off until
# machine.toml names a command.
start_desktop() {
  local tray="$1" opener="$2" open
  [ -t 1 ] || return 0
  if on_wsl; then
    open="$(machine_setting open_command "$(command -v explorer.exe >/dev/null 2>&1 && printf explorer.exe)")"
  else
    open="$(machine_setting open_command "")"
  fi
  to_clipboard "$opener" "the opener"
  if [ -n "$open" ]; then
    (cd "$tray" && $open . >/dev/null 2>&1 &)
    log "opened the out tray with $open"
  fi
}

# to_clipboard TEXT WHAT: on a terminal, put TEXT on the clipboard and
# say so. On WSL the default is clip.exe (fed UTF-16, which is what it
# reads); elsewhere it is off until machine.toml names clipboard_command,
# and "" there turns it off. Returns 1 when nothing was copied.
to_clipboard() {
  local text="$1" what="$2" clip
  [ -t 1 ] || return 1
  if on_wsl; then
    clip="$(machine_setting clipboard_command "$(command -v clip.exe >/dev/null 2>&1 && printf clip.exe)")"
  else
    clip="$(machine_setting clipboard_command "")"
  fi
  [ -n "$clip" ] || return 1
  if [ "$(basename "${clip%% *}")" = clip.exe ] && command -v iconv >/dev/null 2>&1; then
    printf '%s\n' "$text" | iconv -f UTF-8 -t UTF-16LE | $clip 2>/dev/null
  else
    printf '%s\n' "$text" | $clip 2>/dev/null
  fi
  if [ $? -eq 0 ]; then log "$what is on the clipboard ($clip)"; return 0; fi
  warn "$clip could not take $what; copy it from above"
  return 1
}

# --- bringing a session back ---------------------------------------------------
#
# office land: one command from a response to a landed session. It finds
# the session the response answers, runs bale apply in the repo the
# session belongs to (bale retry for a held one) with this terminal as
# bale's stdin, so bale's own questions reach the occupant and the office
# answers none, and says how it ended, from bale's records. Then, after
# an applied landing, the project's after-land actions and the planner's
# ratification.

usage_land() {
  cat <<'USAGE'
usage: office land [SID | FOLDER | RESPONSE] [--sid SID] [--folder FOLDER] [--response FILE]
                   [--ratified [--except TEXT] | --not-now]
Brings a session back. It finds the response for a session the office has
out, runs bale apply in the repo the session belongs to (a project, or the
office itself; bale retry when bale held the session), and says how it
ended. bale asks its own questions (an admission, the merge, a hook) and
only you answer them. After an applied landing it runs the project's
after-land actions in order, then asks whether the planner ratified the
session's judgment calls, and ends by saying what became of each action
(ran, failed, not run). Anything bale prints for you to carry is printed
whole and, on WSL, put on the clipboard. Given a read-only sitting the
office sent out (by its id or its folder), land ends it instead: bale
unlock in its repo and an `ended` line in the folder's History; the
folder stays as it is. An after-land action runs only through office
land: a session applied by hand with bale apply runs none.
  (nothing)        the session the office has out; asked when there are several
  SID, --sid       a session by its id
  FOLDER, --folder the session out for a folder: its name, part of it, or folder N
  RESPONSE, --response FILE
                   the response tarball: a path, or the name bale's search finds
                   (default: response-SID.tar.gz, found by bale)
  --ratified       the planner ratified the session's judgment calls
  --except TEXT    ...except TEXT: what was corrected, and where it went
  --not-now        do not ask about ratification; office sessions FOLDER SID
                   --ratified records it later
Under the hood: bale apply TARBALL (bale retry for a held session) in the
session's repo, then bale stats --sid SID --json for how it ended; for a
sitting, bale unlock SID --json in its repo.
Examples:
  office land                                  (the session out; asked when there are several)
  office land 2026-10-05-fix-login-001
  office land fix-login --ratified
  office land 2026-10-05-plan-wave-office-001  (a read-only sitting: ends it)
  office land 2026-10-05-fix-login-001 --response "$HOME/Downloads/response-2026-10-05-fix-login-001 (1).tar.gz"
USAGE
}

# What became of each after-land action, for land's last lines.
AFTER_LAND_REPORT=()

# run_after_land REPO CMD...: the project's after-land actions, in order,
# in its repo. The first that fails stops the rest, loudly, with the one
# line that reruns it and each one after it.
run_after_land() {
  local repo="$1" n=0 total rc c i; shift
  total=$#
  for c in "$@"; do
    n=$((n + 1))
    log "after land ($n of $total), in $repo: $c"
    (cd "$repo" && bash -c "$c"); rc=$?
    if [ "$rc" -ne 0 ]; then
      warn "AFTER-LAND ACTION FAILED (exit $rc): $c"
      warn "nothing after it ran; rerun from there with:"
      AFTER_LAND_REPORT+=("FAILED (exit $rc): $c")
      i=0
      for c in "$@"; do
        i=$((i + 1))
        [ "$i" -ge "$n" ] && printf '[office]   (cd %s && %s)\n' "$(shq "$repo")" "$c" >&2
        [ "$i" -gt "$n" ] && AFTER_LAND_REPORT+=("not run: $c")
      done
      local rerun="" r
      for r in "${@:$n}"; do rerun="${rerun:+$rerun && }$r"; done
      AFTER_LAND_REPORT+=("rerun from the failed one: (cd $(shq "$repo") && $rerun)")
      return 1
    fi
    AFTER_LAND_REPORT+=("ran (exit 0): $c")
  done
  [ "$total" -eq 0 ] || log "after land: $total action(s) ran"
  return 0
}

# plan_field FILE KEY: one field of land's plan, as text (a list one per line).
plan_field() {
  python3 -c 'import json,sys
v = json.load(open(sys.argv[1]))
for k in sys.argv[2].split("."):
    v = v[k] if isinstance(v, dict) else None
if isinstance(v, list):
    print("\n".join(str(x) for x in v))
elif isinstance(v, bool):
    print("yes" if v else "")
elif v is not None:
    print(v)' "$1" "$2"
}

cmd_land() {
  local want="" sid="" folder="" response="" ratify="" except="" has_except=0 root tmp plan capture
  local out n line words verb repo label code day tz md name space rc=0 ans relays i
  while [ $# -gt 0 ]; do
    case "$1" in
      --sid|--folder|--response|--except)
        [ $# -ge 2 ] || die "$1 needs a value (office land --help explains it)"
        case "$1" in --sid) sid="$2" ;; --folder) folder="$2" ;; --response) response="$2" ;;
                     --except) except="$2"; has_except=1 ;; esac
        shift 2 ;;
      --ratified) [ "$ratify" != no ] || die "--ratified and --not-now contradict each other"; ratify=yes; shift ;;
      --not-now) [ "$ratify" != yes ] || die "--ratified and --not-now contradict each other"; ratify=no; shift ;;
      -h|--help) usage_land; return 0 ;;
      -*) usage_land >&2; die "office land does not know $1; the flags above are what it takes" ;;
      *) [ -z "$want" ] || die "office land takes one session, folder or response"; want="$1"; shift ;;
    esac
  done
  [ "$has_except" = 0 ] || [ "$ratify" = yes ] || die "--except goes with --ratified"
  # A plain word is whichever of the three it reads as.
  if [ -n "$want" ]; then
    if [[ "$want" =~ ^[0-9]{4}-[0-9]{2}-[0-9]{2}-[a-z0-9]+(-[a-z0-9]+)*-[0-9]{3}$ ]]; then
      [ -z "$sid" ] || die "two session ids: $want and --sid $sid"; sid="$want"
    elif [[ "$want" == *.tar.gz ]] || [ -f "$want" ]; then
      [ -z "$response" ] || die "two responses: $want and --response $response"; response="$want"
    else
      [ -z "$folder" ] || die "two folders: $want and --folder $folder"; folder="$want"
    fi
  fi
  root="$(resolve_office)" || exit 1
  require_current "$root"
  command -v bale >/dev/null 2>&1 || die "bale is not on PATH; office land runs bale apply"
  tmp="$(mktemp -d)" || die "cannot make temp space for the landing"
  TMP_PATHS+=("$tmp")
  plan="$tmp/plan.json"; capture="$tmp/bale-stdout"
  tz="$(office_tz "$root")"; day="$(office_date "$tz")"

  if [ -n "$folder" ]; then
    space=desk
    if ! name="$( (find_folder "$root" desk "$folder") 2>/dev/null)"; then
      space=filing-cabinet; name="$(find_folder "$root" filing-cabinet "$folder")" || exit 1
    fi
    folder="$space/$name"
  fi

  # Which session: the one out, or asked when there are several.
  if [ -z "$sid" ] && [ -z "$folder" ] && [ -z "$response" ]; then
    out="$(reader land-out "$root")" || die "could not read which sessions are out"
    n="$(printf '%s' "$out" | grep -c .)"
    case "$n" in
      0) die "no session is out: none that a folder records is open in this office or in a project it scopes (office start sends one out)" ;;
      1) sid="${out%%$'\t'*}" ;;
      *) if ! can_ask; then
           printf '%s\n' "$out" | sed 's/\t/  (/; s/\t/; /; s/$/)/; s/^/[office]   /' >&2
           die "$n sessions are out; name one: office land SID; piped input is never asked"
         fi
         printf 'Sessions out:\n' >&2
         printf '%s\n' "$out" | sed 's/\t/  (/; s/\t/; /; s/$/)/; s/^/  /' >&2
         while :; do
           ask sid "Which session lands (office land SID)" "${out%%$'\t'*}" 1 \
             "The id of the session whose response came back; the lines above are every session a folder records that is open."
           printf '%s\n' "$out" | cut -f1 | grep -qxF -- "$sid" && break
           printf '  one of the ids above\n' >&2
         done ;;
    esac
  fi

  reader land-plan "$root" ${sid:+--sid "$sid"} ${folder:+--folder "$folder"} ${response:+--response "$response"} \
    --cwd "$PWD" --plan "$plan" || exit 1
  sid="$(plan_field "$plan" sid)"
  if [ -n "$(plan_field "$plan" needs_response)" ]; then
    if ! can_ask; then
      die "bale held $sid, so its corrected response lands with bale retry; give it: office land $sid --response FILE (a browser saves a second download of one name as 'response-$sid (1).tar.gz'); piped input is never asked"
    fi
    ask response "bale held $sid; the corrected response: a path, or a name bale's search finds (--response FILE)" \
      "response-$sid.tar.gz" 1 \
      "The response the worker sent after the HOLD. A browser saves a second download of the same name as 'response-$sid (1).tar.gz', so give the path of the new one; a plain return lets bale find response-$sid.tar.gz, which may be the held one."
    reader land-plan "$root" --sid "$sid" --response "$response" --cwd "$PWD" --plan "$plan" || exit 1
  fi
  plan_field "$plan" problems | while IFS= read -r line; do [ -n "$line" ] && warn "$line"; done
  verb="$(plan_field "$plan" verb)"; repo="$(plan_field "$plan" repo)"; label="$(plan_field "$plan" label)"

  # A read-only sitting the office sent out lands nothing; landing it
  # ends it (the ruling of sitting 2026-10-03-plan-4b-sitting-001): bale
  # unlock in its repo, and the folder's History line. Nothing runs
  # after it and nothing is ratified.
  if [ "$verb" = unlock ]; then
    [ -z "$ratify$except" ] || log "a sitting lands nothing, so nothing is ratified"
    log "ending the read-only sitting $sid ($label; $(plan_field "$plan" folders | paste -sd, - | sed 's/,/, /g')): bale unlock $sid, in $repo"
    out="$(reader land-end "$root" --plan "$plan" --day "$day")" || exit 1
    printf '\n%s\n' "$(printf '%s' "$out" | python3 -c 'import json,sys; print(json.load(sys.stdin)["words"])')"
    printf '%s' "$out" | python3 -c 'import json,sys
for l in json.load(sys.stdin)["told"]:
    print(l)' | while IFS= read -r line; do log "$line"; done
    return 0
  fi
  log "landing $sid ($label; $(plan_field "$plan" folders | paste -sd, - | sed 's/,/, /g; s/^$/no folder records it/')): bale $verb $(plan_field "$plan" tarball), in $repo"
  line="$(reader land-prepare "$root" --plan "$plan")" || exit 1
  [ -z "$line" ] || log "$line"

  reader land-run "$root" --plan "$plan" --capture "$capture"; code=$?
  if ! out="$(reader land-outcome "$root" --plan "$plan" --capture "$capture" --exit "$code" --day "$day")"; then
    [ -z "$line" ] || warn "the record of $sid may still be out of its folder; office sessions $(plan_field "$plan" folders | head -n 1 | sed 's#.*/##') $sid puts it back"
    die "could not read how $sid ended from bale's records (bale stats --sid $sid --json, in $repo, shows them)"
  fi
  words="$(printf '%s' "$out" | python3 -c 'import json,sys; print(json.load(sys.stdin)["words"])')"
  printf '\n%s\n' "$words"
  printf '%s' "$out" | python3 -c 'import json,sys
for l in json.load(sys.stdin)["told"]:
    print(l)' | while IFS= read -r line; do log "$line"; done

  # The blocks to carry: printed whole when bale did not print them (a
  # clarification's), and on the clipboard one at a time, in bale's order.
  relays="$(printf '%s' "$out" | python3 -c 'import json,sys; print(len(json.load(sys.stdin)["relays"]))')"
  i=0
  while [ "$i" -lt "$relays" ]; do
    local block to
    block="$(printf '%s' "$out" | python3 -c 'import json,sys; print("\n".join(json.load(sys.stdin)["relays"][int(sys.argv[1])]["lines"]))' "$i")"
    to="$(printf '%s' "$out" | python3 -c 'import json,sys; print(json.load(sys.stdin)["relays"][int(sys.argv[1])]["to"])' "$i")"
    if [ "$(printf '%s' "$out" | python3 -c 'import json,sys; print(json.load(sys.stdin)["outcome"])')" = clarification ]; then
      printf '\nFor the planner, whole:\n\n%s\n' "$block"
    fi
    if [ "$i" -gt 0 ] && [ -t 1 ] && can_ask; then
      ask ans "Return puts the block for the $to on the clipboard" "" 0 \
        "bale printed more than one block to carry; they go one at a time, in the order bale says to send them."
    fi
    to_clipboard "$block" "the block for the $to" || [ "$i" -gt 0 ] || [ ! -t 1 ] || log "copy the block for the $to from above"
    i=$((i + 1))
  done

  if [ -z "$(printf '%s' "$out" | python3 -c 'import json,sys; print("yes" if json.load(sys.stdin)["applied"] else "")')" ]; then
    [ -z "$ratify$except" ] || log "nothing landed, so nothing is ratified"
    line="$(printf '%s' "$out" | python3 -c 'import json,sys; print(json.load(sys.stdin)["next"] or "")')"
    [ -z "$line" ] || printf 'Next: %s\n' "$line"
    [ "$(printf '%s' "$out" | python3 -c 'import json,sys; print(json.load(sys.stdin)["outcome"])')" = clarification ] && return 0
    return 1
  fi

  # After an applied landing: the project's after-land actions, in order.
  # What became of each is said again as land's last lines, after the
  # ratification, so it is never lost above a long screen.
  local problem actions=() project
  AFTER_LAND_REPORT=()
  project="$(plan_field "$plan" project)"
  problem="$(plan_field "$plan" after_land_problem)"
  # An empty list prints one empty line; it is no action (0.7.0 and 0.8.0
  # ran it as `bash -c ""` and said "1 action(s) ran").
  mapfile -t actions < <(plan_field "$plan" after_land | grep -v '^$')
  if [ -n "$problem" ]; then
    warn "after-land actions not run: the project's declarations do not read ($problem; office projects set fixes them)"
    AFTER_LAND_REPORT+=("not run: $project's declarations do not read ($problem); office projects set $project fixes them")
    rc=1
  elif [ "${#actions[@]}" -gt 0 ]; then
    run_after_land "$repo" "${actions[@]}" || rc=1
  elif [ -n "$project" ]; then
    log "after land: $project declares no after-land action, so nothing ran (office projects set $project --after-land CMD declares one)"
    AFTER_LAND_REPORT+=("none: $project declares no after-land action")
  else
    debug "after land: an office session runs no after-land actions"
  fi

  # The planner's ratification, through the same step as office sessions.
  local folders
  folders="$(plan_field "$plan" folders | head -n 1)"
  if [ -z "$folders" ]; then
    log "no folder records $sid, so there is nothing to ratify in"
    after_land_summary "$repo"
    return "$rc"
  fi
  space="${folders%%/*}"; name="${folders#*/}"
  if [ -z "$ratify" ] && can_ask; then
    while :; do
      ask ans "Did the planner ratify $sid's judgment calls: yes, yes except TEXT, or not now (--ratified, --except TEXT, --not-now)" \
        "not now" 0 \
        "yes records that the planner ratified the session's judgment calls (the flagged decisions in its notes); yes except TEXT records what was corrected and where it went; not now records nothing, and office sessions $name $sid --ratified records it later."
      case "$ans" in
        y|Y|yes|Yes|YES) ratify=yes; break ;;
        "yes except "*|"Yes except "*|"except "*) ratify=yes; except="${ans#*except }"; has_except=1
          [ -n "${except//[[:space:]]/}" ] && break
          printf '  except what: the correction, and where it went\n' >&2; ratify="" ;;
        n|N|no|No|"not now"|"Not now") ratify=no; break ;;
        *) printf '  answer yes, yes except TEXT, or not now\n' >&2 ;;
      esac
    done
  fi
  if [ "$ratify" = yes ]; then
    md="$root/$space/$name/folder.md"
    if [ "$has_except" = 1 ]; then
      out="$(helper ratify "$md" "$sid" --day "$day" --except "$except")" || { after_land_summary "$repo"; return 1; }
    else
      out="$(helper ratify "$md" "$sid" --day "$day")" || { after_land_summary "$repo"; return 1; }
    fi
    log "$name: $out"
    commit_paths "$root" "office sessions: $sid ratified in $name" "$space/$name/folder.md" || true
  else
    log "not ratified; when the planner rules: office sessions $name $sid --ratified (or --ratified --except TEXT)"
  fi
  after_land_summary "$repo"
  return "$rc"
}

# land's last lines after an applied landing: what became of each
# after-land action (ran, failed, not run), on stdout, so the outcome of
# an install or a deploy is the last thing on the screen and never a
# guess afterwards.
after_land_summary() {
  local repo="$1" line
  [ "${#AFTER_LAND_REPORT[@]}" -gt 0 ] || return 0
  printf '\nAfter land, in %s:\n' "$repo"
  for line in "${AFTER_LAND_REPORT[@]}"; do printf '  %s\n' "$line"; done
}

# The projects this office scopes, and what bale records about them.
# The floor plan's [projects] table names each project and its repo on
# this machine; `office projects add` is the only writer. The renderings
# read bale's records through the read side and write nothing.
usage_projects() {
  cat <<'EOF'
usage: office projects                       list the projects this office scopes, and
                                             what rides with each and runs after it lands
       office projects add [NAME] [PATH]     add one (asks for what it was not given)
                           [--name NAME] [--path PATH] [--ride PATH]... [--after-land CMD]...
       office projects set [NAME]            declare what rides beside every session on a
                           [--ride PATH]... [--no-rides]       project, and what runs in its
                           [--after-land CMD]... [--no-after-land]   repo after one lands
       office projects [NAME] --ledger       trust ledger per work class
       office projects [NAME] --landed PATH  the last applied session that landed PATH
       office projects [NAME] --versions     the version trail
NAME narrows a rendering to one project; without it every project is read.
PATH for --landed is relative to the project's root, e.g. bin/office.
A ride-along is a path on this machine, absolute or ~/: a directory inside
another repo, a whole repo, or a file. Its context rides beside every
session office start packs for the project. An after-land action is a
command run in the project's repo after one of its sessions lands: office
land runs them in order once bale has applied it. Both live in this
office's floor plan, never in the project's repo. --ride and --after-land
replace the list they name; on a terminal, set asks for what it was not
given.
Examples:
  office projects
  office projects add                          (asks for the path, the name, what rides)
  office projects add office-src ~/office-src
  office projects set office-src --after-land ./install.sh
  office projects set office-src --ride ~/nisaba-src/blueprints
  office projects --landed bin/office
EOF
}

# ask_declaration ARRAY PROJECT KIND: on a terminal, one ride-along path
# (KIND ride) or after-land action (KIND after-land) per question until
# a plain return; each answer is checked as it is given and asked again
# with the reason when it does not check.
ask_declaration() {
  local -n __list="$1"
  local name="$2" kind="$3" answer out q flag help n=0
  case "$kind" in
    ride) flag=--ride; q="A path whose context rides beside every $name session"
          help="A path on this machine, absolute or ~/: a directory inside another repo (~/other-repo/docs), a whole repo, or a file. office start packs its context and puts it in the out tray beside every request for $name." ;;
    *) flag=--after-land; q="A command to run in $name's repo after one of its sessions lands"
       help="One line, run from the top of $name's repo once a session there has landed, e.g. ./install.sh. office land runs them in order after bale applies a session, and says loudly when one fails." ;;
  esac
  __list=()
  while :; do
    [ "$n" -eq 0 ] || q="Another"
    IFS= read -r -p "$q ($flag) [return ends the list]: " answer || die "no answer given to: $q"
    answer="$(printf '%s' "$answer" | sed 's/^[[:space:]]*//; s/[[:space:]]*$//')"
    if [ "$answer" = "?" ]; then printf '%s\n' "$help" | fold -s -w 76 | sed 's/^/  /' >&2; continue; fi
    [ -n "$answer" ] || return 0
    if out="$(helper check-declaration "$kind" -- "$answer" 2>&1)"; then
      __list+=("$out"); n=$((n + 1))
    else
      printf '  %s\n' "${out#\[office\] error: }" >&2
    fi
  done
}

# declaration_args ARRAY RIDES_SET RIDES... -- : the project-declare
# flags for one key, given its list and whether it was set at all.
declare_flags() {
  local -n __out="$1"; local key="$2" set="$3"; shift 3
  [ "$set" = 1 ] || return 0
  if [ $# -eq 0 ]; then __out+=("--no-$([ "$key" = ride ] && printf rides || printf after-land)"); return 0; fi
  local v; for v in "$@"; do __out+=("--$key" "$v"); done
}

cmd_projects_add() {
  local name="" path="" root default missing=() rides=() afters=() set_r=0 set_a=0 args=()
  while [ $# -gt 0 ]; do
    case "$1" in
      --name) [ $# -ge 2 ] || die "--name needs a value"; name="$2"; shift 2 ;;
      --path) [ $# -ge 2 ] || die "--path needs a value"; path="$2"; shift 2 ;;
      --ride) [ $# -ge 2 ] || die "--ride needs a path"; rides+=("$2"); set_r=1; shift 2 ;;
      --after-land) [ $# -ge 2 ] || die "--after-land needs a command"; afters+=("$2"); set_a=1; shift 2 ;;
      -h|--help) usage_projects; return 0 ;;
      -*) usage_projects >&2; die "office projects add does not know $1; it takes a name and a path, as words or as --name and --path, and --ride and --after-land" ;;
      *) if [ -z "$name" ]; then name="$1"; elif [ -z "$path" ]; then path="$1"; else die "office projects add takes a name and a path, and got more: $1"; fi; shift ;;
    esac
  done
  root="$(resolve_office)" || exit 1
  require_current "$root"
  if [ -z "$name" ] || [ -z "$path" ]; then
    if [ -t 0 ]; then
      # A wizard on a terminal: ask for what was not given (doctrine
      # section 7); every question has its flag twin.
      # The path is checked as soon as it is given, so a wrong one is
      # asked again before the name and the declarations are.
      while [ -z "$path" ]; do
        ask path "Path to the project's git repo on this machine (--path)" "" 1 \
          "The top of the project's git repo, absolute or under your home directory (~/...). bale must run there: it needs a .bale/ directory or a bale.toml."
        case "$path" in "~"|"~/"*) path="$HOME${path#\~}" ;; esac
        project_dir_ok "$path" || path=""
      done
      if [ -z "$name" ]; then
        default="$(slugify "$(basename "${path%/}")")"
        ask name "Name for it in this office (--name)" "$default" 0 \
          "What this office calls the project on the walk-in and in office projects: letters, digits, dash or underscore."
      fi
      if [ "$set_r" = 0 ]; then ask_declaration rides "$name" ride; set_r=1; fi
      if [ "$set_a" = 0 ]; then ask_declaration afters "$name" after-land; set_a=1; fi
    else
      [ -n "$name" ] || missing+=("--name NAME")
      [ -n "$path" ] || missing+=("--path PATH")
      die "stdin is not a terminal, so nothing is asked; give ${missing[*]}"
    fi
  fi
  [ -n "$name" ] && [ -n "$path" ] || die "a project needs a name and a path"
  # Check the declarations before the table is touched, so a bad one
  # adds nothing.
  local v
  for v in "${rides[@]}"; do helper check-declaration ride -- "$v" >/dev/null || exit 1; done
  for v in "${afters[@]}"; do helper check-declaration after-land -- "$v" >/dev/null || exit 1; done
  helper project-add "$root/$MANIFEST_REL" "$name" "$path" || exit 1
  if [ "${#rides[@]}" -gt 0 ] || [ "${#afters[@]}" -gt 0 ]; then
    declare_flags args ride "$([ "${#rides[@]}" -gt 0 ] && echo 1 || echo 0)" "${rides[@]}"
    declare_flags args after-land "$([ "${#afters[@]}" -gt 0 ] && echo 1 || echo 0)" "${afters[@]}"
    helper project-declare "$root/$MANIFEST_REL" "$name" "${args[@]}" || die "added $name, but its declarations could not be written; office projects set $name tries again"
  fi
  commit_paths "$root" "office projects: add $name" "$MANIFEST_REL" || true
}

cmd_projects_set() {
  local name="" root facts rides=() afters=() set_r=0 set_a=0 args=() current keep line
  while [ $# -gt 0 ]; do
    case "$1" in
      --ride) [ $# -ge 2 ] || die "--ride needs a path"; rides+=("$2"); set_r=1; shift 2 ;;
      --no-rides) set_r=2; shift ;;
      --after-land) [ $# -ge 2 ] || die "--after-land needs a command"; afters+=("$2"); set_a=1; shift 2 ;;
      --no-after-land) set_a=2; shift ;;
      -h|--help) usage_projects; return 0 ;;
      -*) usage_projects >&2; die "office projects set does not know $1; it takes a project's name, --ride, --no-rides, --after-land and --no-after-land" ;;
      *) [ -z "$name" ] || die "office projects set takes one project"; name="$1"; shift ;;
    esac
  done
  [ "$set_r" != 2 ] || [ "${#rides[@]}" -eq 0 ] || die "--ride and --no-rides contradict each other"
  [ "$set_a" != 2 ] || [ "${#afters[@]}" -eq 0 ] || die "--after-land and --no-after-land contradict each other"
  root="$(resolve_office)" || exit 1
  require_current "$root"
  if [ -z "$name" ]; then
    can_ask || { usage_projects >&2; die "name the project: office projects set NAME; piped input is never asked"; }
    printf 'Projects: %s\n' "$(helper project-names "$root/$MANIFEST_REL" | paste -sd, - | sed 's/,/, /g')" >&2
    ask name "Which project (office projects set NAME)" "" 1 "One of the projects this office scopes, by the name office projects lists."
  fi
  facts="$(helper project-facts "$root/$MANIFEST_REL" "$name")" || exit 1
  if [ "$set_r" = 0 ] && [ "$set_a" = 0 ] && ! can_ask; then
    die "nothing to set for $name; give --ride PATH (repeatable) or --no-rides, and --after-land CMD (repeatable) or --no-after-land; piped input is never asked"
  fi
  if can_ask; then
    for line in ride after-land; do
      if [ "$line" = ride ] && [ "$set_r" != 0 ]; then continue; fi
      if [ "$line" = after-land ] && [ "$set_a" != 0 ]; then continue; fi
      current="$(printf '%s\n' "$facts" | awk -F'\t' -v k="$([ "$line" = ride ] && echo rides || echo after_land)" '$1 == k {print $2}' | paste -sd, - | sed 's/,/, /g')"
      if [ -n "$current" ]; then
        ask keep "Keep $([ "$line" = ride ] && echo "what rides with $name" || echo "what runs after $name lands"): $current? (y/n)" "y" 0 \
          "y keeps the list as it is; n asks for the new list, one per question, and a plain return at once clears it."
        case "$keep" in y|Y|yes) continue ;; esac
      fi
      if [ "$line" = ride ]; then ask_declaration rides "$name" ride; set_r=$([ "${#rides[@]}" -gt 0 ] && echo 1 || echo 2)
      else ask_declaration afters "$name" after-land; set_a=$([ "${#afters[@]}" -gt 0 ] && echo 1 || echo 2); fi
      if [ -z "$current" ] && [ "$line" = ride ] && [ "$set_r" = 2 ]; then set_r=0; fi
      if [ -z "$current" ] && [ "$line" = after-land ] && [ "$set_a" = 2 ]; then set_a=0; fi
    done
  fi
  [ "$set_r" != 0 ] || [ "$set_a" != 0 ] || { log "nothing changed for $name"; return 0; }
  declare_flags args ride "$([ "$set_r" != 0 ] && echo 1 || echo 0)" "${rides[@]}"
  declare_flags args after-land "$([ "$set_a" != 0 ] && echo 1 || echo 0)" "${afters[@]}"
  helper project-declare "$root/$MANIFEST_REL" "$name" "${args[@]}" || exit 1
  commit_paths "$root" "office projects: set $name" "$MANIFEST_REL" || true
}

cmd_projects() {
  local name="" mode="" landed="" root rc
  case "${1:-}" in
    add) shift; cmd_projects_add "$@"; return ;;
    set) shift; cmd_projects_set "$@"; return ;;
  esac
  while [ $# -gt 0 ]; do
    case "$1" in
      --ledger|--versions) [ -z "$mode" ] || die "one rendering at a time: $mode or $1"; mode="$1"; shift ;;
      --landed) [ -z "$mode" ] || die "one rendering at a time: $mode or $1"
                [ $# -ge 2 ] || die "--landed needs a path, relative to the project's root"
                mode="$1"; landed="$2"; shift 2 ;;
      -h|--help) usage_projects; return 0 ;;
      -*) usage_projects >&2; die "office projects does not know $1" ;;
      *) [ -z "$name" ] || die "name one project, or none for all"; name="$1"; shift ;;
    esac
  done
  root="$(resolve_office)" || exit 1
  if [ -z "$mode" ]; then
    [ -z "$name" ] || die "a project name narrows a rendering: add --ledger, --landed PATH or --versions"
    helper projects "$root/$MANIFEST_REL"; rc=$?
  else
    case "$mode" in
      --ledger) reader ledger "$root" ${name:+--project "$name"} ;;
      --versions) reader versions "$root" ${name:+--project "$name"} ;;
      --landed) reader landed "$root" "$landed" ${name:+--project "$name"} ;;
    esac
    rc=$?
  fi
  case $rc in
    0) return 0 ;;
    3) die "some of this office's projects could not be read; the lines above say why" ;;
    *) exit 1 ;;
  esac
}

# --- the toy drawer: office tour ----------------------------------------------------
#
# A throwaway office to play in before committing to real work (the
# construction sitting's toy drawer). It is built in a temp directory and
# every command runs with OFFICE_ROOT pointing at it, its own config and
# state directories (so neither this machine's default office nor the
# walk-in record is read or written), git's global config switched off,
# and a stand-in bale first on the PATH that refuses everything, so no
# bale registry is ever touched. start and land are shown and explained,
# never run. At the end, or when interrupted, the office is deleted and
# the tour says so.

usage_tour() {
  cat <<'USAGE'
usage: office tour [--no-pause] [--play | --no-play]
Builds a throwaway office in a temp directory, with sample folders, notes, a
slip and a calendar with a gap, and walks you through the verbs on it: each
step runs one command, shows what it printed, and says what it did and why
you would type it. office start and office land are shown and explained,
never run. At the end it deletes the office and says so; stopped early or
interrupted, it deletes it too. It never touches your offices, this
machine's default office, the walk-in record, or bale.
  --no-pause   run every step without waiting for a return between them
  --play       at the end, open a shell where every office command acts on
               the tour office, to try things yourself; exit ends it and
               the office is deleted then. On a terminal the tour asks.
  --no-play    end without asking
Piped, it pauses for nothing and asks nothing.
Examples:
  office tour
  office tour --no-pause --no-play
  office tour --play
USAGE
}

TOUR_DIR=""
TOUR_ENV=()
TOUR_PAUSE=1

# The office command in the tour office: its environment, never asking.
tour_office() {
  env "${TOUR_ENV[@]}" "$OFFICE_SRC/bin/office" "$@" </dev/null
}

# A paragraph: a blank line, then the words wrapped and indented.
tour_say() {
  printf '\n'
  printf '%s\n' "$*" | fold -s -w 74 | sed 's/ *$//; s/^/  /'
}

# tour_show ARGS...: the command line as you would type it, then what it
# printed (stderr's lines too, as a terminal shows them), indented.
tour_show() {
  local shown="office" w
  for w in "$@"; do
    case "$w" in ""|*[!A-Za-z0-9_./:=@-]*) shown+=" $(shq "$w")" ;; *) shown+=" $w" ;; esac
  done
  printf '\n  $ %s\n' "$shown"
  tour_office "$@" 2>&1 | sed 's/^/    /; s/ *$//'
}

# Between steps, on a terminal: return goes on, q ends the tour early.
# Returns 1 when the occupant asked to end.
tour_pause() {
  local ans rc prompt="  [return: the next step; q: end the tour] "
  [ "$TOUR_PAUSE" = 1 ] || return 0
  printf '\n' >&2
  # A read that waits forever would hold a signal that lands just before
  # it until the next keystroke; one-second reads let the traps run at
  # once. The terminal hands over a line only on return, so a timeout
  # loses nothing typed.
  while :; do
    IFS= read -r -t 1 -p "$prompt" ans && break
    rc=$?
    [ "$rc" -gt 128 ] || return 1
    prompt=""
  done
  case "$ans" in q|Q|quit|exit) return 1 ;; esac
  return 0
}

tour_step() {  # tour_step N TOTAL TITLE
  printf '\n== Step %s of %s: %s ==\n' "$1" "$2" "$3"
}

# The sample office: a written profile (a real one is written in the
# founding session), a calendar with a gap, three folders, notes and a
# slip, each made the way the verbs make them.
tour_furnish() {
  local office="$TOUR_DIR/office" tz today gap_day
  python3 - "$SHAPE" > "$office/$PROFILE_REL" <<'PY' || return 1
import sys, tomllib
with open(sys.argv[1], "rb") as f:
    shape = tomllib.load(f)
print("# Profile: tour\n")
print("A sample profile written by office tour. A real office writes its own in its")
print("founding session, with you, section by section.\n")
for s in shape["section"]:
    print(f"## {s['heading']}\n\nThe tour's sample. In a real office this says: {s['asks']}\n")
PY
  # A renovation adds the calendar to a real office; the tour adds it so
  # office week has something to show.
  printf '\n[spaces.calendar]\npath = "calendar"\nhung = true\nfiled = false\n' >> "$office/$MANIFEST_REL" || return 1
  tz="$(OFFICE_ROOT="$office" office_tz "$office")"; today="$(office_date "$tz")"
  # The gap is planned for yesterday, or, on a Monday, for the first
  # minute of today: always in the past, always this week.
  gap_day="$today"
  [ "$(TZ="$tz" date +%u)" = 1 ] || gap_day="$(TZ="$tz" date -d "$today -1 day" +%F)"
  mkdir -p "$office/calendar" || return 1
  printf '# Plan\n\nWhat should happen, one bullet per line.\n\n- %s 00:00 call the electrician about the porch light\n- %s 00:00 water the tomatoes\n' \
    "$gap_day" "$today" > "$office/calendar/plan.md" || return 1
  printf '# Record\n\nWhat happened, one bullet per line.\n\n- %s 00:00 water the tomatoes: done before breakfast\n' \
    "$today" > "$office/calendar/record.md" || return 1
  env "${TOUR_ENV[@]}" git -C "$office" add -A -- "$PROFILE_REL" "$MANIFEST_REL" calendar >/dev/null 2>>"$TOUR_DIR/furnish.log" \
    && env "${TOUR_ENV[@]}" git -C "$office" commit -q -m "office tour: a sample profile and a calendar" >/dev/null 2>>"$TOUR_DIR/furnish.log" || return 1
  tour_office open fix-the-porch-light --title "Fix the porch light" --size small --source "a note on the notepad" >/dev/null 2>>"$TOUR_DIR/furnish.log" || return 1
  tour_office open paint-the-fence --title "Paint the fence" --size medium --after "folder 1" >/dev/null 2>>"$TOUR_DIR/furnish.log" || return 1
  tour_office open build-a-shed --title "Build a shed" --candidate >/dev/null 2>>"$TOUR_DIR/furnish.log" || return 1
  tour_office note "bought bulbs; the porch light still flickers" >/dev/null 2>>"$TOUR_DIR/furnish.log" || return 1
  tour_office slip --about office "the tour should come with snacks" >/dev/null 2>>"$TOUR_DIR/furnish.log" || return 1
}

tour_end() {
  rm -rf "$TOUR_DIR"
  trap - INT TERM HUP
  printf '\nThe tour office is deleted (%s). Nothing else was touched: your offices, this machine'"'"'s default office, the walk-in record and bale are as they were.\n' "$TOUR_DIR"
  if [ -n "$(office_default_exists)" ]; then
    printf '\nNext: office  (walk into your own office; office help lists every verb by what you want to do)\n'
  else
    printf '\nNext: office init  (build a real office; it asks where, what to call it and which projects it watches)\n'
  fi
}

# Whether this machine has a default office or the working directory is
# inside one (the tour's own office is gone by now): any output means yes.
office_default_exists() {
  if find_office_from "$PWD" >/dev/null 2>&1 || [ -f "$DEFAULT_FILE" ] || [ -n "${OFFICE_ROOT:-}" ]; then printf yes; fi
}

cmd_tour() {
  local play="" porch ans total=6
  while [ $# -gt 0 ]; do
    case "$1" in
      --no-pause) TOUR_PAUSE=0; shift ;;
      --play) [ "$play" != no ] || die "--play and --no-play contradict each other"; play=yes; shift ;;
      --no-play) [ "$play" != yes ] || die "--play and --no-play contradict each other"; play=no; shift ;;
      -h|--help) usage_tour; return 0 ;;
      *) usage_tour >&2; die "office tour does not know $1; it takes --no-pause, --play and --no-play" ;;
    esac
  done
  if ! can_ask; then
    [ "$play" != yes ] || die "--play opens a shell in the tour office, which needs a terminal; piped input is never asked"
    TOUR_PAUSE=0; play=no
  fi
  require_tools git python3 timeout
  TOUR_DIR="$(mktemp -d "${TMPDIR:-/tmp}/office-tour.XXXXXX")" || die "cannot make a temp directory for the tour"
  TMP_PATHS+=("$TOUR_DIR")
  # Interrupted, the EXIT trap deletes the tour office; say so first.
  trap 'printf "\n[office] the tour was interrupted; deleting the tour office at %s\n" "$TOUR_DIR" >&2; exit 130' INT
  trap 'printf "\n[office] the tour was stopped; deleting the tour office at %s\n" "$TOUR_DIR" >&2; exit 143' TERM HUP
  mkdir -p "$TOUR_DIR/bin" "$TOUR_DIR/config" "$TOUR_DIR/state" || die "cannot furnish $TOUR_DIR"
  cat > "$TOUR_DIR/bin/bale" <<'STUB'
#!/usr/bin/env bash
# office tour's stand-in for bale: the tour never runs the real one, so no
# bale registry anywhere is touched.
printf 'bale, in the office tour: the tour never runs bale; in a real office, office start and office land run it for you\n' >&2
exit 97
STUB
  chmod +x "$TOUR_DIR/bin/bale" && ln -s "$OFFICE_SRC/bin/office" "$TOUR_DIR/bin/office" || die "cannot furnish $TOUR_DIR/bin"
  # The tour's machine settings: an out tray inside the tour, and no
  # clipboard or file manager, so even a start tried in the play shell
  # leaves nothing on this machine.
  mkdir -p "$TOUR_DIR/config/office-src" \
    && printf 'out_tray = %s\nclipboard_command = ""\nopen_command = ""\n' "\"$TOUR_DIR/out-tray\"" \
       > "$TOUR_DIR/config/office-src/machine.toml" || die "cannot furnish $TOUR_DIR/config"
  TOUR_ENV=("OFFICE_ROOT=$TOUR_DIR/office" "XDG_CONFIG_HOME=$TOUR_DIR/config" "XDG_STATE_HOME=$TOUR_DIR/state"
            "PATH=$TOUR_DIR/bin:$PATH" "GIT_CONFIG_GLOBAL=/dev/null" "GIT_CONFIG_NOSYSTEM=1"
            "GIT_AUTHOR_NAME=office tour" "GIT_AUTHOR_EMAIL=tour@office.invalid"
            "GIT_COMMITTER_NAME=office tour" "GIT_COMMITTER_EMAIL=tour@office.invalid" "OFFICE_TOUR=1")

  printf 'office tour: a throwaway office to try the verbs on.\n'
  tour_say "It lives in $TOUR_DIR and is deleted at the end, or as soon as you stop the tour. It never touches your offices, this machine's default office, the walk-in record, or bale: a stand-in bale that refuses everything is first on its PATH."
  if ! tour_office init "$TOUR_DIR/office" --name tour --no-default --no-projects >/dev/null 2>"$TOUR_DIR/init.log"; then
    sed 's/^/  /' "$TOUR_DIR/init.log" >&2
    die "could not build the tour office; it is deleted"
  fi
  if ! tour_furnish; then
    [ -f "$TOUR_DIR/furnish.log" ] && tail -n 15 "$TOUR_DIR/furnish.log" | sed 's/^/  /' >&2
    die "could not furnish the tour office (the lines above say why); it is deleted"
  fi
  tour_say "Built with: office init $TOUR_DIR/office --name tour --no-default --no-projects. That made the spaces (desk, filing cabinet, notepad, suggestion box, drawer), a profile, a survey of this machine and a first commit. The tour then wrote a sample profile (a real office writes its own in its founding session), added a calendar with a gap, opened three folders, noted a line and dropped a slip."
  tour_pause || { tour_end; return 0; }

  tour_step 1 "$total" "walk in"
  tour_show
  tour_say "What it did: showed the room. The header says which office, the time in its timezone, and whether it is founded and current. In flight lists the sessions out (none: the tour sends none). On the desk counts the folders and shows the first ready ones. This week lays the calendar against what happened. Then the last notepad lines and the slips."
  tour_say "The last line, Next, is the one command to type now, with its arguments filled in. It is worked out from the office on every walk-in and never written down: land a session when one is out, start the first ready folder, and so on down to nothing to do."
  tour_say "Why you would type it: it is the front door. Walk in, read the last line, type it."
  tour_pause || { tour_end; return 0; }

  tour_step 2 "$total" "capture a thought"
  tour_show note "the electrician can come Thursday"
  tour_say "What it did: appended a timed line to today's notepad page and committed that page alone. office slip does the same for a friction slip, each its own page in the suggestion box."
  tour_say "Why you would type it: capture is instant and dumb. A phone call, a decision, a thought: one line, no session, and it works even in an office that is unfounded or out of date."
  tour_pause || { tour_end; return 0; }

  tour_step 3 "$total" "start a job"
  tour_show open fix-the-gate --title "Fix the garden gate" --size small
  tour_say "What it did: opened a folder on the desk, numbered one more than any folder before it, status queued, with the fields it was given. On a terminal, office open with nothing after it asks for the title, size, lane and source, and ? explains each; the tour gave them as flags, so nothing was asked."
  tour_say "Why you would type it: a job gets a folder. The folder holds why the job exists, the questions and answers, and the ids of the sessions that worked on it."
  tour_pause || { tour_end; return 0; }

  tour_step 4 "$total" "look at the desk"
  tour_show desk
  tour_say "What it did: put every folder in order, computed from what the folders say. Ready comes small first, then by number. Paint the fence is parked: it waits for folder 1, the porch light. Build a shed is a candidate, an idea not yet queued."
  tour_say "Why you would type it: nobody writes the order. The desk works it out each time, and says what each parked folder waits for."
  tour_pause || { tour_end; return 0; }

  tour_step 5 "$total" "this week"
  tour_show week
  tour_say "What it did: laid this week's plan against the record. Watering the tomatoes was planned and recorded; calling the electrician was planned for earlier this week and nothing was recorded, so it is a gap."
  tour_say "Why you would type it: to see what slipped. A session reads the same calendar and can ask about a gap."
  tour_pause || { tour_end; return 0; }

  porch="$(cd "$TOUR_DIR/office/desk" 2>/dev/null && ls -d -- *-fix-the-porch-light 2>/dev/null | head -n 1)"
  tour_step 6 "$total" "send a session out, and bring it back (shown, not run)"
  printf '\n  $ office start %s --in-office --goal %s\n' "${porch:-FOLDER}" "$(shq "Plan the porch light fix")"
  printf '    (not run: the tour never runs bale)\n'
  tour_say "In a real office this is the command the Next line names for a ready folder. It asks what it was not given (which job, whether the work lands in the office or on one of its projects, and the goal), then packs the session with bale where the work lands, records the session id in the folder, and puts everything to attach in one out tray, ~/out-tray/SID: the request, the doctrine, the office's context and whatever rides with the project. It prints the opener: attach the tray's files to a fresh chat and paste it. You never type a session id or an include list."
  printf '\n  $ office land\n'
  printf '    (not run: the tour never runs bale)\n'
  tour_say "When the response comes back: it finds the session out, runs bale apply in the repo it belongs to (bale asks its own questions, and only you answer them), says how it ended, prints the relay to carry back to the planner, runs the project's after-land steps (an install, say), and records whether the planner ratified the session. You never forget a landing step."
  tour_pause || { tour_end; return 0; }

  printf '\n== That is the tour ==\n'
  tour_say "office help lists every verb by what you want to do, and office VERB --help explains one, with examples."
  if [ -z "$play" ] && can_ask; then
    printf '\n'
    ask ans "Play in the tour office yourself before it goes? A shell where every office command acts on it; exit ends it (--play or --no-play)" "n" 0 \
      "y opens a shell inside the tour office with the tour's settings: office note, open, desk, week, close and the rest act on the tour office, never on yours, and start and land meet the stand-in bale. Type exit to leave; the tour office is deleted then. n ends the tour now."
    case "$ans" in y|Y|yes|Yes|YES) play=yes ;; *) play=no ;; esac
  fi
  if [ "$play" = yes ]; then
    cat > "$TOUR_DIR/tourrc" <<RC
PS1='(office tour) \W \\\$ '
HISTFILE=$(shq "$TOUR_DIR/history")
cd $(shq "$TOUR_DIR/office") || exit 1
printf '%s\n' "You are in the tour office. Every office command acts on it. Type exit to end the tour."
RC
    # A trap that does nothing, not an ignore: commands run in the shell
    # can still be interrupted, and the tour is not.
    trap ':' INT
    env "${TOUR_ENV[@]}" bash --rcfile "$TOUR_DIR/tourrc" -i
    trap 'printf "\n[office] the tour was interrupted; deleting the tour office at %s\n" "$TOUR_DIR" >&2; exit 130' INT
  fi
  tour_end
}

# Walking in: `office` with no arguments.
walk_in() {
  local root name tz report state skew slips notes founded is_founded next_file next
  if ! root="$(resolve_office 2>/dev/null)"; then
    usage
    printf '\nNot inside an office, and this machine has no default office. office init PATH builds one.\n'
    printf '\nNext: office tour  (a throwaway office to try every verb on; then office init PATH builds a real one)\n'
    return 0
  fi
  name="$(helper get "$root/$MANIFEST_REL" office.name --default "(unnamed)")"
  tz="$(office_tz "$root")"
  local tz_named tz_shown
  tz_named="$(office_tz_named "$root")"
  tz_shown="$tz"
  [ "$tz_named" = "$tz" ] || tz_shown="$tz (the floor plan's $tz_named does not resolve here; office status says what fixes it)"
  report="$(skew_report "$root" 2>/dev/null)" && state="$(printf '%s\n' "$report" | head -n 1)" || state="unreadable"
  case "$state" in current|behind|ahead) skew="$state" ;; *) skew=unreadable ;; esac
  if helper profile-check "$root/$PROFILE_REL" "$SHAPE" >/dev/null 2>&1; then founded="founded"; is_founded=yes
  else founded="UNFOUNDED (profile incomplete: office status)"; is_founded=no; fi
  case "$state" in
    current) state="current with office-src $(install_version)" ;;
    behind) state="BEHIND office-src $(install_version) (run: office upgrade)" ;;
    ahead) state="AHEAD of office-src $(install_version) (install a newer office-src)" ;;
    *) state="version stamp unreadable" ;;
  esac
  printf 'The %s office, %s\n' "$name" "$root"
  printf '%s, %s %s. %s; %s.\n\n' "$(TZ="$tz" date '+%A %F')" "$(office_time "$tz")" "$tz_shown" "$founded" "$state"

  # In flight: one line per session open in the projects this office
  # scopes and in the office itself, and the folder that names it; then
  # the desk's count and its first three ready folders. A gate cleared
  # since the last walk-in says so. Never fails the walk-in.
  local desk today since
  today="$(office_date "$tz")"; since="$(last_walk_in "$root")"
  # The Next line is worked out from the same reading as the desk, so
  # bale is asked each question once; it is printed last.
  next_file="$(mktemp)" || die "cannot make a temp file for the walk-in"
  TMP_PATHS+=("$next_file")
  desk="$(reader desk "$root" --walk-in --today "$today" ${since:+--since "$since"} \
    --next-file "$next_file" --skew "$skew" --founded "$is_founded")"
  case $? in
    0|3) printf '%s\n' "$desk" ;;
    *) printf 'In flight:\n  could not be read (OFFICE_DEBUG=1 office for why)\n\nOn the desk:\n  could not be read; office desk says why\n' ;;
  esac
  next="$(head -n 1 "$next_file" 2>/dev/null)"
  [ -n "$next" ] || next="Next: office desk  (the next move could not be worked out; OFFICE_DEBUG=1 office says why)"
  record_walk_in "$root" "$today"
  printf '\nThis week:\n'
  OFFICE_ROOT="$root" cmd_week | sed 's/^/  /'
  printf '\nNotepad, last lines:\n'
  notes="$(helper recent-notes "$root/notepad" 3 2>/dev/null)"
  if [ -n "$notes" ]; then printf '%s\n' "$notes" | sed 's/^/  /'; else printf '  nothing noted yet\n'; fi
  slips="$(find "$root/suggestion-box" -maxdepth 1 -type f -name '*.md' 2>/dev/null | wc -l | tr -d ' ')"
  printf '\nSuggestion box: %s slip(s).\n' "$slips"
  printf '\nFrom here: office start, office land, office note TEXT, office slip TEXT, office open, office close FOLDER, office desk, office week, office projects, office status. office help lists everything by what you want to do; office tour tries it all on a throwaway office.\n'
  printf '\n%s\n' "$next"
}

usage_where() {
  cat <<'USAGE'
usage: office where
Prints the office a command run here acts on: OFFICE_ROOT if set, else the
office around the working directory, else this machine's default.
Examples:
  office where
  cd ~/somewhere && office where
USAGE
}

cmd_where() {
  case "${1:-}" in -h|--help) usage_where; return 0 ;; esac
  [ $# -eq 0 ] || { usage_where >&2; die "office where takes no arguments"; }
  resolve_office; printf '\n'
}

usage_default() {
  cat <<'USAGE'
usage: office default [PATH]
Shows this machine's default office, the one a command acts on outside any
office, or makes PATH the default. The first office init on a machine sets
it. It is kept in ~/.config/office-src/default-office, outside every office.
Examples:
  office default
  office default ~/offices/home
USAGE
}

cmd_default() {
  local root
  case "${1:-}" in -h|--help) usage_default; return 0 ;; esac
  [ $# -le 1 ] || { usage_default >&2; die "office default takes one path"; }
  if [ $# -eq 0 ]; then
    [ -f "$DEFAULT_FILE" ] || die "this machine has no default office (set one with: office default PATH)"
    head -n 1 "$DEFAULT_FILE"; return 0
  fi
  root="$(readlink -f "$1" 2>/dev/null)" || die "no such path: $1"
  [ -f "$root/$MANIFEST_REL" ] || die "not an office (no $MANIFEST_REL): $root"
  mkdir -p "$CONFIG_DIR" && printf '%s\n' "$root" > "$DEFAULT_FILE" || die "cannot write $DEFAULT_FILE"
  log "this machine's default office is now $root"
}

usage_version() {
  cat <<'USAGE'
usage: office version
Prints the installed office-src version, where the install is, and where it
was installed from (the commit and the working copy).
Examples:
  office version
  office --version
USAGE
}

cmd_version() {
  case "${1:-}" in -h|--help) usage_version; return 0 ;; esac
  printf 'office-src %s (%s)\n' "$(install_version)" "$OFFICE_SRC"
  [ -f "$OFFICE_SRC/INSTALLED" ] && sed 's/^/  /' "$OFFICE_SRC/INSTALLED"
  return 0
}

usage_init() {
  cat <<'EOF'
usage: office init [PATH | --path PATH] [--name NAME] [--no-default]
                   [--project [NAME=]PATH]... [--no-projects]
Builds an office at PATH (new or empty): the base spaces, a profile stub,
the version stamp, a first survey and a first commit. Then, on a terminal,
it asks which projects the office watches, one at a time through the same
questions as office projects add, until a plain return. Prints the pack
line for the founding sitting. Makes PATH this machine's default office
when there is none yet, unless --no-default. On a terminal it asks for the
path and the name when it was given no path; ? explains a question. Piped,
it asks nothing. It refuses to build from an install whose catalogs have a
defect.
  --project [NAME=]PATH  a project the office watches: the top of a git repo
                         bale runs in; NAME defaults to the directory's name.
                         Repeatable; each is checked before anything is built.
  --no-projects          ask no project question on a terminal
Examples:
  office init                                  (asks where, the name, and the projects)
  office init ~/offices/home
  office init ~/offices/home --project ~/office-src --project tools=~/bale-src
  office tour                                  (try an office first, on a throwaway one)
EOF
}

usage() {
  cat <<EOF
office-src $(install_version): builds and keeps offices.

usage: office [VERB [args]]

New here? office tour builds a throwaway office, walks you through it, and
deletes it at the end. Nothing real is touched.

What you want to do, and the command for it:

Walk in and look around
  office                    walk in: sessions out, what is ready, this week, the last
                            notes, slips, and the one command to type next
  office desk               in flight, ready in order, parked under what each waits
                            for, candidates, orphaned riders, pending desk moves
  office week               this week's calendar and its gaps
  office sessions FOLDER    the sessions that worked on a job, and how each went
  office projects           the projects this office watches; --ledger, --landed PATH
                            and --versions show what bale records about them

Capture a thought or a friction
  office note TEXT          a timed line on today's notepad page
  office slip TEXT          a friction slip in the suggestion box (--about the office,
                            a tool or a project)

Start a job, and finish one
  office open               a numbered folder on the desk; asks for what it needs
  office close FOLDER       to the filing cabinet: done, or --into N, --split A,B,
                            --retired WHY
  office reopen FOLDER      a done folder back on the desk, history and all

Plan work too big for one folder (the drafting table)
  office blueprint open SLUG
                            draft a blueprint: one arc, its charter and its
                            decomposition into folders
  office blueprint ratify ID
                            freeze its charter, pointing at the ratifying words
  office blueprint close ID send out the sitting that writes its close report
  office moves              apply the desk moves a sitting wrote: open, queue, gate,
                            close or retire folders, each ticked with its folder
  office rider add TITLE    small work with a named carrier, on the riders page
  office rider carry N      moved into the folder that carries it (--folder M)
  office rider consumed N SID
                            consumed at a session
  office riders             the riders, where each is, and the orphans;
                            --forecast PATH... the ones a pack would carry
  office agenda add TEXT    a question for a sitting to rule on
  office rulings [ID]       the rulings ledger, or one ruling with its amendments;
                            --check resolves every citation
  office evidence [N]       the evidence ledger, or one entry with its occurrences
  office watches            the watches and where each stands; --all with the closed
  office watches check      run every query watch over its window, and the standing
                            lines; --record appends a fired record for each that fired
  office digest             write the sitting-open page and print it: versions, since
                            the last sitting, watches, standing lines, desk, agenda

Send a session out
  office start [FOLDER]     asks which job, where the work lands and the goal; packs
                            the session, records it in the folder, and puts every file
                            to attach in one out tray beside the opener

Bring one back
  office land [SID]         applies the response in the right repo, says how it ended,
                            hands you the relay, runs the after-land steps, records the
                            planner's ratification, and ends saying how each step went;
                            given a read-only sitting's id, ends the sitting

Look after the office
  office init PATH          build an office; asks which projects it watches
  office projects add       watch a project; set NAME says what rides with its sessions
                            and what runs after one lands
  office status             version, the install against its source, profile, survey
                            age, timezone, hung items, catalogs, folders, filed pages,
                            bale (read-only)
  office survey             rewrite floor-plan/survey.md and say what changed
  office upgrade            take a breaking release: dry run, then one commit
  office where              the office a command here acts on
  office default [PATH]     show or set this machine's default office
  office version            the installed version
  office tour               try every verb on a throwaway office

Why the office, if you already use bale: you never type a session id, never
assemble an include list, and never forget a landing step. start knows the
folder's lane, the forecast, the work class and what rides with each project;
land knows which repo, which response, and what to do after it applies. bale
stays visible: start and land run bale's own pack, open, apply, retry and
unlock (only to end a read-only sitting the office sent out), bale
asks its own questions and only you answer them, office start --help and
office land --help name the bale commands they run, and OFFICE_DEBUG=1 shows
every bale call. Any bale command still works by hand beside the office.

office help VERB (or office VERB --help) explains one verb, with examples.
A command acts on OFFICE_ROOT if set, else the office around the working
directory, else this machine's default. The doctrine is
$DOCTRINE_DIR/OFFICE.md.
EOF
}

# The verbs office help VERB explains, each through its own --help.
HELP_VERBS=" init survey status upgrade where default note slip open desk week close reopen sessions projects start land tour version moves blueprint rider riders agenda rulings evidence watches digest "
# The two-word verbs, as office help VERB WORD (or VERB-WORD, the key
# share/verbs.toml gives them) explains them.
HELP_PAIRS=" blueprint-open blueprint-ratify blueprint-close rider-add rider-carry rider-consumed agenda-add watches-check "

# office help [VERB [WORD]]: everything by task, or one verb's own help.
cmd_help() {
  [ $# -gt 0 ] || { usage; return 0; }
  local pair="${1}${2:+-$2}"
  case "$HELP_PAIRS" in
    *" $pair "*) main "${pair%%-*}" "${pair#*-}" --help; return ;;
  esac
  [ $# -le 1 ] || { usage >&2; die "office help knows no verb $*; the list above is every verb"; }
  case "$HELP_VERBS" in
    *" $1 "*) main "$1" --help ;;
    *) usage >&2; die "office help knows no verb $1; the list above is every verb" ;;
  esac
}

main() {
  if [ $# -eq 0 ]; then walk_in; return; fi
  local verb="$1"; shift
  case "$verb" in
    init) cmd_init "$@" ;;
    survey) cmd_survey "$@" ;;
    status) cmd_status "$@" ;;
    upgrade) cmd_upgrade "$@" ;;
    where) cmd_where "$@" ;;
    default) cmd_default "$@" ;;
    note) cmd_note "$@" ;;
    slip) cmd_slip "$@" ;;
    open) cmd_open "$@" ;;
    desk) cmd_desk "$@" ;;
    week) cmd_week "$@" ;;
    close) cmd_close "$@" ;;
    reopen) cmd_reopen "$@" ;;
    sessions) cmd_sessions "$@" ;;
    projects) cmd_projects "$@" ;;
    start) cmd_start "$@" ;;
    land) cmd_land "$@" ;;
    version|--version|-V) cmd_version "$@" ;;
    help|--help|-h) cmd_help "$@" ;;
    tour) cmd_tour "$@" ;;
    moves) cmd_moves "$@" ;;
    blueprint) cmd_blueprint "$@" ;;
    rider) cmd_rider "$@" ;;
    riders) cmd_riders "$@" ;;
    agenda) cmd_agenda "$@" ;;
    rulings) cmd_rulings "$@" ;;
    evidence) cmd_evidence "$@" ;;
    watches) cmd_watches "$@" ;;
    digest) cmd_digest "$@" ;;
    *) usage >&2; die "unknown verb: $verb" ;;
  esac
}

main "$@"
