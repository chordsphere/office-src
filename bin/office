#!/usr/bin/env bash
# office: builds and keeps offices. See doctrine/OFFICE.md in the install.
#
# Everything the command reads about itself (templates, doctrine, space
# catalog, profile shape, migrations) comes from the install this script
# sits in, found through its own path, so an upgraded install upgrades
# every office's tools without touching any office.

set -uo pipefail

OFFICE_SRC="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)"
HELPER="$OFFICE_SRC/lib/office_helper.py"
# The read side: the only code that runs bale, through the --json
# surfaces share/bale-consumption.toml declares.
READER="$OFFICE_SRC/lib/office_bale.py"
CATALOG="$OFFICE_SRC/share/spaces.toml"
VERBS="$OFFICE_SRC/share/verbs.toml"
SHAPE="$OFFICE_SRC/share/profile-shape.toml"
TEMPLATES="$OFFICE_SRC/templates"
MIGRATIONS="$OFFICE_SRC/migrations"
DOCTRINE_DIR="$OFFICE_SRC/doctrine"
CONFIG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/office-src"
DEFAULT_FILE="$CONFIG_DIR/default-office"
MANIFEST_REL="floor-plan/manifest.toml"
SURVEY_REL="floor-plan/survey.md"
PROFILE_REL="profile.md"
BALE_TOML_REL="bale.toml"
STEP_TIMEOUT="${OFFICE_STEP_TIMEOUT:-10}"
VERSION_TIMEOUT=5

log()   { printf '[office] %s\n' "$*" >&2; }
warn()  { printf '[office] warning: %s\n' "$*" >&2; }
die()   { printf '[office] error: %s\n' "$*" >&2; exit 1; }
debug() { [ "${OFFICE_DEBUG:-0}" = "1" ] && printf '[office] debug: %s\n' "$*" >&2; return 0; }

helper() { python3 "$HELPER" "$@"; }
# -B: the reader imports the helper, and an install is never written to.
reader() { python3 -B "$READER" "$@"; }

# Single-quote a word for a printed command line.
shq() { printf "'%s'" "$(printf '%s' "$1" | sed "s/'/'\\\\''/g")"; }

# Escape a value for the right-hand side of a sed s|||.
sed_rhs() { printf '%s' "$1" | sed 's/[&|\\]/\\&/g'; }

# --- asking --------------------------------------------------------------------
#
# A verb is a wizard on a terminal (doctrine section 7): it asks for what
# it was not given, every question names its flag twin, `?` explains the
# field rather than refusing it, and an answer the field does not take is
# explained and asked again. Piped input is never asked anything; the
# verb refuses what it was not given and names the flag.

can_ask() { [ -t 0 ]; }

# ask VAR PROMPT DEFAULT REQUIRED HELP [FIELD]
# PROMPT names the flag twin. DEFAULT is taken on a plain return; with no
# default a plain return skips, unless REQUIRED is 1. HELP is what `?`
# prints; FIELD, when given, is the folder field the answer is checked
# and normalized as (the helper's closed vocabularies).
ask() {
  local __var="$1" prompt="$2" def="$3" required="$4" help="$5" field="${6:-}" answer norm shown="$2"
  if [ -n "$def" ]; then shown="$shown [$def]"
  elif [ "$required" != "1" ]; then shown="$shown [return skips]"; fi
  while :; do
    IFS= read -r -p "$shown: " answer || die "no answer given to: $prompt"
    answer="$(printf '%s' "$answer" | sed 's/^[[:space:]]*//; s/[[:space:]]*$//')"
    if [ "$answer" = "?" ]; then printf '%s\n' "$help" | fold -s -w 76 | sed 's/^/  /' >&2; continue; fi
    if [ -z "$answer" ]; then
      if [ -n "$def" ]; then answer="$def"
      elif [ "$required" = "1" ]; then printf '  an answer is needed here; ? explains it\n' >&2; continue
      else printf -v "$__var" '%s' ""; return 0; fi
    fi
    if [ -z "$field" ]; then printf -v "$__var" '%s' "$answer"; return 0; fi
    if norm="$(helper normalize-field "$field" -- "$answer" 2>&1)"; then printf -v "$__var" '%s' "$norm"; return 0; fi
    printf '  %s\n' "${norm#\[office\] error: }" >&2
  done
}

field_help() { helper field-help "$1" 2>/dev/null | sed 's/^[^:]*: //'; }

# ask_field VAR FIELD FLAG QUESTION [DEFAULT] [REQUIRED]
ask_field() {
  ask "$1" "$4 ($3)" "${5:-}" "${6:-0}" "$(field_help "$2")" "$2"
}

# check_field VAR FIELD FLAG: normalize a value given as a flag. A value
# the field does not take is explained; on a terminal the field is then
# asked (the return is 2, so the caller asks), piped it refuses.
check_field() {
  local __var="$1" field="$2" flag="$3" norm
  [ -n "${!__var}" ] || return 0
  if norm="$(helper normalize-field "$field" -- "${!__var}" 2>&1)"; then printf -v "$__var" '%s' "$norm"; return 0; fi
  norm="${norm#\[office\] error: }"
  if can_ask; then
    printf '[office] %s %s: %s\n' "$flag" "$(shq "${!__var}")" "$norm" >&2
    printf -v "$__var" '%s' ""
    return 2
  fi
  die "$flag: $norm"
}

TMP_PATHS=()
cleanup_tmp() { [ "${#TMP_PATHS[@]}" -gt 0 ] && rm -rf "${TMP_PATHS[@]}"; return 0; }
trap cleanup_tmp EXIT

install_version() {
  local v
  v="$(head -n 1 "$OFFICE_SRC/VERSION" 2>/dev/null)" || die "install has no VERSION file: $OFFICE_SRC"
  [ -n "$v" ] || die "install VERSION is empty: $OFFICE_SRC/VERSION"
  printf '%s' "$v"
}

require_tools() {
  local t
  for t in "$@"; do
    command -v "$t" >/dev/null 2>&1 || die "$t is required and not on PATH"
  done
}

# --- finding the office ----------------------------------------------------

# Walk up from a directory to the nearest office, the way git finds .git.
find_office_from() {
  local dir
  dir="$(readlink -f "$1" 2>/dev/null)" || return 1
  while :; do
    if [ -f "$dir/$MANIFEST_REL" ]; then printf '%s' "$dir"; return 0; fi
    [ "$dir" = "/" ] && return 1
    dir="$(dirname "$dir")"
  done
}

# OFFICE_ROOT, then the office around the working directory, then this
# machine's default. Each source is reported so a surprise is traceable.
resolve_office() {
  local root
  if [ -n "${OFFICE_ROOT:-}" ]; then
    [ -f "$OFFICE_ROOT/$MANIFEST_REL" ] || die "OFFICE_ROOT is not an office (no $MANIFEST_REL): $OFFICE_ROOT"
    debug "office from OFFICE_ROOT: $OFFICE_ROOT"
    readlink -f "$OFFICE_ROOT"; return 0
  fi
  if root="$(find_office_from "$PWD")"; then
    debug "office found above the working directory: $root"
    printf '%s' "$root"; return 0
  fi
  if [ -f "$DEFAULT_FILE" ]; then
    root="$(head -n 1 "$DEFAULT_FILE")"
    [ -f "$root/$MANIFEST_REL" ] || die "this machine's default office is gone or not an office: $root (set another with: office default PATH)"
    log "not inside an office; using this machine's default, $root"
    printf '%s' "$root"; return 0
  fi
  die "not inside an office and this machine has no default office (set one with: office default PATH)"
}

# --- version skew ----------------------------------------------------------

# Prints the skew state and any pending migrations (helper format).
skew_report() {
  local root="$1" office_v
  office_v="$(helper stamp "$root/$MANIFEST_REL" migrated_to)" || die "cannot read the version stamp in $root/$MANIFEST_REL"
  helper skew "$office_v" "$(install_version)" "$MIGRATIONS" || die "cannot plan migrations from $MIGRATIONS"
}

# Refuse loudly on skew in either direction; commands that act on the
# office's shape call this before touching it.
require_current() {
  local root="$1" report state office_v
  report="$(skew_report "$root")" || exit 1
  state="$(printf '%s\n' "$report" | head -n 1)"
  office_v="$(helper stamp "$root/$MANIFEST_REL" migrated_to)"
  case "$state" in
    current) return 0 ;;
    ahead) die "this office was migrated to $office_v, past the installed office-src $(install_version); install $office_v or later before using it" ;;
    behind)
      log "this office is at $office_v and office-src $(install_version) has breaking releases it has not taken:"
      printf '%s\n' "$report" | tail -n +2 | cut -f1,4 | sed 's/\t/: /; s/^/[office]   /' >&2
      die "run: office upgrade" ;;
    *) die "unexpected skew state: $state" ;;
  esac
}

warn_if_unfounded() {
  local root="$1" out
  out="$(helper profile-check "$root/$PROFILE_REL" "$SHAPE")"
  case $? in
    0) return 0 ;;
    3) warn "this office is unfounded: its profile is incomplete (office status)" ;;
    *) warn "could not check the profile against the required shape" ;;
  esac
}

# --- survey ----------------------------------------------------------------

fact() { printf '%s\t%s\t%s\n' "$1" "$2" "$3"; }

tool_version() {
  local t="$1" out
  if ! command -v "$t" >/dev/null 2>&1; then printf 'not found'; return; fi
  case "$t" in
    R) out="$(timeout "$VERSION_TIMEOUT" R --version 2>&1 | head -n 1)" ;;
    *) out="$(timeout "$VERSION_TIMEOUT" "$t" --version 2>&1 | head -n 1)" ;;
  esac
  [ -n "$out" ] || out="no version output (or timed out after ${VERSION_TIMEOUT}s)"
  printf '%s (%s)' "$out" "$(command -v "$t")"
}

gather_facts() {
  local root="$1" os tz mounts n step name out
  fact Survey surveyed_at "$(date -u +%Y-%m-%dT%H:%M:%SZ)"
  fact Survey office_root "$root"

  os="$(. /etc/os-release 2>/dev/null && printf '%s' "${PRETTY_NAME:-unknown}")"
  fact Machine hostname "$(hostname 2>/dev/null || printf 'unknown')"
  fact Machine os "${os:-unknown (no /etc/os-release)}"
  fact Machine kernel "$(uname -srm 2>/dev/null)"
  if grep -qi microsoft /proc/version 2>/dev/null; then fact Machine class "WSL"
  elif [ -f /.dockerenv ]; then fact Machine class "container"
  else fact Machine class "host (not WSL, no container marker)"; fi
  fact Machine login_shell "${SHELL:-unset}"
  fact Machine bash "$BASH_VERSION"

  for t in bale git python3 R quarto node; do fact Tools "$t" "$(tool_version "$t")"; done

  tz="$(cat /etc/timezone 2>/dev/null || readlink /etc/localtime 2>/dev/null | sed 's#.*/zoneinfo/##')"
  fact Timezone system "${tz:-unknown}"
  fact Timezone TZ "${TZ:-unset}"
  fact Timezone zone_offset "$(date '+%Z %z')"

  # Mount points by name only: /proc/mounts is a list, never a walk.
  mounts="$(awk '$3 !~ /^(proc|sysfs|devtmpfs|devpts|tmpfs|cgroup2?|mqueue|securityfs|debugfs|tracefs|pstore|bpf|hugetlbfs|configfs|fusectl|autofs|binfmt_misc|nsfs|rpc_pipefs|efivarfs|ramfs|squashfs)$/ {print $2 "\t" $3}' /proc/mounts 2>/dev/null | sort -u)"
  n="$(printf '%s\n' "$mounts" | grep -c . || true)"
  if [ "$n" -eq 0 ]; then
    fact Mounts none "no /proc/mounts or no real filesystems listed"
  else
    printf '%s\n' "$mounts" | head -n 40 | while IFS=$'\t' read -r target fstype; do fact Mounts "$target" "$fstype"; done
    [ "$n" -gt 40 ] && fact Mounts truncated "$n mount points, showing 40"
  fi

  if command -v bale >/dev/null 2>&1; then
    fact bale on_path "$(command -v bale)"
    fact bale install "$(readlink -f "$(command -v bale)")"
  else
    fact bale on_path "not found"
  fi
  fact office-src install "$OFFICE_SRC"
  fact office-src version "$(install_version)"
  fact office-src on_path "$(command -v office 2>/dev/null || printf 'not on PATH')"

  if [ -d "$root/drawer/survey" ]; then
    for step in "$root"/drawer/survey/*; do
      [ -f "$step" ] || continue
      name="$(basename "$step")"
      if [ ! -x "$step" ]; then fact "Office step: $name" skipped "not executable"; continue; fi
      out="$(cd "$root" && timeout "$STEP_TIMEOUT" "$step" 2>&1)"
      case $? in
        0) ;;
        124) fact "Office step: $name" error "timed out after ${STEP_TIMEOUT}s" ;;
        *) fact "Office step: $name" error "exited nonzero" ;;
      esac
      n=0
      while IFS= read -r line && [ "$n" -lt 40 ]; do
        n=$((n + 1))
        if [[ "$line" =~ ^([^:]+):[[:space:]]*(.*)$ ]]; then
          fact "Office step: $name" "${BASH_REMATCH[1]}" "${BASH_REMATCH[2]}"
        elif [ -n "$line" ]; then
          fact "Office step: $name" "line $n" "$line"
        fi
      done <<< "$out"
      [ "$(printf '%s\n' "$out" | wc -l)" -gt 40 ] && fact "Office step: $name" truncated "output capped at 40 lines"
    done
  fi
}

# Write the survey page; print the change report on stdout.
write_survey() {
  local root="$1" facts
  facts="$(mktemp)" || die "cannot make a temp file for the survey"
  gather_facts "$root" > "$facts"
  if ! helper survey-render --facts "$facts" --previous "$root/$SURVEY_REL" --out "$root/$SURVEY_REL"; then
    rm -f "$facts"; die "could not write $root/$SURVEY_REL"
  fi
  rm -f "$facts"
}

# --- pack lines --------------------------------------------------------------

slugify() { printf '%s' "$1" | tr '[:upper:]' '[:lower:]' | tr -c 'a-z0-9' '-' | sed 's/--*/-/g; s/^-//; s/-$//'; }

# The doctrine rides as a context tarball made in the install; include
# groups only pull paths inside the repo being packed.
doctrine_context_cmd() {
  printf '(cd %s && bale pack --context)' "$(shq "$DOCTRINE_DIR")"
}

# The founding session is scoped, so one trip lands the profile, the
# occupant's words from the founding conversation as a notepad page, and
# the office's real timezone. The include group in bale.toml pulls the
# hung items (profile.md, the survey) once floor-plan is included.
founding_line() {
  local root="$1" name="$2" slug
  slug="$(slugify "$name")-founding"
  printf '%s && cd %s && bale pack --slug %s --include floor-plan --write %s notepad floor-plan --no-readme %s\n' \
    "$(doctrine_context_cmd)" "$(shq "$root")" "$slug" "$PROFILE_REL" \
    "$(shq "Found the $name office: write its profile with the occupant section by section, file the occupant's words from this conversation as a notepad page, and set the office's real timezone in the floor plan and the profile's Site section, asking the occupant rather than trusting the machine clock")"
}

# Only office upgrade writes the version stamp. The renovation session
# does the work; a re-run of office upgrade checks the migration's
# declaration and stamps the office when it holds.
renovation_line() {
  local root="$1" version="$2" goal="$3" landed="$4" slug
  slug="upgrade-$(slugify "$version")"
  printf '%s && cd %s && bale pack --slug %s --no-readme %s\n' \
    "$(doctrine_context_cmd)" "$(shq "$root")" "$slug" \
    "$(shq "Renovate this office for office-src $version: $goal Done means $landed. Leave the version stamp alone; office upgrade checks this and stamps the office.")"
}

# --- verbs -------------------------------------------------------------------

# The install's own catalogs, checked before anything is built from
# them: office status reports a defect and exits 0, office init refuses.
require_sound_install() {
  local defects rc
  defects="$(helper catalog-check "$VERBS" "$CATALOG" 2>/dev/null)"; rc=$?
  case $rc in
    0) debug "the install's catalogs hold: $VERBS, $CATALOG" ;;
    3) log "the install at $OFFICE_SRC has a defect in its catalogs (share/verbs.toml, share/spaces.toml):"
       printf '%s\n' "$defects" | sed 's/^/[office]   /' >&2
       die "refusing to build an office from a defective install; fix office-src and run install.sh again" ;;
    *) die "could not check the install's catalogs ($VERBS, $CATALOG); refusing to build an office from them" ;;
  esac
}

cmd_init() {
  local path="" name="" set_default=1 parent root anc
  while [ $# -gt 0 ]; do
    case "$1" in
      --name) [ $# -ge 2 ] || die "--name needs a value"; name="$2"; shift 2 ;;
      --path) [ $# -ge 2 ] || die "--path needs a value"; [ -z "$path" ] || die "init takes one path"; path="$2"; shift 2 ;;
      --no-default) set_default=0; shift ;;
      -h|--help) usage_init; return 0 ;;
      -*) usage_init >&2; die "office init does not know $1; it takes a path, --name and --no-default" ;;
      *) [ -z "$path" ] || die "init takes one path"; path="$1"; shift ;;
    esac
  done
  require_tools git python3 timeout
  require_sound_install
  if [ -z "$path" ]; then
    can_ask || { usage_init >&2; die "init needs a path: office init PATH (or --path PATH); piped input is never asked"; }
    ask path "Where to build the office, a new or empty directory (--path)" "" 1 \
      "The directory the office is built in: new, or empty. It becomes its own git repo, so it may not sit inside another repo or another office, and it may not be your home directory itself."
    case "$path" in "~"|"~/"*) path="$HOME${path#\~}" ;; esac
    if [ -z "$name" ]; then
      ask name "Name for the office (--name)" "$(basename "$(readlink -m "$path")")" 0 \
        "What the office is called on the walk-in and in its founding session's slug: letters, digits, dot, dash or underscore."
    fi
  fi

  root="$(readlink -m "$path")"
  [ "$root" != "/" ] || die "refusing to make an office of /"
  [ "$root" != "$(readlink -m "$HOME")" ] || die "refusing to make an office of the home directory itself; bale refuses it too"
  if [ -f "$root/$MANIFEST_REL" ]; then die "already an office: $root"; fi
  anc="$root"; while [ ! -e "$anc" ]; do anc="$(dirname "$anc")"; done
  [ -d "$anc" ] || die "not a directory: $anc"
  if parent="$(find_office_from "$anc")"; then die "$root would sit inside the office at $parent"; fi
  if git -C "$anc" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
    die "$root is inside the git repo at $(git -C "$anc" rev-parse --show-toplevel); an office is its own repo"
  fi
  if [ -e "$root" ] && [ -n "$(ls -A "$root" 2>/dev/null)" ]; then
    die "$root exists and is not empty; init builds into an empty or new directory, and things move in after"
  fi
  git var GIT_COMMITTER_IDENT >/dev/null 2>&1 || die "git has no identity to commit with; set it once with: git config --global user.name 'Your Name' && git config --global user.email you@example.com"

  [ -n "$name" ] || name="$(basename "$root")"
  [[ "$name" =~ ^[A-Za-z0-9][A-Za-z0-9._-]*$ ]] || die "office name must be letters, digits, dot, dash or underscore: $name"
  local version built_at tz sp
  version="$(install_version)"
  built_at="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
  tz="$(cat /etc/timezone 2>/dev/null || readlink /etc/localtime 2>/dev/null | sed 's#.*/zoneinfo/##')"
  tz="${tz:-UTC}"

  log "building office '$name' at $root from office-src $version"
  mkdir -p "$root/floor-plan" || die "cannot create $root"
  helper render-manifest "$CATALOG" --name "$name" --version "$version" --built-at "$built_at" --timezone "$tz" > "$root/$MANIFEST_REL" \
    || die "could not write the floor plan; $root is partial, remove it with: rm -rf $(printf '%q' "$root")"
  while IFS= read -r sp; do
    case "$sp" in
      "$PROFILE_REL"|floor-plan) ;;
      *) mkdir -p "$root/$sp" && : > "$root/$sp/.keep" || die "cannot create space $sp" ;;
    esac
    debug "space: $sp"
  done < <(helper base-spaces "$CATALOG")
  sed -e "s|{{name}}|$(sed_rhs "$name")|g" -e "s|{{root}}|$(sed_rhs "$root")|g" -e "s|{{timezone}}|$(sed_rhs "$tz")|g" \
      -e "s|{{machine}}|$(sed_rhs "$(hostname 2>/dev/null || printf unknown)")|g" -e "s|{{date}}|${built_at%%T*}|g" \
      "$TEMPLATES/profile.md" > "$root/$PROFILE_REL" || die "could not write the profile stub"
  printf '.bale/\n' > "$root/.gitignore"

  log "first survey"
  write_survey "$root" | sed 's/^/[office] survey: /' >&2
  # After the survey, so the survey page is on disk to be a pull.
  helper render-bale-toml "$root/$MANIFEST_REL" --root "$root" > "$root/$BALE_TOML_REL" || die "could not write $BALE_TOML_REL"
  debug "wrote $BALE_TOML_REL: the include group that pulls the hung items"

  git -C "$root" init -q -b main || die "git init failed in $root"
  git -C "$root" add -A && git -C "$root" commit -q -m "office init: $name (office-src $version)" \
    || die "the first commit failed; $root is partial, remove it with: rm -rf $(printf '%q' "$root")"
  log "committed the skeleton, the profile stub, bale.toml and the first survey"

  if [ "$set_default" = "1" ] && [ ! -f "$DEFAULT_FILE" ]; then
    mkdir -p "$CONFIG_DIR" && printf '%s\n' "$root" > "$DEFAULT_FILE" && log "made $root this machine's default office"
  fi
  log "the office is unfounded until its profile is written; the line below packs the founding session"
  log "attach $DOCTRINE_DIR/.bale/outbox/context-doctrine.tar.gz beside the request it opens"
  founding_line "$root" "$name"
}

cmd_survey() {
  local commit=1 root
  while [ $# -gt 0 ]; do
    case "$1" in
      --no-commit) commit=0; shift ;;
      -h|--help) printf 'usage: office survey [--no-commit]\n'; return 0 ;;
      *) die "unknown option for survey: $1" ;;
    esac
  done
  require_tools python3 timeout
  root="$(resolve_office)" || exit 1
  require_current "$root"
  warn_if_unfounded "$root"
  log "surveying $(hostname 2>/dev/null) for $root"
  local report
  report="$(write_survey "$root")" || exit 1
  printf '%s\n' "$report"
  if [ "$commit" = "1" ] && git -C "$root" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
    git -C "$root" add -- "$SURVEY_REL"
    if git -C "$root" diff --cached --quiet -- "$SURVEY_REL"; then
      log "survey page unchanged in git"
    else
      git -C "$root" commit -q -m "office survey: $(printf '%s\n' "$report" | grep -c '^\(added\|removed\|changed\) ' || true) facts changed" -- "$SURVEY_REL" || die "could not commit $SURVEY_REL"
      log "committed $SURVEY_REL"
    fi
  fi
}

cmd_status() {
  local root report state office_v built profile rc
  root="$(resolve_office)" || exit 1
  report="$(skew_report "$root")" || exit 1
  state="$(printf '%s\n' "$report" | head -n 1)"
  office_v="$(helper stamp "$root/$MANIFEST_REL" migrated_to)"
  built="$(helper stamp "$root/$MANIFEST_REL" built_from)"
  printf 'office:     %s\n' "$root"
  printf 'name:       %s\n' "$(helper get "$root/$MANIFEST_REL" office.name --default "(unnamed)")"
  printf 'install:    office-src %s at %s\n' "$(install_version)" "$OFFICE_SRC"
  printf 'built from: %s\n' "$built"
  printf 'migrated:   %s\n' "$office_v"
  case "$state" in
    current) printf 'skew:       none\n' ;;
    ahead)   printf 'skew:       AHEAD; office migrated past this install; install %s or later\n' "$office_v" ;;
    behind)  printf 'skew:       BEHIND; run: office upgrade\n'
             printf '%s\n' "$report" | tail -n +2 | cut -f1,2,4 | sed 's/\t/ (/; s/\t/): /; s/^/  pending:  /' ;;
  esac
  profile="$(helper profile-check "$root/$PROFILE_REL" "$SHAPE")"; rc=$?
  case $rc in
    0) printf 'profile:    complete\n' ;;
    3) printf 'profile:    INCOMPLETE; this office is unfounded\n'
       printf '%s\n' "$profile" | sed 's/^/  /' ;;
    *) printf 'profile:    could not be checked\n' ;;
  esac
  printf 'survey:     %s\n' "$(helper survey-age "$root/$SURVEY_REL" 2>/dev/null || printf 'unreadable')"
  local drift
  drift="$(helper include-group-check "$root/$MANIFEST_REL" "$root/$BALE_TOML_REL" "$root")"
  case $? in
    0) printf 'hung items: bale.toml include group matches the floor plan\n' ;;
    3) printf 'hung items: bale.toml differs from the floor plan\n'; printf '%s\n' "$drift" | sed 's/^/  /' ;;
    *) printf 'hung items: could not compare bale.toml with the floor plan\n' ;;
  esac
  # The install's catalogs, not the office's: a verb declared unattended
  # with no landing, or a hung page that is also filed, is a defect in
  # office-src that every office on this install should hear about.
  local defects
  defects="$(helper catalog-check "$VERBS" "$CATALOG" 2>/dev/null)"
  case $? in
    0) printf 'catalogs:   every unattended session kind declares a landing; no hung page is filed\n' ;;
    3) printf 'catalogs:   DEFECT in the install at %s (share/verbs.toml, share/spaces.toml)\n' "$OFFICE_SRC"
       printf '%s\n' "$defects" | sed 's/^/  /' ;;
    *) printf 'catalogs:   could not be checked\n' ;;
  esac
  # The desk's facts: every folder's status agrees with its History's
  # last state-changing line, and the numbers are minted once each.
  helper folder-check "$root" 2>/dev/null
  case $? in 0|3) ;; *) printf 'folders:    could not be checked\n' ;; esac
  # Filed pages only grow at their end: git's history of every filed
  # page the floor plan lists, the net for a hand edit that went
  # through neither bale nor a script.
  helper filed-check "$root" 2>/dev/null
  case $? in 0|3) ;; *) printf 'filed:      could not be checked (is the office a git repo?)\n' ;; esac
  # The read side: which bale is installed against the version the
  # office's reads were written for, and whether each project in scope
  # can be read. Lines, never a refusal.
  reader status-lines "$root" || printf 'bale:       the read side could not be checked\n'
}

# Run planned migrations in a target office. Arguments: target, plan file.
# Prints the applied lines to stdout. Returns 0 when every migration ran,
# 10 when it stopped at a renovation (whose line is the last printed),
# 1 on failure.
run_migrations() {
  local target="$1" plan="$2" version kind action summary landed filed changed
  # Filed paper, one pathspec per line: a whole space, or the paths a
  # part-filed space lists (a path may hold a glob, which git expands;
  # a path that does not exist yet matches nothing and refuses nothing).
  mapfile -t filed < <(helper spaces "$target/$MANIFEST_REL" filed)
  while IFS=$'\t' read -r version kind action summary landed; do
    [ -n "$version" ] || continue
    if [ "$kind" = "renovation" ]; then
      local unmet
      if unmet="$(helper landed "$version" "$MIGRATIONS" "$(install_version)" "$target")"; then
        log "migration $version is a renovation and its declaration holds: $landed"
        helper set-migrated "$target/$MANIFEST_REL" "$version" || return 1
        printf 'verified\t%s\t%s (renovation, checked)\n' "$version" "$summary"
        continue
      fi
      [ -n "$unmet" ] || { log "could not check renovation $version"; return 1; }
      printf '%s\n' "$unmet" | sed "s/^/[office]   $version not landed yet: /" >&2
      printf 'renovation\t%s\t%s\t%s\t%s\n' "$version" "$action" "$summary" "$landed"
      return 10
    fi
    log "migration $version: $summary"
    if ! (cd "$target" && OFFICE_ROOT="$target" OFFICE_MIGRATION="$version" OFFICE_SRC="$OFFICE_SRC" timeout 300 bash "$MIGRATIONS/$action") >&2; then
      log "migration $version failed in $target"
      return 1
    fi
    if [ "${#filed[@]}" -gt 0 ]; then
      changed="$(git -C "$target" status --porcelain -- "${filed[@]}")"
      if [ -n "$changed" ]; then
        log "migration $version touched filed paper, which is never rewritten:"
        printf '%s\n' "$changed" | sed 's/^/[office]   /' >&2
        return 1
      fi
    fi
    helper set-migrated "$target/$MANIFEST_REL" "$version" || return 1
    printf 'applied\t%s\t%s\n' "$version" "$summary"
  done < "$plan"
  return 0
}

cmd_upgrade() {
  local dry=0 root report state office_v plan scratch rc applied msg
  while [ $# -gt 0 ]; do
    case "$1" in
      --dry-run) dry=1; shift ;;
      -h|--help) printf 'usage: office upgrade [--dry-run]\n'; return 0 ;;
      *) die "unknown option for upgrade: $1" ;;
    esac
  done
  require_tools git python3 timeout
  root="$(resolve_office)" || exit 1
  report="$(skew_report "$root")" || exit 1
  state="$(printf '%s\n' "$report" | head -n 1)"
  office_v="$(helper stamp "$root/$MANIFEST_REL" migrated_to)"
  case "$state" in
    ahead) die "this office was migrated to $office_v, past the installed office-src $(install_version); install $office_v or later" ;;
    current) log "nothing to upgrade: office at $office_v, office-src $(install_version), no migrations pending"; return 0 ;;
  esac
  git -C "$root" rev-parse --is-inside-work-tree >/dev/null 2>&1 || die "$root is not a git repo; an upgrade lands as a commit"
  [ -z "$(git -C "$root" status --porcelain)" ] || die "$root has uncommitted changes; commit them first so the upgrade is one clean commit"

  plan="$(mktemp)" && scratch="$(mktemp -d)" || die "cannot make temp space for the upgrade"
  TMP_PATHS+=("$plan" "$scratch")
  printf '%s\n' "$report" | tail -n +2 > "$plan"
  log "upgrading $root from $office_v to office-src $(install_version); pending:"
  cut -f1,2,4 "$plan" | sed 's/\t/ (/; s/\t/): /; s/^/[office]   /' >&2

  log "dry run on a scratch clone"
  git clone -q "$root" "$scratch/office" || die "could not clone $root for the dry run"
  run_migrations "$scratch/office" "$plan" > "$scratch/dry.out"; rc=$?
  [ "$rc" -eq 1 ] && die "the dry run failed; $root was not touched"
  log "dry run passed"
  if [ "$dry" = "1" ]; then
    log "dry run only; nothing changed in $root"
    return 0
  fi

  run_migrations "$root" "$plan" > "$scratch/real.out"; rc=$?
  if [ "$rc" -eq 1 ]; then
    git -C "$root" reset -q --hard HEAD && git -C "$root" clean -qfd
    die "the upgrade failed after the dry run passed; $root was reset to its last commit"
  fi
  applied="$(grep -E '^(applied|verified)' "$scratch/real.out" || true)"
  if [ -n "$applied" ]; then
    msg="$scratch/msg"
    {
      printf 'office upgrade: %s to %s\n\n' "$office_v" "$(helper stamp "$root/$MANIFEST_REL" migrated_to)"
      printf '%s\n' "$applied" | cut -f2,3 | sed 's/\t/: /; s/^/- /'
    } > "$msg"
    git -C "$root" add -A && git -C "$root" commit -q -F "$msg" || die "could not commit the upgrade in $root"
    log "committed the upgrade:"
    sed 's/^/[office]   /' "$msg" >&2
  fi
  if [ "$rc" -eq 10 ]; then
    local line version goal landed
    line="$(grep '^renovation' "$scratch/real.out" | head -n 1)"
    version="$(printf '%s' "$line" | cut -f2)"; goal="$(printf '%s' "$line" | cut -f3)"; landed="$(printf '%s' "$line" | cut -f5)"
    log "migration $version needs judgment, so it is a renovation session, not a script; the line below packs it"
    log "when that session has landed, run office upgrade again: it checks the renovation and stamps the office"
    log "attach $DOCTRINE_DIR/.bale/outbox/context-doctrine.tar.gz beside the request it opens"
    renovation_line "$root" "$version" "$goal" "$landed"
  fi
}

# --- the everyday verbs --------------------------------------------------------
#
# Script verbs: the office command alone, in seconds, no session and no
# network. Each commits exactly the paths it touched, so the occupant's
# other work in progress is never swept into a verb's commit.

# The office's timezone from its floor plan, checked against the zone
# database; a bad or missing zone falls back to UTC, loudly.
office_tz() {
  local root="$1" tz
  tz="$(helper get "$root/$MANIFEST_REL" office.timezone --default UTC 2>/dev/null)" || tz="UTC"
  if [ "$tz" != "UTC" ] && [ ! -e "/usr/share/zoneinfo/$tz" ]; then
    warn "the floor plan's timezone '$tz' is not in /usr/share/zoneinfo; using UTC"
    tz="UTC"
  fi
  printf '%s' "$tz"
}

office_date() { TZ="$1" date +%F; }
office_time() { TZ="$1" date +%H:%M; }

# Commit only the named paths. Returns 1 (after a warning) when there is
# no repo or git refuses; the change on disk stands either way.
commit_paths() {
  local root="$1" msg="$2"; shift 2
  if ! git -C "$root" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
    warn "$root is not a git repo; nothing committed"; return 1
  fi
  git -C "$root" add -A -- "$@" 2>/dev/null || { warn "git add failed for: $*"; return 1; }
  if git -C "$root" diff --cached --quiet -- "$@"; then debug "nothing to commit for: $*"; return 0; fi
  if ! git -C "$root" commit -q -m "$msg" -- "$@" >/dev/null 2>&1; then
    warn "git could not commit ($msg); the change is on disk, uncommitted"; return 1
  fi
  debug "committed: $msg"
}

# Skew for capture: warn, never refuse. Capture is instant and dumb.
warn_on_skew() {
  local root="$1" report state
  report="$(skew_report "$root" 2>/dev/null)" || { warn "could not read this office's version stamp"; return 0; }
  state="$(printf '%s\n' "$report" | head -n 1)"
  case "$state" in
    behind) warn "this office is behind office-src $(install_version) (run: office upgrade); noting anyway" ;;
    ahead) warn "this office was migrated past office-src $(install_version); noting anyway" ;;
  esac
  return 0
}

has_space() {  # has_space ROOT KEY: is the space in this office's floor plan?
  helper get "$1/$MANIFEST_REL" "spaces.$2.path" >/dev/null 2>&1
}

# A folder by exact name, by a unique part of its name, or by its number
# (`folder N`, or N alone when no folder has that number and the digits
# are part of a name), in one space.
find_folder() {
  local root="$1" space="$2" want="$3" d rel matches=()
  [ -n "$want" ] || die "name a folder"
  if [ -d "$root/$space/$want" ]; then printf '%s' "$want"; return 0; fi
  if [[ "$want" =~ ^(folder[[:space:]]+|#)?[0-9]+$ ]]; then
    if rel="$(helper folder-by-number "$root" "$want" 2>/dev/null)"; then
      [ "${rel%%/*}" = "$space" ] || die "$want is $rel, not in $space/"
      printf '%s' "${rel#*/}"; return 0
    fi
    [[ "$want" =~ ^[0-9]+$ ]] || die "no $want on the desk or in the filing cabinet"
  fi
  for d in "$root/$space"/*/; do
    [ -d "$d" ] || continue
    d="$(basename "$d")"
    case "$d" in *"$want"*) matches+=("$d") ;; esac
  done
  case "${#matches[@]}" in
    1) printf '%s' "${matches[0]}" ;;
    0) die "no folder matching '$want' in $space/" ;;
    *) die "'$want' matches ${#matches[@]} folders in $space/: ${matches[*]}" ;;
  esac
}

# On a terminal, a folder a verb was not given: the folders it could
# mean, then the question. Piped, the verb refuses before this.
ask_folder() {
  local __var="$1" root="$2" space="$3" verb="$4" d n=0 number
  printf 'Folders in %s/:\n' "$space" >&2
  for d in "$root/$space"/*/; do
    [ -d "$d" ] || continue
    n=$((n + 1))
    number=""
    [ -f "$d/folder.md" ] && number="$(helper folder-facts "$d/folder.md" 2>/dev/null | sed -n 's/^number\t//p')"
    printf '  %s%s\n' "${number:+folder $number  }" "$(basename "$d")" >&2
  done
  [ "$n" -gt 0 ] || die "nothing in $space/ to $verb"
  ask "$__var" "Which folder: a unique part of its name, or folder N (office $verb FOLDER)" "" 1 \
    "The folder to $verb: its directory name, any part of it that names only one folder, or its number as folder N."
}

cmd_note() {
  local root tz day now page text line n=0
  case "${1:-}" in -h|--help) printf 'usage: office note TEXT...   (or lines on stdin)\n'; return 0 ;; esac
  root="$(resolve_office)" || exit 1
  warn_on_skew "$root"
  warn_if_unfounded "$root"
  if [ $# -gt 0 ]; then text="$*"
  elif [ ! -t 0 ]; then text="$(cat)"
  else die "nothing to note: give the text as arguments or on stdin"; fi
  [ -n "${text//[[:space:]]/}" ] || die "nothing to note: the text is empty"
  tz="$(office_tz "$root")"; day="$(office_date "$tz")"; now="$(office_time "$tz")"
  page="notepad/$day.md"
  mkdir -p "$root/notepad" || die "cannot create $root/notepad"
  if [ ! -f "$root/$page" ]; then
    helper render-template "$TEMPLATES/notepad-page.md" "date=$day" "title=notes" > "$root/$page" \
      || die "could not start $page"
    printf '\n' >> "$root/$page"
  fi
  text="$(printf '%s' "$text" | helper ascii-escape)"
  while IFS= read -r line; do
    [ -n "${line//[[:space:]]/}" ] || continue
    printf -- '- %s %s\n' "$now" "$line" >> "$root/$page" || die "could not append to $page"
    n=$((n + 1))
  done <<< "$text"
  log "noted $n line(s) in $page"
  # The notepad is filed paper: before committing, the page must be its
  # committed bytes with lines added at the end (doctrine section 15).
  # The words stay on disk either way; nothing is lost, only not filed.
  local why
  why="$(helper append-check "$root" "$page")"
  case $? in
    0) ;;
    3) die "$page differs from its committed bytes other than at its end ($why); the line is on disk but not committed, and office status names the page" ;;
    *) die "could not check $page against its committed bytes; the line is on disk but not committed" ;;
  esac
  commit_paths "$root" "office note: $day $now" "$page" || true
}

usage_slip() {
  cat <<'USAGE'
usage: office slip [TEXT...] [--about WHAT]   (or the text on stdin)
Drops a friction slip in the suggestion box: one new page,
suggestion-box/DATE-SLUG.md, committed on its own. --about names what the
slip is about: the office, a tool (bale, office-src) or one of the
office's projects, so it can be carried to that tool's project. On a
terminal it asks for what it was not told; piped, it never asks. Like
office note, it works in an unfounded office and one behind or ahead of
the installed tool, and only warns.
USAGE
}

# A slip is about the office, a tool or a project: one word, the way a
# project is named.
slip_about_choices() {
  local root="$1" names
  names="$(helper project-names "$root/$MANIFEST_REL" 2>/dev/null | paste -sd, - | sed 's/,/, /g')"
  printf 'office, bale, office-src%s' "${names:+, $names}"
}

cmd_slip() {
  local about="" text="" words=() root tz day now title slug page n=1 base
  while [ $# -gt 0 ]; do
    case "$1" in
      --about) [ $# -ge 2 ] || die "--about needs what the slip is about: office, a tool or a project"; about="$2"; shift 2 ;;
      -h|--help) usage_slip; return 0 ;;
      --) shift; words+=("$@"); break ;;
      -*) usage_slip >&2; die "office slip does not know $1; it takes the text and --about" ;;
      *) words+=("$1"); shift ;;
    esac
  done
  root="$(resolve_office)" || exit 1
  warn_on_skew "$root"
  warn_if_unfounded "$root"
  if [ "${#words[@]}" -gt 0 ]; then text="${words[*]}"
  elif [ ! -t 0 ]; then text="$(cat)"
  else
    ask text "What caused friction, in a line or two (office slip TEXT)" "" 1 \
      "Where it hurt and what would remove it, in your words. It lands as its own page in the suggestion box; cleanup and renovation sessions read the box."
  fi
  [ -n "${text//[[:space:]]/}" ] || die "nothing to slip: the text is empty"
  if [ -z "$about" ] && can_ask; then
    ask about "What it is about: $(slip_about_choices "$root") (--about)" "office" 0 \
      "The office itself, a tool the office uses (bale, office-src), or one of this office's projects. A slip about a tool says so, so it can be carried to that tool's project."
  fi
  if [ -n "$about" ] && [[ ! "$about" =~ ^[A-Za-z0-9][A-Za-z0-9._-]*$ ]]; then
    die "--about takes one word, the office, a tool or a project ($(slip_about_choices "$root")), not $(shq "$about")"
  fi
  [ -n "$about" ] || log "the slip does not say what it is about (--about office, a tool or a project says so)"
  tz="$(office_tz "$root")"; day="$(office_date "$tz")"; now="$(office_time "$tz")"
  # The slug from the words as typed, as office open makes one: an
  # escape is no part of a file name.
  slug="$(short_slug "$(printf '%s\n' "$text" | grep -m 1 '[^[:space:]]')")"; [ -n "$slug" ] || slug="slip"
  text="$(printf '%s' "$text" | helper ascii-escape)"
  title="$(printf '%s\n' "$text" | grep -m 1 '[^[:space:]]' | tr -s '[:space:]' ' ' | sed 's/^ //; s/ $//')"
  [ "${#title}" -le 72 ] || title="${title:0:69}..."
  base="suggestion-box/$day-$slug"; page="$base.md"
  while [ -e "$root/$page" ]; do n=$((n + 1)); page="$base-$n.md"; done
  mkdir -p "$root/suggestion-box" || die "cannot create $root/suggestion-box"
  helper render-template "$TEMPLATES/suggestion-slip.md" "title=$title" "about=$about" "dropped=$day $now" "text=$text" \
    > "$root/$page" || { rm -f "$root/$page"; die "could not write $page"; }
  log "slipped $page${about:+ (about $about)}"
  commit_paths "$root" "office slip: $(basename "$page" .md)${about:+ (about $about)}" "$page" || true
  printf '%s\n' "$page"
}

usage_open() {
  cat <<'USAGE'
usage: office open [SLUG] [--title TITLE] [--size SIZE] [--lane LANE] [--source SOURCE]
                   [--class CLASS] [--blueprint ID] [--linked GATE]... [--after GATE]...
                   [--serializes-after GATE]... [--consumer GATE]...
                   [--candidate | --filed --sid SID] [--thread < pasted-thread]
Starts a folder on the desk: numbered one more than the highest number on
the desk and in the filing cabinet, status queued, the day it was queued,
and every field it is given. --candidate opens it as a candidate; --filed
--sid SID files it straight into the filing cabinet, done at that session.
On a terminal it asks for the title, size, lane and source it was not
given: a plain return skips one, and ? explains it. Piped, it never asks.
The fields, and what each takes:
USAGE
  helper field-help all | grep -v -e '^status:' -e '^queued:' -e '^number:' -e '^sid:' | fold -s -w 76 | sed 's/^/  /'
}

# The one-writer rule: a verb that mints a folder number refuses while
# the office's own bale registry shows an open session whose forecast
# holds where the number lands. An office bale has never run in has no
# registry, and nothing to refuse; a registry that cannot be read is
# said loudly and does not stop capture.
require_one_writer() {
  local root="$1" target="$2" out rc
  out="$(reader writers "$root" "$target")"; rc=$?
  case $rc in
    0) debug "one-writer rule: no open session in this office's registry holds $target" ;;
    3) printf '%s\n' "$out" | sed 's/^/[office]   /' >&2
       die "an open session holds $target, so no folder number is minted beside it (the one-writer rule); open the folder once that session is applied or closed" ;;
    *) warn "bale's registry in this office could not be read (the line above says why); minting without the one-writer check" ;;
  esac
}

# A slug made from a title: at most 40 characters, cut at a word.
short_slug() {
  local s
  s="$(slugify "$1")"
  if [ "${#s}" -gt 40 ]; then
    s="${s:0:41}"; s="${s%-*}"; s="${s:0:40}"
  fi
  printf '%s' "$s"
}

cmd_open() {
  local slug="" title="" thread=0 candidate=0 filed=0 sid="" size="" lane="" source="" class="" blueprint=""
  local after=() serializes=() consumer=() linked=() root tz day name folder number space status verb text asked=0
  local raw_title=""
  local v i
  while [ $# -gt 0 ]; do
    case "$1" in
      --title|--size|--lane|--source|--class|--blueprint|--sid|--after|--serializes-after|--consumer|--linked)
        [ $# -ge 2 ] || die "$1 needs a value (office open --help explains it)"
        case "$1" in
          --title) title="$2" ;; --size) size="$2" ;; --lane) lane="$2" ;; --source) source="$2" ;;
          --class) class="$2" ;; --blueprint) blueprint="$2" ;; --sid) sid="$2" ;;
          --after) after+=("$2") ;; --serializes-after) serializes+=("$2") ;;
          --consumer) consumer+=("$2") ;; --linked) linked+=("$2") ;;
        esac
        shift 2 ;;
      --thread) thread=1; shift ;;
      --candidate) candidate=1; shift ;;
      --filed) filed=1; shift ;;
      -h|--help) usage_open; return 0 ;;
      -*) usage_open >&2; die "office open does not know $1; the flags above are what it takes" ;;
      *) [ -z "$slug" ] || die "open takes one slug (quote a title with --title)"; slug="$1"; shift ;;
    esac
  done
  [ "$candidate" = 0 ] || [ "$filed" = 0 ] || die "--candidate and --filed are two different births; give one"
  [ -z "$sid" ] || [ "$filed" = 1 ] || die "--sid goes with --filed: a folder born done at that session"
  root="$(resolve_office)" || exit 1
  require_current "$root"
  warn_if_unfounded "$root"

  # Flags first: a value a field does not take is explained, then asked
  # on a terminal and refused when piped.
  raw_title="$title"
  check_field title title --title; check_field size size --size; check_field lane lane --lane
  check_field source source --source; check_field sid sid --sid
  check_field class class --class || ask_field class class --class "Class: bale's work class for its sessions" "" 1
  check_field blueprint blueprint --blueprint || ask_field blueprint blueprint --blueprint "Blueprint id, YYYY-MM-DD-slug" "" 1
  for i in "${!after[@]}"; do v="${after[$i]}"; check_field v after --after || ask_field v after --after "Gate: what must be done first" "" 1; after[$i]="$v"; done
  for i in "${!serializes[@]}"; do v="${serializes[$i]}"; check_field v serializes-after --serializes-after || ask_field v serializes-after --serializes-after "Serializes after which folder" "" 1; serializes[$i]="$v"; done
  for i in "${!consumer[@]}"; do v="${consumer[$i]}"; check_field v consumer --consumer || ask_field v consumer --consumer "Consumer that will carry it" "" 1; consumer[$i]="$v"; done
  for i in "${!linked[@]}"; do v="${linked[$i]}"; check_field v linked --linked || ask_field v linked --linked "Linked folder" "" 1; linked[$i]="$v"; done

  if can_ask && [ "$thread" = 0 ]; then
    # The wizard: what matters to the desk, in four answers at most.
    if [ -z "$title" ]; then
      ask raw_title "Title, in a few words (--title)" "$slug" 1 "$(field_help title)"; asked=1
      title="$(helper normalize-field title -- "$raw_title")" || die "--title: the title is empty"
    fi
    if [ -z "$size" ]; then ask_field size size --size "Size: small, medium or high"; asked=1; fi
    if [ -z "$lane" ]; then ask_field lane lane --lane "Lane: the project and paths, as project: paths"; asked=1; fi
    if [ -z "$source" ]; then ask_field source source --source "Source: where the job came from"; asked=1; fi
    if [ "$filed" = 1 ] && [ -z "$sid" ]; then ask_field sid sid --sid "Session id it was done in" "" 1; asked=1; fi
    [ "$asked" = 0 ] || log "other fields take flags: --class, --blueprint, --after, --serializes-after, --consumer, --linked (office open --help explains each)"
  else
    [ -n "$slug" ] || [ -n "$title" ] || die "open needs a slug or a title: office open SLUG, or --title TITLE; piped input is never asked"
    [ "$filed" = 0 ] || [ -n "$sid" ] || die "--filed needs --sid SID, the session the job was done in; piped input is never asked"
  fi
  [ -n "$title" ] || title="$slug"
  # The slug comes from the words as typed, before the title was kept
  # as one ASCII line: an escape is no part of a directory name.
  [ -n "$slug" ] || slug="$(short_slug "${raw_title:-$title}")"
  slug="$(slugify "$slug")"; [ -n "$slug" ] || die "the slug has no letters or digits (give one: office open SLUG)"

  tz="$(office_tz "$root")"; day="$(office_date "$tz")"
  name="$day-$slug"
  [ ! -e "$root/desk/$name" ] || die "already on the desk: desk/$name"
  [ ! -e "$root/filing-cabinet/$name" ] || die "already filed: filing-cabinet/$name (office reopen $name)"
  if [ "$filed" = 1 ]; then
    space=filing-cabinet; status=done; verb=done; text="office open --filed, done at $sid"
  elif [ "$candidate" = 1 ]; then
    space=desk; status=candidate; verb=candidate; text="office open --candidate"
  else
    space=desk; status=queued; verb=queued; text="office open"
  fi
  folder="$space/$name"
  require_one_writer "$root" "$space"
  number="$(helper next-number "$root")" || die "no folder number could be minted; the line above says why"

  local args=("title=$title" "number=$number" "status=$status" "queued=$day" "class=$class" "size=$size"
              "lane=$lane" "source=$source" "blueprint=$blueprint" "history=$day $verb: $text")
  for v in "${linked[@]}"; do args+=("linked=$v"); done
  for v in "${after[@]}"; do args+=("after=$v"); done
  for v in "${serializes[@]}"; do args+=("serializes_after=$v"); done
  for v in "${consumer[@]}"; do args+=("consumer=$v"); done
  mkdir -p "$root/$folder" || die "cannot create $folder"
  helper render-template "$TEMPLATES/folder.md" "${args[@]}" > "$root/$folder/folder.md" \
    || { rm -rf "${root:?}/$folder"; die "could not write $folder/folder.md"; }
  if [ "$filed" = 1 ]; then
    helper record-session "$root/$folder/folder.md" "$sid" >/dev/null || die "could not record $sid in $folder/folder.md"
  fi
  if [ "$thread" = "1" ]; then
    [ ! -t 0 ] || die "--thread reads the pasted thread on stdin"
    { printf '# Thread that started this job\n\nPasted when the folder was opened, verbatim.\n\n'; helper ascii-escape; } > "$root/$folder/thread.md" \
      || die "could not write $folder/thread.md"
    log "seeded $folder/thread.md from stdin"
  fi
  log "opened $folder as folder $number, $status"
  commit_paths "$root" "office open: $name (folder $number)" "$folder" || true
  printf '%s\n' "$folder"
}

# The desk's groups: In flight, Ready, Parked, Candidates (doctrine
# section 5). A gate that cleared since the last walk-in says so.
cmd_desk() {
  local root tz since rc
  case "${1:-}" in -h|--help) printf 'usage: office desk\n  In flight, Ready (in order), Parked (under what each waits for), Candidates\n'; return 0 ;; esac
  root="$(resolve_office)" || exit 1
  tz="$(office_tz "$root")"
  since="$(last_walk_in "$root")"
  reader desk "$root" --today "$(office_date "$tz")" ${since:+--since "$since"}; rc=$?
  case $rc in
    0) return 0 ;;
    3) warn "some of this office's projects could not be read; In flight says which"; return 0 ;;
    *) die "could not render the desk" ;;
  esac
}

# The day of the last walk-in, kept on this machine outside the office
# (the walk-in only reads the office), so the desk can say which gates
# cleared since. Empty when there is none.
walk_in_file() {
  printf '%s/office-src/walk-ins/%s' "${XDG_STATE_HOME:-$HOME/.local/state}" "$(printf '%s' "$1" | sha256sum | cut -c1-16)"
}

last_walk_in() {
  local f
  f="$(walk_in_file "$1")"
  [ -f "$f" ] || { debug "no walk-in recorded for $1 on this machine"; return 0; }
  head -n 1 "$f" | grep -E '^[0-9]{4}-[0-9]{2}-[0-9]{2}$' || debug "unreadable walk-in record: $f"
  return 0
}

record_walk_in() {
  local f
  f="$(walk_in_file "$1")"
  { mkdir -p "$(dirname "$f")" && printf '%s\n' "$2" > "$f"; } 2>/dev/null || debug "could not record this walk-in in $f"
  return 0
}

cmd_week() {
  local root tz
  case "${1:-}" in -h|--help) printf 'usage: office week\n'; return 0 ;; esac
  root="$(resolve_office)" || exit 1
  if ! has_space "$root" calendar; then
    printf 'this office has no calendar. A renovation adds one: an office session that adds the calendar space to the floor plan (doctrine section 5).\n'
    return 0
  fi
  tz="$(office_tz "$root")"
  helper week "$root/calendar" --today "$(office_date "$tz")" --now "$(office_time "$tz")" --tz "$tz" \
    || die "could not read the calendar in $root/calendar"
}

# Moving a folder is not rewriting it: the bytes move, git keeps the
# history, and anything uncommitted in the folder moves with it.
move_folder_dir() {
  local root="$1" from="$2" to="$3" name="$4"
  [ ! -e "$root/$to/$name" ] || die "$to/$name already exists; not overwriting it"
  mkdir -p "$root/$to" || die "cannot create $to"
  mv "$root/$from/$name" "$root/$to/$name" || die "could not move $from/$name to $to/"
  log "moved $from/$name to $to/"
}

# folder_fact FOLDER_MD KEY: status, number, history (1 or 0) or sids.
folder_fact() {
  helper folder-facts "$1" 2>/dev/null | sed -n "s/^$2\t//p"
}

# One History line, and the status line when given, in a folder; each
# says what it did, and a folder from before the field block is left
# as it is and said so at debug.
folder_event() {
  local md="$1" day="$2" verb="$3" text="$4" status="${5:-}" out
  out="$(helper folder-event "$md" --day "$day" --verb "$verb" --text "$text" ${status:+--status "$status"})" \
    || die "could not write the $verb line in $md"
  while IFS= read -r line; do
    case "$line" in
      no\ *) debug "$(basename "$(dirname "$md")"): $line" ;;
      *) log "$(basename "$(dirname "$md")"): $line" ;;
    esac
  done <<< "$out"
}

# The folder a closing job lives on in: an existing folder other than
# the one closing, whose own job has not ended elsewhere (an absorbed,
# split or retired folder carries nothing further).
successor_folder() {
  local root="$1" closing="$2" ref="$3" rel status
  rel="$(helper folder-by-number "$root" "$ref")" || return 1
  [ "${rel#*/}" != "$closing" ] || die "a folder is not absorbed or split into itself"
  status="$(folder_fact "$root/$rel/folder.md" status)"
  case "$status" in
    absorbed|split|retired) die "$(helper normalize-field linked -- "$ref") is $status itself, so the job cannot live on in it; name the folder it went to" ;;
  esac
  printf '%s' "$rel"
}

usage_close() {
  cat <<'USAGE'
usage: office close [FOLDER] [--into N | --split A,B | --retired WHY]
Moves a folder from the desk to the filing cabinet, writing its status and
a History line. Plain close is done. --into N: absorbed into folder N;
--split A,B: split into those folders; --retired WHY: retired, and why.
Each successor gets a note line pointing back. FOLDER is its name, a
unique part of it, or folder N; on a terminal it is asked for when
missing.
USAGE
}

cmd_close() {
  local want="" into="" split="" retired="" set=0 root name md tz day status verb text number me
  local succ=() rels=() paths=() parts=() s rel i label
  while [ $# -gt 0 ]; do
    case "$1" in
      --into|--split|--retired)
        [ $# -ge 2 ] || die "$1 needs a value (office close --help)"
        set=$((set + 1))
        case "$1" in --into) into="$2" ;; --split) split="$2" ;; --retired) retired="$2" ;; esac
        shift 2 ;;
      -h|--help) usage_close; return 0 ;;
      -*) usage_close >&2; die "office close does not know $1" ;;
      *) [ -z "$want" ] || die "close takes one folder"; want="$1"; shift ;;
    esac
  done
  [ "$set" -le 1 ] || die "--into, --split and --retired are three different endings; give one"
  root="$(resolve_office)" || exit 1
  require_current "$root"
  if [ -z "$want" ]; then
    can_ask || { usage_close >&2; die "name a folder: office close FOLDER; piped input is never asked"; }
    ask_folder want "$root" desk close
  fi
  name="$(find_folder "$root" desk "$want")" || exit 1
  md="$root/desk/$name/folder.md"
  [ -f "$md" ] || die "desk/$name has no folder.md"
  status="$(folder_fact "$md" status)"; number="$(folder_fact "$md" number)"
  case "$status" in done|absorbed|split|retired) die "desk/$name says status $status, which belongs in the filing cabinet; office status names what disagrees" ;; esac
  me="${number:+folder $number}"; me="${me:-$name}"
  [ ! -e "$root/filing-cabinet/$name" ] || die "filing-cabinet/$name already exists; not overwriting it, and nothing was written"
  if [ -n "$into" ]; then
    rel="$(successor_folder "$root" "$name" "$into")" || exit 1
    succ=("$(helper normalize-field linked -- "$into")"); rels=("$rel")
    verb=absorbed; status=absorbed; text="into ${succ[0]}"
  elif [ -n "$split" ]; then
    IFS=',' read -r -a parts <<< "$split"
    [ "${#parts[@]}" -ge 2 ] || die "--split names the two or more folders the job was cut into, as A,B"
    for s in "${parts[@]}"; do
      rel="$(successor_folder "$root" "$name" "$s")" || exit 1
      case " ${rels[*]} " in *" $rel "*) die "--split names $(helper normalize-field linked -- "$s") twice" ;; esac
      succ+=("$(helper normalize-field linked -- "$s")"); rels+=("$rel")
    done
    verb=split; status=split
    text="into folders $(printf '%s\n' "${succ[@]}" | sed 's/^folder //' | paste -sd, - | sed 's/,/, /g')"
  elif [ -n "$retired" ]; then
    [ -n "${retired//[[:space:]]/}" ] || die "--retired needs the reason, in a few words"
    verb=retired; status=retired; text="$(printf '%s' "$retired" | helper ascii-escape)"
  else
    verb=done; status=done; text="office close"
  fi
  tz="$(office_tz "$root")"; day="$(office_date "$tz")"
  # The status and History lines go in while the folder is on the desk,
  # which is live; the filing cabinet only ever gains lines.
  folder_event "$md" "$day" "$verb" "$text" "$status"
  move_folder_dir "$root" desk filing-cabinet "$name"
  paths=("desk/$name" "filing-cabinet/$name")
  label="$me"; [ -z "$number" ] || label="$me ($name)"
  for i in "${!rels[@]}"; do
    if [ "$verb" = absorbed ]; then
      folder_event "$root/${rels[$i]}/folder.md" "$day" note "absorbed $label"
    else
      folder_event "$root/${rels[$i]}/folder.md" "$day" note "split from $label"
    fi
    paths+=("${rels[$i]}/folder.md")
  done
  if [ "$verb" = done ]; then
    commit_paths "$root" "office close: $name (done)" "${paths[@]}" || true
  else
    commit_paths "$root" "office close: $name ($verb: $text)" "${paths[@]}" || true
  fi
}

cmd_reopen() {
  local want="" root name md status tz day
  case "${1:-}" in -h|--help) printf 'usage: office reopen [FOLDER]\nBrings a done folder back to the desk, history and all: status open, and a reopened line.\n'; return 0 ;; esac
  want="${1:-}"
  [ $# -le 1 ] || die "reopen takes one folder"
  root="$(resolve_office)" || exit 1
  require_current "$root"
  if [ -z "$want" ]; then
    can_ask || die "name a folder: office reopen FOLDER; piped input is never asked"
    ask_folder want "$root" filing-cabinet reopen
  fi
  name="$(find_folder "$root" filing-cabinet "$want")" || exit 1
  md="$root/filing-cabinet/$name/folder.md"
  status=""
  [ -f "$md" ] && status="$(folder_fact "$md" status)"
  case "$status" in
    absorbed|split|retired)
      die "filing-cabinet/$name was $status; the job lives on elsewhere or not at all, so it is not reopened (its History names where; office open starts a new folder)" ;;
  esac
  move_folder_dir "$root" filing-cabinet desk "$name"
  if [ -f "$root/desk/$name/folder.md" ]; then
    tz="$(office_tz "$root")"; day="$(office_date "$tz")"
    folder_event "$root/desk/$name/folder.md" "$day" reopened "office reopen" open
  fi
  commit_paths "$root" "office reopen: $name" "filing-cabinet/$name" "desk/$name" || true
}

# Record which sessions worked on a folder's job. The id comes from
# bale, never typed: `bale pack --json ... | office sessions FOLDER -`
# reads the pack report. With the first id a candidate or queued folder
# records, the folder is open: status open and an opened line.
record_session() {
  local root="$1" folder="$2" sid="$3" words="$4" day="$5" out rc
  out="$(helper record-session "$root/$folder/folder.md" "$sid" ${words:+--words "$words"} ${day:+--day "$day"})"; rc=$?
  case $rc in
    0) log "recorded $sid in $folder"
       printf '%s\n' "$out" | tail -n +2 | sed "s|^|[office] $(basename "$folder"): |" >&2
       commit_paths "$root" "office sessions: $sid in $(basename "$folder")" "$folder/folder.md" || true ;;
    4) log "$sid is already recorded in $folder" ;;
    *) die "could not record $sid in $folder/folder.md" ;;
  esac
}

usage_sessions() {
  cat <<'USAGE'
usage: office sessions [FOLDER] [SID | -] [-m WORDS] [--ratified [--except TEXT]]
  office sessions FOLDER               list the recorded sessions, with what bale records
  office sessions FOLDER SID|-         record one; - reads a bale pack --json report on stdin.
                                       The first one a candidate or queued folder records opens it.
  office sessions FOLDER SID|- --ratified [--except TEXT]
                                       the planner ratified that session's judgment calls,
                                       except TEXT (what was corrected, and where it went)
USAGE
}

cmd_sessions() {
  local want="" source="" words="" ratified=0 except="" has_except=0 root space name sid tz day out
  while [ $# -gt 0 ]; do
    case "$1" in
      -m) [ $# -ge 2 ] || die "-m needs a few words"; words="$2"; shift 2 ;;
      --ratified) ratified=1; shift ;;
      --except) [ $# -ge 2 ] || die "--except needs what was corrected, and where it went"; except="$2"; has_except=1; shift 2 ;;
      -h|--help) usage_sessions; return 0 ;;
      -?*) [ "$1" = "-" ] || { usage_sessions >&2; die "office sessions does not know $1"; }
           if [ -z "$want" ]; then die "name the folder before -"; elif [ -z "$source" ]; then source="-"; else die "too many arguments"; fi; shift ;;
      *) if [ -z "$want" ]; then want="$1"; elif [ -z "$source" ]; then source="$1"; else die "too many arguments"; fi; shift ;;
    esac
  done
  [ "$has_except" = 0 ] || [ "$ratified" = 1 ] || die "--except goes with --ratified"
  root="$(resolve_office)" || exit 1
  if [ -z "$want" ]; then
    can_ask || { usage_sessions >&2; die "name a folder: office sessions FOLDER; piped input is never asked"; }
    ask_folder want "$root" desk "record sessions in"
  fi
  space=desk
  if ! name="$( (find_folder "$root" desk "$want") 2>/dev/null)"; then
    space=filing-cabinet; name="$(find_folder "$root" filing-cabinet "$want")" || exit 1
  fi
  [ -f "$root/$space/$name/folder.md" ] || die "$space/$name has no folder.md"
  if [ -z "$source" ] && [ "$ratified" = 1 ]; then
    can_ask || die "--ratified needs the session: office sessions FOLDER SID --ratified; piped input is never asked"
    ask_field source sid "SID" "Session id to ratify" "" 1
  fi
  if [ -z "$source" ]; then
    helper folder-summary "$root/$space/$name/folder.md" "$TEMPLATES/folder.md" >/dev/null || die "could not read $space/$name/folder.md"
    # Each recorded id, then what bale's records say about it: outcome,
    # dates, claims beside verdicts, exchange rounds. Rendered on every
    # run and never written into the folder.
    reader folder-sessions "$root" "$root/$space/$name/folder.md"
    case $? in
      0) return 0 ;;
      3) die "some of this office's projects could not be read; the lines above say why" ;;
      *) die "could not render the sessions of $space/$name" ;;
    esac
  fi
  if [ "$source" = "-" ]; then
    sid="$(helper pack-sid)" || die "no session id recorded in $space/$name"
  else
    sid="$source"
  fi
  tz="$(office_tz "$root")"; day="$(office_date "$tz")"
  if [ "$ratified" = 1 ]; then
    [ -z "$words" ] || die "-m goes with recording a session, not with --ratified"
    if [ "$has_except" = 1 ]; then
      out="$(helper ratify "$root/$space/$name/folder.md" "$sid" --day "$day" --except "$except")" || exit 1
    else
      out="$(helper ratify "$root/$space/$name/folder.md" "$sid" --day "$day")" || exit 1
    fi
    log "$name: $out"
    commit_paths "$root" "office sessions: $sid ratified in $name" "$space/$name/folder.md" || true
    return 0
  fi
  record_session "$root" "$space/$name" "$sid" "$words" "$day"
}

# --- sending a session out ----------------------------------------------------
#
# office start: one command from a folder to an out tray. It asks which
# job, whether the work lands in the office or on a project, and the
# goal, and derives the rest: the slug from the folder, the forecast from
# its lane, the work class from its class. Then the read side packs the
# context that rides and the session itself, records the session id in
# the folder, and gathers every file to attach into one directory.

MACHINE_FILE="$CONFIG_DIR/machine.toml"

# A per-machine setting, outside every office: KEY from machine.toml, or
# the default given. An empty value in the file turns a desktop step off.
machine_setting() {
  if [ -f "$MACHINE_FILE" ]; then
    helper get "$MACHINE_FILE" "$1" --default "$2" 2>/dev/null && return 0
    warn "$MACHINE_FILE could not be read; using the default for $1"
  fi
  printf '%s\n' "$2"
}

on_wsl() { grep -qi microsoft /proc/version 2>/dev/null; }

usage_start() {
  cat <<'USAGE'
usage: office start [FOLDER] [--in-office | --on PROJECT] [--goal TEXT] [--slug SLUG]
                    [--write PATH]... [--include PATH]... [--brief FILE] [--read-only]
Packs a session for a folder on the desk and gathers everything to attach
into one out tray: the request, the doctrine, and whatever rides with the
work (on a project, the office's context and the project's ride-alongs;
in the office, the project its lane names, when it names one). Records
the session id in the folder and prints the opener to paste.
  FOLDER         the job: its name, a unique part of it, or folder N;
                 on a terminal it is asked for, and new opens one through
                 office open's own questions
  --in-office    the work lands in the office (packed from the office,
                 forecasting the folder and the notepad)
  --on PROJECT   the work lands in one of the office's projects (packed
                 from the project, with the office's context beside it)
  --goal TEXT    the session's goal, one sentence
  --slug SLUG    default: the folder's name without its date, and
                 -office after it for a session in the office
  --write PATH   what the session will change, relative to where it is
                 packed; for a project, default: the paths in the folder's
                 lane, else the whole repo
  --include PATH more to ship as context (a project ships its whole repo
                 by default)
  --brief FILE   a brief to ship as the request's README.md
  --read-only    forecast nothing: a sitting that lands nothing itself
The out tray is ~/out-tray/SID unless this machine's
~/.config/office-src/machine.toml sets out_tray. On WSL the tray opens in
Explorer and the opener goes to the clipboard; clipboard_command and
open_command in the same file change that, and "" turns either off.
USAGE
}

# The folder a start is for: asked on a terminal, with new as a choice.
ask_start_folder() {
  local __var="$1" root="$2" d number n=0
  printf 'Folders on the desk:\n' >&2
  for d in "$root/desk"/*/; do
    [ -d "$d" ] || continue
    n=$((n + 1)); number=""
    [ -f "$d/folder.md" ] && number="$(folder_fact "$d/folder.md" number)"
    printf '  %s%s\n' "${number:+folder $number  }" "$(basename "$d")" >&2
  done
  [ "$n" -gt 0 ] || printf '  (none yet)\n' >&2
  ask "$__var" "Which job: a unique part of its name, folder N, or new to open one (office start FOLDER)" \
    "$([ "$n" -eq 0 ] && printf new)" 1 \
    "The folder the session works on. new opens one first, with office open's questions (title, size, lane, source)."
}

cmd_start() {
  local want="" where="" project="" goal="" slug="" brief="" read_only=0 includes=() writes=() set_w=0
  local root name md status lane lane_project lane_paths names cls ans tz day out sid tray tray_root rel about="" args=() v
  while [ $# -gt 0 ]; do
    case "$1" in
      --in-office) [ -z "$where" ] || [ "$where" = office ] || die "--in-office and --on are two places; give one"; where=office; shift ;;
      --on) [ $# -ge 2 ] || die "--on needs the project's name"; [ "$where" != office ] || die "--in-office and --on are two places; give one"
            where=project; project="$2"; shift 2 ;;
      --goal|--slug|--brief|--write|--include)
        [ $# -ge 2 ] || die "$1 needs a value (office start --help explains it)"
        case "$1" in --goal) goal="$2" ;; --slug) slug="$2" ;; --brief) brief="$2" ;;
                     --write) writes+=("$2"); set_w=1 ;; --include) includes+=("$2") ;; esac
        shift 2 ;;
      --read-only) read_only=1; shift ;;
      -h|--help) usage_start; return 0 ;;
      -*) usage_start >&2; die "office start does not know $1; the flags above are what it takes" ;;
      *) [ -z "$want" ] || die "office start takes one folder"; want="$1"; shift ;;
    esac
  done
  [ "$read_only" = 0 ] || [ "$set_w" = 0 ] || die "--read-only forecasts nothing, so it takes no --write"
  root="$(resolve_office)" || exit 1
  require_current "$root"
  warn_if_unfounded "$root"
  command -v bale >/dev/null 2>&1 || die "bale is not on PATH; office start runs bale pack"

  # Which job.
  if [ -z "$want" ]; then
    can_ask || { usage_start >&2; die "name the folder: office start FOLDER (office open makes one first); piped input is never asked"; }
    ask_start_folder want "$root"
  fi
  if [ "$want" = new ]; then
    can_ask || die "new opens a folder through office open's questions, which need a terminal; run office open first"
    rel="$(cmd_open)" || exit 1
    want="${rel#desk/}"
  fi
  name="$(find_folder "$root" desk "$want")" || exit 1
  md="$root/desk/$name/folder.md"
  [ -f "$md" ] || die "desk/$name has no folder.md"
  status="$(folder_fact "$md" status)"
  case "$status" in done|absorbed|split|retired) die "desk/$name says status $status, which belongs in the filing cabinet; office status names what disagrees" ;; esac

  # What the folder already says: its lane (project: paths) and class.
  lane="$(folder_fact "$md" lane)"; cls="$(folder_fact "$md" class)"
  lane_project=""; lane_paths=""
  case "$lane" in *:*) lane_project="$(printf '%s' "${lane%%:*}" | sed 's/^[[:space:]]*//; s/[[:space:]]*$//')"; lane_paths="${lane#*:}" ;; esac
  names="$(helper project-names "$root/$MANIFEST_REL" 2>/dev/null)"
  printf '%s\n' "$names" | grep -qxF -- "$lane_project" || lane_project=""

  # Where the work lands: two choices, the kind names behind the curtain.
  if [ -z "$where" ]; then
    can_ask || die "say where the work lands: --in-office, or --on PROJECT ($(printf '%s' "$names" | paste -sd, - | sed 's/,/, /g')); piped input is never asked"
    while :; do
      ask ans "Where the work lands: office, or the project it changes ($(printf '%s' "$names" | paste -sd, - | sed 's/,/, /g')) (--in-office or --on PROJECT)" \
        "${lane_project:-office}" 1 \
        "office: the session works in this office (the folder, the notepad) and is packed here. A project's name: the session changes that project's repo and is packed there, with this office's context riding beside it, never inside it."
      if [ "$ans" = office ]; then where=office; break; fi
      if printf '%s\n' "$names" | grep -qxF -- "$ans"; then where=project; project="$ans"; break; fi
      printf '  office, or one of this office'"'"'s projects: %s\n' "$(printf '%s' "$names" | paste -sd, - | sed 's/,/, /g')" >&2
    done
  fi
  if [ "$where" = project ]; then
    printf '%s\n' "$names" | grep -qxF -- "$project" || die "--on $project: no such project in this office (it scopes: $(printf '%s' "$names" | paste -sd, - | sed 's/,/, /g'); office projects add adds one)"
  else
    about="$lane_project"
  fi

  # The goal: the one thing the pack cannot derive.
  if [ -z "$goal" ]; then
    can_ask || die "give the session's goal: --goal TEXT, one sentence; piped input is never asked"
    ask goal "The session's goal, in one sentence (--goal)" "" 1 \
      "What the session is for, in one sentence: it becomes the request's goal and the opener's first line. The folder, its lane and the project's ride-alongs go with it on their own."
  fi
  goal="$(printf '%s' "$goal" | tr '\n' ' ' | sed 's/^[[:space:]]*//; s/[[:space:]]*$//')"
  [ -n "$goal" ] || die "the goal is empty"
  case "$goal" in -*) die "a goal may not start with a dash (bale would read it as a flag)" ;; esac
  # bale numbers sessions per repo, so the same slug packed in the office
  # and in a project the same day would mint one id twice; an office
  # session's default slug says office.
  if [ -z "$slug" ]; then
    slug="$(short_slug "${name#[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]-}")"
    [ "$where" = project ] || slug="$slug-office"
  fi
  slug="$(slugify "$slug")"; [ -n "$slug" ] || die "the slug has no letters or digits (give one: --slug SLUG)"

  # A project session's forecast: the lane's paths when the lane names
  # this project, else asked, else the whole repo.
  if [ "$where" = project ] && [ "$set_w" = 0 ] && [ "$read_only" = 0 ]; then
    if [ "$lane_project" = "$project" ] && [ -n "${lane_paths//[[:space:],]/}" ]; then
      IFS=',' read -r -a writes <<< "$lane_paths"
      for v in "${!writes[@]}"; do writes[$v]="$(printf '%s' "${writes[$v]}" | sed 's/^[[:space:]]*//; s/[[:space:]]*$//')"; done
      log "forecast from the folder's lane: ${writes[*]}"
    elif can_ask; then
      ask ans "Paths in $project the session will change, comma-separated (--write) [return: the whole repo]" "" 0 \
        "Its write forecast, relative to $project's top: what bale keeps other sessions off while this one is open. A directory covers what lands under it. The whole repo keeps every other $project session waiting."
      [ -z "$ans" ] || IFS=',' read -r -a writes <<< "$ans"
      for v in "${!writes[@]}"; do writes[$v]="$(printf '%s' "${writes[$v]}" | sed 's/^[[:space:]]*//; s/[[:space:]]*$//')"; done
    fi
    [ "${#writes[@]}" -gt 0 ] || log "no forecast given: bale forecasts the whole of $project, so no other session there runs beside this one"
  fi
  args=(--where "$where" --goal "$goal" --slug "$slug")
  [ "$where" = project ] && args+=(--project "$project")
  [ -z "$about" ] || args+=(--project "$about")
  for v in "${writes[@]}"; do [ -n "$v" ] && args+=(--write "${v%/}"); done
  for v in "${includes[@]}"; do args+=(--include "${v%/}"); done
  [ "$read_only" = 0 ] || args+=(--read-only)
  if [ -n "$brief" ]; then [ -f "$brief" ] || die "--brief $brief: no such file"; args+=(--brief "$brief"); fi
  [ -z "$cls" ] || args+=(--work-class "$cls")
  tray_root="$(machine_setting out_tray "$HOME/out-tray")"
  case "$tray_root" in "~"|"~/"*) tray_root="$HOME${tray_root#\~}" ;; esac

  log "packing desk/$name ($([ "$where" = office ] && printf 'in the office' || printf 'on %s' "$project"))"
  out="$(reader start "$root" "desk/$name" "${args[@]}" --tray-root "$tray_root")" || exit 1
  sid="$(printf '%s' "$out" | python3 -c 'import json,sys; print(json.load(sys.stdin)["sid"])')" || die "could not read what office start packed"
  tray="$(printf '%s' "$out" | python3 -c 'import json,sys; print(json.load(sys.stdin)["tray"])')"
  tz="$(office_tz "$root")"; day="$(office_date "$tz")"
  record_session "$root" "desk/$name" "$sid" "" "$day"

  printf 'Packed %s for desk/%s.\n\n' "$sid" "$name"
  printf 'Out tray: %s\n' "$tray"
  printf '%s' "$out" | python3 -c 'import json,sys
r = json.load(sys.stdin)
for line in r["carried"]:
    print("  " + line)'
  printf '\nAttach every file in the out tray to a fresh chat, then paste the opener:\n\n'
  local opener
  opener="$(printf '%s' "$out" | python3 -c 'import json,sys
r = json.load(sys.stdin)
if r["opener"] is not None:
    print("\n".join(r["opener"]))')"
  if [ -z "$opener" ]; then
    warn "bale printed no opener between its scissor lines; the session is open, and bale pack's own report (run it by hand) or bale status shows it"
    return 0
  fi
  printf -- '--8<-- session opener --8<--\n%s\n--8<-- end session opener --8<--\n' "$opener"
  start_desktop "$tray" "$opener"
}

# The two desktop steps, on a terminal only: copy the opener to the
# clipboard and open the out tray in the file manager. On WSL they
# default to clip.exe and explorer.exe; elsewhere they are off until
# machine.toml names a command.
start_desktop() {
  local tray="$1" opener="$2" clip open
  [ -t 1 ] || return 0
  if on_wsl; then
    clip="$(machine_setting clipboard_command "$(command -v clip.exe >/dev/null 2>&1 && printf clip.exe)")"
    open="$(machine_setting open_command "$(command -v explorer.exe >/dev/null 2>&1 && printf explorer.exe)")"
  else
    clip="$(machine_setting clipboard_command "")"; open="$(machine_setting open_command "")"
  fi
  if [ -n "$clip" ]; then
    # clip.exe reads UTF-16; anything else takes the bytes as they are.
    if [ "$(basename "${clip%% *}")" = clip.exe ] && command -v iconv >/dev/null 2>&1; then
      printf '%s\n' "$opener" | iconv -f UTF-8 -t UTF-16LE | $clip 2>/dev/null
    else
      printf '%s\n' "$opener" | $clip 2>/dev/null
    fi
    if [ $? -eq 0 ]; then log "the opener is on the clipboard ($clip)"; else warn "$clip could not take the opener; copy it from above"; fi
  fi
  if [ -n "$open" ]; then
    (cd "$tray" && $open . >/dev/null 2>&1 &)
    log "opened the out tray with $open"
  fi
}

# The projects this office scopes, and what bale records about them.
# The floor plan's [projects] table names each project and its repo on
# this machine; `office projects add` is the only writer. The renderings
# read bale's records through the read side and write nothing.
usage_projects() {
  cat <<'EOF'
usage: office projects                       list the projects this office scopes, and
                                             what rides with each and runs after it lands
       office projects add [NAME] [PATH]     add one (asks for what it was not given)
                           [--name NAME] [--path PATH] [--ride PATH]... [--after-land CMD]...
       office projects set [NAME]            declare what rides beside every session on a
                           [--ride PATH]... [--no-rides]       project, and what runs in its
                           [--after-land CMD]... [--no-after-land]   repo after one lands
       office projects [NAME] --ledger       trust ledger per work class
       office projects [NAME] --landed PATH  the last applied session that landed PATH
       office projects [NAME] --versions     the version trail
NAME narrows a rendering to one project; without it every project is read.
PATH for --landed is relative to the project's root, e.g. bin/office.
A ride-along is a path on this machine, absolute or ~/: a directory inside
another repo, a whole repo, or a file. Its context rides beside every
session office start packs for the project. An after-land action is a
command run in the project's repo after one of its sessions lands (office
land runs them; this release only declares them). Both live in this
office's floor plan, never in the project's repo. --ride and --after-land
replace the list they name; on a terminal, set asks for what it was not
given.
EOF
}

# ask_declaration ARRAY PROJECT KIND: on a terminal, one ride-along path
# (KIND ride) or after-land action (KIND after-land) per question until
# a plain return; each answer is checked as it is given and asked again
# with the reason when it does not check.
ask_declaration() {
  local -n __list="$1"
  local name="$2" kind="$3" answer out q flag help n=0
  case "$kind" in
    ride) flag=--ride; q="A path whose context rides beside every $name session"
          help="A path on this machine, absolute or ~/: a directory inside another repo (~/other-repo/docs), a whole repo, or a file. office start packs its context and puts it in the out tray beside every request for $name." ;;
    *) flag=--after-land; q="A command to run in $name's repo after one of its sessions lands"
       help="One line, run from the top of $name's repo once a session there has landed, e.g. ./install.sh. office land runs these; until it is built, office projects shows them." ;;
  esac
  __list=()
  while :; do
    [ "$n" -eq 0 ] || q="Another"
    IFS= read -r -p "$q ($flag) [return ends the list]: " answer || die "no answer given to: $q"
    answer="$(printf '%s' "$answer" | sed 's/^[[:space:]]*//; s/[[:space:]]*$//')"
    if [ "$answer" = "?" ]; then printf '%s\n' "$help" | fold -s -w 76 | sed 's/^/  /' >&2; continue; fi
    [ -n "$answer" ] || return 0
    if out="$(helper check-declaration "$kind" -- "$answer" 2>&1)"; then
      __list+=("$out"); n=$((n + 1))
    else
      printf '  %s\n' "${out#\[office\] error: }" >&2
    fi
  done
}

# declaration_args ARRAY RIDES_SET RIDES... -- : the project-declare
# flags for one key, given its list and whether it was set at all.
declare_flags() {
  local -n __out="$1"; local key="$2" set="$3"; shift 3
  [ "$set" = 1 ] || return 0
  if [ $# -eq 0 ]; then __out+=("--no-$([ "$key" = ride ] && printf rides || printf after-land)"); return 0; fi
  local v; for v in "$@"; do __out+=("--$key" "$v"); done
}

cmd_projects_add() {
  local name="" path="" root default missing=() rides=() afters=() set_r=0 set_a=0 args=()
  while [ $# -gt 0 ]; do
    case "$1" in
      --name) [ $# -ge 2 ] || die "--name needs a value"; name="$2"; shift 2 ;;
      --path) [ $# -ge 2 ] || die "--path needs a value"; path="$2"; shift 2 ;;
      --ride) [ $# -ge 2 ] || die "--ride needs a path"; rides+=("$2"); set_r=1; shift 2 ;;
      --after-land) [ $# -ge 2 ] || die "--after-land needs a command"; afters+=("$2"); set_a=1; shift 2 ;;
      -h|--help) usage_projects; return 0 ;;
      -*) usage_projects >&2; die "office projects add does not know $1; it takes a name and a path, as words or as --name and --path, and --ride and --after-land" ;;
      *) if [ -z "$name" ]; then name="$1"; elif [ -z "$path" ]; then path="$1"; else die "office projects add takes a name and a path, and got more: $1"; fi; shift ;;
    esac
  done
  root="$(resolve_office)" || exit 1
  require_current "$root"
  if [ -z "$name" ] || [ -z "$path" ]; then
    if [ -t 0 ]; then
      # A wizard on a terminal: ask for what was not given (doctrine
      # section 7); every question has its flag twin.
      if [ -z "$path" ]; then
        ask path "Path to the project's git repo on this machine (--path)" "" 1 \
          "The top of the project's git repo, absolute or under your home directory (~/...). bale must run there: it needs a .bale/ directory or a bale.toml."
      fi
      if [ -z "$name" ]; then
        default="$(slugify "$(basename "${path%/}")")"
        ask name "Name for it in this office (--name)" "$default" 0 \
          "What this office calls the project on the walk-in and in office projects: letters, digits, dash or underscore."
      fi
      if [ "$set_r" = 0 ]; then ask_declaration rides "$name" ride; set_r=1; fi
      if [ "$set_a" = 0 ]; then ask_declaration afters "$name" after-land; set_a=1; fi
    else
      [ -n "$name" ] || missing+=("--name NAME")
      [ -n "$path" ] || missing+=("--path PATH")
      die "stdin is not a terminal, so nothing is asked; give ${missing[*]}"
    fi
  fi
  [ -n "$name" ] && [ -n "$path" ] || die "a project needs a name and a path"
  # Check the declarations before the table is touched, so a bad one
  # adds nothing.
  local v
  for v in "${rides[@]}"; do helper check-declaration ride -- "$v" >/dev/null || exit 1; done
  for v in "${afters[@]}"; do helper check-declaration after-land -- "$v" >/dev/null || exit 1; done
  helper project-add "$root/$MANIFEST_REL" "$name" "$path" || exit 1
  if [ "${#rides[@]}" -gt 0 ] || [ "${#afters[@]}" -gt 0 ]; then
    declare_flags args ride "$([ "${#rides[@]}" -gt 0 ] && echo 1 || echo 0)" "${rides[@]}"
    declare_flags args after-land "$([ "${#afters[@]}" -gt 0 ] && echo 1 || echo 0)" "${afters[@]}"
    helper project-declare "$root/$MANIFEST_REL" "$name" "${args[@]}" || die "added $name, but its declarations could not be written; office projects set $name tries again"
  fi
  commit_paths "$root" "office projects: add $name" "$MANIFEST_REL" || true
}

cmd_projects_set() {
  local name="" root facts rides=() afters=() set_r=0 set_a=0 args=() current keep line
  while [ $# -gt 0 ]; do
    case "$1" in
      --ride) [ $# -ge 2 ] || die "--ride needs a path"; rides+=("$2"); set_r=1; shift 2 ;;
      --no-rides) set_r=2; shift ;;
      --after-land) [ $# -ge 2 ] || die "--after-land needs a command"; afters+=("$2"); set_a=1; shift 2 ;;
      --no-after-land) set_a=2; shift ;;
      -h|--help) usage_projects; return 0 ;;
      -*) usage_projects >&2; die "office projects set does not know $1; it takes a project's name, --ride, --no-rides, --after-land and --no-after-land" ;;
      *) [ -z "$name" ] || die "office projects set takes one project"; name="$1"; shift ;;
    esac
  done
  [ "$set_r" != 2 ] || [ "${#rides[@]}" -eq 0 ] || die "--ride and --no-rides contradict each other"
  [ "$set_a" != 2 ] || [ "${#afters[@]}" -eq 0 ] || die "--after-land and --no-after-land contradict each other"
  root="$(resolve_office)" || exit 1
  require_current "$root"
  if [ -z "$name" ]; then
    can_ask || { usage_projects >&2; die "name the project: office projects set NAME; piped input is never asked"; }
    printf 'Projects: %s\n' "$(helper project-names "$root/$MANIFEST_REL" | paste -sd, - | sed 's/,/, /g')" >&2
    ask name "Which project (office projects set NAME)" "" 1 "One of the projects this office scopes, by the name office projects lists."
  fi
  facts="$(helper project-facts "$root/$MANIFEST_REL" "$name")" || exit 1
  if [ "$set_r" = 0 ] && [ "$set_a" = 0 ] && ! can_ask; then
    die "nothing to set for $name; give --ride PATH (repeatable) or --no-rides, and --after-land CMD (repeatable) or --no-after-land; piped input is never asked"
  fi
  if can_ask; then
    for line in ride after-land; do
      if [ "$line" = ride ] && [ "$set_r" != 0 ]; then continue; fi
      if [ "$line" = after-land ] && [ "$set_a" != 0 ]; then continue; fi
      current="$(printf '%s\n' "$facts" | awk -F'\t' -v k="$([ "$line" = ride ] && echo rides || echo after_land)" '$1 == k {print $2}' | paste -sd, - | sed 's/,/, /g')"
      if [ -n "$current" ]; then
        ask keep "Keep $([ "$line" = ride ] && echo "what rides with $name" || echo "what runs after $name lands"): $current? (y/n)" "y" 0 \
          "y keeps the list as it is; n asks for the new list, one per question, and a plain return at once clears it."
        case "$keep" in y|Y|yes) continue ;; esac
      fi
      if [ "$line" = ride ]; then ask_declaration rides "$name" ride; set_r=$([ "${#rides[@]}" -gt 0 ] && echo 1 || echo 2)
      else ask_declaration afters "$name" after-land; set_a=$([ "${#afters[@]}" -gt 0 ] && echo 1 || echo 2); fi
      if [ -z "$current" ] && [ "$line" = ride ] && [ "$set_r" = 2 ]; then set_r=0; fi
      if [ -z "$current" ] && [ "$line" = after-land ] && [ "$set_a" = 2 ]; then set_a=0; fi
    done
  fi
  [ "$set_r" != 0 ] || [ "$set_a" != 0 ] || { log "nothing changed for $name"; return 0; }
  declare_flags args ride "$([ "$set_r" != 0 ] && echo 1 || echo 0)" "${rides[@]}"
  declare_flags args after-land "$([ "$set_a" != 0 ] && echo 1 || echo 0)" "${afters[@]}"
  helper project-declare "$root/$MANIFEST_REL" "$name" "${args[@]}" || exit 1
  commit_paths "$root" "office projects: set $name" "$MANIFEST_REL" || true
}

cmd_projects() {
  local name="" mode="" landed="" root rc
  case "${1:-}" in
    add) shift; cmd_projects_add "$@"; return ;;
    set) shift; cmd_projects_set "$@"; return ;;
  esac
  while [ $# -gt 0 ]; do
    case "$1" in
      --ledger|--versions) [ -z "$mode" ] || die "one rendering at a time: $mode or $1"; mode="$1"; shift ;;
      --landed) [ -z "$mode" ] || die "one rendering at a time: $mode or $1"
                [ $# -ge 2 ] || die "--landed needs a path, relative to the project's root"
                mode="$1"; landed="$2"; shift 2 ;;
      -h|--help) usage_projects; return 0 ;;
      -*) usage_projects >&2; die "office projects does not know $1" ;;
      *) [ -z "$name" ] || die "name one project, or none for all"; name="$1"; shift ;;
    esac
  done
  root="$(resolve_office)" || exit 1
  if [ -z "$mode" ]; then
    [ -z "$name" ] || die "a project name narrows a rendering: add --ledger, --landed PATH or --versions"
    helper projects "$root/$MANIFEST_REL"; rc=$?
  else
    case "$mode" in
      --ledger) reader ledger "$root" ${name:+--project "$name"} ;;
      --versions) reader versions "$root" ${name:+--project "$name"} ;;
      --landed) reader landed "$root" "$landed" ${name:+--project "$name"} ;;
    esac
    rc=$?
  fi
  case $rc in
    0) return 0 ;;
    3) die "some of this office's projects could not be read; the lines above say why" ;;
    *) exit 1 ;;
  esac
}

# Walking in: `office` with no arguments.
walk_in() {
  local root name tz report state slips notes founded
  if ! root="$(resolve_office 2>/dev/null)"; then
    usage
    printf '\nNot inside an office, and this machine has no default office. office init PATH builds one.\n'
    return 0
  fi
  name="$(helper get "$root/$MANIFEST_REL" office.name --default "(unnamed)")"
  tz="$(office_tz "$root")"
  report="$(skew_report "$root" 2>/dev/null)" && state="$(printf '%s\n' "$report" | head -n 1)" || state="unreadable"
  if helper profile-check "$root/$PROFILE_REL" "$SHAPE" >/dev/null 2>&1; then founded="founded"; else founded="UNFOUNDED (profile incomplete: office status)"; fi
  case "$state" in
    current) state="current with office-src $(install_version)" ;;
    behind) state="BEHIND office-src $(install_version) (run: office upgrade)" ;;
    ahead) state="AHEAD of office-src $(install_version) (install a newer office-src)" ;;
    *) state="version stamp unreadable" ;;
  esac
  printf 'The %s office, %s\n' "$name" "$root"
  printf '%s, %s %s. %s; %s.\n\n' "$(TZ="$tz" date '+%A %F')" "$(office_time "$tz")" "$tz" "$founded" "$state"

  # In flight: one line per session open in the projects this office
  # scopes and in the office itself, and the folder that names it; then
  # the desk's count and its first three ready folders. A gate cleared
  # since the last walk-in says so. Never fails the walk-in.
  local desk today since
  today="$(office_date "$tz")"; since="$(last_walk_in "$root")"
  desk="$(reader desk "$root" --walk-in --today "$today" ${since:+--since "$since"})"
  case $? in
    0|3) printf '%s\n' "$desk" ;;
    *) printf 'In flight:\n  could not be read (OFFICE_DEBUG=1 office for why)\n\nOn the desk:\n  could not be read; office desk says why\n' ;;
  esac
  record_walk_in "$root" "$today"
  printf '\nThis week:\n'
  OFFICE_ROOT="$root" cmd_week | sed 's/^/  /'
  printf '\nNotepad, last lines:\n'
  notes="$(helper recent-notes "$root/notepad" 3 2>/dev/null)"
  if [ -n "$notes" ]; then printf '%s\n' "$notes" | sed 's/^/  /'; else printf '  nothing noted yet\n'; fi
  slips="$(find "$root/suggestion-box" -maxdepth 1 -type f -name '*.md' 2>/dev/null | wc -l | tr -d ' ')"
  printf '\nSuggestion box: %s slip(s).\n' "$slips"
  printf '\nFrom here: office start, office note TEXT, office slip TEXT, office open, office close FOLDER, office desk, office week, office projects, office status. office help lists everything.\n'
}

cmd_where() {
  resolve_office; printf '\n'
}

cmd_default() {
  local root
  if [ $# -eq 0 ]; then
    [ -f "$DEFAULT_FILE" ] || die "this machine has no default office (set one with: office default PATH)"
    head -n 1 "$DEFAULT_FILE"; return 0
  fi
  root="$(readlink -f "$1" 2>/dev/null)" || die "no such path: $1"
  [ -f "$root/$MANIFEST_REL" ] || die "not an office (no $MANIFEST_REL): $root"
  mkdir -p "$CONFIG_DIR" && printf '%s\n' "$root" > "$DEFAULT_FILE" || die "cannot write $DEFAULT_FILE"
  log "this machine's default office is now $root"
}

cmd_version() {
  printf 'office-src %s (%s)\n' "$(install_version)" "$OFFICE_SRC"
  [ -f "$OFFICE_SRC/INSTALLED" ] && sed 's/^/  /' "$OFFICE_SRC/INSTALLED"
  return 0
}

usage_init() {
  cat <<'EOF'
usage: office init [PATH | --path PATH] [--name NAME] [--no-default]
Builds an office at PATH (new or empty): the base spaces, a profile stub,
the version stamp, a first survey and a first commit. Prints the pack line
for the founding sitting. Makes PATH this machine's default office when
there is none yet, unless --no-default. On a terminal it asks for the path
and the name when it was given no path; ? explains a question. It refuses
to build from an install whose catalogs have a defect.
EOF
}

usage() {
  cat <<EOF
office-src $(install_version): builds and keeps offices.

usage: office [VERB [args]]

  (no verb)       walk in: sessions in flight, what is ready on the desk, this week,
                  recent notes, slips
  note TEXT       append a dated line to the notepad (works unfounded or behind)
  slip TEXT       drop a friction slip in the suggestion box, --about the office,
                  a tool or a project (works unfounded or behind)
  start [FOLDER]  pack a session for a folder, in the office or --on a project,
                  and gather everything to attach into one out tray; records
                  the session in the folder and prints the opener
  open [SLUG]     start a numbered folder on the desk; asks on a terminal for the
                  title, size, lane and source it was not given; --candidate,
                  --filed --sid SID, gates with --after; --help lists the fields
  desk            in flight, ready in order, parked under what each waits for,
                  candidates
  week            this week's calendar and its gaps
  close FOLDER    to the filing cabinet: done, or --into N, --split A,B,
                  --retired WHY
  reopen FOLDER   bring a done folder back to the desk, history and all
  sessions FOLDER [SID|-] [--ratified [--except TEXT]]
                  list or record the sessions that worked on a folder;
                  - reads a bale pack --json report on stdin; listing shows
                  each session's outcome from bale's records
  projects        list the projects this office scopes; add NAME PATH adds one;
                  set NAME declares what rides with it (--ride) and what runs
                  after it lands (--after-land); --ledger, --landed PATH,
                  --versions render bale's records

  init PATH       build an office and print its founding session's pack line
  survey          rewrite floor-plan/survey.md and report what changed
  status          version, skew, profile, survey age, hung items, catalogs, folders,
                  filed pages, bale (read-only)
  upgrade         run pending migrations, dry run first, one commit
  where           print the office a command here would act on
  default [PATH]  show or set this machine's default office
  version         print the installed version

A command acts on OFFICE_ROOT if set, else the office around the working
directory, else this machine's default. The doctrine is
$DOCTRINE_DIR/OFFICE.md.
EOF
}

main() {
  if [ $# -eq 0 ]; then walk_in; return; fi
  local verb="$1"; shift
  case "$verb" in
    init) cmd_init "$@" ;;
    survey) cmd_survey "$@" ;;
    status) cmd_status "$@" ;;
    upgrade) cmd_upgrade "$@" ;;
    where) cmd_where "$@" ;;
    default) cmd_default "$@" ;;
    note) cmd_note "$@" ;;
    slip) cmd_slip "$@" ;;
    open) cmd_open "$@" ;;
    desk) cmd_desk "$@" ;;
    week) cmd_week "$@" ;;
    close) cmd_close "$@" ;;
    reopen) cmd_reopen "$@" ;;
    sessions) cmd_sessions "$@" ;;
    projects) cmd_projects "$@" ;;
    start) cmd_start "$@" ;;
    version|--version|-V) cmd_version ;;
    help|--help|-h) usage ;;
    *) usage >&2; die "unknown verb: $verb" ;;
  esac
}

main "$@"
