#!/usr/bin/env bash
# office: builds and keeps offices. See doctrine/OFFICE.md in the install.
#
# Everything the command reads about itself (templates, doctrine, space
# catalog, profile shape, migrations) comes from the install this script
# sits in, found through its own path, so an upgraded install upgrades
# every office's tools without touching any office.

set -uo pipefail

OFFICE_SRC="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)"
HELPER="$OFFICE_SRC/lib/office_helper.py"
# The read side: the only code that runs bale, through the --json
# surfaces share/bale-consumption.toml declares.
READER="$OFFICE_SRC/lib/office_bale.py"
CATALOG="$OFFICE_SRC/share/spaces.toml"
VERBS="$OFFICE_SRC/share/verbs.toml"
SHAPE="$OFFICE_SRC/share/profile-shape.toml"
TEMPLATES="$OFFICE_SRC/templates"
MIGRATIONS="$OFFICE_SRC/migrations"
DOCTRINE_DIR="$OFFICE_SRC/doctrine"
CONFIG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/office-src"
DEFAULT_FILE="$CONFIG_DIR/default-office"
MANIFEST_REL="floor-plan/manifest.toml"
SURVEY_REL="floor-plan/survey.md"
PROFILE_REL="profile.md"
BALE_TOML_REL="bale.toml"
STEP_TIMEOUT="${OFFICE_STEP_TIMEOUT:-10}"
VERSION_TIMEOUT=5

log()   { printf '[office] %s\n' "$*" >&2; }
warn()  { printf '[office] warning: %s\n' "$*" >&2; }
die()   { printf '[office] error: %s\n' "$*" >&2; exit 1; }
debug() { [ "${OFFICE_DEBUG:-0}" = "1" ] && printf '[office] debug: %s\n' "$*" >&2; return 0; }

# -B throughout: the helper imports office_host, the reader imports the
# helper, and an install is never written to.
helper() { python3 -B "$HELPER" "$@"; }
reader() { python3 -B "$READER" "$@"; }

# Single-quote a word for a printed command line.
shq() { printf "'%s'" "$(printf '%s' "$1" | sed "s/'/'\\\\''/g")"; }

# Escape a value for the right-hand side of a sed s|||.
sed_rhs() { printf '%s' "$1" | sed 's/[&|\\]/\\&/g'; }

# --- asking --------------------------------------------------------------------
#
# A verb is a wizard on a terminal (doctrine section 7): it asks for what
# it was not given, every question names its flag twin, `?` explains the
# field rather than refusing it, and an answer the field does not take is
# explained and asked again. Piped input is never asked anything; the
# verb refuses what it was not given and names the flag.

can_ask() { [ -t 0 ]; }

# ask VAR PROMPT DEFAULT REQUIRED HELP [FIELD]
# PROMPT names the flag twin. DEFAULT is taken on a plain return; with no
# default a plain return skips, unless REQUIRED is 1. HELP is what `?`
# prints; FIELD, when given, is the folder field the answer is checked
# and normalized as (the helper's closed vocabularies).
ask() {
  local __var="$1" prompt="$2" def="$3" required="$4" help="$5" field="${6:-}" answer norm shown="$2"
  if [ -n "$def" ]; then shown="$shown [$def]"
  elif [ "$required" != "1" ]; then shown="$shown [return skips]"; fi
  while :; do
    IFS= read -r -p "$shown: " answer || die "no answer given to: $prompt"
    answer="$(printf '%s' "$answer" | sed 's/^[[:space:]]*//; s/[[:space:]]*$//')"
    if [ "$answer" = "?" ]; then printf '%s\n' "$help" | fold -s -w 76 | sed 's/^/  /' >&2; continue; fi
    if [ -z "$answer" ]; then
      if [ -n "$def" ]; then answer="$def"
      elif [ "$required" = "1" ]; then printf '  an answer is needed here; ? explains it\n' >&2; continue
      else printf -v "$__var" '%s' ""; return 0; fi
    fi
    if [ -z "$field" ]; then printf -v "$__var" '%s' "$answer"; return 0; fi
    if norm="$(helper normalize-field "$field" -- "$answer" 2>&1)"; then printf -v "$__var" '%s' "$norm"; return 0; fi
    printf '  %s\n' "${norm#\[office\] error: }" >&2
  done
}

field_help() { helper field-help "$1" 2>/dev/null | sed 's/^[^:]*: //'; }

# ask_field VAR FIELD FLAG QUESTION [DEFAULT] [REQUIRED]
ask_field() {
  ask "$1" "$4 ($3)" "${5:-}" "${6:-0}" "$(field_help "$2")" "$2"
}

# check_field VAR FIELD FLAG: normalize a value given as a flag. A value
# the field does not take is explained; on a terminal the field is then
# asked (the return is 2, so the caller asks), piped it refuses.
check_field() {
  local __var="$1" field="$2" flag="$3" norm
  [ -n "${!__var}" ] || return 0
  if norm="$(helper normalize-field "$field" -- "${!__var}" 2>&1)"; then printf -v "$__var" '%s' "$norm"; return 0; fi
  norm="${norm#\[office\] error: }"
  if can_ask; then
    printf '[office] %s %s: %s\n' "$flag" "$(shq "${!__var}")" "$norm" >&2
    printf -v "$__var" '%s' ""
    return 2
  fi
  die "$flag: $norm"
}

TMP_PATHS=()
cleanup_tmp() { [ "${#TMP_PATHS[@]}" -gt 0 ] && rm -rf "${TMP_PATHS[@]}"; return 0; }
trap cleanup_tmp EXIT

install_version() {
  local v
  v="$(head -n 1 "$OFFICE_SRC/VERSION" 2>/dev/null)" || die "install has no VERSION file: $OFFICE_SRC"
  [ -n "$v" ] || die "install VERSION is empty: $OFFICE_SRC/VERSION"
  printf '%s' "$v"
}

require_tools() {
  local t
  for t in "$@"; do
    command -v "$t" >/dev/null 2>&1 || die "$t is required and not on PATH"
  done
}

# --- finding the office ----------------------------------------------------

# Walk up from a directory to the nearest office, the way git finds .git.
find_office_from() {
  local dir
  dir="$(readlink -f "$1" 2>/dev/null)" || return 1
  while :; do
    if [ -f "$dir/$MANIFEST_REL" ]; then printf '%s' "$dir"; return 0; fi
    [ "$dir" = "/" ] && return 1
    dir="$(dirname "$dir")"
  done
}

# OFFICE_ROOT, then the office around the working directory, then this
# machine's default. Each source is reported so a surprise is traceable.
resolve_office() {
  local root
  if [ -n "${OFFICE_ROOT:-}" ]; then
    [ -f "$OFFICE_ROOT/$MANIFEST_REL" ] || die "OFFICE_ROOT is not an office (no $MANIFEST_REL): $OFFICE_ROOT"
    debug "office from OFFICE_ROOT: $OFFICE_ROOT"
    readlink -f "$OFFICE_ROOT"; return 0
  fi
  if root="$(find_office_from "$PWD")"; then
    debug "office found above the working directory: $root"
    printf '%s' "$root"; return 0
  fi
  if [ -f "$DEFAULT_FILE" ]; then
    root="$(head -n 1 "$DEFAULT_FILE")"
    [ -f "$root/$MANIFEST_REL" ] || die "this machine's default office is gone or not an office: $root (set another with: office default PATH)"
    log "not inside an office; using this machine's default, $root"
    printf '%s' "$root"; return 0
  fi
  die "not inside an office and this machine has no default office (set one with: office default PATH)"
}

# --- version skew ----------------------------------------------------------

# Prints the skew state and any pending migrations (helper format).
skew_report() {
  local root="$1" office_v
  office_v="$(helper stamp "$root/$MANIFEST_REL" migrated_to)" || die "cannot read the version stamp in $root/$MANIFEST_REL"
  helper skew "$office_v" "$(install_version)" "$MIGRATIONS" || die "cannot plan migrations from $MIGRATIONS"
}

# Refuse loudly on skew in either direction; commands that act on the
# office's shape call this before touching it.
require_current() {
  local root="$1" report state office_v
  report="$(skew_report "$root")" || exit 1
  state="$(printf '%s\n' "$report" | head -n 1)"
  office_v="$(helper stamp "$root/$MANIFEST_REL" migrated_to)"
  case "$state" in
    current) return 0 ;;
    ahead) die "this office was migrated to $office_v, past the installed office-src $(install_version); install $office_v or later before using it" ;;
    behind)
      # The renovation door: office upgrade opens the renovation's folder and
      # sends its session out while the office is behind the migration that
      # needs it (RENOVATING, set by upgrade alone), and office land brings
      # that session back the same way.
      if [ "${RENOVATING:-0}" = 1 ]; then debug "behind office-src $(install_version), for the renovation"; return 0; fi
      log "this office is at $office_v and office-src $(install_version) has breaking releases it has not taken:"
      printf '%s\n' "$report" | tail -n +2 | cut -f1,4 | sed 's/\t/: /; s/^/[office]   /' >&2
      die "run: office upgrade" ;;
    *) die "unexpected skew state: $state" ;;
  esac
}

warn_if_unfounded() {
  local root="$1" out
  # The founding door's own steps are the founding; they say so themselves.
  [ "${FOUNDING_DOOR:-0}" != 1 ] || return 0
  out="$(helper profile-check "$root/$PROFILE_REL" "$SHAPE")"
  case $? in
    0) return 0 ;;
    3) warn "this office is unfounded: its profile is incomplete (office status names the sections; the walk-in's Next line names what founds it)" ;;
    *) warn "could not check the profile against the required shape" ;;
  esac
}

# --- survey ----------------------------------------------------------------

fact() { printf '%s\t%s\t%s\n' "$1" "$2" "$3"; }

tool_version() {
  local t="$1" out
  if ! command -v "$t" >/dev/null 2>&1; then printf 'not found'; return; fi
  case "$t" in
    R) out="$(timeout "$VERSION_TIMEOUT" R --version 2>&1 | head -n 1)" ;;
    *) out="$(timeout "$VERSION_TIMEOUT" "$t" --version 2>&1 | head -n 1)" ;;
  esac
  [ -n "$out" ] || out="no version output (or timed out after ${VERSION_TIMEOUT}s)"
  printf '%s (%s)' "$out" "$(command -v "$t")"
}

gather_facts() {
  local root="$1" os tz mounts n step name out
  fact Survey surveyed_at "$(date -u +%Y-%m-%dT%H:%M:%SZ)"
  fact Survey office_root "$root"

  os="$(. /etc/os-release 2>/dev/null && printf '%s' "${PRETTY_NAME:-unknown}")"
  fact Machine hostname "$(hostname 2>/dev/null || printf 'unknown')"
  fact Machine os "${os:-unknown (no /etc/os-release)}"
  fact Machine kernel "$(uname -srm 2>/dev/null)"
  if on_wsl; then fact Machine class "WSL"
  elif [ -f /.dockerenv ]; then fact Machine class "container"
  else fact Machine class "host (not WSL, no container marker)"; fi
  fact Machine login_shell "${SHELL:-unset}"
  fact Machine bash "$BASH_VERSION"

  for t in bale git python3 R quarto node; do fact Tools "$t" "$(tool_version "$t")"; done

  tz="$(cat /etc/timezone 2>/dev/null || readlink /etc/localtime 2>/dev/null | sed 's#.*/zoneinfo/##')"
  fact Timezone system "${tz:-unknown}"
  fact Timezone TZ "${TZ:-unset}"
  fact Timezone zone_offset "$(date '+%Z %z')"

  # Mount points by name only: /proc/mounts is a list, never a walk.
  mounts="$(awk '$3 !~ /^(proc|sysfs|devtmpfs|devpts|tmpfs|cgroup2?|mqueue|securityfs|debugfs|tracefs|pstore|bpf|hugetlbfs|configfs|fusectl|autofs|binfmt_misc|nsfs|rpc_pipefs|efivarfs|ramfs|squashfs)$/ {print $2 "\t" $3}' /proc/mounts 2>/dev/null | sort -u)"
  n="$(printf '%s\n' "$mounts" | grep -c . || true)"
  if [ "$n" -eq 0 ]; then
    fact Mounts none "no /proc/mounts or no real filesystems listed"
  else
    printf '%s\n' "$mounts" | head -n 40 | while IFS=$'\t' read -r target fstype; do fact Mounts "$target" "$fstype"; done
    [ "$n" -gt 40 ] && fact Mounts truncated "$n mount points, showing 40"
  fi

  if command -v bale >/dev/null 2>&1; then
    fact bale on_path "$(command -v bale)"
    fact bale install "$(readlink -f "$(command -v bale)")"
  else
    fact bale on_path "not found"
  fi
  fact office-src install "$OFFICE_SRC"
  fact office-src version "$(install_version)"
  fact office-src on_path "$(command -v office 2>/dev/null || printf 'not on PATH')"

  if [ -d "$root/drawer/survey" ]; then
    for step in "$root"/drawer/survey/*; do
      [ -f "$step" ] || continue
      name="$(basename "$step")"
      if [ ! -x "$step" ]; then fact "Office step: $name" skipped "not executable"; continue; fi
      out="$(cd "$root" && timeout "$STEP_TIMEOUT" "$step" 2>&1)"
      case $? in
        0) ;;
        124) fact "Office step: $name" error "timed out after ${STEP_TIMEOUT}s" ;;
        *) fact "Office step: $name" error "exited nonzero" ;;
      esac
      n=0
      while IFS= read -r line && [ "$n" -lt 40 ]; do
        n=$((n + 1))
        if [[ "$line" =~ ^([^:]+):[[:space:]]*(.*)$ ]]; then
          fact "Office step: $name" "${BASH_REMATCH[1]}" "${BASH_REMATCH[2]}"
        elif [ -n "$line" ]; then
          fact "Office step: $name" "line $n" "$line"
        fi
      done <<< "$out"
      [ "$(printf '%s\n' "$out" | wc -l)" -gt 40 ] && fact "Office step: $name" truncated "output capped at 40 lines"
    done
  fi
}

# Write the survey page; print the change report on stdout.
write_survey() {
  local root="$1" facts
  facts="$(mktemp)" || die "cannot make a temp file for the survey"
  gather_facts "$root" > "$facts"
  if ! helper survey-render --facts "$facts" --previous "$root/$SURVEY_REL" --out "$root/$SURVEY_REL"; then
    rm -f "$facts"; die "could not write $root/$SURVEY_REL"
  fi
  rm -f "$facts"
}

# --- the founding door and the renovation door ---------------------------------
#
# An office comes to exist, and is renovated, through the door every other
# session uses (doctrine sections 12 and 14): a folder on the desk, and
# office start sending a session out for it with a brief. office init and
# office found ask the profile's questions and send the founding session
# out with the answers in its brief; office upgrade sends a renovation out
# with its migration in its brief. The doctrine rides from the out tray as
# it does for every session, so nothing here ever writes into the install.

DOOR="$OFFICE_SRC/lib/office_door.py"
door() { python3 -B "$DOOR" "$@"; }

slugify() { printf '%s' "$1" | tr '[:upper:]' '[:lower:]' | tr -c 'a-z0-9' '-' | sed 's/--*/-/g; s/^-//; s/-$//'; }

# The zone this machine says it is in: TZ when it names a zone (the
# variable the C library reads before the system's setting), else
# /etc/timezone, else the zone /etc/localtime links to; empty when none
# of them says.
machine_zone() {
  local tz="${TZ:-}"
  tz="${tz#:}"
  if [[ "$tz" =~ ^[A-Za-z0-9_+-]+(/[A-Za-z0-9_+-]+)*$ ]]; then printf '%s' "$tz"; return 0; fi
  tz="$(cat /etc/timezone 2>/dev/null || readlink /etc/localtime 2>/dev/null | sed 's#.*/zoneinfo/##')"
  printf '%s' "$tz"
}

# The profile's questions, from the install's profile shape: one per
# section, in its order (office_door.py sections). Loaded once, before a
# verb reads its flags, since each question's flag twin is the section's.
SEC_FLAG=(); SEC_ASKED=(); SEC_HEADING=(); SEC_Q=(); SEC_HELP=()
load_sections() {
  local rows row f a h q x
  [ "${#SEC_FLAG[@]}" -eq 0 ] || return 0
  rows="$(door sections "$SHAPE")" || die "could not read the profile's questions from $SHAPE"
  mapfile -t rows <<< "$rows"
  for row in "${rows[@]}"; do
    [ -n "$row" ] || continue
    IFS=$'\t' read -r f a h q x <<< "$row"
    SEC_FLAG+=("$f"); SEC_ASKED+=("$a"); SEC_HEADING+=("$h"); SEC_Q+=("$q"); SEC_HELP+=("$x")
  done
}

# section_flag WORD: is --WORD a profile question's flag twin? Prints the
# section's index.
section_flag() {
  local i
  for i in "${!SEC_FLAG[@]}"; do
    if [ "${SEC_FLAG[$i]}" = "$1" ] && [ "${SEC_ASKED[$i]}" = 1 ]; then printf '%s' "$i"; return 0; fi
  done
  return 1
}

# The flag twins, for a usage line: [--purpose TEXT] [--not-for TEXT] ...,
# wrapped, every line after the first indented by INDENT spaces.
section_flags_usage() {
  local i out="" pad
  for i in "${!SEC_FLAG[@]}"; do [ "${SEC_ASKED[$i]}" = 1 ] && out+="[--${SEC_FLAG[$i]} TEXT] "; done
  printf -v pad '%*s' "${1:-0}" ''
  printf '%s\n' "${out% }" | fold -s -w $((78 - ${1:-0})) | sed 's/ *$//' | sed "2,\$s/^/$pad/"
}

# take_answer ADIR FLAG TEXT: an answer given as a flag, kept as the
# occupant typed it; an empty one answers nothing.
take_answer() {
  local adir="$1" flag="$2" text="$3"
  if [ -z "${text//[[:space:]]/}" ]; then rm -f "$adir/$flag"; return 0; fi
  printf '%s\n' "$text" > "$adir/$flag" || die "could not keep the answer to --$flag"
}

# ask_timezone ADIR: after Site, the zone the occupant lives in, defaulting
# to the machine's when that resolves. A zone that does not resolve is
# named with what fixes it and asked again; the same answer twice keeps
# it as given, and the founding session settles it with him.
ask_timezone() {
  local adir="$1" machine def="" ans again=""
  [ -s "$adir/timezone.given" ] || [ -s "$adir/timezone" ] && return 0
  machine="$(machine_zone)"
  zone_resolves "$machine" && def="$machine"
  while :; do
    ask ans "The timezone you live in, a zone name such as America/Chicago (--timezone)" "${again:-$def}" 0 \
      "The zone the office keeps its dates and times in: where you live, which a machine's clock does not always say. A name from the zone database (Continent/City), checked against $(zoneinfo_dir). ${def:+The default is the zone this machine is set to. }A plain return leaves it to the founding session."
    [ -n "$ans" ] || return 0
    if zone_resolves "$ans" || [ "$ans" = "$again" ]; then
      printf '%s\n' "$ans" > "$adir/timezone.given" || die "could not keep the timezone"
      return 0
    fi
    printf '  %s is not in %s: %s\n  give another zone, or the same one again to keep it as given\n' \
      "$ans" "$(zoneinfo_dir)" "$(zone_remedy "$ans")" >&2
    again="$ans"
  done
}

# ask_paragraph VAR PROMPT HELP: an answer that may run to several lines,
# on a terminal. Each line is kept as typed (its trailing spaces aside),
# and a blank line ends the answer; a blank first line skips the
# question, and ? as the first line explains it. The flag twin with a
# file, or the founding session's conversation, takes anything longer.
ask_paragraph() {
  local __var="$1" prompt="$2" help="$3" line lines=()
  while :; do
    IFS= read -r -p "$prompt [several lines welcome; a blank line ends the answer, and return at once skips]: " line \
      || die "no answer given to: $prompt"
    line="$(printf '%s' "$line" | sed 's/^[[:space:]]*//; s/[[:space:]]*$//')"
    if [ "$line" = "?" ]; then printf '%s\n' "$help" | fold -s -w 76 | sed 's/^/  /' >&2; continue; fi
    break
  done
  if [ -z "$line" ]; then printf -v "$__var" '%s' ""; return 0; fi
  lines=("$line")
  while IFS= read -r -p "  > " line; do
    line="$(printf '%s' "$line" | sed 's/[[:space:]]*$//')"
    [ -n "${line//[[:space:]]/}" ] || break
    lines+=("$line")
  done
  printf -v "$__var" '%s' "$(printf '%s\n' "${lines[@]}")"
}

# ask_profile ADIR: on a terminal, the profile's questions that neither a
# flag nor a kept answer answers yet, one per section in the shape's
# order, worded from its asks line; the timezone right after Site. An
# answer may be a paragraph (ask_paragraph: a blank line ends it), and a
# plain return at once leaves a section to the founding session. Piped,
# nothing is asked and what was given is what ships.
ask_profile() {
  local adir="$1" i ans said=0 tz_asked=0
  can_ask || return 0
  for i in "${!SEC_FLAG[@]}"; do
    [ "${SEC_ASKED[$i]}" = 1 ] || continue
    if [ ! -s "$adir/${SEC_FLAG[$i]}" ]; then
      if [ "$said" = 0 ]; then
        log "the profile's questions, one per section; your answers go to the founding session as you type them. An answer may run to several lines, and a blank line ends it; ? explains a question, and a plain return at once leaves it for the founding session to ask"
        said=1
      fi
      ask_paragraph ans "${SEC_Q[$i]} (--${SEC_FLAG[$i]})" "${SEC_HELP[$i]}"
      [ -z "$ans" ] || take_answer "$adir" "${SEC_FLAG[$i]}" "$ans"
    fi
    if [ "${SEC_HEADING[$i]}" = Site ]; then ask_timezone "$adir"; tz_asked=1; fi
  done
  [ "$tz_asked" = 1 ] || ask_timezone "$adir"
}

founding_goal() {
  printf 'Found the %s office: write its profile with the occupant section by section, file the occupant'"'"'s words from this conversation as a notepad page, and set the office'"'"'s real timezone in the floor plan and the profile'"'"'s Site section, asking the occupant rather than trusting the machine clock' "$1"
}

# found_office ROOT VIA GOAL ADIR: the founding door. The profile's
# questions (asked on a terminal for what ADIR does not answer yet); the
# timezone checked and, when it resolves, written to the floor plan, so
# the office's dates are the occupant's from the founding folder on; the
# founding folder (the one on the desk, or a new one: founding, size
# small, class meta, source VIA) with the answers kept in it as
# answers.md; then the founding session sent out through office start,
# scoped to the profile, the notepad and the floor plan, with a brief
# carrying the answers. Returns 1, having said why, when the session did
# not go out; the answers stay in the folder for office found.
found_office() {
  local root="$1" via="$2" goal="$3" adir="$4"
  local name folder kept zone="" floor_zone floor_ok=no wrote=no remedy tz day f i summary brief rc
  name="$(helper get "$root/$MANIFEST_REL" office.name --default "$(basename "$root")")"
  folder="$(door door-folder "$root" founding)" || die "could not look for a founding folder on the desk"
  if [ -n "$folder" ]; then
    kept="$(door load-answers "$root/$folder" --into "$adir" --shape "$SHAPE")" \
      || die "could not read the answers kept in $folder/answers.md"
    [ -z "$kept" ] || log "kept from $folder/answers.md, where they were given before: $(printf '%s' "$kept" | paste -sd, - | sed 's/,/, /g')"
  fi
  ask_profile "$adir"

  # The timezone: a zone given now (a flag or the question) is checked; a
  # kept one was checked when it was given, and is checked again here.
  if [ -s "$adir/timezone.given" ]; then
    zone="$(head -n 1 "$adir/timezone.given")"
    rm -f "$adir/timezone.answered"
  elif [ -s "$adir/timezone" ]; then
    zone="$(head -n 1 "$adir/timezone")"
  fi
  floor_zone="$(office_tz_named "$root")"
  if [ -n "$zone" ]; then
    printf '%s\n' "$zone" > "$adir/timezone"
    if zone_resolves "$zone"; then
      printf 'yes\n' > "$adir/timezone.resolves"; : > "$adir/timezone.remedy"
      if [ "$zone" != "$floor_zone" ]; then
        if reader writers "$root" "$MANIFEST_REL" >/dev/null 2>&1; then
          door set-timezone "$root/$MANIFEST_REL" "$zone" || die "could not write $zone to the floor plan's timezone"
          commit_paths "$root" "$via: the timezone the occupant lives in, $zone" "$MANIFEST_REL" \
            || warn "the floor plan's timezone was written but not committed"
          log "the office keeps its dates in $zone, the zone you live in (the floor plan's timezone; it was $floor_zone)"
          floor_zone="$zone"; wrote=yes
        else
          warn "the floor plan's timezone was left as $floor_zone: an open session holds the floor plan, or bale's registry could not be read; the founding session sets $zone"
        fi
      fi
    else
      remedy="$(zone_remedy "$zone")"
      printf 'no\n' > "$adir/timezone.resolves"; printf '%s\n' "$remedy" > "$adir/timezone.remedy"
      warn "the timezone $zone is not in $(zoneinfo_dir): $remedy; the floor plan keeps $floor_zone, and the founding session settles it with you"
    fi
  fi
  zone_resolves "$floor_zone" && floor_ok=yes
  tz="$(office_tz "$root" 2>/dev/null)"; day="$(office_date "$tz")"
  for i in "${!SEC_FLAG[@]}"; do
    f="${SEC_FLAG[$i]}"
    [ -s "$adir/$f" ] && [ ! -s "$adir/$f.answered" ] && printf '%s through %s\n' "$day" "$via" > "$adir/$f.answered"
  done

  if [ -z "$folder" ]; then
    folder="$(OFFICE_ROOT="$root" FOUNDING_DOOR=1 cmd_open founding --title "Found the $name office" --source "$via" --size small \
      --class meta < /dev/null)" || die "the founding folder could not be opened (the lines above say why); office found tries again"
  else
    log "the founding folder is already on the desk: $folder"
  fi
  summary="$(door write-answers "$root/$folder" --answers "$adir" --shape "$SHAPE" --name "$name" --day "$day" \
    --zone-label "$tz" --via "$via")" || die "could not keep the answers in $folder/answers.md"
  commit_paths "$root" "$via: the profile's answers, in $folder" "$folder/answers.md" \
    || warn "the answers were kept in $folder/answers.md but not committed"
  if [ -n "${summary#*$'\t'}" ]; then
    log "${summary%%$'\t'*} section(s) answered; left to the founding session: ${summary#*$'\t'}"
  else
    log "every section answered (${summary%%$'\t'*}); the founding session writes the profile from them"
  fi

  if ! command -v bale >/dev/null 2>&1; then
    warn "bale is not on PATH, so the founding session did not go out; the answers are kept in $folder/answers.md, and office found sends it once bale is installed"
    return 1
  fi
  brief="$(mktemp)" || die "cannot make a temp file for the founding brief"
  TMP_PATHS+=("$brief")
  door founding-brief "$root" --folder "$folder" --answers "$adir" --shape "$SHAPE" --name "$name" --day "$day" \
    --zone-label "$tz" --install-version "$(install_version)" --floor-zone "$floor_zone" \
    --floor-zone-resolves "$floor_ok" --zone-written "$wrote" --out "$brief" || die "could not compose the founding brief"
  log "sending the founding session out through office start, for $folder"
  ( OFFICE_ROOT="$root" FOUNDING_DOOR=1 cmd_start "${folder#desk/}" --in-office --goal "$goal" --slug "$(slugify "$name")-founding" \
      --write "$PROFILE_REL" --write floor-plan --include floor-plan --brief "$brief" < /dev/null ); rc=$?
  if [ "$rc" != 0 ]; then
    warn "the founding session did not go out (the lines above say why); the answers are kept in $folder/answers.md, and office found sends it"
    return 1
  fi
}

# session_out_for LAND_OUT FOLDER: the session reader land-out lists for
# FOLDER (its lines are SID, where, and the folders recording it).
session_out_for() {
  local line s w fs
  while IFS=$'\t' read -r s w fs; do
    [ -n "$s" ] || continue
    case ", $fs, " in *", $2, "*) printf '%s' "$s"; return 0 ;; esac
  done <<< "$1"
  return 0
}

# The renovation door: office upgrade, stopped at a renovation whose
# declaration does not hold, opens the renovation's folder (or takes the
# one on the desk) and sends the session out through office start, with
# the migration's goal and a brief carrying its summary, its [landed]
# declaration in full and its version. It forecasts what the migration
# declares under writes, or the whole office when it declares nothing
# (what the printed pack line forecast before 0.12.0). A session already
# out for it is named, never sent twice.
renovate_office() {
  local root="$1" version="$2" folder goal brief tz day writes=() w out sid rc
  folder="$(door door-folder "$root" renovation --version "$version")" || die "could not look for the renovation's folder"
  if [ -n "$folder" ] && command -v bale >/dev/null 2>&1; then
    out="$(reader land-out "$root" 2>/dev/null)" || true
    sid="$(session_out_for "$out" "$folder")"
    if [ -n "$sid" ]; then
      log "the renovation session $sid is out for $folder; it is not sent twice"
      printf 'Next: office land %s  (then office upgrade again: it checks the renovation and stamps the office)\n' "$sid"
      return 0
    fi
  fi
  goal="$(door renovation goal "$root" --version "$version" --migrations "$MIGRATIONS" --install-version "$(install_version)")" \
    || die "could not read migration $version"
  mapfile -t writes < <(door renovation writes "$root" --version "$version" --migrations "$MIGRATIONS" --install-version "$(install_version)")
  command -v bale >/dev/null 2>&1 || die "bale is not on PATH, so the renovation session cannot go out; office upgrade sends it once bale is installed"
  if [ -z "$folder" ]; then
    folder="$(OFFICE_ROOT="$root" RENOVATING=1 cmd_open "upgrade-$(slugify "$version")" --title "Renovate for office-src $version" \
      --source "office upgrade" --size small --class meta < /dev/null)" || die "the renovation's folder could not be opened (the lines above say why)"
  else
    log "the renovation's folder is already on the desk: $folder"
  fi
  tz="$(office_tz "$root" 2>/dev/null)"; day="$(office_date "$tz")"
  brief="$(mktemp)" || die "cannot make a temp file for the renovation brief"
  TMP_PATHS+=("$brief")
  door renovation brief "$root" --version "$version" --migrations "$MIGRATIONS" --install-version "$(install_version)" \
    --folder "$folder" --day "$day" --zone-label "$tz" --out "$brief" || die "could not compose the renovation brief"
  local args=()
  for w in "${writes[@]}"; do [ -n "$w" ] && args+=(--write "$w"); done
  log "sending the renovation session out through office start, for $folder"
  ( OFFICE_ROOT="$root" RENOVATING=1 cmd_start "${folder#desk/}" --in-office --goal "$goal" --slug "upgrade-$(slugify "$version")" \
      "${args[@]}" --brief "$brief" < /dev/null ); rc=$?
  [ "$rc" = 0 ] || die "the renovation session did not go out (the lines above say why); office upgrade sends it again"
}

# --- verbs -------------------------------------------------------------------

# The install's own catalogs, checked before anything is built from
# them: office status reports a defect and exits 0, office init refuses.
require_sound_install() {
  local defects rc
  defects="$(helper catalog-check "$VERBS" "$CATALOG" 2>/dev/null)"; rc=$?
  case $rc in
    0) debug "the install's catalogs hold: $VERBS, $CATALOG" ;;
    3) log "the install at $OFFICE_SRC has a defect in its catalogs (share/verbs.toml, share/spaces.toml):"
       printf '%s\n' "$defects" | sed 's/^/[office]   /' >&2
       die "refusing to build an office from a defective install; fix office-src and run install.sh again" ;;
    *) die "could not check the install's catalogs ($VERBS, $CATALOG); refusing to build an office from them" ;;
  esac
}

cmd_init() {
  local path="" name="" set_default=1 parent root anc ask_projects=1 project_specs=() checked="" pname ppath
  local founding=1 adir given=() i
  # The profile's questions are the shape's, so their flag twins are too.
  load_sections
  adir="$(mktemp -d)" || die "cannot make temp space for the profile's answers"
  TMP_PATHS+=("$adir")
  while [ $# -gt 0 ]; do
    case "$1" in
      --name) [ $# -ge 2 ] || die "--name needs a value"; name="$2"; shift 2 ;;
      --timezone) [ $# -ge 2 ] || die "--timezone needs a zone name, such as America/Chicago"
                  printf '%s\n' "$2" > "$adir/timezone.given"; given+=("$1"); shift 2 ;;
      --no-founding) founding=0; shift ;;
      --project) [ $# -ge 2 ] || die "--project needs a project's repo: --project PATH, or --project NAME=PATH"
                 project_specs+=("$2"); shift 2 ;;
      --no-projects) ask_projects=0; shift ;;
      --path) [ $# -ge 2 ] || die "--path needs a value"; [ -z "$path" ] || die "init takes one path"; path="$2"; shift 2 ;;
      --no-default) set_default=0; shift ;;
      -h|--help) usage_init; return 0 ;;
      -*) if i="$(section_flag "${1#--}")"; then
            [ $# -ge 2 ] || die "$1 needs your answer: ${SEC_Q[$i]}"
            take_answer "$adir" "${1#--}" "$2"; given+=("$1"); shift 2
          else
            usage_init >&2; die "office init does not know $1; the flags above are what it takes"
          fi ;;
      *) [ -z "$path" ] || die "init takes one path"; path="$1"; shift ;;
    esac
  done
  [ "$founding" = 1 ] || [ "${#given[@]}" -eq 0 ] \
    || die "--no-founding sends no founding session, so it takes none of the profile's answers (${given[*]}); office found takes them later"
  require_tools git python3 timeout
  require_sound_install
  if [ -z "$path" ]; then
    can_ask || { usage_init >&2; die "init needs a path: office init PATH (or --path PATH); piped input is never asked"; }
    ask path "Where to build the office, a new or empty directory (--path)" "" 1 \
      "The directory the office is built in: new, or empty. It becomes its own git repo, so it may not sit inside another repo or another office, and it may not be your home directory itself."
    case "$path" in "~"|"~/"*) path="$HOME${path#\~}" ;; esac
    if [ -z "$name" ]; then
      ask name "Name for the office (--name)" "$(basename "$(readlink -m "$path")")" 0 \
        "What the office is called on the walk-in and in its founding session's slug: letters, digits, dot, dash or underscore."
    fi
  fi

  root="$(readlink -m "$path")"
  [ "$root" != "/" ] || die "refusing to make an office of /"
  [ "$root" != "$(readlink -m "$HOME")" ] || die "refusing to make an office of the home directory itself; bale refuses it too"
  if [ -f "$root/$MANIFEST_REL" ]; then die "already an office: $root"; fi
  anc="$root"; while [ ! -e "$anc" ]; do anc="$(dirname "$anc")"; done
  [ -d "$anc" ] || die "not a directory: $anc"
  if parent="$(find_office_from "$anc")"; then die "$root would sit inside the office at $parent"; fi
  if git -C "$anc" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
    die "$root is inside the git repo at $(git -C "$anc" rev-parse --show-toplevel); an office is its own repo"
  fi
  if [ -e "$root" ] && [ -n "$(ls -A "$root" 2>/dev/null)" ]; then
    die "$root exists and is not empty; init builds into an empty or new directory, and things move in after"
  fi
  git var GIT_COMMITTER_IDENT >/dev/null 2>&1 || die "git has no identity to commit with; set it once with: git config --global user.name 'Your Name' && git config --global user.email you@example.com"
  # The projects given as flags are checked before anything is built, so
  # one that is not a repo bale runs in builds nothing.
  if [ "${#project_specs[@]}" -gt 0 ]; then
    checked="$(helper project-spec "${project_specs[@]}")" || die "nothing was built; fix the --project above, or leave it out and add it later with office projects add"
  fi

  [ -n "$name" ] || name="$(basename "$root")"
  [[ "$name" =~ ^[A-Za-z0-9][A-Za-z0-9._-]*$ ]] || die "office name must be letters, digits, dot, dash or underscore: $name"
  local version built_at tz sp
  version="$(install_version)"
  built_at="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
  tz="$(machine_zone)"
  tz="${tz:-UTC}"

  log "building office '$name' at $root from office-src $version"
  mkdir -p "$root/floor-plan" || die "cannot create $root"
  helper render-manifest "$CATALOG" --name "$name" --version "$version" --built-at "$built_at" --timezone "$tz" > "$root/$MANIFEST_REL" \
    || die "could not write the floor plan; $root is partial, remove it with: rm -rf $(printf '%q' "$root")"
  while IFS= read -r sp; do
    case "$sp" in
      "$PROFILE_REL"|floor-plan) ;;
      *) mkdir -p "$root/$sp" && : > "$root/$sp/.keep" || die "cannot create space $sp" ;;
    esac
    debug "space: $sp"
  done < <(helper base-spaces "$CATALOG")
  sed -e "s|{{name}}|$(sed_rhs "$name")|g" -e "s|{{root}}|$(sed_rhs "$root")|g" -e "s|{{timezone}}|$(sed_rhs "$tz")|g" \
      -e "s|{{machine}}|$(sed_rhs "$(hostname 2>/dev/null || printf unknown)")|g" -e "s|{{date}}|${built_at%%T*}|g" \
      "$TEMPLATES/profile.md" > "$root/$PROFILE_REL" || die "could not write the profile stub"
  printf '.bale/\n' > "$root/.gitignore"

  log "first survey"
  write_survey "$root" | sed 's/^/[office] survey: /' >&2
  # After the survey, so the survey page is on disk to be a pull.
  helper render-bale-toml "$root/$MANIFEST_REL" --root "$root" > "$root/$BALE_TOML_REL" || die "could not write $BALE_TOML_REL"
  debug "wrote $BALE_TOML_REL: the include group that pulls the hung items"

  git -C "$root" init -q -b main || die "git init failed in $root"
  git -C "$root" add -A && git -C "$root" commit -q -m "office init: $name (office-src $version)" \
    || die "the first commit failed; $root is partial, remove it with: rm -rf $(printf '%q' "$root")"
  log "committed the skeleton, the profile stub, bale.toml and the first survey"

  if [ "$set_default" = "1" ] && [ ! -f "$DEFAULT_FILE" ]; then
    mkdir -p "$CONFIG_DIR" && printf '%s\n' "$root" > "$DEFAULT_FILE" && log "made $root this machine's default office"
  fi
  # Which projects the office watches: the flags', then, on a terminal,
  # asked one at a time through office projects add's own questions until
  # a plain return.
  while IFS=$'\t' read -r pname ppath; do
    [ -n "$pname" ] || continue
    # stdout stays the founding session's report alone.
    ( OFFICE_ROOT="$root" cmd_projects_add --name "$pname" --path "$ppath" ) >&2 \
      || die "the office is built, but $pname could not be added; office projects add $pname $(shq "$ppath") tries again"
  done <<< "$checked"
  if [ "${#project_specs[@]}" -eq 0 ] && [ "$ask_projects" = 1 ] && can_ask; then
    init_ask_projects "$root"
  fi
  if [ "$founding" = 0 ]; then
    log "the office is unfounded until its founding session writes the profile; --no-founding sent none"
    printf 'Next: office found  (it asks the profile'"'"'s questions and sends the founding session out)\n'
    return 0
  fi
  # The founding door: the profile's questions, the founding folder, and
  # the founding session out through office start with the answers.
  if ! OFFICE_ROOT="$root" found_office "$root" "office init" "$(founding_goal "$name")" "$adir"; then
    log "the office is built at $root and unfounded; office found sends the founding session out (the lines above say what stopped it)"
    exit 1
  fi
}

usage_found() {
  load_sections
  cat <<USAGE
usage: office found $(section_flags_usage 20)
                    [--timezone ZONE] [--goal TEXT]
Sends the founding session out for an unfounded office, the way office init
does after it builds one: it asks the profile's questions, one per section
of the profile's required shape in its order (an answer may run to several
lines, and a blank line ends it; ? explains each, and a plain return at
once leaves a section for the founding session to ask about), and the
timezone you live in after Site, checked against the zone database and,
when it resolves, written to the floor plan. It keeps the answers in the
founding folder as answers.md (the folder on the desk, or a new one, source
office found) and sends the founding session out through office start, in
the office, forecasting the profile, the notepad and the floor plan, with a
brief carrying your answers verbatim and saying which sections were left
to ask. Answers a founding folder already keeps are kept, so only what was
skipped is asked again; a flag given now wins. Piped, it asks nothing and
sends what it was given. It refuses a founded office, and one whose
founding session is out (office land SID brings that back). The Founding
section is never asked: the founding session writes it. When the founding
session lands applied and the profile is complete, office land closes the
founding folder.
Under the hood: office open, then office start's own code (bale pack --json,
bale pack --context for each context tarball).
Examples:
  office found                                 (asks what is not answered yet)
  office found --purpose "My own tools, and my life outside work" --timezone America/Chicago
  office start 2026-10-06-founding             (the same, from the founding folder)
USAGE
}

cmd_found() {
  local root adir goal="" i out sid folder
  load_sections
  adir="$(mktemp -d)" || die "cannot make temp space for the profile's answers"
  TMP_PATHS+=("$adir")
  while [ $# -gt 0 ]; do
    case "$1" in
      --timezone) [ $# -ge 2 ] || die "--timezone needs a zone name, such as America/Chicago"
                  printf '%s\n' "$2" > "$adir/timezone.given"; shift 2 ;;
      --goal) [ $# -ge 2 ] || die "--goal needs a sentence"; goal="$2"; shift 2 ;;
      -h|--help) usage_found; return 0 ;;
      -*) if i="$(section_flag "${1#--}")"; then
            [ $# -ge 2 ] || die "$1 needs your answer: ${SEC_Q[$i]}"
            take_answer "$adir" "${1#--}" "$2"; shift 2
          else
            usage_found >&2; die "office found does not know $1; the flags above are what it takes"
          fi ;;
      *) usage_found >&2; die "office found takes no word ($1); the profile's answers are flags" ;;
    esac
  done
  require_tools git python3 timeout
  root="$(resolve_office)" || exit 1
  require_current "$root"
  if helper profile-check "$root/$PROFILE_REL" "$SHAPE" >/dev/null 2>&1; then
    die "this office is founded: its profile is complete, and nothing re-founds it (a change to the profile is an office session's, from a folder)"
  fi
  # A founding session already out is landed, never sent twice.
  folder="$(door door-folder "$root" founding)" || die "could not look for a founding folder on the desk"
  if [ -n "$folder" ] && command -v bale >/dev/null 2>&1; then
    out="$(reader land-out "$root" 2>/dev/null)" || true
    sid="$(session_out_for "$out" "$folder")"
    [ -z "$sid" ] || die "the founding session $sid is out for $folder; office land $sid brings it back"
  fi
  [ -n "$goal" ] || goal="$(founding_goal "$(helper get "$root/$MANIFEST_REL" office.name --default "$(basename "$root")")")"
  found_office "$root" "office found" "$goal" "$adir" || exit 1
}

usage_survey() {
  cat <<'USAGE'
usage: office survey [--no-commit | --before-pack]
Rewrites floor-plan/survey.md with facts about this machine (the system,
tools and their versions, the timezone, mounts by name, the bale and
office-src installs, and the office's own drawer/survey steps), says what
changed since the last survey, and commits the page. Facts only.
--before-pack is how office start runs it, once its checks have passed
and before it packs: never fatal, and left alone while an open session's
forecast holds the page.
Examples:
  office survey
  office survey --no-commit
USAGE
}

# project_dir_ok PATH: is it the top of a git repo bale runs in? When it
# is not, the reason, indented, for a wizard to ask again.
project_dir_ok() {
  local why
  if why="$(helper check-project-dir -- "$1" 2>&1 >/dev/null)"; then return 0; fi
  printf '  %s\n' "${why#\[office\] error: }" >&2
  return 1
}

# On a terminal, after building: which projects the office watches, one
# at a time through office projects add's own questions (the path, where
# it is, the name, what rides, what runs after it lands), until a plain
# return. A path that does not check is said and asked again at once, by
# add's own wizard; nothing here stops the office being built.
init_ask_projects() {
  local root="$1" p n=0 q
  log "which projects does this office watch? Each is the top of a git repo bale runs in, on this machine or on a host the office reaches over ssh; office start packs its sessions and office land brings them back. A plain return ends the list, and office projects add adds one any time"
  while :; do
    if [ "$n" -eq 0 ]; then q="A project this office watches: the path to its repo (--project PATH)"
    else q="Another project's path (--project PATH)"; fi
    ask p "$q" "" 0 \
      "The top of a project's git repo, absolute or ~/..., where bale has run (a .bale/ directory) or is set up (a bale.toml), or which the office prepares for bale; on this machine, or, when the next question names a host, as that host's shell sees it. The office reads what bale records there, packs that project's sessions there, and keeps what rides with it in its own floor plan, never in the repo. A plain return ends the list."
    [ -n "$p" ] || break
    if ( OFFICE_ROOT="$root" cmd_projects_add --path "$p" ) >&2; then
      n=$((n + 1))
    else
      printf '  that one was not added (the line above says why); give another path, or a plain return\n' >&2
    fi
  done
  if [ "$n" -eq 0 ]; then log "no projects yet; office projects add adds one when you want it"
  else log "this office watches $n project(s); office projects lists them"; fi
  return 0
}

cmd_survey() {
  local commit=1 root before_pack=0
  while [ $# -gt 0 ]; do
    case "$1" in
      --no-commit) commit=0; shift ;;
      --before-pack) before_pack=1; shift ;;
      -h|--help) usage_survey; return 0 ;;
      *) die "unknown option for survey: $1" ;;
    esac
  done
  require_tools python3 timeout
  root="$(resolve_office)" || exit 1
  if [ "$before_pack" = 1 ]; then
    [ "$commit" = 1 ] || die "--before-pack commits the page; it takes no --no-commit"
    refresh_survey "$root"; return 0
  fi
  require_current "$root"
  warn_if_unfounded "$root"
  log "surveying $(hostname 2>/dev/null) for $root"
  local report
  report="$(write_survey "$root")" || exit 1
  printf '%s\n' "$report"
  if [ "$commit" = "1" ] && git -C "$root" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
    commit_survey "$root" "$report" "office survey" || die "could not commit $SURVEY_REL"
  fi
}

# commit_survey ROOT REPORT WHO: commit the survey page alone, its
# subject counting the facts that changed.
commit_survey() {
  local root="$1" report="$2" who="$3" n
  git -C "$root" add -- "$SURVEY_REL" || return 1
  if git -C "$root" diff --cached --quiet -- "$SURVEY_REL"; then
    log "survey page unchanged in git"; return 0
  fi
  n="$(printf '%s\n' "$report" | grep -c '^\(added\|removed\|changed\) ' || true)"
  git -C "$root" commit -q -m "$who: $n facts changed" -- "$SURVEY_REL" || return 1
  log "committed $SURVEY_REL ($n facts changed)"
}

# Before office start packs anything (office survey --before-pack, which
# the start in lib/office_bale.py runs once its checks have passed, so a
# refused start commits nothing): survey the machine again, so the hung
# survey every session reads first is never older than its pack
# (doctrine section 13). One commit, the page alone. Never fails a
# start: a survey that cannot run, or a page an open session's forecast
# holds (the one-writer rule), leaves the page as it is and says how old
# it is and which office-src it records.
refresh_survey() {
  local root="$1" held rc report age
  age="$(helper survey-age "$root/$SURVEY_REL" --install "$(install_version)" 2>/dev/null || printf 'unreadable')"
  held="$(reader writers "$root" "$SURVEY_REL" 2>/dev/null)"; rc=$?
  case $rc in
    0) ;;
    3) warn "an open session holds $SURVEY_REL (the one-writer rule), so office start leaves the survey as it is: $age"
       printf '%s\n' "$held" | sed 's/^/[office]   /' >&2
       return 0 ;;
    *) warn "bale's registry in this office could not be read, so office start leaves the survey as it is: $age"
       return 0 ;;
  esac
  if ! report="$( (write_survey "$root") 2>/dev/null )"; then
    warn "the survey could not run, so the session reads the survey as it was: $age (office survey says why)"
    return 0
  fi
  if git -C "$root" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
    commit_survey "$root" "$report" "office start: survey" \
      || warn "the survey was refreshed but not committed; $SURVEY_REL is changed on disk"
  fi
  log "surveyed this machine again for the session ($(helper survey-age "$root/$SURVEY_REL" --install "$(install_version)" 2>/dev/null))"
}

usage_status() {
  cat <<'USAGE'
usage: office status
Says whether the office matches the installed tool, read-only: the version
stamp and any skew, whether the install is level with the working copy it
was installed from, whether the profile is complete, the survey's age and
the office-src it records, whether the floor plan's timezone resolves (and
what fixes it when it does not), whether bale.toml's include group matches
the floor plan, the install's catalogs, folders against their History,
filed pages against git, the drafting table against the catalog and each
ratified charter against git from its ratifying commit on, and the
installed bale and the projects. It reports and exits 0.
Examples:
  office status
  OFFICE_ROOT=~/offices/work office status
USAGE
}

# The install against the working copy it was installed from, as
# install.sh stamped it in INSTALLED: an install that is not the
# source's HEAD says so, with the line that brings it level. An install
# moves only when install.sh runs (office land runs it for office-src as
# an after-land action, when office land lands the session); this line
# is how an install left behind is seen.
install_source_line() {
  local stamp="$OFFICE_SRC/INSTALLED" src commit head have v
  if [ ! -f "$stamp" ]; then
    printf 'source:     none recorded (no INSTALLED stamp: this office-src runs from a working copy, not an install)\n'
    return 0
  fi
  src="$(sed -n 's/^source: //p' "$stamp" | head -n 1)"
  commit="$(sed -n 's/^commit: //p' "$stamp" | head -n 1)"
  if [ -z "$src" ] || ! git -C "$src" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
    printf 'source:     %s, which is not a git work tree here, so the install cannot be compared with it\n' "${src:-(unrecorded)}"
    return 0
  fi
  head="$(git -C "$src" rev-parse HEAD 2>/dev/null)"
  have="$(git -C "$src" rev-parse --verify --quiet "${commit}^{commit}" 2>/dev/null)"
  if [ -n "$have" ] && [ "$have" = "$head" ]; then
    printf 'source:     %s at %s, as installed\n' "$src" "$commit"
  else
    v="$(git -C "$src" show HEAD:VERSION 2>/dev/null | head -n 1)"
    printf 'source:     BEHIND: the install is %s, and %s is now at %s (office-src %s); (cd %s && ./install.sh) brings the install level\n' \
      "$commit" "$src" "$(git -C "$src" rev-parse --short HEAD)" "${v:-?}" "$(shq "$src")"
  fi
}

cmd_status() {
  local root report state office_v built profile rc
  case "${1:-}" in -h|--help) usage_status; return 0 ;; esac
  [ $# -eq 0 ] || { usage_status >&2; die "office status takes no arguments"; }
  root="$(resolve_office)" || exit 1
  report="$(skew_report "$root")" || exit 1
  state="$(printf '%s\n' "$report" | head -n 1)"
  office_v="$(helper stamp "$root/$MANIFEST_REL" migrated_to)"
  built="$(helper stamp "$root/$MANIFEST_REL" built_from)"
  printf 'office:     %s\n' "$root"
  printf 'name:       %s\n' "$(helper get "$root/$MANIFEST_REL" office.name --default "(unnamed)")"
  printf 'install:    office-src %s at %s\n' "$(install_version)" "$OFFICE_SRC"
  install_source_line
  printf 'built from: %s\n' "$built"
  printf 'migrated:   %s\n' "$office_v"
  case "$state" in
    current) printf 'skew:       none\n' ;;
    ahead)   printf 'skew:       AHEAD; office migrated past this install; install %s or later\n' "$office_v" ;;
    behind)  printf 'skew:       BEHIND; run: office upgrade\n'
             printf '%s\n' "$report" | tail -n +2 | cut -f1,2,4 | sed 's/\t/ (/; s/\t/): /; s/^/  pending:  /' ;;
  esac
  profile="$(helper profile-check "$root/$PROFILE_REL" "$SHAPE")"; rc=$?
  case $rc in
    0) printf 'profile:    complete\n' ;;
    3) printf 'profile:    INCOMPLETE; this office is unfounded\n'
       printf '%s\n' "$profile" | sed 's/^/  /' ;;
    *) printf 'profile:    could not be checked\n' ;;
  esac
  printf 'survey:     %s\n' "$(helper survey-age "$root/$SURVEY_REL" --install "$(install_version)" 2>/dev/null || printf 'unreadable')"
  local tz_named
  tz_named="$(office_tz_named "$root")"
  if zone_resolves "$tz_named"; then
    printf 'timezone:   %s\n' "$tz_named"
  else
    printf 'timezone:   PROBLEM: the floor plan names %s, which is not in %s, so the office runs on UTC\n' "$tz_named" "$(zoneinfo_dir)"
    printf '  %s\n' "$(zone_remedy "$tz_named")"
  fi
  local drift
  drift="$(helper include-group-check "$root/$MANIFEST_REL" "$root/$BALE_TOML_REL" "$root")"
  case $? in
    0) printf 'hung items: bale.toml include group matches the floor plan\n' ;;
    3) printf 'hung items: bale.toml differs from the floor plan\n'; printf '%s\n' "$drift" | sed 's/^/  /' ;;
    *) printf 'hung items: could not compare bale.toml with the floor plan\n' ;;
  esac
  # The install's catalogs, not the office's: a verb declared unattended
  # with no landing, or a hung page that is also filed, is a defect in
  # office-src that every office on this install should hear about.
  local defects
  defects="$(helper catalog-check "$VERBS" "$CATALOG" 2>/dev/null)"
  case $? in
    0) printf 'catalogs:   every unattended session kind declares a landing; no hung page is filed\n' ;;
    3) printf 'catalogs:   DEFECT in the install at %s (share/verbs.toml, share/spaces.toml)\n' "$OFFICE_SRC"
       printf '%s\n' "$defects" | sed 's/^/  /' ;;
    *) printf 'catalogs:   could not be checked\n' ;;
  esac
  # The desk's facts: every folder's status agrees with its History's
  # last state-changing line, and the numbers are minted once each.
  helper folder-check "$root" 2>/dev/null
  case $? in 0|3) ;; *) printf 'folders:    could not be checked\n' ;; esac
  # Filed pages only grow at their end: git's history of every filed
  # page the floor plan lists, the net for a hand edit that went
  # through neither bale nor a script.
  helper filed-check "$root" 2>/dev/null
  case $? in 0|3) ;; *) printf 'filed:      could not be checked (is the office a git repo?)\n' ;; esac
  # The drafting table, when it exists, against the install's catalog;
  # and every ratified charter's bytes against git from its ratifying
  # commit on.
  drafting table-check "$root" 2>/dev/null
  case $? in 0|3) ;; *) printf 'drafting:   could not be checked\n' ;; esac
  # The in-tray, when it exists, against the install's catalog, and every
  # drop's page against the shape office drop writes (0.19.0).
  dropx tray-check "$root" 2>/dev/null
  case $? in 0|3) ;; *) printf 'in-tray:    could not be checked\n' ;; esac
  # The handbook, when it exists, against the install's catalog, and every
  # chapter against the shape office land writes (0.20.0).
  sortx handbook-check "$root" 2>/dev/null
  case $? in 0|3) ;; *) printf 'handbook:   could not be checked\n' ;; esac
  # The read side: which bale is installed against the version the
  # office's reads were written for, and whether each project in scope
  # can be read. Lines, never a refusal.
  reader status-lines "$root" || printf 'bale:       the read side could not be checked\n'
}

# Run planned migrations in a target office. Arguments: target, plan file.
# Prints the applied lines to stdout. Returns 0 when every migration ran,
# 10 when it stopped at a renovation (whose line is the last printed),
# 1 on failure.
run_migrations() {
  local target="$1" plan="$2" version kind action summary landed filed changed
  # Filed paper, one pathspec per line: a whole space, or the paths a
  # part-filed space lists (a path may hold a glob, which git expands;
  # a path that does not exist yet matches nothing and refuses nothing).
  mapfile -t filed < <(helper spaces "$target/$MANIFEST_REL" filed)
  while IFS=$'\t' read -r version kind action summary landed; do
    [ -n "$version" ] || continue
    if [ "$kind" = "renovation" ]; then
      local unmet
      if unmet="$(helper landed "$version" "$MIGRATIONS" "$(install_version)" "$target")"; then
        log "migration $version is a renovation and its declaration holds: $landed"
        helper set-migrated "$target/$MANIFEST_REL" "$version" || return 1
        printf 'verified\t%s\t%s (renovation, checked)\n' "$version" "$summary"
        continue
      fi
      [ -n "$unmet" ] || { log "could not check renovation $version"; return 1; }
      printf '%s\n' "$unmet" | sed "s/^/[office]   $version not landed yet: /" >&2
      printf 'renovation\t%s\t%s\t%s\t%s\n' "$version" "$action" "$summary" "$landed"
      return 10
    fi
    log "migration $version: $summary"
    if ! (cd "$target" && OFFICE_ROOT="$target" OFFICE_MIGRATION="$version" OFFICE_SRC="$OFFICE_SRC" timeout 300 bash "$MIGRATIONS/$action") >&2; then
      log "migration $version failed in $target"
      return 1
    fi
    if [ "${#filed[@]}" -gt 0 ]; then
      changed="$(git -C "$target" status --porcelain -- "${filed[@]}")"
      if [ -n "$changed" ]; then
        log "migration $version touched filed paper, which is never rewritten:"
        printf '%s\n' "$changed" | sed 's/^/[office]   /' >&2
        return 1
      fi
    fi
    helper set-migrated "$target/$MANIFEST_REL" "$version" || return 1
    printf 'applied\t%s\t%s\n' "$version" "$summary"
  done < "$plan"
  return 0
}

usage_upgrade() {
  cat <<'USAGE'
usage: office upgrade [--dry-run]
Runs the migrations a breaking release of office-src ships, after a dry run
on a scratch clone, and lands them as one commit. A migration that needs
judgment stops at a renovation: upgrade opens a folder for it on the desk
(upgrade-VERSION, source office upgrade) and sends the renovation session
out through office start, in the office, with the migration's goal and a
brief carrying its summary, its [landed] declaration and its version; the
session forecasts what the migration declares under writes, or the whole
office. office land SID brings it back, and the next run of office upgrade
checks the declaration and stamps the office. A renovation session already
out is named, never sent twice. Additive releases need nothing; upgrade
says so.
Under the hood, for a renovation: office open, then office start's own code
(bale pack --json, bale pack --context for each context tarball).
Examples:
  office upgrade --dry-run
  office upgrade
USAGE
}

cmd_upgrade() {
  local dry=0 root report state office_v plan scratch rc applied msg
  while [ $# -gt 0 ]; do
    case "$1" in
      --dry-run) dry=1; shift ;;
      -h|--help) usage_upgrade; return 0 ;;
      *) die "unknown option for upgrade: $1" ;;
    esac
  done
  require_tools git python3 timeout
  root="$(resolve_office)" || exit 1
  report="$(skew_report "$root")" || exit 1
  state="$(printf '%s\n' "$report" | head -n 1)"
  office_v="$(helper stamp "$root/$MANIFEST_REL" migrated_to)"
  case "$state" in
    ahead) die "this office was migrated to $office_v, past the installed office-src $(install_version); install $office_v or later" ;;
    current) log "nothing to upgrade: office at $office_v, office-src $(install_version), no migrations pending"; return 0 ;;
  esac
  git -C "$root" rev-parse --is-inside-work-tree >/dev/null 2>&1 || die "$root is not a git repo; an upgrade lands as a commit"
  [ -z "$(git -C "$root" status --porcelain)" ] || die "$root has uncommitted changes; commit them first so the upgrade is one clean commit"

  plan="$(mktemp)" && scratch="$(mktemp -d)" || die "cannot make temp space for the upgrade"
  TMP_PATHS+=("$plan" "$scratch")
  printf '%s\n' "$report" | tail -n +2 > "$plan"
  log "upgrading $root from $office_v to office-src $(install_version); pending:"
  cut -f1,2,4 "$plan" | sed 's/\t/ (/; s/\t/): /; s/^/[office]   /' >&2

  log "dry run on a scratch clone"
  git clone -q "$root" "$scratch/office" || die "could not clone $root for the dry run"
  run_migrations "$scratch/office" "$plan" > "$scratch/dry.out"; rc=$?
  [ "$rc" -eq 1 ] && die "the dry run failed; $root was not touched"
  log "dry run passed"
  if [ "$dry" = "1" ]; then
    log "dry run only; nothing changed in $root"
    return 0
  fi

  run_migrations "$root" "$plan" > "$scratch/real.out"; rc=$?
  if [ "$rc" -eq 1 ]; then
    git -C "$root" reset -q --hard HEAD && git -C "$root" clean -qfd
    die "the upgrade failed after the dry run passed; $root was reset to its last commit"
  fi
  applied="$(grep -E '^(applied|verified)' "$scratch/real.out" || true)"
  if [ -n "$applied" ]; then
    msg="$scratch/msg"
    {
      printf 'office upgrade: %s to %s\n\n' "$office_v" "$(helper stamp "$root/$MANIFEST_REL" migrated_to)"
      printf '%s\n' "$applied" | cut -f2,3 | sed 's/\t/: /; s/^/- /'
    } > "$msg"
    git -C "$root" add -A && git -C "$root" commit -q -F "$msg" || die "could not commit the upgrade in $root"
    log "committed the upgrade:"
    sed 's/^/[office]   /' "$msg" >&2
  fi
  if [ "$rc" -eq 10 ]; then
    local line version
    line="$(grep '^renovation' "$scratch/real.out" | head -n 1)"
    version="$(printf '%s' "$line" | cut -f2)"
    log "migration $version needs judgment, so it is a renovation session, not a script; it goes out through office start"
    log "when that session has landed, run office upgrade again: it checks the renovation and stamps the office"
    renovate_office "$root" "$version"
  fi
}

# --- the everyday verbs --------------------------------------------------------
#
# Script verbs: the office command alone, in seconds, no session and no
# network. Each commits exactly the paths it touched, so the occupant's
# other work in progress is never swept into a verb's commit.

# The zone database the office checks a timezone against: TZDIR when it
# is set (the variable the C library reads too), else the usual place.
zoneinfo_dir() { printf '%s' "${TZDIR:-/usr/share/zoneinfo}"; }

# The timezone the floor plan names, as written (UTC when it names none).
office_tz_named() {
  helper get "$1/$MANIFEST_REL" office.timezone --default UTC 2>/dev/null || printf 'UTC'
}

# zone_resolves NAME: is NAME a zone file under the zone database?
zone_resolves() {
  local tz="$1"
  [ "$tz" = UTC ] && return 0
  case "$tz" in ""|/*|*..*) return 1 ;; esac
  [ -f "$(zoneinfo_dir)/$tz" ]
}

# zone_remedy NAME: what makes a zone that does not resolve resolve.
# Ubuntu 24.04 moved the legacy names (America/Indianapolis among them)
# to the tzdata-legacy package; the canonical spelling is found by the
# zone's last name (Indianapolis -> America/Indiana/Indianapolis).
zone_remedy() {
  local tz="$1" dir base found
  dir="$(zoneinfo_dir)"; base="${tz##*/}"
  found="$(cd "$dir" 2>/dev/null && find . \( -path ./posix -o -path ./right \) -prune -o -type f -name "$base" -print 2>/dev/null \
    | sed 's#^\./##' | sort | head -n 3 | paste -sd, - | sed 's/,/, /g')"
  if [ -n "$found" ]; then
    printf 'this zone database spells it %s: the floor plan'"'"'s timezone line can name that, or the package that keeps the legacy names (tzdata-legacy on Debian and Ubuntu) brings %s back' "$found" "$tz"
  else
    printf 'no zone here is named %s: install the package that keeps the legacy names (tzdata-legacy on Debian and Ubuntu), or name a zone %s holds in the floor plan'"'"'s timezone line' "$base" "$dir"
  fi
}

# The office's timezone from its floor plan, checked against the zone
# database; a bad or missing zone falls back to UTC, loudly, with what
# fixes it.
office_tz() {
  local root="$1" tz
  tz="$(office_tz_named "$root")"
  if ! zone_resolves "$tz"; then
    warn "the floor plan's timezone '$tz' is not in $(zoneinfo_dir), so the office runs on UTC; $(zone_remedy "$tz")"
    tz="UTC"
  fi
  printf '%s' "$tz"
}

office_date() { TZ="$1" date +%F; }
office_time() { TZ="$1" date +%H:%M; }

# Commit only the named paths. Returns 1 (after a warning) when there is
# no repo or git refuses; the change on disk stands either way. While
# DEFER_COMMITS names a file (office moves, applying a sitting's moves
# through the verbs' own code), the paths are written there instead, and
# the caller commits them all at once.
commit_paths() {
  local root="$1" msg="$2"; shift 2
  if [ -n "${DEFER_COMMITS:-}" ]; then
    printf '%s\n' "$@" >> "$DEFER_COMMITS" || die "could not keep the paths to commit in $DEFER_COMMITS"
    debug "deferred to office moves' commit: $msg"
    return 0
  fi
  if ! git -C "$root" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
    warn "$root is not a git repo; nothing committed"; return 1
  fi
  git -C "$root" add -A -- "$@" 2>/dev/null || { warn "git add failed for: $*"; return 1; }
  if git -C "$root" diff --cached --quiet -- "$@"; then debug "nothing to commit for: $*"; return 0; fi
  if ! git -C "$root" commit -q -m "$msg" -- "$@" >/dev/null 2>&1; then
    warn "git could not commit ($msg); the change is on disk, uncommitted"; return 1
  fi
  debug "committed: $msg"
}

# Skew for capture: warn, never refuse. Capture is instant and dumb.
warn_on_skew() {
  local root="$1" report state
  report="$(skew_report "$root" 2>/dev/null)" || { warn "could not read this office's version stamp"; return 0; }
  state="$(printf '%s\n' "$report" | head -n 1)"
  case "$state" in
    behind) warn "this office is behind office-src $(install_version) (run: office upgrade); noting anyway" ;;
    ahead) warn "this office was migrated past office-src $(install_version); noting anyway" ;;
  esac
  return 0
}

has_space() {  # has_space ROOT KEY: is the space in this office's floor plan?
  helper get "$1/$MANIFEST_REL" "spaces.$2.path" >/dev/null 2>&1
}

# A folder by exact name, by a unique part of its name, or by its number
# (`folder N`, or N alone when no folder has that number and the digits
# are part of a name), in one space.
find_folder() {
  local root="$1" space="$2" want="$3" d rel matches=()
  [ -n "$want" ] || die "name a folder"
  if [ -d "$root/$space/$want" ]; then printf '%s' "$want"; return 0; fi
  if [[ "$want" =~ ^(folder[[:space:]]+|#)?[0-9]+$ ]]; then
    if rel="$(helper folder-by-number "$root" "$want" 2>/dev/null)"; then
      [ "${rel%%/*}" = "$space" ] || die "$want is $rel, not in $space/"
      printf '%s' "${rel#*/}"; return 0
    fi
    [[ "$want" =~ ^[0-9]+$ ]] || die "no $want on the desk or in the filing cabinet"
  fi
  for d in "$root/$space"/*/; do
    [ -d "$d" ] || continue
    d="$(basename "$d")"
    case "$d" in *"$want"*) matches+=("$d") ;; esac
  done
  case "${#matches[@]}" in
    1) printf '%s' "${matches[0]}" ;;
    0) die "no folder matching '$want' in $space/" ;;
    *) die "'$want' matches ${#matches[@]} folders in $space/: ${matches[*]}" ;;
  esac
}

# On a terminal, a folder a verb was not given: the folders it could
# mean, then the question. Piped, the verb refuses before this.
ask_folder() {
  local __var="$1" root="$2" space="$3" verb="$4" d n=0 number
  printf 'Folders in %s/:\n' "$space" >&2
  for d in "$root/$space"/*/; do
    [ -d "$d" ] || continue
    n=$((n + 1))
    number=""
    [ -f "$d/folder.md" ] && number="$(helper folder-facts "$d/folder.md" 2>/dev/null | sed -n 's/^number\t//p')"
    printf '  %s%s\n' "${number:+folder $number  }" "$(basename "$d")" >&2
  done
  [ "$n" -gt 0 ] || die "nothing in $space/ to $verb"
  ask "$__var" "Which folder: a unique part of its name, or folder N (office $verb FOLDER)" "" 1 \
    "The folder to $verb: its directory name, any part of it that names only one folder, or its number as folder N."
}

usage_note() {
  cat <<'USAGE'
usage: office note TEXT...   (or lines on stdin)
Appends a timed line to today's notepad page, notepad/DATE.md, and commits
that page alone. Capture is instant: it works in an unfounded office and in
one behind or ahead of the installed tool, and only warns. Each line of
stdin is its own note.
Examples:
  office note called the bank; rate locks Friday
  office note "decided: the porch light waits until spring"
  printf '%s\n' "rate locks Friday" "lawyer on Monday" | office note
USAGE
}

cmd_note() {
  local root tz day now page text line n=0
  case "${1:-}" in -h|--help) usage_note; return 0 ;; esac
  root="$(resolve_office)" || exit 1
  warn_on_skew "$root"
  warn_if_unfounded "$root"
  if [ $# -gt 0 ]; then text="$*"
  elif [ ! -t 0 ]; then text="$(cat)"
  else die "nothing to note: give the text as arguments or on stdin"; fi
  [ -n "${text//[[:space:]]/}" ] || die "nothing to note: the text is empty"
  tz="$(office_tz "$root")"; day="$(office_date "$tz")"; now="$(office_time "$tz")"
  page="notepad/$day.md"
  mkdir -p "$root/notepad" || die "cannot create $root/notepad"
  if [ ! -f "$root/$page" ]; then
    helper render-template "$TEMPLATES/notepad-page.md" "date=$day" "title=notes" > "$root/$page" \
      || die "could not start $page"
    printf '\n' >> "$root/$page"
  fi
  text="$(printf '%s' "$text" | helper ascii-escape)"
  while IFS= read -r line; do
    [ -n "${line//[[:space:]]/}" ] || continue
    printf -- '- %s %s\n' "$now" "$line" >> "$root/$page" || die "could not append to $page"
    n=$((n + 1))
  done <<< "$text"
  log "noted $n line(s) in $page"
  # The notepad is filed paper: before committing, the page must be its
  # committed bytes with lines added at the end (doctrine section 15).
  # The words stay on disk either way; nothing is lost, only not filed.
  local why
  why="$(helper append-check "$root" "$page")"
  case $? in
    0) ;;
    3) die "$page differs from its committed bytes other than at its end ($why); the line is on disk but not committed, and office status names the page" ;;
    *) die "could not check $page against its committed bytes; the line is on disk but not committed" ;;
  esac
  commit_paths "$root" "office note: $day $now" "$page" || true
}

usage_slip() {
  cat <<'USAGE'
usage: office slip [TEXT...] [--about WHAT]   (or the text on stdin)
Drops a friction slip in the suggestion box: one new page,
suggestion-box/DATE-SLUG.md, committed on its own. --about names what the
slip is about: the office, a tool (bale, office-src) or one of the
office's projects, so it can be carried to that tool's project. On a
terminal it asks for what it was not told; piped, it never asks. Like
office note, it works in an unfounded office and one behind or ahead of
the installed tool, and only warns.
Examples:
  office slip                                  (asks what caused friction, and about what)
  office slip --about bale pack needs too many flags
  office slip --about office-src the desk does not say why a folder waits
USAGE
}

# A title from words as typed: a leading list marker (1. 2) - * +) and
# emphasis markers (** __ *) taken out, so a slip lifted from a numbered
# Markdown list is titled by its words. The text itself stays as typed.
title_words() {
  sed -E 's/^[[:space:]]*([0-9]+[.)]|[-*+])[[:space:]]+//; s/\*\*|__//g; s/(^|[^[:alnum:]])\*+/\1/g; s/\*+([^[:alnum:]]|$)/\1/g'
}

# A slip is about the office, a tool or a project: one word, the way a
# project is named.
slip_about_choices() {
  local root="$1" names
  names="$(helper project-names "$root/$MANIFEST_REL" 2>/dev/null | paste -sd, - | sed 's/,/, /g')"
  printf 'office, bale, office-src%s' "${names:+, $names}"
}

cmd_slip() {
  local about="" text="" words=() root tz day now title slug page n=1 base
  while [ $# -gt 0 ]; do
    case "$1" in
      --about) [ $# -ge 2 ] || die "--about needs what the slip is about: office, a tool or a project"; about="$2"; shift 2 ;;
      -h|--help) usage_slip; return 0 ;;
      --) shift; words+=("$@"); break ;;
      -*) usage_slip >&2; die "office slip does not know $1; it takes the text and --about" ;;
      *) words+=("$1"); shift ;;
    esac
  done
  root="$(resolve_office)" || exit 1
  warn_on_skew "$root"
  warn_if_unfounded "$root"
  if [ "${#words[@]}" -gt 0 ]; then text="${words[*]}"
  elif [ ! -t 0 ]; then text="$(cat)"
  else
    ask text "What caused friction, in a line or two (office slip TEXT)" "" 1 \
      "Where it hurt and what would remove it, in your words. It lands as its own page in the suggestion box; cleanup and renovation sessions read the box."
  fi
  [ -n "${text//[[:space:]]/}" ] || die "nothing to slip: the text is empty"
  if [ -z "$about" ] && can_ask; then
    ask about "What it is about: $(slip_about_choices "$root") (--about)" "office" 0 \
      "The office itself, a tool the office uses (bale, office-src), or one of this office's projects. A slip about a tool says so, so it can be carried to that tool's project."
  fi
  if [ -n "$about" ] && [[ ! "$about" =~ ^[A-Za-z0-9][A-Za-z0-9._-]*$ ]]; then
    die "--about takes one word, the office, a tool or a project ($(slip_about_choices "$root")), not $(shq "$about")"
  fi
  [ -n "$about" ] || log "the slip does not say what it is about (--about office, a tool or a project says so)"
  tz="$(office_tz "$root")"; day="$(office_date "$tz")"; now="$(office_time "$tz")"
  # The slug from the words as typed, as office open makes one: an
  # escape is no part of a file name.
  slug="$(short_slug "$(printf '%s\n' "$text" | grep -m 1 '[^[:space:]]' | title_words)")"; [ -n "$slug" ] || slug="slip"
  text="$(printf '%s' "$text" | helper ascii-escape)"
  title="$(printf '%s\n' "$text" | grep -m 1 '[^[:space:]]' | title_words | tr -s '[:space:]' ' ' | sed 's/^ //; s/ $//')"
  [ "${#title}" -le 72 ] || title="${title:0:69}..."
  base="suggestion-box/$day-$slug"; page="$base.md"
  while [ -e "$root/$page" ]; do n=$((n + 1)); page="$base-$n.md"; done
  mkdir -p "$root/suggestion-box" || die "cannot create $root/suggestion-box"
  helper render-template "$TEMPLATES/suggestion-slip.md" "title=$title" "about=$about" "dropped=$day $now" "text=$text" \
    > "$root/$page" || { rm -f "$root/$page"; die "could not write $page"; }
  log "slipped $page${about:+ (about $about)}"
  commit_paths "$root" "office slip: $(basename "$page" .md)${about:+ (about $about)}" "$page" || true
  printf '%s\n' "$page"
}

# --- the in-tray: office drop (0.19.0) -----------------------------------------
#
# A message or a thread, captured instant and dumb (doctrine principle 1)
# as one page of the in-tray, with an optional free-text project. Nothing
# is judged here: the sort is a session's (the one office start --drop
# sends, or any session that carries the drop), since judgment sits with
# the session that has the code in context. lib/office_drop.py writes and
# reads the pages; this is the wizard around it.

DROP_PY="$OFFICE_SRC/lib/office_drop.py"
dropx() { python3 -B "$DROP_PY" "$@"; }

usage_drop() {
  cat <<'USAGE'
usage: office drop [FILE | -] [--project TEXT]
Drops a message or a thread in the in-tray: one new page,
in-tray/DATE-SLUG.md, committed on its own, waiting to be sorted. The text
comes from FILE, from stdin (-, or anything piped), or, on a terminal with
neither, from the clipboard (machine.toml's paste_command, asked once). It
says what it took: the first line and how many lines. On a terminal it asks
one question, the project, as free text: the office's projects are offered
as hints, any words are taken, and a plain return leaves it empty
(--project is the flag twin). Piped, it asks nothing. It never refuses a
drop it can write: no project is needed, and like office note it works in an
unfounded office and one behind or ahead of the installed tool, and only
warns. The in-tray arrives with the first drop. Every session office start
sends out carries the unsorted drops; office start --drop in-tray/PAGE sends
one straight out as a project session.
Examples:
  office drop                                  (the clipboard; asks the project)
  office drop --project alpha                  (the clipboard, for alpha)
  office drop thread.txt --project "the website"
  pbpaste | office drop - --project alpha
USAGE
}

cmd_drop() {
  local file="" project="" project_given=0 root tz day now tmp text_file via took lines first slug out page rc
  local paths=() names
  while [ $# -gt 0 ]; do
    case "$1" in
      --project) [ $# -ge 2 ] || die "--project needs the project, in any words (office drop --help)"
                 project="$2"; project_given=1; shift 2 ;;
      -h|--help) usage_drop; return 0 ;;
      -) [ -z "$file" ] || die "office drop takes one text: FILE, or - for stdin"; file="-"; shift ;;
      -*) usage_drop >&2; die "office drop does not know $1; it takes FILE or -, and --project" ;;
      *) [ -z "$file" ] || die "office drop takes one text: FILE, or - for stdin"; file="$1"; shift ;;
    esac
  done
  root="$(resolve_office)" || exit 1
  warn_on_skew "$root"
  warn_if_unfounded "$root"
  tmp="$(mktemp -d "${TMPDIR:-/tmp}/office-drop.XXXXXXXX")" || die "no temporary directory for the drop"
  TMP_PATHS+=("$tmp")
  text_file="$tmp/text"
  if [ "$file" = "-" ]; then
    [ ! -t 0 ] || die "office drop - reads the text from stdin, and stdin is this terminal: pipe the text in, give it as a file, or leave it on the clipboard and give neither"
    cat > "$text_file" || die "could not read the text from stdin"
    via="stdin"
  elif [ -n "$file" ]; then
    [ -f "$file" ] || die "$file: no such file (the text is a file, - for stdin, or neither for the clipboard)"
    cp -- "$file" "$text_file" || die "could not read $file"
    via="file $(basename -- "$file")"
  elif ! can_ask; then
    cat > "$text_file" || die "could not read the text from stdin"
    via="stdin"
  else
    paste_setting "office drop reads the message from the clipboard when it is given no file" \
      "give the message as a file (office drop FILE) or on stdin (office drop -)"
    log "reading the message from the clipboard ($PASTE)"
    timeout 15 bash -c "$PASTE" < /dev/null > "$text_file" 2> "$tmp/paste.err"; rc=$?
    [ "$rc" = 0 ] || die "the clipboard could not be read: $PASTE exited $rc ($(tail -n 1 "$tmp/paste.err")); paste_command in $MACHINE_FILE"
    via="clipboard"
  fi
  took="$(dropx took --text-file "$text_file")" \
    || die "nothing to drop: the text from $([ "$via" = clipboard ] && printf 'the clipboard' || printf '%s' "$via") is empty"
  lines="${took%%$'\t'*}"; first="${took#*$'\t'}"
  log "took $lines line(s) from $([ "$via" = clipboard ] && printf 'the clipboard' || printf '%s' "$via"): $first"
  if [ "$project_given" = 0 ] && can_ask; then
    names="$(helper project-names "$root/$MANIFEST_REL" 2>/dev/null | paste -sd, - | sed 's/,/, /g')"
    ask project "Which project it is for, in any words${names:+ ($names, or anything)} (--project)" "" 0 \
      "Free text, kept on the page as you type it, to help the session that sorts the drop decide where it goes. When it names one of this office's projects, office start --drop sends the drop out on that project without asking. A plain return leaves it empty: the drop is taken either way."
  fi
  tz="$(office_tz "$root")"; day="$(office_date "$tz")"; now="$(office_time "$tz")"
  # The slug from the first line as typed, the way office slip makes one:
  # an escape is no part of a file name.
  slug="$(short_slug "$(python3 -B -c 'import sys
for line in open(sys.argv[1], encoding="utf-8", errors="replace"):
    if line.strip():
        print(line.strip()); break' "$text_file" | title_words)")"
  [ -n "$slug" ] || slug="drop"
  out="$(dropx write "$root" --text-file "$text_file" --project "$project" --via "$via" \
           --day "$day" --time "$now" --slug "$slug")" || die "the drop could not be written (the line above says why)"
  mapfile -t paths <<< "$out"
  page="${paths[0]}"
  log "dropped $page${project:+ (project: $project)}, unsorted"
  # The page alone, like a note; the in-tray's arrival, when this drop
  # brought it, in the same commit.
  commit_paths "$root" "office drop: $(basename "$page" .md)" "${paths[@]}" || true
  printf '%s\n' "$page"
}

usage_open() {
  cat <<'USAGE'
usage: office open [SLUG] [--title TITLE] [--size SIZE] [--lane LANE] [--source SOURCE]
                   [--goal TEXT] [--class CLASS] [--blueprint ID] [--linked GATE]... [--after GATE]...
                   [--serializes-after GATE]... [--consumer GATE]...
                   [--candidate | --filed --sid SID] [--thread < pasted-thread]
Starts a folder on the desk: numbered one more than the highest number on
the desk and in the filing cabinet, status queued, the day it was queued,
and every field it is given. --candidate opens it as a candidate; --filed
--sid SID files it straight into the filing cabinet, done at that session.
On a terminal it asks for the title, size, lane and source it was not
given: a plain return skips one, and ? explains it. The title comes first
and is checked at once: a folder of that name already on the desk or in
the filing cabinet is said before anything else is asked (office start
new offers the one on the desk as the folder to start). Piped, it never
asks.
Examples:
  office open                                  (asks for the title, size, lane, source)
  office open fix-login --title "Fix the login" --size small --lane "office-src: bin/"
  office open fix-login --title "Fix the login" --goal "Fix the login redirect"
                                               (office start offers the goal)
  office open house-hunt --thread < thread.txt (keeps the pasted thread as thread.md)
  office open paint-fence --after "folder 3"   (waits until folder 3 is done)
  office open build-a-shed --candidate         (an idea on the desk, not queued yet)
The fields, and what each takes:
USAGE
  helper field-help all | grep -v -e '^status:' -e '^queued:' -e '^number:' -e '^sid:' | fold -s -w 76 | sed 's/^/  /'
}

# The one-writer rule: a verb that mints a folder number refuses while
# the office's own bale registry shows an open session whose forecast
# holds where the number lands. An office bale has never run in has no
# registry, and nothing to refuse; a registry that cannot be read is
# said loudly and does not stop capture.
require_one_writer() {
  local root="$1" target="$2" out rc
  out="$(reader writers "$root" "$target")"; rc=$?
  case $rc in
    0) debug "one-writer rule: no open session in this office's registry holds $target" ;;
    3) printf '%s\n' "$out" | sed 's/^/[office]   /' >&2
       die "an open session holds $target, so no folder number is minted beside it (the one-writer rule); open the folder once that session is applied or closed" ;;
    *) warn "bale's registry in this office could not be read (the line above says why); minting without the one-writer check" ;;
  esac
}

# A slug made from a title: at most 40 characters, cut at a word.
short_slug() {
  local s
  s="$(slugify "$1")"
  if [ "${#s}" -gt 40 ]; then
    s="${s:0:41}"; s="${s%-*}"; s="${s:0:40}"
  fi
  printf '%s' "$s"
}

cmd_open() {
  local slug="" title="" thread=0 candidate=0 filed=0 sid="" size="" lane="" source="" class="" blueprint="" goal=""
  local after=() serializes=() consumer=() linked=() root tz day name folder number space status verb text asked=0
  local raw_title=""
  local v i
  while [ $# -gt 0 ]; do
    case "$1" in
      --title|--size|--lane|--source|--class|--blueprint|--sid|--after|--serializes-after|--consumer|--linked|--goal)
        [ $# -ge 2 ] || die "$1 needs a value (office open --help explains it)"
        case "$1" in
          --title) title="$2" ;; --size) size="$2" ;; --lane) lane="$2" ;; --source) source="$2" ;;
          --goal) goal="$2" ;;
          --class) class="$2" ;; --blueprint) blueprint="$2" ;; --sid) sid="$2" ;;
          --after) after+=("$2") ;; --serializes-after) serializes+=("$2") ;;
          --consumer) consumer+=("$2") ;; --linked) linked+=("$2") ;;
        esac
        shift 2 ;;
      --thread) thread=1; shift ;;
      --candidate) candidate=1; shift ;;
      --filed) filed=1; shift ;;
      -h|--help) usage_open; return 0 ;;
      -*) usage_open >&2; die "office open does not know $1; the flags above are what it takes" ;;
      *) [ -z "$slug" ] || die "open takes one slug (quote a title with --title)"; slug="$1"; shift ;;
    esac
  done
  [ "$candidate" = 0 ] || [ "$filed" = 0 ] || die "--candidate and --filed are two different births; give one"
  [ -z "$sid" ] || [ "$filed" = 1 ] || die "--sid goes with --filed: a folder born done at that session"
  root="$(resolve_office)" || exit 1
  require_current "$root"
  warn_if_unfounded "$root"

  # Flags first: a value a field does not take is explained, then asked
  # on a terminal and refused when piped.
  raw_title="$title"
  check_field title title --title; check_field size size --size; check_field lane lane --lane
  check_field source source --source; check_field sid sid --sid; check_field goal goal --goal
  check_field class class --class || ask_field class class --class "Class: bale's work class for its sessions" "" 1
  check_field blueprint blueprint --blueprint || ask_field blueprint blueprint --blueprint "Blueprint id, YYYY-MM-DD-slug" "" 1
  for i in "${!after[@]}"; do v="${after[$i]}"; check_field v after --after || ask_field v after --after "Gate: what must be done first" "" 1; after[$i]="$v"; done
  for i in "${!serializes[@]}"; do v="${serializes[$i]}"; check_field v serializes-after --serializes-after || ask_field v serializes-after --serializes-after "Serializes after which folder" "" 1; serializes[$i]="$v"; done
  for i in "${!consumer[@]}"; do v="${consumer[$i]}"; check_field v consumer --consumer || ask_field v consumer --consumer "Consumer that will carry it" "" 1; consumer[$i]="$v"; done
  for i in "${!linked[@]}"; do v="${linked[$i]}"; check_field v linked --linked || ask_field v linked --linked "Linked folder" "" 1; linked[$i]="$v"; done

  tz="$(office_tz "$root")"; day="$(office_date "$tz")"
  if can_ask && [ "$thread" = 0 ]; then
    # The wizard: what matters to the desk, in four answers at most. The
    # title comes first and is checked at once, so a name already on the
    # desk or in the filing cabinet is said before any other question:
    # nobody answers questions whose outcome is a refusal. Opened for
    # office start (new), a folder already on the desk is offered as the
    # one to start.
    local fixed_name=0 taken want_slug ans
    [ -z "$title" ] || fixed_name=1
    [ -z "$slug" ] || fixed_name=1
    while :; do
      if [ -z "$title" ]; then
        ask raw_title "Title, in a few words (--title)" "$slug" 1 "$(field_help title)"; asked=1
        title="$(helper normalize-field title -- "$raw_title")" || die "--title: the title is empty"
      fi
      want_slug="$slug"; [ -n "$want_slug" ] || want_slug="$(short_slug "${raw_title:-$title}")"
      want_slug="$(slugify "$want_slug")"
      [ -n "$want_slug" ] || die "the slug has no letters or digits (give one: office open SLUG)"
      taken=""
      [ ! -e "$root/desk/$day-$want_slug" ] || taken=desk
      [ ! -e "$root/filing-cabinet/$day-$want_slug" ] || taken=filing-cabinet
      [ -n "$taken" ] || break
      if [ "$taken" = desk ] && [ "${OPEN_FOR_START:-0}" = 1 ] && [ "$filed" = 0 ]; then
        ask ans "desk/$day-$want_slug is already on the desk: start it, rather than open another (office start $day-$want_slug)" "yes" 1 \
          "A folder with this title was opened today, perhaps by a start that did not get its session out. yes starts that folder as it is; no asks for another title."
        case "$ans" in
          y|Y|yes|Yes|YES) log "desk/$day-$want_slug is already on the desk; start takes it as it is"
                           printf 'desk/%s\n' "$day-$want_slug"; return 0 ;;
        esac
      fi
      [ "$fixed_name" = 0 ] || { [ "$taken" = desk ] && die "already on the desk: desk/$day-$want_slug"; die "already filed: filing-cabinet/$day-$want_slug (office reopen $day-$want_slug)"; }
      if [ "$taken" = desk ]; then
        printf '  desk/%s is already on the desk; give another title\n' "$day-$want_slug" >&2
      else
        printf '  filing-cabinet/%s is already filed (office reopen %s brings it back); give another title\n' "$day-$want_slug" "$day-$want_slug" >&2
      fi
      title=""; raw_title=""
    done
    if [ -z "$size" ]; then ask_field size size --size "Size: small, medium or high"; asked=1; fi
    if [ -z "$lane" ]; then ask_field lane lane --lane "Lane: the project and paths, as project: paths"; asked=1; fi
    if [ -z "$source" ]; then ask_field source source --source "Source: where the job came from"; asked=1; fi
    if [ "$filed" = 1 ] && [ -z "$sid" ]; then ask_field sid sid --sid "Session id it was done in" "" 1; asked=1; fi
    [ "$asked" = 0 ] || log "other fields take flags: --class, --blueprint, --after, --serializes-after, --consumer, --linked (office open --help explains each)"
  else
    [ -n "$slug" ] || [ -n "$title" ] || die "open needs a slug or a title: office open SLUG, or --title TITLE; piped input is never asked"
    [ "$filed" = 0 ] || [ -n "$sid" ] || die "--filed needs --sid SID, the session the job was done in; piped input is never asked"
  fi
  [ -n "$title" ] || title="$slug"
  # The slug comes from the words as typed, before the title was kept
  # as one ASCII line: an escape is no part of a directory name.
  [ -n "$slug" ] || slug="$(short_slug "${raw_title:-$title}")"
  slug="$(slugify "$slug")"; [ -n "$slug" ] || die "the slug has no letters or digits (give one: office open SLUG)"

  name="$day-$slug"
  [ ! -e "$root/desk/$name" ] || die "already on the desk: desk/$name"
  [ ! -e "$root/filing-cabinet/$name" ] || die "already filed: filing-cabinet/$name (office reopen $name)"
  if [ "$filed" = 1 ]; then
    space=filing-cabinet; status=done; verb=done; text="office open --filed, done at $sid"
  elif [ "$candidate" = 1 ]; then
    space=desk; status=candidate; verb=candidate; text="${MOVE_TEXT:-office open --candidate}"
  else
    space=desk; status=queued; verb=queued; text="${MOVE_TEXT:-office open}"
  fi
  folder="$space/$name"
  require_one_writer "$root" "$space"
  number="$(helper next-number "$root")" || die "no folder number could be minted; the line above says why"

  local args=("title=$title" "number=$number" "status=$status" "queued=$day" "class=$class" "size=$size"
              "lane=$lane" "source=$source" "blueprint=$blueprint" "history=$day $verb: $text")
  for v in "${linked[@]}"; do args+=("linked=$v"); done
  for v in "${after[@]}"; do args+=("after=$v"); done
  for v in "${serializes[@]}"; do args+=("serializes_after=$v"); done
  for v in "${consumer[@]}"; do args+=("consumer=$v"); done
  mkdir -p "$root/$folder" || die "cannot create $folder"
  helper render-template "$TEMPLATES/folder.md" "${args[@]}" > "$root/$folder/folder.md" \
    || { rm -rf "${root:?}/$folder"; die "could not write $folder/folder.md"; }
  if [ -n "$goal" ]; then
    # The goal is a field the command writes after the template's block
    # (0.20.0): office start N offers it as the session's goal.
    helper folder-set-field "$root/$folder/folder.md" --key goal --value "$goal" >/dev/null \
      || { rm -rf "${root:?}/$folder"; die "could not write the goal in $folder/folder.md"; }
  fi
  if [ "$filed" = 1 ]; then
    helper record-session "$root/$folder/folder.md" "$sid" >/dev/null || die "could not record $sid in $folder/folder.md"
  fi
  if [ "$thread" = "1" ]; then
    [ ! -t 0 ] || die "--thread reads the pasted thread on stdin"
    { printf '# Thread that started this job\n\nPasted when the folder was opened, verbatim.\n\n'; helper ascii-escape; } > "$root/$folder/thread.md" \
      || die "could not write $folder/thread.md"
    log "seeded $folder/thread.md from stdin"
  fi
  log "opened $folder as folder $number, $status"
  commit_paths "$root" "office open: $name (folder $number)" "$folder" || true
  printf '%s\n' "$folder"
}

usage_desk() {
  cat <<'USAGE'
usage: office desk [--blueprint ID]
Shows the desk in order, computed from what the folders say: In flight (the
folders a session is open for), Ready (queued folders whose gates are met:
by serializes after, then small first, then number), Parked (under what each
waits for), Candidates, then the riders orphaned in a closed folder and the
desk moves a sitting wrote that office moves has not applied yet. A gate
names a folder, a blueprint (met when its close report exists), an agenda
item (met when a sitting ruled on it) or a ruling (met when it is on the
ledger); one that names nothing is an error line. A gate that cleared
since you last walked in says so. --blueprint ID shows only that arc's
folders, in the same order, then the ones already filed and the
decomposition lines with no folder yet. It only reads.
Examples:
  office desk
  office desk --blueprint 2026-10-05-rider-verbs
  office desk | grep -A3 Parked
USAGE
}

# The desk's groups: In flight, Ready, Parked, Candidates (doctrine
# section 5). A gate that cleared since the last walk-in says so.
cmd_desk() {
  local root tz since rc bp=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --blueprint) [ $# -ge 2 ] || die "--blueprint needs the blueprint's id"; bp="${2#blueprint }"; shift 2 ;;
      -h|--help) usage_desk; return 0 ;;
      *) usage_desk >&2; die "office desk does not know $1" ;;
    esac
  done
  root="$(resolve_office)" || exit 1
  tz="$(office_tz "$root")"
  since="$(last_walk_in "$root")"
  reader desk "$root" --today "$(office_date "$tz")" ${since:+--since "$since"} ${bp:+--blueprint "$bp"}; rc=$?
  case $rc in
    0) return 0 ;;
    3) warn "some of this office's projects could not be read; In flight says which"; return 0 ;;
    *) die "could not render the desk" ;;
  esac
}

# The day of the last walk-in, kept on this machine outside the office
# (the walk-in only reads the office), so the desk can say which gates
# cleared since. Empty when there is none.
walk_in_file() {
  printf '%s/office-src/walk-ins/%s' "${XDG_STATE_HOME:-$HOME/.local/state}" "$(printf '%s' "$1" | sha256sum | cut -c1-16)"
}

last_walk_in() {
  local f
  f="$(walk_in_file "$1")"
  [ -f "$f" ] || { debug "no walk-in recorded for $1 on this machine"; return 0; }
  head -n 1 "$f" | grep -E '^[0-9]{4}-[0-9]{2}-[0-9]{2}$' || debug "unreadable walk-in record: $f"
  return 0
}

record_walk_in() {
  local f
  f="$(walk_in_file "$1")"
  { mkdir -p "$(dirname "$f")" && printf '%s\n' "$2" > "$f"; } 2>/dev/null || debug "could not record this walk-in in $f"
  return 0
}

usage_week() {
  cat <<'USAGE'
usage: office week
Lays this week's plan (calendar/plan.md) against what happened
(calendar/record.md), in the office's timezone: a planned item in the past
with no record that day is a gap. An office without a calendar is told
which renovation adds one. It only reads.
Examples:
  office week
  office tour                                  (a throwaway office with a calendar gap to look at)
USAGE
}

cmd_week() {
  local root tz
  case "${1:-}" in -h|--help) usage_week; return 0 ;; esac
  root="$(resolve_office)" || exit 1
  if ! has_space "$root" calendar; then
    printf 'this office has no calendar. A renovation adds one: an office session that adds the calendar space to the floor plan (doctrine section 5).\n'
    return 0
  fi
  tz="$(office_tz "$root")"
  helper week "$root/calendar" --today "$(office_date "$tz")" --now "$(office_time "$tz")" --tz "$tz" \
    || die "could not read the calendar in $root/calendar"
}

# Moving a folder is not rewriting it: the bytes move, git keeps the
# history, and anything uncommitted in the folder moves with it.
move_folder_dir() {
  local root="$1" from="$2" to="$3" name="$4"
  [ ! -e "$root/$to/$name" ] || die "$to/$name already exists; not overwriting it"
  mkdir -p "$root/$to" || die "cannot create $to"
  mv "$root/$from/$name" "$root/$to/$name" || die "could not move $from/$name to $to/"
  log "moved $from/$name to $to/"
}

# folder_fact FOLDER_MD KEY: status, number, history (1 or 0) or sids.
folder_fact() {
  helper folder-facts "$1" 2>/dev/null | sed -n "s/^$2\t//p"
}

# One History line, and the status line when given, in a folder; each
# says what it did, and a folder from before the field block is left
# as it is and said so at debug.
folder_event() {
  local md="$1" day="$2" verb="$3" text="$4" status="${5:-}" out
  out="$(helper folder-event "$md" --day "$day" --verb "$verb" --text "$text" ${status:+--status "$status"})" \
    || die "could not write the $verb line in $md"
  while IFS= read -r line; do
    case "$line" in
      no\ *) debug "$(basename "$(dirname "$md")"): $line" ;;
      *) log "$(basename "$(dirname "$md")"): $line" ;;
    esac
  done <<< "$out"
}

# The folder a closing job lives on in: an existing folder other than
# the one closing, whose own job has not ended elsewhere (an absorbed,
# split or retired folder carries nothing further).
successor_folder() {
  local root="$1" closing="$2" ref="$3" rel status
  rel="$(helper folder-by-number "$root" "$ref")" || return 1
  [ "${rel#*/}" != "$closing" ] || die "a folder is not absorbed or split into itself"
  status="$(folder_fact "$root/$rel/folder.md" status)"
  case "$status" in
    absorbed|split|retired) die "$(helper normalize-field linked -- "$ref") is $status itself, so the job cannot live on in it; name the folder it went to" ;;
  esac
  printf '%s' "$rel"
}

usage_close() {
  cat <<'USAGE'
usage: office close [FOLDER] [--into N | --split A,B | --retired WHY]
Moves a folder from the desk to the filing cabinet, writing its status and
a History line. Plain close is done. --into N: absorbed into folder N;
--split A,B: split into those folders; --retired WHY: retired, and why.
Each successor gets a note line pointing back. FOLDER is its name, a
unique part of it, or folder N; on a terminal it is asked for when
missing.
Examples:
  office close fix-login
  office close "folder 12" --into 14
  office close fix-login --split 14,15
  office close fix-login --retired "the premise was wrong"
USAGE
}

cmd_close() {
  local want="" into="" split="" retired="" set=0 root name md tz day status verb text number me
  local succ=() rels=() paths=() parts=() s rel i label
  while [ $# -gt 0 ]; do
    case "$1" in
      --into|--split|--retired)
        [ $# -ge 2 ] || die "$1 needs a value (office close --help)"
        set=$((set + 1))
        case "$1" in --into) into="$2" ;; --split) split="$2" ;; --retired) retired="$2" ;; esac
        shift 2 ;;
      -h|--help) usage_close; return 0 ;;
      -*) usage_close >&2; die "office close does not know $1" ;;
      *) [ -z "$want" ] || die "close takes one folder"; want="$1"; shift ;;
    esac
  done
  [ "$set" -le 1 ] || die "--into, --split and --retired are three different endings; give one"
  root="$(resolve_office)" || exit 1
  require_current "$root"
  if [ -z "$want" ]; then
    can_ask || { usage_close >&2; die "name a folder: office close FOLDER; piped input is never asked"; }
    ask_folder want "$root" desk close
  fi
  name="$(find_folder "$root" desk "$want")" || exit 1
  md="$root/desk/$name/folder.md"
  [ -f "$md" ] || die "desk/$name has no folder.md"
  status="$(folder_fact "$md" status)"; number="$(folder_fact "$md" number)"
  case "$status" in done|absorbed|split|retired) die "desk/$name says status $status, which belongs in the filing cabinet; office status names what disagrees" ;; esac
  me="${number:+folder $number}"; me="${me:-$name}"
  [ ! -e "$root/filing-cabinet/$name" ] || die "filing-cabinet/$name already exists; not overwriting it, and nothing was written"
  if [ -n "$into" ]; then
    rel="$(successor_folder "$root" "$name" "$into")" || exit 1
    succ=("$(helper normalize-field linked -- "$into")"); rels=("$rel")
    verb=absorbed; status=absorbed; text="into ${succ[0]}"
  elif [ -n "$split" ]; then
    IFS=',' read -r -a parts <<< "$split"
    [ "${#parts[@]}" -ge 2 ] || die "--split names the two or more folders the job was cut into, as A,B"
    for s in "${parts[@]}"; do
      rel="$(successor_folder "$root" "$name" "$s")" || exit 1
      case " ${rels[*]} " in *" $rel "*) die "--split names $(helper normalize-field linked -- "$s") twice" ;; esac
      succ+=("$(helper normalize-field linked -- "$s")"); rels+=("$rel")
    done
    verb=split; status=split
    text="into folders $(printf '%s\n' "${succ[@]}" | sed 's/^folder //' | paste -sd, - | sed 's/,/, /g')"
  elif [ -n "$retired" ]; then
    [ -n "${retired//[[:space:]]/}" ] || die "--retired needs the reason, in a few words"
    verb=retired; status=retired; text="$(printf '%s' "$retired" | helper ascii-escape)"
  else
    verb=done; status=done; text="${MOVE_TEXT:-office close}"
  fi
  tz="$(office_tz "$root")"; day="$(office_date "$tz")"
  # The status and History lines go in while the folder is on the desk,
  # which is live; the filing cabinet only ever gains lines.
  folder_event "$md" "$day" "$verb" "$text" "$status"
  move_folder_dir "$root" desk filing-cabinet "$name"
  paths=("desk/$name" "filing-cabinet/$name")
  label="$me"; [ -z "$number" ] || label="$me ($name)"
  for i in "${!rels[@]}"; do
    if [ "$verb" = absorbed ]; then
      folder_event "$root/${rels[$i]}/folder.md" "$day" note "absorbed $label"
    else
      folder_event "$root/${rels[$i]}/folder.md" "$day" note "split from $label"
    fi
    paths+=("${rels[$i]}/folder.md")
  done
  if [ "$verb" = done ]; then
    commit_paths "$root" "office close: $name (done)" "${paths[@]}" || true
  else
    commit_paths "$root" "office close: $name ($verb: $text)" "${paths[@]}" || true
  fi
}

usage_reopen() {
  cat <<'USAGE'
usage: office reopen [FOLDER]
Brings a done folder back to the desk, history and all: status open, and a
reopened line. A folder absorbed, split or retired is not reopened; its
History names where the job went. On a terminal FOLDER is asked for.
Examples:
  office reopen fix-login
  office reopen "folder 12"
USAGE
}

cmd_reopen() {
  local want="" root name md status tz day
  case "${1:-}" in -h|--help) usage_reopen; return 0 ;; esac
  want="${1:-}"
  [ $# -le 1 ] || die "reopen takes one folder"
  root="$(resolve_office)" || exit 1
  require_current "$root"
  if [ -z "$want" ]; then
    can_ask || die "name a folder: office reopen FOLDER; piped input is never asked"
    ask_folder want "$root" filing-cabinet reopen
  fi
  name="$(find_folder "$root" filing-cabinet "$want")" || exit 1
  md="$root/filing-cabinet/$name/folder.md"
  status=""
  [ -f "$md" ] && status="$(folder_fact "$md" status)"
  case "$status" in
    absorbed|split|retired)
      die "filing-cabinet/$name was $status; the job lives on elsewhere or not at all, so it is not reopened (its History names where; office open starts a new folder)" ;;
  esac
  move_folder_dir "$root" filing-cabinet desk "$name"
  if [ -f "$root/desk/$name/folder.md" ]; then
    tz="$(office_tz "$root")"; day="$(office_date "$tz")"
    folder_event "$root/desk/$name/folder.md" "$day" reopened "office reopen" open
  fi
  commit_paths "$root" "office reopen: $name" "filing-cabinet/$name" "desk/$name" || true
}

# Record which sessions worked on a folder's job. The id comes from
# bale, never typed: `bale pack --json ... | office sessions FOLDER -`
# reads the pack report. With the first id a candidate or queued folder
# records, the folder is open: status open and an opened line.
record_session() {
  local root="$1" folder="$2" sid="$3" words="$4" day="$5" out rc
  out="$(helper record-session "$root/$folder/folder.md" "$sid" ${words:+--words "$words"} ${day:+--day "$day"})"; rc=$?
  case $rc in
    0) log "recorded $sid in $folder"
       printf '%s\n' "$out" | tail -n +2 | sed "s|^|[office] $(basename "$folder"): |" >&2
       commit_paths "$root" "office sessions: $sid in $(basename "$folder")" "$folder/folder.md" || true ;;
    4) log "$sid is already recorded in $folder" ;;
    *) die "could not record $sid in $folder/folder.md" ;;
  esac
}

# file_pages ROOT FOLDER SID RESPONSE: the folder's walkthrough.md and
# delivery.md from the Walkthrough and Delivery sections of the
# response's notes.md (doctrine section 3, principle 6; the templates say
# their shape), committed together; a section the notes lack files
# nothing and is said. The office step that brings the folder up to date
# after a build session lands (doctrine section 4), never the session
# writing into the office.
file_pages() {
  local root="$1" folder="$2" sid="$3" response="$4" out key state path paths=() absent=() told=()
  out="$(helper file-pages "$root/$folder" --response "$response" --sid "$sid")" || { warn "the walkthrough and delivery pages could not be filed from $response (the line above says why)"; return 1; }
  while IFS=$'\t' read -r key state path; do
    [ -n "$key" ] || continue
    case "$state" in
      filed) log "filed $folder/$(basename "$path"): the $key from $sid's notes.md"; paths+=("$folder/$(basename "$path")"); told+=("$(basename "$path") filed") ;;
      rewritten) log "rewrote $folder/$(basename "$path") from $sid's notes.md (what it said before is in git)"; paths+=("$folder/$(basename "$path")"); told+=("$(basename "$path") rewritten") ;;
      absent) absent+=("$key") ;;
    esac
  done <<< "$out"
  [ "${#paths[@]}" -eq 0 ] || commit_paths "$root" "office land: $sid's pages in $(basename "$folder")" "${paths[@]}" || true
  if [ "${#absent[@]}" -gt 0 ]; then
    log "$sid's notes.md carries no $(printf '%s\n' "${absent[@]}" | paste -sd, - | sed 's/,/ or /') section, so that page was not filed; a build session writes both (the install's templates/walkthrough.md and templates/delivery.md say the shape), and office deliver needs delivery.md"
    told+=("$(printf '%s\n' "${absent[@]}" | paste -sd, - | sed 's/,/, /') not in the notes")
  fi
  FILED_PAGES="$(printf '%s\n' "${told[@]}" | paste -sd, - | sed 's/,/; /g')"
  return 0
}
FILED_PAGES=""

# file_notes ROOT FOLDER SID RESPONSE: what the response's notes.md says
# beyond the folder's two pages (0.20.0), filed by lib/office_sort.py and
# committed together: its Sort on each drop's page (the in-tray, or
# FOLDER's drops/), its Questions and answers in FOLDER, and its
# Handbook's facts and front sheets in the chapters, the handbook
# arriving with the first fact. FOLDER is empty for a session no folder
# records (a standalone sort). Each section is said; a section the notes
# lack files nothing and says nothing.
file_notes() {
  local root="$1" folder="$2" sid="$3" response="$4" tz day names out kind text paths=()
  tz="$(office_tz "$root")"; day="$(office_date "$tz")"
  names="$(helper project-names "$root/$MANIFEST_REL" 2>/dev/null)"
  out="$(sortx file-notes "$root" --response "$response" --sid "$sid" --day "$day" ${folder:+--folder "$folder"} \
           --projects "$names")" || return 1
  while IFS=$'\t' read -r kind text; do
    case "$kind" in
      say) log "$text" ;;
      path) paths+=("$text") ;;
    esac
  done <<< "$out"
  [ "${#paths[@]}" -eq 0 ] || commit_paths "$root" "office land: $sid's notes filed (sort, answers, handbook)" "${paths[@]}" || true
  return 0
}

usage_sessions() {
  cat <<'USAGE'
usage: office sessions [FOLDER] [SID | -] [-m WORDS] [--ratified [--except TEXT]] [--pages RESPONSE]
       office sessions --in-tray SID --pages RESPONSE
  office sessions FOLDER               list the recorded sessions, with what bale records
  office sessions FOLDER SID|-         record one; - reads a bale pack --json report on stdin.
                                       The first one a candidate or queued folder records opens it.
  office sessions FOLDER SID|- --ratified [--except TEXT]
                                       the planner ratified that session's judgment calls,
                                       except TEXT (what was corrected, and where it went)
  office sessions FOLDER SID --pages RESPONSE
                                       file the Walkthrough and Delivery sections of the
                                       response's notes.md as the folder's walkthrough.md and
                                       delivery.md, then its Sort, Questions and answers and
                                       Handbook sections (office land does this after an
                                       applied landing; this is for a response bale found on
                                       its own, or a session applied by hand)
  office sessions --in-tray SID --pages RESPONSE
                                       the same for a standalone sort (office start --sort),
                                       which no folder records: its Sort and Handbook
office start and office land record sessions and ratifications themselves;
this is for a session packed by hand, and for reading how each one went.
Examples:
  office sessions fix-login
  office sessions fix-login 2026-10-05-fix-login-001 --ratified
  office sessions fix-login 2026-10-05-fix-login-001 --pages ~/Downloads/response-2026-10-05-fix-login-001.tar.gz
  bale pack --json --include desk/2026-10-05-fix-login "Fix it" | office sessions fix-login -
USAGE
}

cmd_sessions() {
  local want="" source="" words="" ratified=0 except="" has_except=0 root space name sid tz day out pages="" in_tray=0
  while [ $# -gt 0 ]; do
    case "$1" in
      --in-tray) in_tray=1; shift ;;
      -m) [ $# -ge 2 ] || die "-m needs a few words"; words="$2"; shift 2 ;;
      --pages) [ $# -ge 2 ] || die "--pages needs the response tarball"; [ -f "$2" ] || die "--pages $2: no such file"; pages="$(readlink -f "$2")"; shift 2 ;;
      --ratified) ratified=1; shift ;;
      --except) [ $# -ge 2 ] || die "--except needs what was corrected, and where it went"; except="$2"; has_except=1; shift 2 ;;
      -h|--help) usage_sessions; return 0 ;;
      -?*) [ "$1" = "-" ] || { usage_sessions >&2; die "office sessions does not know $1"; }
           if [ -z "$want" ]; then die "name the folder before -"; elif [ -z "$source" ]; then source="-"; else die "too many arguments"; fi; shift ;;
      *) if [ -z "$want" ]; then want="$1"; elif [ -z "$source" ]; then source="$1"; else die "too many arguments"; fi; shift ;;
    esac
  done
  [ "$has_except" = 0 ] || [ "$ratified" = 1 ] || die "--except goes with --ratified"
  root="$(resolve_office)" || exit 1
  if [ "$in_tray" = 1 ]; then
    # A standalone sort's notes (0.20.0): no folder records it, so the
    # word after --in-tray is the session.
    [ -n "$pages" ] && [ -n "$want" ] && [ -z "$source" ] && [ "$ratified" = 0 ] && [ -z "$words" ] \
      || die "--in-tray goes as office sessions --in-tray SID --pages RESPONSE, and alone"
    [[ "$want" =~ ^[0-9]{4}-[0-9]{2}-[0-9]{2}-[a-z0-9]+(-[a-z0-9]+)*-[0-9]{3}$ ]] || die "not a session id (YYYY-MM-DD-slug-NNN): $want"
    file_notes "$root" "" "$want" "$pages" || die "the notes of $want could not be filed from $pages (the line above says why)"
    sortx pending "$root" && log "a sorted drop waits in the in-tray: office moves applies it"
    return 0
  fi
  if [ -z "$want" ]; then
    can_ask || { usage_sessions >&2; die "name a folder: office sessions FOLDER; piped input is never asked"; }
    ask_folder want "$root" desk "record sessions in"
  fi
  space=desk
  if ! name="$( (find_folder "$root" desk "$want") 2>/dev/null)"; then
    space=filing-cabinet; name="$(find_folder "$root" filing-cabinet "$want")" || exit 1
  fi
  [ -f "$root/$space/$name/folder.md" ] || die "$space/$name has no folder.md"
  if [ -z "$source" ] && [ "$ratified" = 1 ]; then
    can_ask || die "--ratified needs the session: office sessions FOLDER SID --ratified; piped input is never asked"
    ask_field source sid "SID" "Session id to ratify" "" 1
  fi
  if [ -z "$source" ]; then
    helper folder-summary "$root/$space/$name/folder.md" "$TEMPLATES/folder.md" >/dev/null || die "could not read $space/$name/folder.md"
    # Each recorded id, then what bale's records say about it: outcome,
    # dates, claims beside verdicts, exchange rounds. Rendered on every
    # run and never written into the folder.
    reader folder-sessions "$root" "$root/$space/$name/folder.md"
    case $? in
      0) return 0 ;;
      3) die "some of this office's projects could not be read; the lines above say why" ;;
      *) die "could not render the sessions of $space/$name" ;;
    esac
  fi
  if [ "$source" = "-" ]; then
    sid="$(helper pack-sid)" || die "no session id recorded in $space/$name"
  else
    sid="$source"
  fi
  tz="$(office_tz "$root")"; day="$(office_date "$tz")"
  if [ -n "$pages" ]; then
    [ "$ratified" = 0 ] && [ -z "$words" ] || die "--pages goes alone: office sessions FOLDER SID --pages RESPONSE"
    [ "$source" != "-" ] || die "--pages takes the session's id, not a pack report"
    [[ "$sid" =~ ^[0-9]{4}-[0-9]{2}-[0-9]{2}-[a-z0-9]+(-[a-z0-9]+)*-[0-9]{3}$ ]] || die "not a session id (YYYY-MM-DD-slug-NNN): $sid"
    file_pages "$root" "$space/$name" "$sid" "$pages" || return 1
    file_notes "$root" "$space/$name" "$sid" "$pages" || die "the Sort, Questions and answers and Handbook of $sid could not be filed from $pages (the line above says why)"
    sortx pending "$root" && log "a sorted drop waits in the in-tray: office moves applies it"
    return 0
  fi
  if [ "$ratified" = 1 ]; then
    [ -z "$words" ] || die "-m goes with recording a session, not with --ratified"
    if [ "$has_except" = 1 ]; then
      out="$(helper ratify "$root/$space/$name/folder.md" "$sid" --day "$day" --except "$except")" || exit 1
    else
      out="$(helper ratify "$root/$space/$name/folder.md" "$sid" --day "$day")" || exit 1
    fi
    log "$name: $out"
    commit_paths "$root" "office sessions: $sid ratified in $name" "$space/$name/folder.md" || true
    return 0
  fi
  record_session "$root" "$space/$name" "$sid" "$words" "$day"
}

# --- the drafting table -----------------------------------------------------------
#
# Blueprints for work too big for one folder, and the pages a sitting
# rules in (doctrine section 5). The space arrives in an office with the
# first verb that writes it: drafting-table/README.md from the install's
# template, the floor plan's entry and bale.toml's trigger, and each page
# from its template on its first write, committed with the write that
# asked for it. lib/office_drafting.py reads and writes the pages; these
# verbs ask, hold the one-writer rule, check what they append, and commit
# exactly what they touched.

DRAFTING="$OFFICE_SRC/lib/office_drafting.py"
drafting() { python3 -B "$DRAFTING" "$@"; }

# one_writer ROOT VERB TARGET...: a script that mints a number or appends
# to a page refuses while an open session in the office's own registry
# forecasts what it writes, and names the session (the blueprint's
# section 5.4). An office bale has never run in has no registry and
# nothing to refuse; a registry that cannot be read is said loudly.
one_writer() {
  local root="$1" verb="$2" out rc; shift 2
  out="$(reader writers "$root" "$@")"; rc=$?
  case $rc in
    0) debug "one-writer rule: no open session in this office's registry holds $*" ;;
    3) printf '%s\n' "$out" | sed 's/^/[office]   /' >&2
       die "an open session holds what office $verb writes, so it waits (the one-writer rule); run it once that session is applied or closed" ;;
    *) warn "bale's registry in this office could not be read (the line above says why); office $verb runs without the one-writer check" ;;
  esac
}

# What the drafting table's arrival writes, when it has not arrived: the
# floor plan, bale.toml and the space's front page, for the rule above.
arrival_targets() {
  local root="$1"
  if helper get "$root/$MANIFEST_REL" "spaces.drafting-table.path" >/dev/null 2>&1 && [ -f "$root/drafting-table/README.md" ]; then
    return 0
  fi
  printf '%s\n' "$MANIFEST_REL" "$BALE_TOML_REL" "drafting-table/README.md"
}

# check_page ROOT PAGE [--insertion]: a page a verb added to, against its
# committed bytes, before the commit: appended at its end (or, with
# --insertion, one entry put in above its foot), nothing else changed.
check_page() {
  local root="$1" page="$2" why; shift 2
  why="$(helper append-check "$root" "$page" "$@")"
  case $? in
    0) return 0 ;;
    3) die "$page differs from its committed bytes other than by this entry ($why); the entry is on disk but not committed, and nothing else was" ;;
    *) die "could not check $page against its committed bytes; the entry is on disk but not committed" ;;
  esac
}

# run_drafting VAR ARGS...: run a writing subcommand; VAR gets what it
# printed (its citation first, then the paths it changed).
run_drafting() {
  local __var="$1" __out; shift
  __out="$(drafting "$@")" || exit 1
  printf -v "$__var" '%s' "$__out"
}

# A rider, agenda item or blueprint named as N, `rider N` and so on.
bare_number() {  # bare_number KIND WORD
  local w
  w="$(printf '%s' "$2" | sed -E "s/^[[:space:]]*($1[[:space:]]+)?//; s/[[:space:]]+\$//")"
  [[ "$w" =~ ^[0-9]+$ ]] || die "$1 takes a number ($1 N), not $(shq "$2")"
  printf '%s' "$((10#$w))"
}

usage_blueprint() {
  cat <<'USAGE'
usage: office blueprint open SLUG | ratify ID | close ID
A blueprint is work too big for one folder: one arc on the drafting table,
drafting-table/blueprints/DATE-SLUG/blueprint.md, with its charter, its
decomposition into folders, its watch list and its history.
  office blueprint open SLUG     draft one from the template
  office blueprint ratify ID     write the charter's ratified line
  office blueprint close ID      send out the sitting that writes its close report
office blueprint VERB --help explains each, with examples. office desk
--blueprint ID shows the arc's folders in the desk's order.
Examples:
  office blueprint open rider-verbs --title "The rider verbs"
  office blueprint ratify 2026-10-05-rider-verbs --words notepad/2026-10-05-plan.md
  office blueprint close 2026-10-05-rider-verbs
USAGE
}

cmd_blueprint() {
  local sub="${1:-}"
  case "$sub" in
    open) shift; cmd_blueprint_open "$@" ;;
    ratify) shift; cmd_blueprint_ratify "$@" ;;
    close) shift; cmd_blueprint_close "$@" ;;
    ""|-h|--help) usage_blueprint ;;
    *) usage_blueprint >&2; die "office blueprint does not know $sub; it takes open, ratify or close" ;;
  esac
}

usage_blueprint_open() {
  cat <<'USAGE'
usage: office blueprint open [SLUG] [--title TITLE] [--charter TEXT]   (or the charter on stdin)
Drafts a blueprint: drafting-table/blueprints/DATE-SLUG/blueprint.md from
the install's template, with a drafted History line, committed alone. The
blueprint's id is DATE-SLUG, in the office's timezone; it is cited as
blueprint DATE-SLUG. The charter says what the arc is for and what done
means; left out, it is marked not written yet, and ratify refuses it until
it is. The first blueprint brings the drafting table into the office (its
front page, the floor plan's entry and bale.toml's trigger), in the same
commit. On a terminal it asks for the slug, title and charter it was not
given; piped, it never asks. A sitting may equally draft a blueprint
itself; this is for the occupant drafting alone.
Examples:
  office blueprint open                        (asks for the slug, title and charter)
  office blueprint open rider-verbs --title "The rider verbs" --charter "Riders get verbs; done when ..."
  printf '%s\n' "What the arc is for ..." | office blueprint open rider-verbs --title "The rider verbs"
USAGE
}

cmd_blueprint_open() {
  local slug="" title="" charter="" have_charter=0 root tz day out tmp paths=() cite
  while [ $# -gt 0 ]; do
    case "$1" in
      --title|--charter) [ $# -ge 2 ] || die "$1 needs a value (office blueprint open --help)"
        case "$1" in --title) title="$2" ;; --charter) charter="$2"; have_charter=1 ;; esac; shift 2 ;;
      -h|--help) usage_blueprint_open; return 0 ;;
      -*) usage_blueprint_open >&2; die "office blueprint open does not know $1" ;;
      *) [ -z "$slug" ] || die "blueprint open takes one slug (quote a title with --title)"; slug="$1"; shift ;;
    esac
  done
  root="$(resolve_office)" || exit 1
  require_current "$root"
  if [ "$have_charter" = 0 ] && [ ! -t 0 ]; then charter="$(cat)"; fi
  if can_ask; then
    [ -n "$slug" ] || [ -n "$title" ] || ask title "Title, in a few words (--title)" "" 1 \
      "The blueprint's name in words, its first line. The slug, the id after the date, is made from it unless you give one."
    [ -n "$slug" ] || slug="$(short_slug "$title")"
    [ -n "$title" ] || ask title "Title, in a few words (--title)" "$(printf '%s' "$slug" | tr '-' ' ')" 1 \
      "The blueprint's name in words, its first line."
    [ "$have_charter" = 1 ] || ask charter "Charter: what the arc is for and what done means (--charter)" "" 0 \
      "In the asker's words where there are words to keep. It freezes once ratified. A plain return leaves it marked not written yet; ratify refuses it until it is."
  else
    [ -n "$slug" ] || [ -n "$title" ] || die "blueprint open needs a slug or a title: office blueprint open SLUG, or --title TITLE; piped input is never asked"
  fi
  [ -n "$slug" ] || slug="$(short_slug "$title")"
  slug="$(slugify "$slug")"; [ -n "$slug" ] || die "the slug has no letters or digits (give one: office blueprint open SLUG)"
  [ -n "$title" ] || title="$(printf '%s' "$slug" | tr '-' ' ')"
  mapfile -t paths < <(arrival_targets "$root")
  one_writer "$root" "blueprint open" "drafting-table/blueprints" "${paths[@]}"
  tz="$(office_tz "$root")"; day="$(office_date "$tz")"
  tmp="$(mktemp)" || die "cannot make a temp file"; TMP_PATHS+=("$tmp")
  printf '%s' "$charter" > "$tmp"
  run_drafting out blueprint-open "$root" "$slug" --day "$day" --title "$title" --charter-file "$tmp"
  cite="$(printf '%s\n' "$out" | head -n 1)"
  mapfile -t paths < <(printf '%s\n' "$out" | tail -n +2)
  commit_paths "$root" "office blueprint open: ${cite#blueprint }" "${paths[@]}" || true
  printf '%s\n' "$cite"
}

# The blueprints on the drafting table, then the question.
ask_blueprint() {
  local __var="$1" root="$2" verb="$3" list
  list="$(drafting blueprints "$root" 2>/dev/null)"
  [ -n "$list" ] || die "no blueprint on the drafting table to $verb (office blueprint open drafts one)"
  printf 'Blueprints:\n' >&2
  printf '%s\n' "$list" | awk -F'\t' '{printf "  %s  [%s]  %s\n", $1, $2, $3}' >&2
  ask "$__var" "Which blueprint: its id, DATE-SLUG (office blueprint $verb ID)" "" 1 \
    "The blueprint's id is its directory's name under drafting-table/blueprints/, the date and the slug."
}

usage_blueprint_ratify() {
  cat <<'USAGE'
usage: office blueprint ratify [ID] [--words notepad/PAGE | --sid SID]
Writes the charter's ratified line, last in its Charter section, and a
ratified History line, and commits the blueprint alone: that commit is the
one office status checks the charter's bytes against from then on. The
ratification names where its words are: the notepad page that carries
them (--words), or the session they were given in (--sid). It refuses a
blueprint already ratified or closed, and a charter not written yet. A
sitting can write the same two lines itself; this is for a ratification
given outside one (an "as assumed" reply). On a terminal it asks for what
it was not given; piped, it never asks.
Examples:
  office blueprint ratify 2026-10-05-rider-verbs --words notepad/2026-10-05-plan.md
  office blueprint ratify 2026-10-05-rider-verbs --sid 2026-10-05-plan-sitting-001
USAGE
}

cmd_blueprint_ratify() {
  local id="" words="" sid="" root tz day out paths=()
  while [ $# -gt 0 ]; do
    case "$1" in
      --words|--sid) [ $# -ge 2 ] || die "$1 needs a value (office blueprint ratify --help)"
        case "$1" in --words) words="$2" ;; --sid) sid="$2" ;; esac; shift 2 ;;
      -h|--help) usage_blueprint_ratify; return 0 ;;
      -*) usage_blueprint_ratify >&2; die "office blueprint ratify does not know $1" ;;
      *) [ -z "$id" ] || die "blueprint ratify takes one blueprint"; id="${1#blueprint }"; shift ;;
    esac
  done
  [ -z "$words" ] || [ -z "$sid" ] || die "--words and --sid are two places the words can be; give one"
  root="$(resolve_office)" || exit 1
  require_current "$root"
  if [ -z "$id" ]; then
    can_ask || { usage_blueprint_ratify >&2; die "name the blueprint: office blueprint ratify ID; piped input is never asked"; }
    ask_blueprint id "$root" ratify
  fi
  if [ -z "$words" ] && [ -z "$sid" ]; then
    can_ask || die "say where the ratifying words are: --words notepad/PAGE or --sid SID; piped input is never asked"
    ask words "The notepad page that carries the ratifying words, notepad/PAGE.md (--words; --sid SID for a session)" "" 1 \
      "Ratification points at the words that gave it, never copies them: a notepad page (office note writes the day's page), or a session id given as --sid."
    case "$words" in [0-9][0-9][0-9][0-9]-*-[0-9][0-9][0-9]) sid="$words"; words="" ;; esac
  fi
  one_writer "$root" "blueprint ratify" "drafting-table/blueprints/$id/blueprint.md"
  tz="$(office_tz "$root")"; day="$(office_date "$tz")"
  if [ -n "$words" ]; then
    run_drafting out blueprint-ratify "$root" "$id" --day "$day" --words "$words"
  else
    run_drafting out blueprint-ratify "$root" "$id" --day "$day" --sid "$sid"
  fi
  mapfile -t paths < <(printf '%s\n' "$out")
  commit_paths "$root" "office blueprint ratify: $id" "${paths[@]}" || true
}

usage_blueprint_close() {
  cat <<'USAGE'
usage: office blueprint close [ID] [--goal TEXT]
Sends out the sitting that closes a blueprint, the way office start sends
any session out: a folder born for the close (Close blueprint ID, source
blueprint ID), opened unless one is on the desk already; the session
packed in the office, forecasting that folder, the notepad and the
drafting table; the blueprint, its member folders, the rulings, evidence
and watches pages, and the close report's template from the install,
shipped; a brief saying what lands. The sitting writes close.md and its
notepad page, and puts the member folders' endings on the desk moves page
for office moves. You attach the out tray and paste the opener, as for
office start; office land brings it back.
Under the hood: office open, then office start's own code (bale pack --json,
bale pack --context for each context tarball).
Examples:
  office blueprint close 2026-10-05-rider-verbs
  office blueprint close                       (asks which blueprint)
USAGE
}

cmd_blueprint_close() {
  local id="" goal="" root plan tmp folder rel members=() m title close_folder includes=() ledgers=()
  while [ $# -gt 0 ]; do
    case "$1" in
      --goal) [ $# -ge 2 ] || die "--goal needs a sentence"; goal="$2"; shift 2 ;;
      -h|--help) usage_blueprint_close; return 0 ;;
      -*) usage_blueprint_close >&2; die "office blueprint close does not know $1" ;;
      *) [ -z "$id" ] || die "blueprint close takes one blueprint"; id="${1#blueprint }"; shift ;;
    esac
  done
  root="$(resolve_office)" || exit 1
  require_current "$root"
  if [ -z "$id" ]; then
    can_ask || { usage_blueprint_close >&2; die "name the blueprint: office blueprint close ID; piped input is never asked"; }
    ask_blueprint id "$root" close
  fi
  tmp="$(mktemp)" || die "cannot make a temp file"; TMP_PATHS+=("$tmp")
  plan="$(drafting blueprint-close-plan "$root" "$id" --brief "$tmp")" || exit 1
  title="$(printf '%s' "$plan" | python3 -c 'import json,sys; print(json.load(sys.stdin)["title"])')"
  close_folder="$(printf '%s' "$plan" | python3 -c 'import json,sys; print(json.load(sys.stdin)["close_folder"] or "")')"
  mapfile -t members < <(printf '%s' "$plan" | python3 -c 'import json,sys; print("\n".join(json.load(sys.stdin)["members"]))')
  mapfile -t ledgers < <(printf '%s' "$plan" | python3 -c 'import json,sys; print("\n".join(json.load(sys.stdin)["ledgers"]))')
  command -v bale >/dev/null 2>&1 || die "bale is not on PATH; office blueprint close sends the close sitting out with bale pack"
  if [ -n "$close_folder" ]; then
    rel="$close_folder"
    log "the close's folder is already on the desk: $rel"
  else
    rel="$(cmd_open "close-${id#[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]-}" --title "Close blueprint $id" \
      --source "blueprint $id" --blueprint "$id" --size small --class meta < /dev/null)" || exit 1
  fi
  includes=(--include "drafting-table/blueprints/$id")
  for m in "${members[@]}" "${ledgers[@]}"; do
    [ -n "$m" ] && [ "$m" != "$rel" ] && includes+=(--include "$m")
  done
  [ -n "$goal" ] || goal="Close blueprint $id ($title): write its close report and the sitting's notepad page, and put its member folders' endings on the desk moves page"
  START_INSTALL_FILES=("templates/close-report.md")
  cmd_start "${rel#desk/}" --in-office --goal "$goal" --write drafting-table "${includes[@]}" --brief "$tmp"
}

usage_moves() {
  cat <<'USAGE'
usage: office moves [--dry-run]
Applies the desk moves waiting in the office: first the in-tray's sorted
drops, oldest first, then every pending line a sitting (or a sort session)
wrote on drafting-table/moves.md, in order.
A sorted drop is a page in the in-tray whose Sort office land filed. Its
Sort says where it goes: folder: new mints a folder through office open's
own code (the title from the drop's heading, the slug from its page's
name, the lane its project, the size and the goal the Sort's, the source
drop), folder: N takes folder N on the desk. The page moves into the
folder's drops/ whole, the folder's brief.md is written from the Sort's
Brief, its History gains a dropped line, its goal is written when it has
none, and the Sort's tell: goes on its Next. A drop whose project is none
of the office's, whose folder is in the filing cabinet or not there, or
that an open session's forecast holds, is said and stays where it is; the
rest go on.
A line on the moves page goes through the same code as office open, office
close and the gate flags: open a folder, queue a candidate, gate a folder,
close, absorb, split or retire one. Each line applied is ticked with the
folder it acted on (- [x] ... -> folder N), an opened folder of a
blueprint has its number written onto the blueprint's decomposition line,
and everything is committed at once. A line that does not read is named
before anything is applied; a line that cannot be applied stops the run
there, named, with the lines before it applied and committed. Walking in
says how many moves are pending and which session wrote them. office land
runs office moves after a landing that sorted a drop.
--dry-run lists the pending moves and applies nothing.
Examples:
  office moves
  office moves --dry-run
USAGE
}

SORT_PY="$OFFICE_SRC/lib/office_sort.py"
sortx() { python3 -B "$SORT_PY" "$@"; }

# held ROOT TARGET...: 0 when no open session in the office's registry
# holds a target (or there is no registry), 1 when one does, with
# HELD_WORDS naming it. Unlike one_writer it never ends the command: a
# sorted drop an open session holds stays where it is, and the rest go
# on (0.20.0).
HELD_WORDS=""
held() {
  local root="$1" out rc; shift
  out="$(reader writers "$root" "$@")"; rc=$?
  case $rc in
    0) return 0 ;;
    3) HELD_WORDS="$(printf '%s\n' "$out" | paste -sd ';' - | sed 's/;/; /g')"; return 1 ;;
    *) warn "bale's registry in this office could not be read (the line above says why); moving without the one-writer check"
       return 0 ;;
  esac
}

# move_sorted_drop ROOT DAY PAGE KIND N TITLE SLUG LANE SIZE GOAL SID
# PROBLEM: one sorted drop out of the in-tray and into its folder (office
# moves). Returns 1, having said why, when the page stays where it is.
move_sorted_drop() {
  local root="$1" day="$2" page="$3" kind="$4" fnum="$5" title="$6" slug="$7" lane="$8" size="$9"
  local goal="${10}" ssid="${11}" problem="${12}" rel out number
  if [ -n "$problem" ]; then warn "$page stays in the in-tray: $problem"; return 1; fi
  if [ "$kind" = new ]; then
    if ! held "$root" in-tray desk; then
      warn "$page stays in the in-tray: $HELD_WORDS (the one-writer rule)"; return 1
    fi
    if ! rel="$(MOVE_TEXT="office moves: $page, sorted by $ssid" cmd_open "$slug" --title "$title" --size "$size" \
                  --lane "$lane" --source drop --goal "$goal" < /dev/null)"; then
      warn "$page stays in the in-tray: its folder could not be opened (the lines above say why)"; return 1
    fi
    number="$(folder_fact "$root/$rel/folder.md" number)"
    log "minted folder $number, $rel, for $page"
    [ -z "${MOVES_MINTED_FILE:-}" ] || printf 'folder %s\t%s\t%s\n' "$number" "$rel" "$page" >> "$MOVES_MINTED_FILE"
  else
    if ! rel="$(helper folder-by-number "$root" "folder $fnum" 2>&1)"; then
      warn "$page stays in the in-tray: its Sort names folder $fnum, and ${rel#\[office\] error: }"; return 1
    fi
    if [ "${rel%%/*}" != desk ]; then
      warn "$page stays in the in-tray: its Sort names folder $fnum, which is in the filing cabinet (office reopen brings it back, or a sitting decides where the drop goes)"
      return 1
    fi
    if ! held "$root" in-tray "$rel"; then
      warn "$page stays in the in-tray: $HELD_WORDS (the one-writer rule)"; return 1
    fi
  fi
  if ! out="$(sortx place "$root" "$page" "$rel" --day "$day")"; then
    warn "$page stays in the in-tray: it could not be moved into $rel (the line above says why)"; return 1
  fi
  printf '%s\n' "$out" >> "$DEFER_COMMITS"
  return 0
}

cmd_moves() {
  local dry=0 root plan="" sorted_plan names tz day lineno verb folder mday bp dline argstr args=() rel number
  local n=0 m=0 left=0 stopped="" blocked="" paths=() key i
  local page kind fnum title slug lane size goal ssid problem
  while [ $# -gt 0 ]; do
    case "$1" in
      --dry-run) dry=1; shift ;;
      -h|--help) usage_moves; return 0 ;;
      *) usage_moves >&2; die "office moves does not know $1" ;;
    esac
  done
  root="$(resolve_office)" || exit 1
  require_current "$root"
  names="$(helper project-names "$root/$MANIFEST_REL" 2>/dev/null)"
  sorted_plan="$(sortx move-plans "$root" --projects "$names")" || die "could not read the in-tray's sorted drops"
  if [ -f "$root/drafting-table/moves.md" ]; then
    plan="$(drafting moves-plan "$root" --shell)"
    case $? in
      0) ;;
      1) printf '%s\n' "$plan" | sed 's/^/[office]   /' >&2
         die "drafting-table/moves.md has line(s) that do not read (above); nothing was applied" ;;
      *) die "could not read drafting-table/moves.md" ;;
    esac
  fi
  if [ -z "$sorted_plan" ] && [ -z "$plan" ]; then
    log "no desk moves pending: no sorted drop waits in the in-tray, and $([ -f "$root/drafting-table/moves.md" ] && printf 'drafting-table/moves.md has no pending line' || printf 'this office has no drafting-table/moves.md')"
    return 0
  fi
  if [ "$dry" = 1 ]; then
    printf 'Pending desk moves, in the order office moves applies them:\n'
    [ -z "$sorted_plan" ] || printf '%s\n' "$sorted_plan" | awk -F'\036' '{
      where = ($2 == "new") ? "a new folder on " $6 : ($2 == "into" ? "folder " $3 : "nowhere yet")
      printf "  %s: sorted by %s, into %s%s\n", $1, ($9 == "" ? "?" : $9), where, ($10 == "" ? "" : "; it stays: " $10) }'
    [ -z "$plan" ] || printf '%s\n' "$plan" | awk -F'\036' '{printf "  line %s: %s %s\n", $1, $4, $8}'
    return 0
  fi
  tz="$(office_tz "$root")"; day="$(office_date "$tz")"
  # The moves page's one-writer rule is asked before anything is applied,
  # so a page that waits leaves the sorted drops free to go on.
  if [ -n "$plan" ]; then
    mapfile -t paths < <(arrival_targets "$root")
    held "$root" desk filing-cabinet "drafting-table/moves.md" "drafting-table/blueprints" "${paths[@]}" || blocked="$HELD_WORDS"
  fi
  DEFER_COMMITS="$(mktemp)" || die "cannot make a temp file"; TMP_PATHS+=("$DEFER_COMMITS")
  # The in-tray's sorted drops first, oldest first (0.20.0).
  while IFS=$'\x1e' read -r page kind fnum title slug lane size goal ssid problem <&4; do
    [ -n "$page" ] || continue
    log "$page: sorted by ${ssid:-?}, $([ "$kind" = new ] && printf 'folder: new' || printf 'folder: %s' "${fnum:-?}")"
    if move_sorted_drop "$root" "$day" "$page" "$kind" "$fnum" "$title" "$slug" "$lane" "$size" "$goal" "$ssid" "$problem"; then
      m=$((m + 1))
    else
      left=$((left + 1))
    fi
  done 4< <(printf '%s\n' "$sorted_plan")
  if [ -z "$blocked" ] && [ -n "$plan" ]; then
    drafting arrive "$root" >> "$DEFER_COMMITS" || { DEFER_COMMITS=""; die "the drafting table could not arrive"; }
    while IFS=$'\x1e' read -r lineno verb folder mday bp dline argstr _ <&3; do
      IFS=$'\x1f' read -r -a args <<< "$argstr"
      MOVE_TEXT="office moves: drafting-table/moves.md line $lineno, decided $mday${bp:+; blueprint $bp, decomposition line $dline}"
      log "line $lineno: $verb${folder:+ folder $folder}"
      case "$verb" in
        open)
          if ! rel="$(cmd_open "${args[@]}" < /dev/null)"; then stopped="$lineno"; break; fi
          number="$(folder_fact "$root/$rel/folder.md" number)" ;;
        queue)
          if ! (move_queue "$root" "$folder" "$day") < /dev/null; then stopped="$lineno"; break; fi
          number="$folder" ;;
        gate)
          if ! (move_gate "$root" "$folder" "$day" "${args[@]}") < /dev/null; then stopped="$lineno"; break; fi
          number="$folder" ;;
        close|absorb|split|retire)
          if ! (cmd_close "${args[@]}") < /dev/null; then stopped="$lineno"; break; fi
          number="$folder" ;;
        *) stopped="$lineno"; warn "line $lineno: no such move: $verb"; break ;;
      esac
      if ! drafting moves-tick "$root" "$lineno" "$number" ${bp:+--blueprint "$bp" --decomposition "$dline"} >> "$DEFER_COMMITS"; then
        stopped="$lineno"; break
      fi
      n=$((n + 1))
    done 3< <(printf '%s\n' "$plan")
  fi
  mapfile -t paths < <(sort -u "$DEFER_COMMITS" | grep -v '^$')
  DEFER_COMMITS=""; MOVE_TEXT=""
  if [ $((n + m)) -gt 0 ]; then
    local words="$n desk move(s) from drafting-table/moves.md"
    [ "$m" = 0 ] || words="$((n + m)) desk move(s): $m sorted drop(s) from the in-tray$([ "$n" = 0 ] || printf ', %s from drafting-table/moves.md' "$n")"
    commit_paths "$root" "office moves: $words" "${paths[@]}" || true
    log "applied $((n + m)) desk move(s)"
  elif [ "${#paths[@]}" -gt 0 ]; then
    commit_paths "$root" "office moves: the drafting table arrives" "${paths[@]}" || true
  fi
  [ "$left" = 0 ] || warn "$left sorted drop(s) stay in the in-tray (the lines above say why); office moves tries them again"
  if [ -n "$blocked" ]; then
    printf '%s\n' "$blocked" | sed 's/; /\n/g' | sed 's/^/[office]   /' >&2
    local done_words=""
    [ "$m" = 0 ] || done_words="; $m sorted drop(s) moved and committed"
    die "an open session holds what office moves writes, so the moves page waits (the one-writer rule); run it once that session is applied or closed$done_words"
  fi
  if [ -n "$stopped" ]; then
    die "office moves stopped at drafting-table/moves.md line $stopped, which could not be applied (the lines above say why); $((n + m)) move(s) before it are applied and committed, and nothing after it ran"
  fi
  return 0
}

# A candidate folder becomes queued: the one move no other verb makes.
move_queue() {
  local root="$1" number="$2" day="$3" rel status
  rel="$(helper folder-by-number "$root" "folder $number")" || exit 1
  [ "${rel%%/*}" = desk ] || die "folder $number is in the filing cabinet; only a candidate on the desk is queued"
  status="$(folder_fact "$root/$rel/folder.md" status)"
  [ "$status" = candidate ] || die "folder $number is ${status:-without a status line}, not a candidate; only a candidate is queued"
  folder_event "$root/$rel/folder.md" "$day" queued "$MOVE_TEXT" queued
  commit_paths "$root" "office moves: folder $number queued" "$rel/folder.md"
}

# move_gate ROOT N DAY KEY VALUE [KEY VALUE]...: gates on a folder on the
# desk, each a field line and a gated History line.
move_gate() {
  local root="$1" number="$2" day="$3" rel out; shift 3
  rel="$(helper folder-by-number "$root" "folder $number")" || exit 1
  [ "${rel%%/*}" = desk ] || die "folder $number is in the filing cabinet; a gate goes on a folder on the desk"
  while [ $# -ge 2 ]; do
    out="$(helper folder-gate "$root/$rel/folder.md" --key "$1" --value "$2" --day "$day")" || exit 1
    log "$(basename "$rel"): $out"
    shift 2
  done
  commit_paths "$root" "office moves: folder $number gated" "$rel/folder.md"
}

usage_rider() {
  cat <<'USAGE'
usage: office rider add TITLE | carry N | consumed N SID
A rider is small work with a named carrier: on the drafting table's riders
page until a folder's next session carries it, then in that folder's
Riders section, never both. Numbers are minted across the page and every
folder, never reused.
  office rider add TITLE --source SRC    a rider on the riders page
  office rider carry N --folder M        moved into folder M; a pointer stays on the page
  office rider consumed N SID            consumed at a session, in the folder that carries it
office riders lists them; office rider VERB --help explains each.
Examples:
  office rider add "Name the sweep commit" --source "proposal 2026-10-04-x-001 #2" --rides bin/bale_apply.py
  office rider carry 3 --folder 12
  office rider consumed 3 2026-10-06-sweep-001
USAGE
}

cmd_rider() {
  local sub="${1:-}"
  case "$sub" in
    add) shift; cmd_rider_add "$@" ;;
    carry) shift; cmd_rider_carry "$@" ;;
    consumed) shift; cmd_rider_consumed "$@" ;;
    ""|-h|--help) usage_rider ;;
    *) usage_rider >&2; die "office rider does not know $sub; it takes add, carry or consumed (office riders lists them)" ;;
  esac
}

usage_rider_add() {
  cat <<'USAGE'
usage: office rider add [TITLE] --source SRC [--rides GLOB | --carrier "folder N"] [--text TEXT]
                        (or the rider's text on stdin)
Adds rider N to the drafting table's riders page, one more than the
highest rider number on the page and in every folder, status queued, with
a dated queued line, and commits the page alone. The rider's text, from
stdin or --text, is kept as given: for a worker's Proposal, its What, Why
and Scope hints byte for byte. A title not given is the text's first line,
without a list marker or emphasis. --rides names the path glob whose next
session carries it (office riders --forecast finds it when a pack touches
it, and office start offers it then); a glob may name its project first,
as a lane does (office-src: bin/), so only a pack on that project
carries it. --carrier names the folder that will. The first rider brings the
drafting table into the office, in the same commit. On a terminal it asks
for the title, source and carrier it was not given; piped, it never asks.
Examples:
  office rider add "Name the sweep commit" --source "proposal 2026-10-04-x-001 #2" --rides bin/bale_apply.py
  office rider add --source "proposal 2026-10-04-x-001 #3" --carrier "folder 12" < proposal-3.txt
  office rider add                             (asks for the title, source and carrier)
USAGE
}

cmd_rider_add() {
  local words=() title="" source="" rides="" carrier="" text="" have_text=0 root tz day out tmp paths=() cite where=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --source|--rides|--carrier|--text|--title) [ $# -ge 2 ] || die "$1 needs a value (office rider add --help)"
        case "$1" in --source) source="$2" ;; --rides) rides="$2" ;; --carrier) carrier="$2" ;;
                     --text) text="$2"; have_text=1 ;; --title) title="$2" ;; esac; shift 2 ;;
      -h|--help) usage_rider_add; return 0 ;;
      -*) usage_rider_add >&2; die "office rider add does not know $1" ;;
      *) words+=("$1"); shift ;;
    esac
  done
  [ "${#words[@]}" -eq 0 ] || title="${words[*]}"
  [ -z "$rides" ] || [ -z "$carrier" ] || die "--rides and --carrier are two carriers; give one"
  root="$(resolve_office)" || exit 1
  require_current "$root"
  if [ "$have_text" = 0 ] && [ ! -t 0 ]; then text="$(cat)"; fi
  if can_ask; then
    [ -n "$title" ] || [ -n "$text" ] || ask title "Title, in a few words (office rider add TITLE)" "" 1 \
      "What the rider is, as the registry would write it. A rider is small work with a named carrier: it rides along with a folder's session rather than having a folder of its own."
    [ -n "$source" ] || ask source "Source: where it came from (--source)" "" 1 \
      "In one form: proposal SID #n (a worker's Proposal), ruling ID, folder N, a notepad page (notepad/...), or a person."
    if [ -z "$rides" ] && [ -z "$carrier" ]; then
      ask where "What carries it: a path glob, or folder N (--rides GLOB, --carrier \"folder N\")" "" 0 \
        "A path glob (bin/bale_apply.py, docs/*.md): the next session whose forecast touches it carries it. folder N: that folder's next session will. A plain return names no carrier yet."
      case "$where" in "") ;; folder\ *|[0-9]*) carrier="$where" ;; *) rides="$where" ;; esac
    fi
    if [ "$have_text" = 0 ] && [ -z "$text" ]; then
      ask text "Its text, in a line (--text; stdin carries a whole Proposal)" "" 0 \
        "Kept as given. For a worker's Proposal, pipe its What, Why and Scope hints on stdin instead, so they are kept byte for byte."
    fi
  else
    [ -n "$title" ] || [ -n "${text//[[:space:]]/}" ] || die "rider add needs a title (office rider add TITLE) or its text on stdin; piped input is never asked"
    [ -n "$source" ] || die "rider add needs --source SRC, where it came from; piped input is never asked"
  fi
  mapfile -t paths < <(arrival_targets "$root")
  one_writer "$root" "rider add" "drafting-table/riders.md" "${paths[@]}"
  tz="$(office_tz "$root")"; day="$(office_date "$tz")"
  tmp="$(mktemp)" || die "cannot make a temp file"; TMP_PATHS+=("$tmp")
  printf '%s' "$text" > "$tmp"
  run_drafting out rider-add "$root" --day "$day" --title "$title" --source "$source" \
    ${rides:+--rides "$rides"} ${carrier:+--carrier "$carrier"} --text-file "$tmp"
  cite="$(printf '%s\n' "$out" | head -n 1)"
  mapfile -t paths < <(printf '%s\n' "$out" | tail -n +2)
  check_page "$root" "drafting-table/riders.md"
  commit_paths "$root" "office rider add: $cite" "${paths[@]}" || true
  printf '%s\n' "$cite"
}

usage_rider_carry() {
  cat <<'USAGE'
usage: office rider carry [N] [--folder M]
Moves rider N from the riders page into folder M's Riders section, the
folder whose next session carries it: its text moves whole, its status
becomes carried with a dated line, the folder's History says carried, and
one pointer line stays on the page (- rider N -> folder M). A pointer is
not a copy. M is a folder on the desk. Commits the page and the folder.
On a terminal it asks for what it was not given; piped, it never asks.
Examples:
  office rider carry 3 --folder 12
  office rider carry "rider 3" --folder "folder 12"
USAGE
}

cmd_rider_carry() {
  local n="" want="" root name number tz day out paths=()
  while [ $# -gt 0 ]; do
    case "$1" in
      --folder) [ $# -ge 2 ] || die "--folder needs the folder that carries it"; want="$2"; shift 2 ;;
      -h|--help) usage_rider_carry; return 0 ;;
      -*) usage_rider_carry >&2; die "office rider carry does not know $1" ;;
      *) [ -z "$n" ] || die "rider carry takes one rider"; n="$1"; shift ;;
    esac
  done
  root="$(resolve_office)" || exit 1
  require_current "$root"
  if [ -z "$n" ]; then
    can_ask || { usage_rider_carry >&2; die "name the rider: office rider carry N --folder M; piped input is never asked"; }
    drafting riders "$root" >&2
    ask n "Which rider: its number (office rider carry N)" "" 1 "The rider's number, as office riders lists it."
  fi
  n="$(bare_number rider "$n")"
  if [ -z "$want" ]; then
    can_ask || die "name the folder that carries it: --folder M; piped input is never asked"
    ask_folder want "$root" desk "carry rider $n in"
  fi
  name="$(find_folder "$root" desk "$want")" || exit 1
  number="$(folder_fact "$root/desk/$name/folder.md" number)"
  [ -n "$number" ] || die "desk/$name has no number, so it cannot be cited as a rider's carrier; a folder from before numbers carries no rider"
  one_writer "$root" "rider carry" "drafting-table/riders.md" "desk/$name/folder.md"
  tz="$(office_tz "$root")"; day="$(office_date "$tz")"
  run_drafting out rider-carry "$root" "$n" --folder "folder $number" --day "$day"
  mapfile -t paths < <(printf '%s\n' "$out")
  commit_paths "$root" "office rider carry: rider $n -> folder $number" "${paths[@]}" || true
}

usage_rider_consumed() {
  cat <<'USAGE'
usage: office rider consumed [N] [SID]
Records that rider N was consumed at session SID, in the folder that
carries it: a dated consumed line under the rider and a consumed History
line. On the desk the rider's status line follows; in the filing cabinet
only lines are added, as for any filed folder. A rider still on the
riders page is carried first (office rider carry). A rider in a closed
folder that was never consumed is an orphan, and the desk says so.
Examples:
  office rider consumed 3 2026-10-06-sweep-001
USAGE
}

cmd_rider_consumed() {
  local n="" sid="" root rel tz day out paths=()
  while [ $# -gt 0 ]; do
    case "$1" in
      -h|--help) usage_rider_consumed; return 0 ;;
      -*) usage_rider_consumed >&2; die "office rider consumed does not know $1" ;;
      *) if [ -z "$n" ]; then n="$1"; elif [ -z "$sid" ]; then sid="$1"; else die "rider consumed takes a rider and a session id"; fi; shift ;;
    esac
  done
  root="$(resolve_office)" || exit 1
  require_current "$root"
  if [ -z "$n" ] || [ -z "$sid" ]; then
    can_ask || { usage_rider_consumed >&2; die "give the rider and the session: office rider consumed N SID; piped input is never asked"; }
    [ -n "$n" ] || ask n "Which rider: its number (office rider consumed N SID)" "" 1 "The rider's number, as office riders lists it."
    [ -n "$sid" ] || ask_field sid sid "SID" "Session id it was consumed at" "" 1
  fi
  n="$(bare_number rider "$n")"
  rel="$(drafting rider-home "$root" "$n")" || exit 1
  one_writer "$root" "rider consumed" "$rel/folder.md"
  tz="$(office_tz "$root")"; day="$(office_date "$tz")"
  run_drafting out rider-consumed "$root" "$n" "$sid" --day "$day"
  mapfile -t paths < <(printf '%s\n' "$out")
  commit_paths "$root" "office rider consumed: rider $n at $sid" "${paths[@]}" || true
}

usage_riders() {
  cat <<'USAGE'
usage: office riders [--forecast PATH... [--project NAME]] [--orphans]
Lists the riders: on the drafting table's riders page (with the pointer
each carried one left), and in folders, each with its status and carrier.
--forecast PATH... lists the queued riders on the page whose path glob a
pack with that forecast touches, so the pack can carry them; a sitting
runs it when it writes a pack line, and office start runs it over the
pack it is about to make. A glob may name its project first, as a lane
does (office-src: bin/): only a pack on that project (--project NAME)
carries it. --orphans lists only the riders in a closed folder that were
never consumed. It only reads.
Examples:
  office riders
  office riders --forecast bin/ lib/office_bale.py --project office-src
  office riders --orphans
USAGE
}

cmd_riders() {
  local args=() root
  while [ $# -gt 0 ]; do
    case "$1" in
      --forecast) shift; [ $# -gt 0 ] && [ "${1#-}" = "$1" ] || die "--forecast needs one or more paths"
        args+=(--forecast); while [ $# -gt 0 ] && [ "${1#-}" = "$1" ]; do args+=("$1"); shift; done ;;
      --orphans) args+=(--orphans); shift ;;
      --project) [ $# -ge 2 ] || die "--project needs the project the pack is on"; args+=(--project "$2"); shift 2 ;;
      -h|--help) usage_riders; return 0 ;;
      *) usage_riders >&2; die "office riders does not know $1" ;;
    esac
  done
  root="$(resolve_office)" || exit 1
  drafting riders "$root" "${args[@]}" || exit 1
}

usage_agenda() {
  cat <<'USAGE'
usage: office agenda add [TEXT...] --source SRC [--title TITLE] [--waiting "folder N"]...
                         (or the text on stdin)
Puts a question on the drafting table's agenda for a sitting to rule on,
so it can wait without a session: agenda N, one more than any agenda
number the page has held (disposed ones included), above the page's
Disposed list, with its source and the folders waiting on it. A folder
that must wait for the ruling gates on it: office open --after "agenda N".
Commits the page alone. The first item brings the drafting table into the
office, in the same commit. On a terminal it asks for the text and source
it was not given; piped, it never asks.
Examples:
  office agenda add "Where does a chat land?" --source notepad/2026-10-05.md
  office agenda add --source "folder 12" --waiting "folder 12" < question.txt
USAGE
}

cmd_agenda() {
  local sub="${1:-}" words=() text="" source="" title="" waiting=() have_text=0 root tz day out tmp paths=() cite
  case "$sub" in
    add) shift ;;
    ""|-h|--help) usage_agenda; return 0 ;;
    *) usage_agenda >&2; die "office agenda does not know $sub; it takes add (a sitting rules on the agenda; office desk shows what waits on it)" ;;
  esac
  while [ $# -gt 0 ]; do
    case "$1" in
      --source|--title|--waiting) [ $# -ge 2 ] || die "$1 needs a value (office agenda add --help)"
        case "$1" in --source) source="$2" ;; --title) title="$2" ;; --waiting) waiting+=(--waiting "$2") ;; esac; shift 2 ;;
      -h|--help) usage_agenda; return 0 ;;
      -*) usage_agenda >&2; die "office agenda add does not know $1" ;;
      *) words+=("$1"); shift ;;
    esac
  done
  root="$(resolve_office)" || exit 1
  require_current "$root"
  if [ "${#words[@]}" -gt 0 ]; then text="${words[*]}"; have_text=1
  elif [ ! -t 0 ]; then text="$(cat)"; have_text=1; fi
  if can_ask; then
    [ -n "${text//[[:space:]]/}" ] || ask text "The question, in a line or two (office agenda add TEXT)" "" 1 \
      "A decision a sitting will rule on, not work: the question, and what turns on it."
    [ -n "$source" ] || ask source "Source: where it came from (--source)" "" 1 \
      "In one form: a notepad page (notepad/...), folder N, a session id, ruling ID, or a person."
  else
    [ -n "${text//[[:space:]]/}" ] || die "agenda add needs the question: office agenda add TEXT, or on stdin; piped input is never asked"
    [ -n "$source" ] || die "agenda add needs --source SRC, where it came from; piped input is never asked"
  fi
  mapfile -t paths < <(arrival_targets "$root")
  one_writer "$root" "agenda add" "drafting-table/agenda.md" "${paths[@]}"
  tz="$(office_tz "$root")"; day="$(office_date "$tz")"
  tmp="$(mktemp)" || die "cannot make a temp file"; TMP_PATHS+=("$tmp")
  printf '%s' "$text" > "$tmp"
  run_drafting out agenda-add "$root" --day "$day" --text-file "$tmp" --source "$source" ${title:+--title "$title"} "${waiting[@]}"
  cite="$(printf '%s\n' "$out" | head -n 1)"
  mapfile -t paths < <(printf '%s\n' "$out" | tail -n +2)
  check_page "$root" "drafting-table/agenda.md" --insertion
  commit_paths "$root" "office agenda add: $cite" "${paths[@]}" || true
  printf '%s\n' "$cite"
}

usage_rulings() {
  cat <<'USAGE'
usage: office rulings [ID] [--check]
Lists the rulings ledger (drafting-table/rulings.md): each ruling by id
with its bold lead, how often it was amended, who supersedes it and where
it was derived. Given an ID, renders that ruling with its fields, its text,
its amendments in date order, its supersessions (forward, and back-pointers
derived from later records, never written) and the folders and sessions
it landed at. --check resolves every citation on the drafting table and
the desk against the citation grammar (folder N, blueprint ID, ruling ID,
evidence N, watch WN, rider N, agenda N, notepad pages, session ids) and
names each that does not resolve; it exits 1 when one does not. Only a
sitting writes a ruling; this only reads.
Examples:
  office rulings
  office rulings 2026-10-05-riders-home
  office rulings --check
USAGE
}

cmd_rulings() {
  local id="" check=0 root
  while [ $# -gt 0 ]; do
    case "$1" in
      --check) check=1; shift ;;
      -h|--help) usage_rulings; return 0 ;;
      -*) usage_rulings >&2; die "office rulings does not know $1" ;;
      *) [ -z "$id" ] || die "rulings takes one ruling id"; id="${1#ruling }"; shift ;;
    esac
  done
  [ "$check" = 0 ] || [ -z "$id" ] || die "--check reads every citation; it takes no ruling id"
  root="$(resolve_office)" || exit 1
  if [ "$check" = 1 ]; then
    drafting rulings "$root" --check
    case $? in 0) return 0 ;; 3) die "some citations do not resolve (above)" ;; *) die "could not check the citations" ;; esac
  fi
  drafting rulings "$root" ${id:+"$id"} || exit 1
}

usage_evidence() {
  cat <<'USAGE'
usage: office evidence [N]
Lists the evidence ledger (drafting-table/evidence.md): each entry by
number with its title, when and by whom it was filed, and its occurrence
count by attribution (planner, worker, operator, courier); then any record
the ledger should not hold (an entry naming no session and no notepad
page, a number used twice, an occurrence of no entry). Given N, renders
evidence N with its fields, its text, and every occurrence and derivation
pointing at it. Only a sitting writes evidence; this only reads.
Examples:
  office evidence
  office evidence 13
USAGE
}

cmd_evidence() {
  local n="" root
  while [ $# -gt 0 ]; do
    case "$1" in
      -h|--help) usage_evidence; return 0 ;;
      -*) usage_evidence >&2; die "office evidence does not know $1" ;;
      *) [ -z "$n" ] || die "evidence takes one entry number"; n="$(bare_number evidence "$1")"; shift ;;
    esac
  done
  root="$(resolve_office)" || exit 1
  drafting evidence "$root" ${n:+"$n"}
  case $? in 0|3) return 0 ;; *) exit 1 ;; esac
}

# --- the watches and the digest -----------------------------------------------
#
# A watch is a named re-trigger a sitting writes on the drafting table's
# watches register; its events are records on the watch log, filed
# paper. lib/office_watches.py reads them, evaluates each query watch
# through the install's share/watch-queries.toml and the reader, and
# appends the fired records; lib/office_digest.py writes the sitting-open
# page. These verbs hold the one-writer rule, check what they append, and
# commit exactly what they touched.

WATCHES="$OFFICE_SRC/lib/office_watches.py"
DIGEST="$OFFICE_SRC/lib/office_digest.py"
watches_py() { python3 -B "$WATCHES" "$@"; }
digest_py() { python3 -B "$DIGEST" "$@"; }

usage_watches() {
  cat <<'USAGE'
usage: office watches [--all]
       office watches check [--record]
Lists the watches on the drafting table's register (drafting-table/
watches.md): each open watch with what it evaluates (a query from the
install's share/watch-queries.toml, or eye), its threshold, scope and
source, and its last record on the watch log. --all lists the closed ones
too. A watch's state is read from the log, never from the entry. Only a
sitting writes a watch, re-arms, rewords or closes one; this only reads.
An office with no register says so and exits 0. office watches check
evaluates them (office help watches check).
Examples:
  office watches
  office watches --all
  office watches check
USAGE
}

usage_watches_check() {
  cat <<'USAGE'
usage: office watches check [--record]
Runs every open query watch over the window since its last fired record
(from the day after it; a watch never fired, from the day it was opened),
once for this office's own bale registry and once for each project it
scopes, and prints one line per watch and place: fired, not fired, or
cannot evaluate (a query bale cannot answer says "cannot evaluate: bale
does not stamp ... (slip)", never not fired). Every eye watch prints as
needs an eye, with the sittings since its last record; then the standing
lines, the catalog's observations over bale's whole corpus, as observed.
It reads bale's stats --json surfaces through the reader and nothing
else, and writes nothing. --record appends a fired record to the watch
log (drafting-table/watch-log.md) for each watch that fired, after the
one-writer rule and the filed-page check, and commits the log alone; the
log is made from its template on its first write. Re-arming, rewording,
closing and a not-fired record are a sitting's. Exits 0, or 3 when a
place could not be read or a record does not read (the lines say which).
Examples:
  office watches check
  office watches check --record
USAGE
}

cmd_watches() {
  local all=0 root
  if [ "${1:-}" = check ]; then shift; cmd_watches_check "$@"; return; fi
  while [ $# -gt 0 ]; do
    case "$1" in
      --all) all=1; shift ;;
      -h|--help) usage_watches; return 0 ;;
      *) usage_watches >&2; die "office watches does not know $1; it takes --all, or check" ;;
    esac
  done
  root="$(resolve_office)" || exit 1
  watches_py list "$root" $([ "$all" = 1 ] && printf -- --all)
  case $? in 0) return 0 ;; 3) warn "some records do not read (the lines above say which)"; return 3 ;; *) exit 1 ;; esac
}

cmd_watches_check() {
  local record=0 root tz day changed rc paths=() targets=()
  while [ $# -gt 0 ]; do
    case "$1" in
      --record) record=1; shift ;;
      -h|--help) usage_watches_check; return 0 ;;
      *) usage_watches_check >&2; die "office watches check does not know $1; it takes --record" ;;
    esac
  done
  root="$(resolve_office)" || exit 1
  tz="$(office_tz "$root")"; day="$(office_date "$tz")"
  if [ "$record" = 0 ]; then
    watches_py check "$root" --day "$day" --tz "$tz"
    rc=$?
    case $rc in 0|3) return "$rc" ;; *) exit 1 ;; esac
  fi
  require_current "$root"
  mapfile -t targets < <(arrival_targets "$root")
  one_writer "$root" "watches check --record" "drafting-table/watch-log.md" "${targets[@]}"
  changed="$(mktemp)" || die "cannot make a temp file"; TMP_PATHS+=("$changed")
  watches_py check "$root" --day "$day" --tz "$tz" --record --changed "$changed"
  rc=$?
  case $rc in 0|3) ;; *) exit 1 ;; esac
  mapfile -t paths < "$changed"
  if [ "${#paths[@]}" -gt 0 ]; then
    check_page "$root" "drafting-table/watch-log.md"
    commit_paths "$root" "office watches check --record: fired records on the watch log" "${paths[@]}" || true
  fi
  return "$rc"
}

usage_digest() {
  cat <<'USAGE'
usage: office digest
Writes the sitting-open page, drafting-table/digest.md, prints it, and
commits it alone. Every section is computed when it runs, never kept:
versions per project (each project's latest release and the bale docs
its latest sessions were packed under); since the last sitting (the
sessions applied, held, bailed and still open, read from bale's records,
the folders opened and closed and what was added to the drafting table,
read from git, since the latest sitting's notepad page was filed, and the
page says how it found that); the watches (office watches check's own
lines, never recorded); the standing lines; the desk (in flight, the first
five ready, parked by gate); the agenda (open items, oldest first); and the
open blueprints with their member folders. The page is overwritten on every
run and never edited by hand, like the survey; the first run brings the
drafting table into the office. office start runs it before it packs a
read-only office session (a sitting), and the drafting table rides with
the sitting. Exits 0, or 3 when a project could not be read (the page says
which).
Examples:
  office digest
  office digest | less
USAGE
}

cmd_digest() {
  local before_pack=0 root tz changed rc paths=() targets=()
  while [ $# -gt 0 ]; do
    case "$1" in
      --before-pack) before_pack=1; shift ;;
      -h|--help) usage_digest; return 0 ;;
      *) usage_digest >&2; die "office digest does not know $1; it takes no arguments" ;;
    esac
  done
  root="$(resolve_office)" || exit 1
  if [ "$before_pack" = 1 ]; then refresh_digest "$root"; return 0; fi
  require_current "$root"
  tz="$(office_tz "$root")"
  mapfile -t targets < <(arrival_targets "$root")
  one_writer "$root" "digest" "drafting-table/digest.md" "${targets[@]}"
  changed="$(mktemp)" || die "cannot make a temp file"; TMP_PATHS+=("$changed")
  digest_py "$root" --tz "$tz" --changed "$changed" --print
  rc=$?
  case $rc in 0|3) ;; *) die "the digest could not be written (the line above says why)" ;; esac
  mapfile -t paths < "$changed"
  [ "${#paths[@]}" -eq 0 ] || commit_paths "$root" "office digest: the sitting-open page" "${paths[@]}" || true
  return "$rc"
}

# Before office start packs a sitting (a read-only office session; office
# digest --before-pack, which the start in lib/office_bale.py runs once its
# checks and the survey have passed): the digest written again and
# committed alone, so the sitting opens on a page computed just before it
# was packed. Never fails a start: an open session holding the drafting
# table (the one-writer rule), or a digest that cannot be written, leaves
# the page as it was and says so.
refresh_digest() {
  local root="$1" held rc tz changed paths=() targets=()
  mapfile -t targets < <(arrival_targets "$root")
  held="$(reader writers "$root" "drafting-table/digest.md" "${targets[@]}" 2>/dev/null)"; rc=$?
  case $rc in
    0) ;;
    3) warn "an open session holds the drafting table (the one-writer rule), so office start leaves the digest as it is"
       printf '%s\n' "$held" | sed 's/^/[office]   /' >&2
       return 0 ;;
    *) warn "bale's registry in this office could not be read, so office start leaves the digest as it is"
       return 0 ;;
  esac
  tz="$(office_tz "$root")"
  changed="$(mktemp)" || { warn "cannot make a temp file, so the digest was not written"; return 0; }
  TMP_PATHS+=("$changed")
  digest_py "$root" --tz "$tz" --changed "$changed" >/dev/null
  rc=$?
  case $rc in
    0) ;;
    3) warn "the digest was written, but a project could not be read; the page says which" ;;
    *) warn "the digest could not be written, so the sitting reads the page as it was (office digest says why)"
       return 0 ;;
  esac
  mapfile -t paths < "$changed"
  if [ "${#paths[@]}" -gt 0 ]; then
    commit_paths "$root" "office start: digest" "${paths[@]}" \
      || warn "the digest was written but not committed; drafting-table/digest.md is changed on disk"
  fi
  log "wrote the digest for the sitting (drafting-table/digest.md); it rides with the drafting table"
}

# --- sending a session out ----------------------------------------------------
#
# office start: one command from a folder to an out tray. It asks which
# job, whether the work lands in the office or on a project, and the
# goal, and derives the rest: the slug from the folder, the forecast from
# its lane, the work class from its class. Then the read side packs the
# context that rides and the session itself, records the session id in
# the folder, and gathers every file to attach into one directory.

MACHINE_FILE="$CONFIG_DIR/machine.toml"
# Install files a session needs beside its request (a template it writes
# from), set by the verb that sends it out through cmd_start (office
# blueprint close): they ride as one context tarball made from a scratch
# copy, so the install is never written.
START_INSTALL_FILES=()

# A per-machine setting, outside every office: KEY from machine.toml, or
# the default given. An empty value in the file turns a desktop step off.
machine_setting() {
  if [ -f "$MACHINE_FILE" ]; then
    helper get "$MACHINE_FILE" "$1" --default "$2" 2>/dev/null && return 0
    warn "$MACHINE_FILE could not be read; using the default for $1"
  fi
  printf '%s\n' "$2"
}

# Whether this machine is WSL: its kernel's version string names
# Microsoft. The one place the office asks it (the survey's machine class
# and the two desktop steps' defaults here; the paste command's candidate
# in lib/office_helper.py reads the same variable): OFFICE_PROC_VERSION
# names the file to read in place of the kernel's own, and "" says no.
# The suite's Env sets it, so no test depends on the machine it runs on,
# and a test that imitates WSL points it at a file of its own.
on_wsl() {
  local source="${OFFICE_PROC_VERSION-/proc/version}"
  [ -n "$source" ] || return 1
  grep -qi microsoft "$source" 2>/dev/null || return 1
}

# desktop_tool NAME: the path of the desktop program NAME (clip.exe,
# explorer.exe: what WSL puts on the PATH from Windows), found in the
# directories OFFICE_DESKTOP_PATH lists when it is set ("" lists none)
# and on PATH when it is not; nothing, and status 1, when there is none.
# Every check for a desktop program goes through here, never through
# command -v: the suite's Env points it at a directory of each test's
# own, and tests/test_suite_clock.py holds the source to that. The path
# is what runs, so a program found is the program used.
desktop_tool() {
  local name="$1" dir dirs=()
  IFS=: read -r -a dirs <<< "${OFFICE_DESKTOP_PATH-$PATH}"
  for dir in "${dirs[@]}"; do
    [ -n "$dir" ] || continue
    if [ -f "$dir/$name" ] && [ -x "$dir/$name" ]; then
      printf '%s\n' "$dir/$name"
      return 0
    fi
  done
  return 1
}

# Where this machine's downloads land: machine.toml's downloads, a list
# of directories, the office's own setting (it never reads bale's
# config). office land finds a response there by name and office start a
# bundle for a hosted project; of several browser copies of one name
# (NAME (1).EXT) the newest wins and is named. Asked once, on a terminal,
# the first time a verb needs it (this machine's likely directories
# offered, ? explaining it), kept, and never asked again; piped, the verb
# refuses and names the key. downloads_setting WHY sets DOWNLOADS (one
# directory per line); WHY says what needs it.
DOWNLOADS=""
DOWNLOADS_HELP="Where this machine's browser saves what you download from a chat: the responses office land brings back and the bundles office start opens. The office looks there by name, and of several copies of one name (a browser saves the second as 'NAME (1).tar.gz') it takes the newest and says which. Give one directory or more: numbers from the list above, or paths, comma-separated. The answer is kept as downloads in this machine's machine.toml (the office's own settings, never bale's config) and is not asked again; edit that file to change it."
downloads_setting() {
  local why="$1" out rc cands=() ans parts=() picked=() w d i bad
  out="$(helper downloads "$MACHINE_FILE")"; rc=$?
  case "$rc" in
    0) DOWNLOADS="$out"; return 0 ;;
    3) ;;
    *) die "downloads in $MACHINE_FILE does not read (the line above says why); fix it there" ;;
  esac
  can_ask || die "$why, so the office needs to know where this machine's downloads land: set downloads in $MACHINE_FILE, a list of directories (downloads = [\"~/Downloads\"]); piped input is never asked"
  mapfile -t cands < <(helper downloads "$MACHINE_FILE" --candidates 2>/dev/null)
  printf 'Where do downloads land on this machine? %s; this is asked once and kept as downloads in %s.\n' "$why" "$MACHINE_FILE" >&2
  if [ "${#cands[@]}" -gt 0 ]; then
    for i in "${!cands[@]}"; do printf '  %s. %s\n' "$((i + 1))" "${cands[$i]}" >&2; done
  else
    printf '  (no likely directory found on this machine; give a path)\n' >&2
  fi
  while :; do
    ask ans "The directories, by number or path, comma-separated (downloads in machine.toml)" \
      "$([ "${#cands[@]}" -gt 0 ] && printf 1)" 1 "$DOWNLOADS_HELP"
    picked=(); bad=0
    IFS=',' read -r -a parts <<< "$ans"
    for w in "${parts[@]}"; do
      w="$(printf '%s' "$w" | sed 's/^[[:space:]]*//; s/[[:space:]]*$//')"
      [ -n "$w" ] || continue
      if [[ "$w" =~ ^[0-9]+([[:space:]]+[0-9]+)*$ ]]; then
        for d in $w; do
          if [ "$d" -ge 1 ] && [ "$d" -le "${#cands[@]}" ]; then picked+=("${cands[$((d - 1))]}")
          else printf '  %s is not a number from the list\n' "$d" >&2; bad=1; fi
        done
        continue
      fi
      case "$w" in "~") w="$HOME" ;; "~/"*) w="$HOME/${w#\~/}" ;; esac
      if [ -d "$w" ]; then picked+=("$(cd "$w" && pwd)")
      else printf '  %s is not a directory on this machine\n' "$w" >&2; bad=1; fi
    done
    [ "$bad" = 0 ] && [ "${#picked[@]}" -gt 0 ] && break
    [ "${#picked[@]}" -gt 0 ] || [ "$bad" = 1 ] || printf '  one directory at least; ? explains it\n' >&2
  done
  helper downloads "$MACHINE_FILE" --set "${picked[@]}" >/dev/null \
    || die "downloads could not be written to $MACHINE_FILE (the line above says why)"
  log "kept in $MACHINE_FILE: downloads = $(printf '%s\n' "${picked[@]}" | paste -sd, - | sed 's/,/, /g'); it is not asked again (edit the file to change it)"
  DOWNLOADS="$(printf '%s\n' "${picked[@]}")"
}

# downloads_known: machine.toml's downloads into DOWNLOADS, without
# asking; returns 3 when the key is not set (or does not read: said).
downloads_known() {
  local out rc
  out="$(helper downloads "$MACHINE_FILE" 2>/dev/null)"; rc=$?
  case "$rc" in
    0) DOWNLOADS="$out"; return 0 ;;
    3) DOWNLOADS=""; return 3 ;;
  esac
  warn "downloads in $MACHINE_FILE does not read (helper downloads $MACHINE_FILE says why); going on without it"
  DOWNLOADS=""
  return 3
}

usage_start() {
  cat <<'USAGE'
usage: office start [FOLDER] [--in-office | --on PROJECT] [--goal TEXT] [--slug SLUG]
                    [--write PATH]... [--include PATH]... [--brief FILE] [--read-only]
                    [--leave-out PATH]... [--no-rides] [--carry N... | --carry none]
       office start [FOLDER] [--in-office | --on PROJECT] --bundle FILE [--leave-out PATH]... [--no-rides]
                    [--carry N... | --carry none]
       office start --drop PAGE [--title TITLE] [--lane LANE] [--size SIZE] [--goal TEXT] [--slug SLUG]
                    [--write PATH]... [--include PATH]... [--leave-out PATH]... [--no-rides]
       office start --sort
Packs a session for a folder on the desk and gathers everything to attach
into one out tray: the request, the doctrine, and whatever rides with the
work (on a project, the office's context and the project's ride-alongs;
in the office, the project its lane names, when it names one). Records
the session id in the folder and prints the opener to paste. A page of a
sitting's words that the brief carries (between NOTEPAD PAGE markers) is
filed in the notepad. Before it packs, it surveys the machine again, so
the survey every session reads first is current; the doctrine rides once
(a project whose own tree carries the same doctrine/ ships it there; one
whose doctrine differs gets the install's beside it, named as the
install's). A session on a project also gets the install's
templates/walkthrough.md and templates/delivery.md: it writes the folder's
two pages from them as the Walkthrough and Delivery sections at the end
of its notes.md, and office land files them in the folder. Every session
it sends out carries the in-tray's unsorted drops (office drop): in the
request for an office session, in the office's context for a project
session; the out tray's listing and the opener say how many ride.
  FOLDER         the job: its name, a unique part of it, or folder N;
                 on a terminal it is asked for, and new opens one through
                 office open's own questions (a title already on the desk
                 is offered as the folder to start, before anything else
                 is asked)
  --in-office    the work lands in the office (packed from the office,
                 forecasting the folder and the notepad)
  --on PROJECT   the work lands in one of the office's projects (packed
                 from the project, with the office's context beside it)
  --goal TEXT    the session's goal, one sentence; a folder with a goal
                 field (office open --goal, or a sorted drop) offers its
                 own, which a plain return takes (piped, it is taken)
  --slug SLUG    default: the folder's name without its date, and
                 -office after it for a session in the office
  --write PATH   what the session will change, relative to where it is
                 packed; for a project, default: the paths in the folder's
                 lane, else the whole repo
  --include PATH more to ship as context (a project ships its whole repo
                 by default)
  --brief FILE   a brief to ship as the request's README.md; a folder
                 with a brief.md (a sorted drop's Brief) sends that one
                 unless --brief names another
  --read-only    forecast nothing: a sitting that lands nothing itself
                 (office land SID ends it when the sitting is over)
  --leave-out PATH
                 a path that rides with the project (office projects
                 lists them) stays home for this session; repeatable. On
                 a terminal, start shows what rides and asks; piped,
                 everything declared rides
  --no-rides     every ride-along stays home for this session
  --carry N      carry rider N into the folder before the pack, so it rides
                 in the request (repeatable); --carry none carries none.
                 On a terminal, start offers each queued rider on the
                 riders page whose path glob the pack's forecast touches
                 (office riders --forecast), default carry; piped, it
                 carries none and names each that matched
  --drop PAGE    a dropped message straight out as a project session: PAGE
                 is the drop's page in the in-tray (in-tray/NAME.md, or its
                 name). start mints the folder through office open's own
                 code (the title from the drop's first line, --title
                 overrides; the lane from the drop's project when it is
                 one of the office's, else asked, --lane the twin; the
                 size asked, small by default, --size; the source drop),
                 moves the page into the folder as drops/NAME.md, and
                 packs the session on the lane's project with the goal
                 "Sort the dropped message and do what it asks" (--goal
                 overrides) and a brief from the install's
                 templates/drop-brief.md: sort first, then do the work.
                 Refused while an open session in the office's registry
                 holds the in-tray or the desk. Given a FOLDER too, PAGE
                 is in that folder's drops/: the one line that retries a
                 drop start whose session did not go out
  --sort         the standalone sort: an office session for the drops
                 nothing carried, belonging to no folder. It ships every
                 folder's folder.md, every handbook chapter, the hung items
                 and the doctrine, and a brief from the install's
                 templates/sort-brief.md carrying every unsorted drop and
                 the desk as office desk prints it; it forecasts the
                 notepad and, where the office has a drafting table, its
                 moves page (which arrives if it must). office land SID
                 files its Sort and Handbook, and runs office moves.
                 Refused while another sort is out, while an open session
                 holds the in-tray, and when no drop is unsorted
  --bundle FILE  a planner's bundle (FILE.bale-bundle, a path or the bare
                 name bale's search finds; given as a word, it needs no
                 flag): bale open replays the bundle's own pack line, so
                 the goal, the forecast and the brief are the bundle's,
                 and the office adds nothing to it. Where defaults to the
                 one place whose tree holds every path the bundle names,
                 and a bundle whose paths no one place holds is refused
                 before bale runs. bale open --check runs first, where
                 the bundle opens and before start writes anything (a
                 folder for new, the survey, the tray): a name bale's
                 search cannot find, or a bundle bale would refuse, stops
                 the start in bale's words with nothing written
A project on a host (office projects add --host) is packed on its host:
start first checks that the host answers (a host that does not stops the
start there, with your connect line), that its bale is at the read side's
floor (one below it is refused, naming office projects level-bale, which
brings it level; start never upgrades it) and that the repo there is one
bale runs in. Then bale's pack, or bale open --check and bale open for a
bundle, runs there through the project's shell, the brief or the bundle
travelling there first, and the request bale makes is carried back into
the out tray here; the office's context and the doctrine are made here,
as for any project. A bundle for a hosted project is a file here: its
path, or a bare name found in this machine's downloads (machine.toml's
downloads, asked once on a terminal; of several browser copies of the
name the newest is taken and named), since bale's own search would run
on the host. The temporary directory start makes on the host is removed
on success and on failure. One start reaches the host once, and the
reads it needs there share a connection.
When start opened the folder itself (new) and its session does not go out,
the folder stays and start's last line is the one line that retries it.
When the response comes back, office land brings it in.
Under the hood: bale pack --json (or bale open --check, then bale open, for
a bundle) where the work lands, and bale pack --context for each context
tarball; OFFICE_DEBUG=1 shows each call.
Examples:
  office start                                 (asks which job, where, and the goal)
  office start fix-login --on office-src --goal "Fix the login redirect"
  office start plan-wave --in-office --read-only --goal "Plan the next wave"
  office start fix-login --on office-src 2026-10-05-fix-login.bale-bundle
  office start fix-login --on office-src --goal "Fix it" --leave-out ~/nisaba-src/blueprints
  office start fix-login --on office-src --goal "Fix it" --carry 3
  office start --drop in-tray/2026-10-14-login-error.md
  office start --drop 2026-10-14-login-error --lane office-src --size medium
  office start --sort
The out tray is ~/out-tray/SID unless this machine's
~/.config/office-src/machine.toml sets out_tray. On WSL the tray opens in
Explorer and the opener goes to the clipboard; clipboard_command and
open_command in the same file change that, and "" turns either off.
USAGE
}

# The folder a start is for: asked on a terminal, with new as a choice.
ask_start_folder() {
  local __var="$1" root="$2" d number n=0
  printf 'Folders on the desk:\n' >&2
  for d in "$root/desk"/*/; do
    [ -d "$d" ] || continue
    n=$((n + 1)); number=""
    [ -f "$d/folder.md" ] && number="$(folder_fact "$d/folder.md" number)"
    printf '  %s%s\n' "${number:+folder $number  }" "$(basename "$d")" >&2
  done
  [ "$n" -gt 0 ] || printf '  (none yet)\n' >&2
  ask "$__var" "Which job: a unique part of its name, folder N, or new to open one (office start FOLDER)" \
    "$([ "$n" -eq 0 ] && printf new)" 1 \
    "The folder the session works on. new opens one first, with office open's questions (title, size, lane, source)."
}

# ask_rides VAR PROJECT RIDE...: on a terminal, what rides with the
# project, each with its size, and which stay home this once. VAR gets
# the ones left out (the flag twin is --leave-out, repeatable, or
# --no-rides). The default is that everything rides, as declared.
ask_rides() {
  local __var="$1" project="$2" ans n i size picked=() w; shift 2
  local rides=("$@")
  printf 'What rides with %s (declared; office projects set %s changes it for good):\n' "$project" "$project" >&2
  i=0
  for w in "${rides[@]}"; do
    i=$((i + 1))
    size="$w"
    case "$size" in "~") size="$HOME" ;; "~/"*) size="$HOME/${size#\~/}" ;; esac
    size="$(timeout 3 du -sh "$size" 2>/dev/null | cut -f1)"
    printf '  %s. %s%s\n' "$i" "$w" "${size:+  ($size)}" >&2
  done
  while :; do
    ask ans "Which ride with this session: all, none, or the numbers to leave out (--leave-out PATH, --no-rides)" \
      "all" 1 \
      "Each declared ride-along is packed as context beside the request. Leave one out when this session does not need it: it stays home this once, and the declaration is unchanged. all rides everything; none leaves everything out; 1 3 leaves out the first and the third."
    case "$ans" in
      all|All|ALL) eval "$__var=()"; return 0 ;;
      none|None|NONE) eval "$__var=(\"\${rides[@]}\")"; return 0 ;;
    esac
    picked=(); n=0
    for w in ${ans//,/ }; do
      if [[ "$w" =~ ^[0-9]+$ ]] && [ "$w" -ge 1 ] && [ "$w" -le "${#rides[@]}" ]; then
        picked+=("${rides[$((w - 1))]}"); n=$((n + 1))
      else
        n=-1; break
      fi
    done
    if [ "$n" -gt 0 ]; then eval "$__var=(\"\${picked[@]}\")"; return 0; fi
    printf '  all, none, or numbers from the list above\n' >&2
  done
}

# ask_where WHERE_VAR PROJECT_VAR DEFAULT WHY NAMES: where the work lands,
# office or one of the projects (NAMES, one per line), asked on a
# terminal; the flag twins are --in-office and --on PROJECT.
ask_where() {
  local __w="$1" __p="$2" def="$3" why="$4" known="$5" ans list
  list="$(printf '%s' "$known" | paste -sd, - | sed 's/,/, /g')"
  can_ask || die "say where the work lands: --in-office, or --on PROJECT ($list); piped input is never asked"
  while :; do
    ask ans "Where the work lands: office, or the project it changes ($list) (--in-office or --on PROJECT)" \
      "$def" 1 \
      "office: the session works in this office (the folder, the notepad) and is packed here. A project's name: the session changes that project's repo and is packed there, with this office's context riding beside it, never inside it.${why:+ The default is $def because $why.}"
    if [ "$ans" = office ]; then printf -v "$__w" '%s' office; return 0; fi
    if printf '%s\n' "$known" | grep -qxF -- "$ans"; then
      printf -v "$__w" '%s' project; printf -v "$__p" '%s' "$ans"; return 0
    fi
    printf '  office, or one of this office'"'"'s projects: %s\n' "$list" >&2
  done
}

# start_check_place WHERE PROJECT NAMES: a project start names a project
# the office scopes. A project on a host is checked here, before anything
# is written (a folder for new, the survey, the tray, the session): the
# host answers (the reach check, with the connect line when it does not),
# its bale is at the read side's floor (start never upgrades it; the
# refusal names office projects level-bale), and the repo there is one
# bale runs in. Once per start: START_CHECKED_HOST remembers it.
start_check_place() {
  [ "$1" = project ] || return 0
  printf '%s\n' "$3" | grep -qxF -- "$2" \
    || die "--on $2: no such project in this office (it scopes: $(printf '%s' "$3" | paste -sd, - | sed 's/,/, /g'); office projects add adds one)"
  local on_host out
  on_host="$(project_host "$root" "$2")"
  [ -n "$on_host" ] || return 0
  [ "${START_CHECKED_HOST:-}" != "$2" ] || return 0
  log "$2 is on $on_host: asking it to answer, and checking its bale and its repo, before anything is written"
  out="$(reader start-check "$root" --project "$2")" \
    || die "nothing was written: no folder, no survey, no out tray, no session"
  START_CHECKED_HOST="$2"
  log "$on_host answers, with bale ${out#*$'\t'}: the session is packed there and its request carried back to the out tray"
}

# project_host ROOT NAME: the host a project declares, or nothing.
project_host() {
  helper project-facts "$1/$MANIFEST_REL" "$2" 2>/dev/null | awk -F'\t' '$1 == "host" {print $2}'
}

# check_start_bundle ROOT WHERE PROJECT BUNDLE: bale open --check where
# the bundle opens, before start writes anything (a survey, a tray, a
# session). bale finds a bare name through its own search, verifies the
# bundle and runs every gate it runs before an open, and writes nothing;
# a refusal stops the start in bale's words.
check_start_bundle() {
  local root="$1" where="$2" project="$3" bundle="$4" out place
  place="$([ "$where" = office ] && printf 'in the office' || printf 'on %s' "$project")"
  log "asking bale whether it can open $(basename "$bundle") $place (bale open --check, which writes nothing)"
  local cargs=(--where "$where")
  [ "$where" != project ] || cargs+=(--project "$project")
  # The host was checked once this start (start-check): not again.
  [ "$where" != project ] || [ "${START_CHECKED_HOST:-}" != "$project" ] || cargs+=(--checked)
  out="$(reader bundle-check "$root" "${cargs[@]}" --bundle "$bundle")" \
    || die "nothing else was written: no survey, no out tray, no session (the lines above are bale's own words, or the office's where it could read the bundle itself)"
  local found_at line over=() said=()
  found_at="$(printf '%s\n' "$out" | head -n 1)"
  while IFS= read -r line; do
    case "$line" in
      over$'\t'*) over+=("${line#over$'\t'}") ;;
      bale$'\t'*) said+=("${line#bale$'\t'}") ;;
    esac
  done <<< "$(printf '%s\n' "$out" | tail -n +2)"
  [ -z "$found_at" ] || log "bale found it at $found_at, and every gate it runs before an open passed"
  # A second desk is bale's to recognize (0.18.0): the office's own
  # overlap check caught this bundle, and bale's rehearsal passed it, so
  # the office says what it saw and what bale said, and goes on.
  if [ "${#over[@]}" -gt 0 ]; then
    for line in "${over[@]}"; do log "$line"; done
    for line in "${said[@]}"; do printf '%s\n' "$line" >&2; done
    log "bale's own rehearsal passed it all the same (outcome rehearsed), so bale takes this bundle as it would open it: a bundle whose session is still open joins that session as a second desk, which is bale's to recognize; the office refuses an overlap only where bale would"
    START_BALE_REHEARSED=1
  fi
}

# resolve_hosted_bundle ROOT WHERE PROJECT: a bundle named by a bare name
# (not a file in the current directory) for a project on a host is found
# in the downloads here (machine.toml's downloads, asked once), the newest
# of its browser copies winning and named, since bale's own search would
# run on the host, where the downloaded file is not. Sets bundle to its
# path. A project on this machine leaves the name to bale's search.
resolve_hosted_bundle() {
  local root="$1" where="$2" project="$3" on_host args=() d found
  [ -n "$bundle" ] && [ "$where" = project ] && [ ! -f "$bundle" ] || return 0
  on_host="$(project_host "$root" "$project")"
  [ -n "$on_host" ] || return 0
  downloads_setting "$(basename "$bundle"), a bundle for $project on $on_host, is found on this machine by name and carried there"
  while IFS= read -r d; do [ -n "$d" ] && args+=(--dir "$d"); done <<< "$DOWNLOADS"
  found="$(reader find-download --name "$(basename "$bundle")" "${args[@]}")" \
    || die "nothing was written: no folder, no survey, no out tray, no session (give the bundle's path, or add the directory it is in to downloads in $MACHINE_FILE)"
  log "the bundle $(basename "$bundle") is $found on this machine; it travels to $on_host for bale"
  bundle="$found"
}

# offer_riders ROOT FOLDER WHERE PROJECT: the riders this start's pack
# carries (office riders --forecast over its forecast), carried into the
# folder before the pack so they ride in the request. On a terminal each
# is offered (default: carry); piped, none is carried and each that
# matched is named with its flag twin. --carry N carries rider N without
# asking, --carry none carries none. Reads cmd_start's writes, includes,
# read_only, bundle, carry and carry_none.
offer_riders() {
  local root="$1" folder="$2" where="$3" project="$4" out rows=() row n t r touched ans v
  local rargs=(--where "$where") take=() named=0
  [ "$where" != project ] || rargs+=(--project "$project")
  for v in "${writes[@]}"; do [ -n "$v" ] && rargs+=(--write "${v%/}"); done
  for v in "${includes[@]}"; do rargs+=(--include "${v%/}"); done
  [ "$read_only" = 0 ] || rargs+=(--read-only)
  [ -z "$bundle" ] || rargs+=(--bundle "$bundle")
  out="$(reader start-riders "$root" "$folder" "${rargs[@]}")" || out=""
  [ -n "$out" ] && mapfile -t rows <<< "$out"
  if [ "$carry_none" = 1 ]; then
    [ "${#rows[@]}" -eq 0 ] || log "${#rows[@]} rider(s) on the riders page ride this forecast; --carry none leaves them there"
    return 0
  fi
  [ "${#carry[@]}" -eq 0 ] || named=1
  for row in "${rows[@]}"; do
    IFS=$'\t' read -r n t r touched <<< "$row"
    [ -n "$n" ] || continue
    if [ "$named" = 1 ]; then
      printf '%s\n' "${carry[@]}" | grep -qxF -- "$n" \
        || log "rider $n ($t) rides this forecast too (rides $r); --carry $n would carry it"
    elif can_ask; then
      ask ans "Rider $n, $t (rides $r; the forecast's $touched): carry it into the folder, so it rides with this session (--carry $n, --carry none)" \
        "yes" 1 \
        "A rider is small work with a named carrier. Its path glob says the next session that touches it carries it, and this one does. yes moves it from the riders page into the folder's Riders section (office rider carry), which rides in the request; no leaves it on the page for a later session."
      case "$ans" in y|Y|yes|Yes|YES) take+=("$n") ;; esac
    else
      log "rider $n ($t) rides this forecast (rides $r); piped input carries none: --carry $n carries it"
    fi
  done
  take+=("${carry[@]}")
  for n in "${take[@]}"; do
    if ( OFFICE_ROOT="$root" cmd_rider_carry "$n" --folder "${folder#desk/}" ); then
      log "rider $n carried into $folder: it rides with this session in the folder's Riders section"
    elif [ "$named" = 1 ]; then
      die "--carry $n: the rider could not be carried (the lines above say why), so nothing was packed"
    else
      warn "rider $n was not carried (the lines above say why); it stays on the riders page, and office rider carry $n --folder ${folder#desk/} carries it later"
    fi
  done
}

# A word for a printed command line: bare when the shell reads it as it
# is, single-quoted otherwise.
qword() {
  if [[ "$1" =~ ^[A-Za-z0-9_./:@%+=,~-]+$ ]] && [[ "$1" != "~"* ]]; then printf '%s' "$1"; else shq "$1"; fi
}

# start_retry_hint RC: the EXIT trap of a start that opened its folder
# itself (new). When the start ends without its session out, its last
# lines name the folder it opened, which stays (a job was asked for), and
# the one line that retries it with the answers it was given. Reads
# cmd_start's own variables.
start_retry_hint() {
  local rc="$1" line number v
  [ "$rc" != 0 ] && [ -n "${START_OPENED:-}" ] || return 0
  line="office start $(qword "$START_OPENED")"
  if [ -n "${START_DROP_PAGE:-}" ]; then
    # A drop start (0.19.0): the folder holds the drop now and its lane
    # names the project, so the line names the page in its drops/ and the
    # brief is written again from it; the goal only when it was given.
    line+=" --drop $(qword "$(basename "$START_DROP_PAGE")")"
    [ -z "${goal:-}" ] || [ "$goal" = "$DROP_GOAL" ] || line+=" --goal $(shq "$goal")"
    [ "${slug_flag:-0}" = 0 ] || line+=" --slug $(qword "$slug")"
    if [ "${set_w:-0}" = 1 ] || [ "${START_ASKED_WRITES:-0}" = 1 ]; then
      for v in "${writes[@]}"; do [ -z "$v" ] || line+=" --write $(qword "$v")"; done
    fi
    for v in "${includes[@]}"; do line+=" --include $(qword "$v")"; done
  elif [ -n "${bundle_given:-}" ]; then
    case "${where:-}" in office) line+=" --in-office" ;; project) line+=" --on $(qword "$project")" ;; esac
    line+=" $(qword "$bundle_given")"
  else
    case "${where:-}" in office) line+=" --in-office" ;; project) line+=" --on $(qword "$project")" ;; esac
    [ -z "${goal:-}" ] || line+=" --goal $(shq "$goal")"
    [ "${slug_flag:-0}" = 0 ] || line+=" --slug $(qword "$slug")"
    if [ "${set_w:-0}" = 1 ] || [ "${START_ASKED_WRITES:-0}" = 1 ]; then
      for v in "${writes[@]}"; do [ -z "$v" ] || line+=" --write $(qword "$v")"; done
    fi
    for v in "${includes[@]}"; do line+=" --include $(qword "$v")"; done
    [ -z "${brief:-}" ] || line+=" --brief $(qword "$brief")"
    [ "${read_only:-0}" = 0 ] || line+=" --read-only"
  fi
  if [ "${no_rides:-0}" = 1 ]; then line+=" --no-rides"
  else for v in "${leave_out[@]}"; do line+=" --leave-out $(qword "$v")"; done; fi
  number="$(folder_fact "${root:-.}/desk/$START_OPENED/folder.md" number 2>/dev/null)"
  if [ "${START_TOOK:-0}" = 1 ]; then
    printf '[office] desk/%s%s, which this start took from the desk, stays there: its session did not go out.\n' \
      "$START_OPENED" "${number:+ (folder $number)}" >&2
  else
    printf '[office] desk/%s%s was opened by this start and stays on the desk: the job is asked for, but its session did not go out.\n' \
      "$START_OPENED" "${number:+ (folder $number)}" >&2
  fi
  printf '[office] once the cause above is fixed, this one line retries it with the answers already given:\n' >&2
  printf '%s\n' "$line" >&2
}

# The direct path (0.19.0): office start --drop PAGE sends a dropped
# message out as a project session in one command. The folder is minted
# through office open's own code (the one-writer rule: only the office
# command mints folders), the page moves into it as drops/NAME.md with a
# `dropped` History line, and the session goes out on the lane's project
# with the install's sort brief. Every refusal comes before anything is
# written. Given a folder too (the retry line), the page is already in
# that folder's drops/ and nothing is minted or moved. Reads and sets
# cmd_start's own variables: want, where, project, goal, brief, root and
# the START_ ones.
DROP_GOAL="Sort the dropped message and do what it asks"
START_DROP_PAGE=""

drop_fact() { printf '%s\n' "$1" | sed -n "s/^$2\t//p"; }

start_drop() {
  local names list facts rel page_name heading pproj resolved status via lane_proj fname md number ftitle tz day
  local tmp brief_file dest paths=() slug
  names="$(helper project-names "$root/$MANIFEST_REL" 2>/dev/null)"
  list="$(printf '%s' "$names" | paste -sd, - | sed 's/,/, /g')"
  [ -n "$names" ] || die "--drop sends the drop out as a project session, and this office scopes no project (office projects add adds one); nothing was written"
  if [ -n "$want" ]; then
    # The retry line: the page is in this folder's drops/ already.
    fname="$(find_folder "$root" desk "$want")" || exit 1
    md="$root/desk/$fname/folder.md"
    [ -f "$md" ] || die "desk/$fname has no folder.md"
    facts="$(dropx facts "$root" "$drop" --folder "desk/$fname" --projects "$names")" \
      || die "--drop $drop: not a drop's page in desk/$fname/drops/ (the line above says why); nothing was written"
    [ -z "$drop_title$drop_lane$drop_size" ] || die "desk/$fname is minted already, so --title, --lane and --size change nothing; office start $fname --drop $(basename "$(drop_fact "$facts" rel)") retries it"
    lane_proj="$(folder_fact "$md" lane)"; lane_proj="$(printf '%s' "${lane_proj%%:*}" | sed 's/^[[:space:]]*//; s/[[:space:]]*$//')"
    printf '%s\n' "$names" | grep -qxF -- "$lane_proj" \
      || die "desk/$fname's lane names no project this office scopes ($list), so its drop has nowhere to go; nothing was written"
    rel="$(drop_fact "$facts" rel)"
    log "desk/$fname holds the drop ${rel#desk/$fname/}: sending it out again, nothing minted or moved"
  else
    facts="$(dropx facts "$root" "$drop" --projects "$names")" \
      || die "--drop $drop: no drop to send out (the line above says why); nothing was written"
    rel="$(drop_fact "$facts" rel)"; page_name="$(basename "$rel")"
    heading="$(drop_fact "$facts" heading)"; pproj="$(drop_fact "$facts" project)"
    resolved="$(drop_fact "$facts" resolved)"; status="$(drop_fact "$facts" status)"; via="$(drop_fact "$facts" via)"
    [ "$status" = unsorted ] || die "$rel says status $status: only an unsorted drop is sent out; nothing was written"

    # The lane: the drop's project when it is one of the office's, else
    # asked as office open asks a lane (--lane the twin); piped, a drop
    # whose project does not resolve is refused by name.
    if [ -n "$drop_lane" ]; then
      check_field drop_lane lane --lane || true
    elif [ -n "$resolved" ]; then
      drop_lane="$resolved"
      log "the drop's project, $pproj, is $resolved: the folder's lane"
    fi
    while :; do
      if [ -n "$drop_lane" ]; then
        lane_proj="$(printf '%s' "${drop_lane%%:*}" | sed 's/^[[:space:]]*//; s/[[:space:]]*$//')"
        printf '%s\n' "$names" | grep -qxF -- "$lane_proj" && break
        can_ask || die "--lane $drop_lane names no project this office scopes ($list); the drop is sent out on one of them; nothing was written"
        printf '  %s is not one of this office'"'"'s projects: %s\n' "$lane_proj" "$list" >&2
        drop_lane=""
      fi
      can_ask || die "$rel's project ($([ -n "$pproj" ] && printf '%s' "$pproj" || printf 'none given')) names no project this office scopes ($list): give --lane PROJECT; nothing was written"
      ask_field drop_lane lane --lane "Lane: the project the drop is for ($list), or project: paths" "" 1
    done
    # The size: asked, small by default (--size); piped, small.
    if [ -n "$drop_size" ]; then check_field drop_size size --size || true; fi
    if [ -z "$drop_size" ]; then
      if can_ask; then ask_field drop_size size --size "Size: small, medium or high" "small" 1; else drop_size=small; fi
    fi
    [ -n "$drop_title" ] || drop_title="$heading"
    check_field drop_title title --title || { ask_field drop_title title --title "Title, in a few words" "" 1; }

    # The one-writer rule, before anything is written: the in-tray this
    # start takes the page from, and the desk it mints the folder on.
    one_writer "$root" "start --drop" in-tray desk
    start_check_place project "$lane_proj" "$names"

    # Minted through office open's own code; the slug from the drop's
    # page name, so the folder and the page are named alike.
    slug="${page_name%.md}"; slug="${slug#[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]-}"
    local open_args=(--title "$drop_title" --size "$drop_size" --lane "$drop_lane" --source drop)
    [ -n "$drop_title_given" ] || open_args=("$slug" "${open_args[@]}")
    local folder_rel
    folder_rel="$(cmd_open "${open_args[@]}")" || exit 1
    fname="${folder_rel#desk/}"
    md="$root/desk/$fname/folder.md"
    START_OPENED="$fname"; START_TOOK=0
    trap 'start_retry_hint $?; cleanup_tmp' EXIT

    # The page moves into the folder, its bytes as they are, and the
    # History says so before the `opened` line the start writes.
    dest="desk/$fname/drops/$page_name"
    mkdir -p "$root/desk/$fname/drops" || die "cannot create desk/$fname/drops"
    mv -- "$root/$rel" "$root/$dest" || die "could not move $rel into desk/$fname/drops/"
    tz="$(office_tz "$root")"; day="$(office_date "$tz")"
    folder_event "$md" "$day" dropped "drops/$page_name, via $via"
    paths=("desk/$fname")
    git -C "$root" ls-files --error-unmatch -- "$rel" >/dev/null 2>&1 && paths+=("$rel")
    commit_paths "$root" "office start --drop: $page_name into desk/$fname" "${paths[@]}" || true
    log "moved $rel into desk/$fname/drops/: the in-tray is one page lighter"
    rel="$dest"
  fi
  START_DROP_PAGE="${rel#desk/$fname/}"

  # The brief, from the install's template, and the goal.
  number="$(folder_fact "$md" number)"
  ftitle="$(head -n 1 "$md" | sed 's/^# //')"
  tmp="$(mktemp -d "${TMPDIR:-/tmp}/office-drop-brief.XXXXXXXX")" || die "no temporary directory for the brief"
  TMP_PATHS+=("$tmp")
  brief_file="$tmp/README.md"
  dropx brief "$root" "desk/$fname" "$rel" --number "${number:-?}" --title "$ftitle" --project "$lane_proj" > "$brief_file" \
    || die "the brief could not be written from the install's templates/drop-brief.md (the line above says why)"
  brief="$brief_file"
  [ -n "$goal" ] || goal="$DROP_GOAL"
  want="$fname"; where=project; project="$lane_proj"
}

# The standalone sort (0.20.0): office start --sort sends the drops
# nothing carried to a session of their own, an office session that
# belongs to no folder. Every refusal comes before anything is written.
# Reads and sets cmd_start's root.
SORT_GOAL="Sort the in-tray's drops"
SORT_SLUG="in-tray-sort"

start_sort() {
  local out sorts tmp desk_file brief_file tray_root sid tray opener d includes=() writes=() paths=() first
  out="$(dropx list "$root" --unsorted)" || die "the in-tray could not be read; nothing was written"
  [ -n "$out" ] || die "the in-tray holds no unsorted drop, so there is nothing to sort; nothing was written"
  if ! sorts="$(reader sort-out "$root")"; then
    die "bale's registry in this office could not be read, so whether a sort is out cannot be told (the line above says why); nothing was written"
  fi
  if [ -n "$sorts" ]; then
    first="$(printf '%s\n' "$sorts" | head -n 1)"
    die "a sort is out already: $first is open in this office; office land $first brings it back, and then office start --sort sends the next; nothing was written"
  fi
  one_writer "$root" "start --sort" in-tray
  # Where the office has a drafting table, the moves page is the sort's
  # to write, as a sitting writes it: it arrives first when it must.
  if [ -d "$root/drafting-table" ]; then
    if [ ! -f "$root/drafting-table/moves.md" ]; then
      one_writer "$root" "start --sort" "drafting-table/moves.md"
      out="$(drafting arrive "$root" --page moves.md)" || die "the drafting table's moves page could not arrive; nothing was sent out"
      mapfile -t paths < <(printf '%s\n' "$out" | grep -v '^$')
      [ "${#paths[@]}" -eq 0 ] || commit_paths "$root" "office start --sort: the drafting table's moves page arrives" "${paths[@]}" || true
    fi
    writes+=(--write drafting-table/moves.md)
  fi
  # What ships: every folder's folder.md (not the folders whole) and every
  # handbook chapter; the hung items ride through bale.toml's group, and
  # the unsorted drops and the doctrine as for every office session.
  for d in "$root"/desk/*/folder.md "$root"/filing-cabinet/*/folder.md; do
    [ -f "$d" ] && includes+=(--include "${d#"$root"/}")
  done
  [ ! -d "$root/handbook" ] || includes+=(--include handbook)
  tmp="$(mktemp -d "${TMPDIR:-/tmp}/office-sort-brief.XXXXXXXX")" || die "no temporary directory for the brief"
  TMP_PATHS+=("$tmp")
  desk_file="$tmp/desk.txt"; brief_file="$tmp/README.md"
  ( OFFICE_ROOT="$root" cmd_desk ) > "$desk_file" 2>/dev/null \
    || printf '(the desk could not be rendered here; office desk says why)\n' > "$desk_file"
  sortx brief "$root" --desk-file "$desk_file" > "$brief_file" \
    || die "the brief could not be written from the install's templates/sort-brief.md (the line above says why); nothing was sent out"
  tray_root="$(machine_setting out_tray "$HOME/out-tray")"
  case "$tray_root" in "~"|"~/"*) tray_root="$HOME${tray_root#\~}" ;; esac
  log "packing the standalone sort in the office: $(printf '%s\n' "$out" | grep -c .) unsorted drop(s), no folder"
  out="$(reader start "$root" - --where office --goal "$SORT_GOAL" --slug "$SORT_SLUG" "${includes[@]}" "${writes[@]}" \
           --brief "$brief_file" --work-class meta --tray-root "$tray_root")" || exit 1
  sid="$(printf '%s' "$out" | python3 -c 'import json,sys; print(json.load(sys.stdin)["sid"])')" || die "could not read what office start packed"
  tray="$(printf '%s' "$out" | python3 -c 'import json,sys; print(json.load(sys.stdin)["tray"])')"
  printf '%s' "$out" | python3 -c 'import json,sys
for w in json.load(sys.stdin)["warnings"]:
    print(w)' | while IFS= read -r d; do warn "$d"; done
  printf 'Packed %s for the in-tray (the standalone sort; no folder records it).\n\n' "$sid"
  printf 'Out tray: %s\n' "$tray"
  printf '%s' "$out" | python3 -c 'import json,sys
r = json.load(sys.stdin)
for line in r["carried"]:
    print("  " + line)'
  printf '\nAttach every file in the out tray to a fresh chat, then paste the opener:\n\n'
  opener="$(printf '%s' "$out" | python3 -c 'import json,sys
r = json.load(sys.stdin)
if r["opener"] is not None:
    print("\n".join(r["opener"]))')"
  if [ -z "$opener" ]; then
    warn "bale printed no opener between its scissor lines; the session is open, and bale status shows it"
    return 0
  fi
  printf -- '--8<-- session opener --8<--\n%s\n--8<-- end session opener --8<--\n' "$opener"
  printf '\nWhen the response comes back: office land %s\n' "$sid"
  start_desktop "$tray" "$opener"
  return 0
}

cmd_start() {
  local want="" where="" project="" goal="" slug="" brief="" read_only=0 includes=() writes=() set_w=0 bundle=""
  local leave_out=() no_rides=0 carry=() carry_none=0 bundle_given="" slug_flag=0
  local root name md status lane lane_project lane_paths names cls ans tz day out sid tray tray_root rel about="" args=() v
  local packed_flags=() drop="" drop_title="" drop_lane="" drop_size="" drop_title_given="" sort=0 others=()
  START_OPENED=""; START_TOOK=0; START_ASKED_WRITES=0; START_CHECKED_HOST=""; START_BALE_REHEARSED=0; START_DROP_PAGE=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --in-office) [ -z "$where" ] || [ "$where" = office ] || die "--in-office and --on are two places; give one"; where=office; shift ;;
      --on) [ $# -ge 2 ] || die "--on needs the project's name"; [ "$where" != office ] || die "--in-office and --on are two places; give one"
            where=project; project="$2"; shift 2 ;;
      --goal|--slug|--brief|--write|--include)
        [ $# -ge 2 ] || die "$1 needs a value (office start --help explains it)"
        case "$1" in --goal) goal="$2" ;; --slug) slug="$2"; slug_flag=1 ;; --brief) brief="$2" ;;
                     --write) writes+=("$2"); set_w=1 ;; --include) includes+=("$2") ;; esac
        packed_flags+=("$1"); shift 2 ;;
      --sort) sort=1; shift ;;
      --drop) [ $# -ge 2 ] || die "--drop needs the drop's page: in-tray/NAME.md, or its name (office desk lists them)"
              [ -z "$drop" ] || die "office start takes one drop"; drop="$2"; shift 2 ;;
      --title|--lane|--size)
        [ $# -ge 2 ] || die "$1 needs a value (office start --help explains it)"
        case "$1" in --title) drop_title="$2"; drop_title_given=1 ;; --lane) drop_lane="$2" ;; --size) drop_size="$2" ;; esac
        shift 2 ;;
      --bundle) [ $# -ge 2 ] || die "--bundle needs the bundle: a path, or the name bale's search finds"
                [ -z "$bundle" ] || die "office start takes one bundle"; bundle="$2"; shift 2 ;;
      --read-only) read_only=1; packed_flags+=("$1"); shift ;;
      --leave-out) [ $# -ge 2 ] || die "--leave-out needs a path that rides with the project (office projects lists them)"
                   leave_out+=("$2"); shift 2 ;;
      --no-rides) no_rides=1; shift ;;
      --carry) [ $# -ge 2 ] || die "--carry needs a rider's number (office riders lists them), or none"
               if [ "$2" = none ]; then carry_none=1; else v="$(bare_number rider "$2")" || exit 1; carry+=("$v"); fi; shift 2 ;;
      -h|--help) usage_start; return 0 ;;
      -*) usage_start >&2; die "office start does not know $1; the flags above are what it takes" ;;
      *.bale-bundle) [ -z "$bundle" ] || die "office start takes one bundle"; bundle="$1"; shift ;;
      *) [ -z "$want" ] || die "office start takes one folder"; want="$1"; shift ;;
    esac
  done
  if [ "$sort" = 1 ]; then
    # The standalone sort takes nothing else: its goal, forecast and brief
    # are the office's own (0.20.0).
    [ -z "$want$where$drop$bundle$drop_title$drop_lane$drop_size" ] && [ "${#packed_flags[@]}" -eq 0 ] \
      && [ "$no_rides" = 0 ] && [ "${#leave_out[@]}" -eq 0 ] && [ "${#carry[@]}" -eq 0 ] && [ "$carry_none" = 0 ] \
      || die "--sort sends the in-tray's own session, with the office's goal, forecast and brief, so it takes nothing else: office start --sort"
    root="$(resolve_office)" || exit 1
    require_current "$root"
    warn_if_unfounded "$root"
    command -v bale >/dev/null 2>&1 || die "bale is not on PATH; office start runs bale pack"
    start_sort
    return $?
  fi
  [ "$read_only" = 0 ] || [ "$set_w" = 0 ] || die "--read-only forecasts nothing, so it takes no --write"
  [ "$no_rides" = 0 ] || [ "${#leave_out[@]}" -eq 0 ] || die "--no-rides leaves every ride-along out, so it takes no --leave-out"
  [ "$carry_none" = 0 ] || [ "${#carry[@]}" -eq 0 ] || die "--carry none carries no rider, so it takes no --carry N"
  if [ -n "$drop" ]; then
    [ -z "$bundle" ] || die "--drop sends the drop out with the office's own brief, so it takes no bundle"
    [ "$where" != office ] || die "--drop sends a project session, so it takes no --in-office"
    [ "$where" != project ] || die "with --drop the project is the drop's own, or --lane PROJECT's, so it takes no --on"
    [ "$read_only" = 0 ] || die "--drop sends a session that lands, so it takes no --read-only"
    [ -z "$brief" ] || die "--drop writes the session's brief from the install's template, so it takes no --brief"
  else
    [ -z "$drop_title$drop_lane$drop_size" ] || die "--title, --lane and --size go with --drop (office open takes them for a folder of its own)"
  fi
  bundle_given="$bundle"
  if [ -n "$bundle" ]; then
    [ "${#packed_flags[@]}" -eq 0 ] || die "a bundle carries its own pack line (goal, forecast, brief), so it takes no ${packed_flags[*]}; give the folder and where the work lands, nothing else"
    # A file here is handed to bale by its full path; a bare name is
    # bale's to find, cwd first, then its search directories.
    if [ -f "$bundle" ]; then bundle="$(readlink -f "$bundle")"
    elif [[ "$bundle" == */* ]]; then die "--bundle $bundle: no such file"
    fi
  fi
  root="$(resolve_office)" || exit 1
  require_current "$root"
  warn_if_unfounded "$root"
  command -v bale >/dev/null 2>&1 || die "bale is not on PATH; office start runs bale pack"

  # A dropped message, sent straight out: the folder minted and the page
  # moved into it, and where, the goal and the brief set (start_drop).
  [ -z "$drop" ] || start_drop

  # Which job.
  if [ -z "$want" ]; then
    can_ask || { usage_start >&2; die "name the folder: office start FOLDER (office open makes one first); piped input is never asked"; }
    ask_start_folder want "$root"
  fi
  names="$(helper project-names "$root/$MANIFEST_REL" 2>/dev/null)"
  # --on PROJECT given: a project on a host refuses here, before a folder
  # for new, the survey, the tray or the session is written.
  [ "$where" != project ] || start_check_place "$where" "$project" "$names"
  local where_default="office" where_why="" found checked=0
  if [ "$want" = new ]; then
    can_ask || die "new opens a folder through office open's questions, which need a terminal; run office open first"
    # A bundle is asked about before the folder is opened: where it lands,
    # then bale open --check there, so a bundle bale cannot find or would
    # refuse stops the start before anything is written. (A bundle that
    # lands in the office is checked once the folder exists, since its
    # forecast may name the folder.)
    if [ -n "$bundle" ]; then
      if [ -z "$where" ]; then
        if [ -f "$bundle" ]; then
          found="$(reader bundle-where "$root" --bundle "$bundle")" || exit 1
          if [ -n "$found" ]; then where_default="${found%%$'\t'*}"; where_why="${found#*$'\t'}"; fi
        fi
        ask_where where project "$where_default" "$where_why" "$names"
      fi
      start_check_place "$where" "$project" "$names"
      resolve_hosted_bundle "$root" "$where" "$project"
      if [ "$where" = project ]; then check_start_bundle "$root" "$where" "$project" "$bundle"; checked=1; fi
    fi
    local desk_before
    desk_before="$(ls -1 "$root/desk" 2>/dev/null)"
    rel="$(OPEN_FOR_START=1 cmd_open)" || exit 1
    want="${rel#desk/}"
    START_OPENED="$want"
    START_TOOK=0
    printf '%s\n' "$desk_before" | grep -qxF -- "$want" && START_TOOK=1
    # From here a start that cannot send its session out ends by naming the
    # folder it opened and the one line that retries it.
    trap 'start_retry_hint $?; cleanup_tmp' EXIT
  fi
  name="$(find_folder "$root" desk "$want")" || exit 1
  md="$root/desk/$name/folder.md"
  [ -f "$md" ] || die "desk/$name has no folder.md"
  status="$(folder_fact "$md" status)"
  case "$status" in done|absorbed|split|retired) die "desk/$name says status $status, which belongs in the filing cabinet; office status names what disagrees" ;; esac

  # The founding folder of an unfounded office goes out through the
  # founding door (office found's own code): the answers its folder keeps
  # ride in the brief, and only what was skipped is asked.
  if [ -z "$brief" ] && [ -z "$bundle" ] && [ "${FOUNDING_DOOR:-0}" != 1 ] \
      && [ "$(door door-folder "$root" founding 2>/dev/null)" = "desk/$name" ] \
      && ! helper profile-check "$root/$PROFILE_REL" "$SHAPE" >/dev/null 2>&1; then
    [ "$where" != project ] && [ "$read_only" = 0 ] && [ "$set_w" = 0 ] && [ "${#includes[@]}" -eq 0 ] && [ -z "$slug" ] \
      || die "desk/$name is this office's founding folder, which goes out through the founding door in the office: office start $name (or office found), with none of --on, --read-only, --write, --include or --slug"
    log "desk/$name is this office's founding folder and the profile is incomplete, so it goes out through the founding door (office found)"
    OFFICE_ROOT="$root" cmd_found ${goal:+--goal "$goal"}
    return $?
  fi

  # A folder that knows its goal and its brief goes out with them (0.20.0:
  # office open --goal, or a drop office moves filed in it): the goal is
  # offered below, and brief.md is the session's brief unless --brief
  # names another; a bundle keeps its own, and that is said.
  local folder_goal
  folder_goal="$(folder_fact "$md" goal)"
  if [ -f "$root/desk/$name/brief.md" ]; then
    if [ -n "$bundle" ]; then
      log "desk/$name/brief.md rides in the folder, not as the brief: a bundle carries its own brief, and the office adds nothing to it"
    elif [ -z "$brief" ]; then
      brief="$root/desk/$name/brief.md"
      log "the session's brief is desk/$name/brief.md, the folder's own (--brief FILE sends another)"
    elif [ "$(readlink -f "$brief")" != "$(readlink -f "$root/desk/$name/brief.md")" ]; then
      log "the session's brief is $brief, as given; desk/$name/brief.md rides in the folder"
    fi
  fi

  # What the folder already says: its lane (project: paths) and class.
  lane="$(folder_fact "$md" lane)"; cls="$(folder_fact "$md" class)"
  lane_project=""; lane_paths=""
  # A lane is `project: paths`, or the project alone (as office start
  # --drop writes it): a bare word that names one of the office's
  # projects is that project with no paths.
  case "$lane" in
    *:*) lane_project="$(printf '%s' "${lane%%:*}" | sed 's/^[[:space:]]*//; s/[[:space:]]*$//')"; lane_paths="${lane#*:}" ;;
    *) lane_project="$(printf '%s' "$lane" | sed 's/^[[:space:]]*//; s/[[:space:]]*$//')" ;;
  esac
  printf '%s\n' "$names" | grep -qxF -- "$lane_project" || lane_project=""

  # Where the work lands: two choices, the kind names behind the curtain.
  # For a bundle the office can read, the default is the one place whose
  # tree holds every path the bundle names, and a bundle whose paths no
  # one place holds is refused here, before bale runs.
  if [ -z "$where" ]; then
    where_default="${lane_project:-office}"; where_why=""
    if [ -n "$bundle" ] && [ -f "$bundle" ]; then
      found="$(reader bundle-where "$root" --bundle "$bundle" ${lane_project:+--lane "$lane_project"})" || exit 1
      if [ -n "$found" ]; then
        where_default="${found%%$'\t'*}"; where_why="${found#*$'\t'}"
        debug "where defaults to $where_default for this bundle: $where_why"
      fi
    fi
    can_ask || die "say where the work lands: --in-office, or --on PROJECT ($(printf '%s' "$names" | paste -sd, - | sed 's/,/, /g')); piped input is never asked"
    ask_where where project "$where_default" "$where_why" "$names"
  fi
  start_check_place "$where" "$project" "$names"
  [ "$where" = project ] || about="$lane_project"
  # A build session writes the folder's two pages from the install's
  # templates, which ride beside the request (share/verbs.toml, build).
  [ "$where" != project ] || START_INSTALL_FILES+=("templates/walkthrough.md" "templates/delivery.md")
  # bale open --check where the bundle opens, before the survey, the tray
  # and the session: a name bale's search cannot find, a forecast path
  # that is not there or a forecast another open session holds refuses
  # here, in bale's words, with nothing written.
  if [ -n "$bundle" ] && [ "$checked" = 0 ]; then
    resolve_hosted_bundle "$root" "$where" "$project"
    check_start_bundle "$root" "$where" "$project" "$bundle"; checked=1
  fi

  # The goal: the one thing the pack cannot derive (a bundle carries its own).
  if [ -n "$bundle" ]; then
    goal="(the bundle's)"
  elif [ -z "$goal" ] && [ -n "$folder_goal" ] && ! can_ask; then
    goal="$folder_goal"
    log "the goal is the folder's own: $folder_goal (--goal TEXT overrides it)"
  elif [ -z "$goal" ]; then
    can_ask || die "give the session's goal: --goal TEXT, one sentence; piped input is never asked"
    ask goal "The session's goal, in one sentence (--goal)" "$folder_goal" 1 \
      "What the session is for, in one sentence: it becomes the request's goal and the opener's first line. The folder, its lane and the project's ride-alongs go with it on their own.${folder_goal:+ The default is the goal field of the folder; a plain return takes it.}"
  fi
  goal="$(printf '%s' "$goal" | tr '\n' ' ' | sed 's/^[[:space:]]*//; s/[[:space:]]*$//')"
  [ -n "$goal" ] || die "the goal is empty"
  case "$goal" in -*) die "a goal may not start with a dash (bale would read it as a flag)" ;; esac
  # bale numbers sessions per repo, so the same slug packed in the office
  # and in a project the same day would mint one id twice; an office
  # session's default slug says office.
  if [ -z "$slug" ]; then
    slug="$(short_slug "${name#[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]-}")"
    [ "$where" = project ] || slug="$slug-office"
  fi
  slug="$(slugify "$slug")"; [ -n "$slug" ] || die "the slug has no letters or digits (give one: --slug SLUG)"

  # A project session's forecast: the lane's paths when the lane names
  # this project, else asked, else the whole repo.
  if [ "$where" = project ] && [ "$set_w" = 0 ] && [ "$read_only" = 0 ] && [ -z "$bundle" ]; then
    if [ "$lane_project" = "$project" ] && [ -n "${lane_paths//[[:space:],]/}" ]; then
      IFS=',' read -r -a writes <<< "$lane_paths"
      for v in "${!writes[@]}"; do writes[$v]="$(printf '%s' "${writes[$v]}" | sed 's/^[[:space:]]*//; s/[[:space:]]*$//')"; done
      log "forecast from the folder's lane: ${writes[*]}"
    elif can_ask; then
      ask ans "Paths in $project the session will change, comma-separated (--write) [return: the whole repo]" "" 0 \
        "Its write forecast, relative to $project's top: what bale keeps other sessions off while this one is open. A directory covers what lands under it. The whole repo keeps every other $project session waiting."
      [ -z "$ans" ] || IFS=',' read -r -a writes <<< "$ans"
      for v in "${!writes[@]}"; do writes[$v]="$(printf '%s' "${writes[$v]}" | sed 's/^[[:space:]]*//; s/[[:space:]]*$//')"; done
      [ "${#writes[@]}" -eq 0 ] || START_ASKED_WRITES=1
    fi
    [ "${#writes[@]}" -gt 0 ] || log "no forecast given: bale forecasts the whole of $project, so no other session there runs beside this one"
  fi
  # What rides with the project: shown on a terminal, where a declared
  # ride-along can stay home for this session; piped, everything rides
  # as declared unless --leave-out or --no-rides says otherwise.
  local ride_project="" rides=() r
  if [ "$where" = project ]; then ride_project="$project"; else ride_project="$about"; fi
  if [ -n "$ride_project" ]; then
    mapfile -t rides < <(helper project-facts "$root/$MANIFEST_REL" "$ride_project" 2>/dev/null | awk -F'\t' '$1 == "rides" {print $2}')
  fi
  if [ "$no_rides" = 1 ]; then
    [ "${#rides[@]}" -gt 0 ] || log "nothing rides with ${ride_project:-this session}, so --no-rides changes nothing"
    leave_out=("${rides[@]}")
  elif [ "${#rides[@]}" -gt 0 ] && [ "${#leave_out[@]}" -eq 0 ] && can_ask; then
    ask_rides leave_out "$ride_project" "${rides[@]}"
    [ "${#leave_out[@]}" -eq 0 ] || START_ASKED_LEAVE=1
  fi

  # The riders this pack carries: the queued riders on the drafting
  # table's riders page whose path glob its forecast touches (office
  # riders --forecast), carried into the folder before the pack, so each
  # rides in the request inside the folder's Riders section.
  offer_riders "$root" "desk/$name" "$where" "$project"

  args=(--where "$where" --goal "$goal" --slug "$slug")
  [ "$where" = project ] && args+=(--project "$project")
  [ -z "$about" ] || args+=(--project "$about")
  for v in "${writes[@]}"; do [ -n "$v" ] && args+=(--write "${v%/}"); done
  for v in "${includes[@]}"; do args+=(--include "${v%/}"); done
  [ "$read_only" = 0 ] || args+=(--read-only)
  if [ -n "$brief" ]; then [ -f "$brief" ] || die "--brief $brief: no such file"; args+=(--brief "$brief"); fi
  [ -z "$cls" ] || [ -n "$bundle" ] || args+=(--work-class "$cls")
  [ -z "$bundle" ] || args+=(--bundle "$bundle")
  for v in "${START_INSTALL_FILES[@]}"; do args+=(--install-file "$v"); done
  for r in "${leave_out[@]}"; do args+=(--leave-out "$r"); done
  [ "$where" != project ] || [ "$START_CHECKED_HOST" != "$project" ] || args+=(--checked)
  [ "$START_BALE_REHEARSED" = 0 ] || args+=(--bale-rehearsed)
  tray_root="$(machine_setting out_tray "$HOME/out-tray")"
  case "$tray_root" in "~"|"~/"*) tray_root="$HOME${tray_root#\~}" ;; esac

  log "$([ -n "$bundle" ] && printf 'opening the bundle %s' "$bundle" || printf 'packing') for desk/$name ($([ "$where" = office ] && printf 'in the office' || printf 'on %s' "$project"))"
  out="$(reader start "$root" "desk/$name" "${args[@]}" --tray-root "$tray_root")" || exit 1
  # The session is out: a failure after this is not a start to retry.
  trap cleanup_tmp EXIT; START_OPENED=""
  sid="$(printf '%s' "$out" | python3 -c 'import json,sys; print(json.load(sys.stdin)["sid"])')" || die "could not read what office start packed"
  tray="$(printf '%s' "$out" | python3 -c 'import json,sys; print(json.load(sys.stdin)["tray"])')"
  printf '%s' "$out" | python3 -c 'import json,sys
for w in json.load(sys.stdin)["warnings"]:
    print(w)' | while IFS= read -r v; do warn "$v"; done
  tz="$(office_tz "$root")"; day="$(office_date "$tz")"
  # A bundle whose session was still open joins it as a second desk
  # (bale 0.4.44 on): no new session, so the folder records the one the
  # bundle joined, saying so, and the first line says it was joined.
  local second_desk
  second_desk="$(printf '%s' "$out" | python3 -c 'import json,sys; print("yes" if json.load(sys.stdin).get("second_desk") else "")')"
  record_session "$root" "desk/$name" "$sid" "${second_desk:+a second desk on a session already open}" "$day"
  local filed_rc=0 request
  request="$(printf '%s' "$out" | python3 -c 'import json,sys; print(json.load(sys.stdin)["request"])')"
  file_sitting_pages "$root" "$request" "$sid" || filed_rc=1

  if [ -n "$second_desk" ]; then
    printf 'Joined %s, already open, as a second desk for desk/%s.\n\n' "$sid" "$name"
  else
    printf 'Packed %s for desk/%s.\n\n' "$sid" "$name"
  fi
  printf 'Out tray: %s\n' "$tray"
  printf '%s' "$out" | python3 -c 'import json,sys
r = json.load(sys.stdin)
for line in r["carried"]:
    print("  " + line)'
  printf '\nAttach every file in the out tray to a fresh chat, then paste the opener:\n\n'
  local opener
  opener="$(printf '%s' "$out" | python3 -c 'import json,sys
r = json.load(sys.stdin)
if r["opener"] is not None:
    print("\n".join(r["opener"]))')"
  if [ -z "$opener" ]; then
    warn "bale printed no opener between its scissor lines; the session is open, and bale pack's own report (run it by hand) or bale status shows it"
    return "$filed_rc"
  fi
  printf -- '--8<-- session opener --8<--\n%s\n--8<-- end session opener --8<--\n' "$opener"
  if [ -n "$(printf '%s' "$out" | python3 -c 'import json,sys; print("yes" if json.load(sys.stdin).get("sitting") else "")')" ]; then
    printf '\nA read-only sitting lands nothing; when it is over: office land %s ends it\n' "$sid"
  else
    printf '\nWhen the response comes back: office land %s\n' "$sid"
  fi
  start_desktop "$tray" "$opener"
  [ "$filed_rc" = 0 ] || warn "the session is open and its tray is ready, but a page of the sitting's words was not filed (the lines above say why)"
  return "$filed_rc"
}

# The pages of a sitting's words the request's brief carries, filed in
# the office's notepad and committed alone (doctrine section 5). A page
# already filed with the same bytes is left as it is; a different page
# at its path is refused loudly and never overwritten.
file_sitting_pages() {
  local root="$1" request="$2" sid="$3" out rc state path why paths=()
  out="$(helper file-sitting-pages "$root" --request "$request")"; rc=$?
  [ "$rc" = 0 ] || [ "$rc" = 3 ] || { warn "could not read the brief in $request for a sitting's pages"; return 1; }
  while IFS=$'\t' read -r state path why; do
    [ -n "$state" ] || continue
    case "$state" in
      filed) log "filed $path, a page of the sitting's words from $sid's brief"; paths+=("$path") ;;
      same) log "$path is already filed with these words; left as it is" ;;
      refused) warn "NOT FILED: $path: $why" ;;
      malformed) warn "NOT FILED: the brief's notepad page markers: $why" ;;
    esac
  done <<< "$out"
  if [ "${#paths[@]}" -gt 0 ]; then
    commit_paths "$root" "office start: the sitting's words from $sid's brief" "${paths[@]}" || true
  fi
  return $([ "$rc" = 0 ] && echo 0 || echo 1)
}

# The two desktop steps, on a terminal only: copy the opener to the
# clipboard and open the out tray in the file manager. On WSL they
# default to clip.exe and explorer.exe, as desktop_tool finds them;
# elsewhere they are off until machine.toml names a command.
start_desktop() {
  local tray="$1" opener="$2" open
  [ -t 1 ] || return 0
  if on_wsl; then
    open="$(machine_setting open_command "$(desktop_tool explorer.exe)")"
  else
    open="$(machine_setting open_command "")"
  fi
  to_clipboard "$opener" "the opener"
  if [ -n "$open" ]; then
    (cd "$tray" && $open . >/dev/null 2>&1 &)
    log "opened the out tray with $open"
  fi
}

# to_clipboard TEXT WHAT: on a terminal, put TEXT on the clipboard and
# say so. On WSL the default is clip.exe as desktop_tool finds it (fed
# UTF-16, which is what it reads); elsewhere it is off until machine.toml
# names clipboard_command, and "" there turns it off. Returns 1 when
# nothing was copied.
to_clipboard() {
  local text="$1" what="$2" clip
  [ -t 1 ] || return 1
  if on_wsl; then
    clip="$(machine_setting clipboard_command "$(desktop_tool clip.exe)")"
  else
    clip="$(machine_setting clipboard_command "")"
  fi
  [ -n "$clip" ] || return 1
  if [ "$(basename "${clip%% *}")" = clip.exe ] && command -v iconv >/dev/null 2>&1; then
    printf '%s\n' "$text" | iconv -f UTF-8 -t UTF-16LE | $clip 2>/dev/null
  else
    printf '%s\n' "$text" | $clip 2>/dev/null
  fi
  if [ $? -eq 0 ]; then log "$what is on the clipboard ($clip)"; return 0; fi
  warn "$clip could not take $what; copy it from above"
  return 1
}

# --- bringing a session back ---------------------------------------------------
#
# office land: one command from a response to a landed session. It finds
# the session the response answers, runs bale apply in the repo the
# session belongs to (bale retry for a held one) with this terminal as
# bale's stdin, so bale's own questions reach the occupant and the office
# answers none, and says how it ended, from bale's records. Then, after
# an applied landing, the project's after-land actions and the planner's
# ratification.

usage_land() {
  cat <<'USAGE'
usage: office land [SID | FOLDER | RESPONSE] [--sid SID] [--folder FOLDER] [--response FILE]
                   [--ratified [--except TEXT] | --not-now] [--close | --leave-open]
Brings a session back. It finds the response for a session the office has
out, runs bale apply in the repo the session belongs to (a project, or the
office itself; bale retry when bale held the session), and says how it
ended. bale asks its own questions (an admission, the merge, a hook) and
only you answer them. After an applied landing it runs the project's
after-land actions in order, then asks whether the planner ratified the
session's judgment calls, and ends by saying what became of each action
(ran, failed, not run). After an applied landing it also runs office
watches check (it records nothing) and prints the watches that fired, and
when the founding session lands with the profile complete it closes the
founding folder, done. Anything bale prints for you to carry is printed
whole and, on WSL, put on the clipboard. Given a read-only sitting the
office sent out (by its id or its folder), land ends it instead: bale
unlock in its repo and an `ended` line in the folder's History; the
folder stays as it is. An after-land action runs only through office
land: a session applied by hand with bale apply runs none.
After an applied landing, when the folder records that session alone and
the planner ratified it with no exception, land offers to close the
folder, done, in the same breath (default: close); piped, it leaves the
folder open and says so.
After an applied landing, before the after-land actions, it files what
the response's notes.md says, when the office found the response on this
machine (a path, or by name in the downloads): for a project session the
folder's two pages, its Walkthrough section as walkthrough.md and its
Delivery section as delivery.md (the words office deliver carries to the
audience); then, for any session, its Sort on each drop's page (the page's
status becomes sorted), its Questions and answers in the folder, and its
Handbook's facts and front sheets in the project's chapter (the handbook
arrives with the first fact). Then, when a sorted drop waits in the
in-tray (or the session was the standalone sort and its moves page holds
pending lines), it runs office moves and names each folder it minted.
When only bale's own search knew where the response was, land names the
line that files it all (office sessions FOLDER SID --pages RESPONSE, or
office sessions --in-tray SID --pages RESPONSE for the standalone sort,
which no folder records).
A session on a project on a host (office projects add --host) lands
there. land first checks that the host answers (one that does not stops
land before anything is carried, with your connect line and the line
that reruns it). The response is found on this machine: the path you
give, or response-SID.tar.gz in this machine's downloads (machine.toml's
downloads, asked once on a terminal; of several browser copies, such as
'response-SID (1).tar.gz', the newest is taken and named). It is carried
to the host, checked by sha256, and bale apply (or retry) runs in the
project's repo there with your terminal, so bale's questions reach you.
The relay comes back to this screen and, on WSL, the clipboard here; the
after-land actions run in the repo there; a sitting ends with bale unlock
there. Nothing land makes on the host outside the repo is left behind.
For a project on this machine bale's own search finds the response, as
before, unless the downloads hold several copies of its name: then the
newest is passed to bale by its path, and land says so.
  (nothing)        the session the office has out; asked when there are several
  SID, --sid       a session by its id
  FOLDER, --folder the session out for a folder: its name, part of it, or folder N
  RESPONSE, --response FILE
                   the response tarball: a path, or a name (bale's search finds
                   it for a project here; for a project on a host, the current
                   directory and then the downloads)
                   (default: response-SID.tar.gz, found by bale, or the newest
                   copy in the downloads)
  --ratified       the planner ratified the session's judgment calls
  --except TEXT    ...except TEXT: what was corrected, and where it went
  --not-now        do not ask about ratification; office sessions FOLDER SID
                   --ratified records it later
  --close          close a finished folder with the landing, without asking
  --leave-open     leave it open, without asking (office close closes it later)
Under the hood: bale apply TARBALL (bale retry for a held session) in the
session's repo, then bale stats --sid SID --json for how it ended, and
after an applied landing office watches check; for a sitting, bale unlock
SID --json in its repo. On a host each runs through the project's shell
(ssh -tt and a container's -it for the step you answer), and one land
reaches the host once.
Examples:
  office land                                  (the session out; asked when there are several)
  office land 2026-10-05-fix-login-001
  office land fix-login --ratified
  office land 2026-10-05-plan-wave-office-001  (a read-only sitting: ends it)
  office land 2026-10-05-fix-login-001 --response "$HOME/Downloads/response-2026-10-05-fix-login-001 (1).tar.gz"
  office land fix-login --ratified --close
USAGE
}

# What became of each after-land action, for land's last lines.
AFTER_LAND_REPORT=()

# run_after_land REPO CMD...: the project's after-land actions, in order,
# in its repo. The first that fails stops the rest, loudly, with the one
# line that reruns it and each one after it.
run_after_land() {
  local repo="$1" n=0 total rc c i; shift
  total=$#
  for c in "$@"; do
    n=$((n + 1))
    log "after land ($n of $total), in $repo: $c"
    (cd "$repo" && bash -c "$c"); rc=$?
    if [ "$rc" -ne 0 ]; then
      warn "AFTER-LAND ACTION FAILED (exit $rc): $c"
      warn "nothing after it ran; rerun from there with:"
      AFTER_LAND_REPORT+=("FAILED (exit $rc): $c")
      i=0
      for c in "$@"; do
        i=$((i + 1))
        [ "$i" -ge "$n" ] && printf '[office]   (cd %s && %s)\n' "$(shq "$repo")" "$c" >&2
        [ "$i" -gt "$n" ] && AFTER_LAND_REPORT+=("not run: $c")
      done
      local rerun="" r
      for r in "${@:$n}"; do rerun="${rerun:+$rerun && }$r"; done
      AFTER_LAND_REPORT+=("rerun from the failed one: (cd $(shq "$repo") && $rerun)")
      return 1
    fi
    AFTER_LAND_REPORT+=("ran (exit 0): $c")
  done
  [ "$total" -eq 0 ] || log "after land: $total action(s) ran"
  return 0
}

# run_after_land_hosted ROOT PLAN WHERE N: a hosted project's N after-land
# actions, in order, each run in its repo on its host through the
# project's shell (attended on a terminal), its output on this screen.
# The first that fails stops the rest, loudly, with the one line that
# reruns it and each after it from this machine.
run_after_land_hosted() {
  local root="$1" plan="$2" where="$3" total="$4" n rc c line i
  for ((n = 1; n <= total; n++)); do
    c="$(plan_field "$plan" after_land | sed -n "${n}p")"
    log "after land ($n of $total), in $where: $c"
    reader land-after "$root" --plan "$plan" --index "$n"; rc=$?
    if [ "$rc" -ne 0 ]; then
      warn "AFTER-LAND ACTION FAILED (exit $rc): $c"
      warn "nothing after it ran; rerun from there, on this machine, with:"
      AFTER_LAND_REPORT+=("FAILED (exit $rc): $c")
      for ((i = n + 1; i <= total; i++)); do
        AFTER_LAND_REPORT+=("not run: $(plan_field "$plan" after_land | sed -n "${i}p")")
      done
      line="$(reader land-after-line "$root" --plan "$plan" --index "$n")"
      printf '[office]   %s\n' "$line" >&2
      AFTER_LAND_REPORT+=("rerun from the failed one: $line")
      return 1
    fi
    AFTER_LAND_REPORT+=("ran (exit 0): $c")
  done
  [ "$total" -eq 0 ] || log "after land: $total action(s) ran, in $where"
  return 0
}

# offer_close ROOT FOLDER SID: after an applied landing, a folder whose
# only recorded session is the one that landed, ratified by the planner
# with no exception, is finished: land offers to close it, done (office
# close's own code), default close. --close and --leave-open answer
# without asking (LAND_CLOSE); piped with neither, it stays open and land
# says so. The founding folder has its own rule (close_founding_folder).
# Never fails the landing.
offer_close() {
  local root="$1" folder="$2" sid="$3" name why ans founding
  [ "${folder%%/*}" = desk ] || return 0
  name="${folder#desk/}"
  founding="$(door door-folder "$root" founding 2>/dev/null)"
  [ "$founding" != "$folder" ] || return 0
  if ! why="$(helper finished-folder "$root/$folder/folder.md" "$sid" 2>&1)"; then
    if [ "${LAND_CLOSE:-}" = close ]; then
      log "--close: $name stays open, since ${why:-it is not finished}; office close $name closes it when it is done"
    else
      debug "$name is not offered for closing: ${why:-it is not finished}"
    fi
    return 0
  fi
  case "${LAND_CLOSE:-}" in
    close) ;;
    leave) log "--leave-open: $name stays open (office close $name closes it)"; return 0 ;;
    *)
      if ! can_ask; then
        log "$name recorded $sid alone, and the planner ratified it with no exception; piped, the folder stays open: office land --close closes it with the landing, office close $name closes it now"
        return 0
      fi
      while :; do
        ask ans "$name recorded $sid alone, and the planner ratified it with no exception: close the folder, done, or leave it open (--close, --leave-open)" \
          "close" 1 \
          "The job looks finished: its one session landed applied and was ratified with nothing corrected. close moves the folder to the filing cabinet as done, with a History line (office close's own step); leave open keeps it on the desk, for another session or a later office close."
        case "$ans" in
          close|Close|c|y|yes|Yes|done) break ;;
          "leave open"|leave|open|l|n|no|No) log "$name stays open (office close $name closes it)"; return 0 ;;
          *) printf '  close, or leave open\n' >&2 ;;
        esac
      done ;;
  esac
  if ( OFFICE_ROOT="$root" MOVE_TEXT="office land: $sid landed and was ratified, the folder's only session" cmd_close "$name" ); then
    log "$name is closed: in the filing cabinet, done"
    AFTER_LAND_REPORT+=("the folder $name: closed, done (its one session landed and was ratified)")
  else
    warn "$name could not be closed (the lines above say why); office close $name closes it"
    AFTER_LAND_REPORT+=("the folder $name: NOT closed; office close $name closes it")
  fi
  return 0
}

# plan_field FILE KEY: one field of land's plan, as text (a list one per line).
plan_field() {
  python3 -c 'import json,sys
v = json.load(open(sys.argv[1]))
for k in sys.argv[2].split("."):
    v = v.get(k) if isinstance(v, dict) else None
if isinstance(v, list):
    print("\n".join(str(x) for x in v))
elif isinstance(v, bool):
    print("yes" if v else "")
elif v is not None:
    print(v)' "$1" "$2"
}

cmd_land() {
  local want="" sid="" folder="" response="" ratify="" except="" has_except=0 root tmp plan capture
  local out n line words verb repo label code day tz md name space rc=0 ans relays i
  local host="" dl_args=() d default help_more
  LAND_CLOSE=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --close) [ "$LAND_CLOSE" != leave ] || die "--close and --leave-open contradict each other"; LAND_CLOSE=close; shift ;;
      --leave-open) [ "$LAND_CLOSE" != close ] || die "--close and --leave-open contradict each other"; LAND_CLOSE=leave; shift ;;
      --sid|--folder|--response|--except)
        [ $# -ge 2 ] || die "$1 needs a value (office land --help explains it)"
        case "$1" in --sid) sid="$2" ;; --folder) folder="$2" ;; --response) response="$2" ;;
                     --except) except="$2"; has_except=1 ;; esac
        shift 2 ;;
      --ratified) [ "$ratify" != no ] || die "--ratified and --not-now contradict each other"; ratify=yes; shift ;;
      --not-now) [ "$ratify" != yes ] || die "--ratified and --not-now contradict each other"; ratify=no; shift ;;
      -h|--help) usage_land; return 0 ;;
      -*) usage_land >&2; die "office land does not know $1; the flags above are what it takes" ;;
      *) [ -z "$want" ] || die "office land takes one session, folder or response"; want="$1"; shift ;;
    esac
  done
  [ "$has_except" = 0 ] || [ "$ratify" = yes ] || die "--except goes with --ratified"
  # A plain word is whichever of the three it reads as.
  if [ -n "$want" ]; then
    if [[ "$want" =~ ^[0-9]{4}-[0-9]{2}-[0-9]{2}-[a-z0-9]+(-[a-z0-9]+)*-[0-9]{3}$ ]]; then
      [ -z "$sid" ] || die "two session ids: $want and --sid $sid"; sid="$want"
    elif [[ "$want" == *.tar.gz ]] || [ -f "$want" ]; then
      [ -z "$response" ] || die "two responses: $want and --response $response"; response="$want"
    else
      [ -z "$folder" ] || die "two folders: $want and --folder $folder"; folder="$want"
    fi
  fi
  root="$(resolve_office)" || exit 1
  # An office behind a renovation migration lands that renovation's session
  # (the renovation door), and nothing else, until office upgrade stamps it.
  local skew_state behind=0
  skew_state="$( (skew_report "$root") 2>/dev/null | head -n 1)"
  if [ "$skew_state" = behind ]; then behind=1; else require_current "$root"; fi
  command -v bale >/dev/null 2>&1 || die "bale is not on PATH; office land runs bale apply"
  tmp="$(mktemp -d)" || die "cannot make temp space for the landing"
  TMP_PATHS+=("$tmp")
  plan="$tmp/plan.json"; capture="$tmp/bale-stdout"
  tz="$(office_tz "$root")"; day="$(office_date "$tz")"

  if [ -n "$folder" ]; then
    space=desk
    if ! name="$( (find_folder "$root" desk "$folder") 2>/dev/null)"; then
      space=filing-cabinet; name="$(find_folder "$root" filing-cabinet "$folder")" || exit 1
    fi
    folder="$space/$name"
  fi

  # Which session: the one out, or asked when there are several.
  if [ -z "$sid" ] && [ -z "$folder" ] && [ -z "$response" ]; then
    out="$(reader land-out "$root")" || die "could not read which sessions are out"
    n="$(printf '%s' "$out" | grep -c .)"
    case "$n" in
      0) die "no session is out: none that a folder records is open in this office or in a project it scopes (office start sends one out)" ;;
      1) sid="${out%%$'\t'*}" ;;
      *) if ! can_ask; then
           printf '%s\n' "$out" | sed 's/\t/  (/; s/\t/; /; s/$/)/; s/^/[office]   /' >&2
           die "$n sessions are out; name one: office land SID; piped input is never asked"
         fi
         printf 'Sessions out:\n' >&2
         printf '%s\n' "$out" | sed 's/\t/  (/; s/\t/; /; s/$/)/; s/^/  /' >&2
         while :; do
           ask sid "Which session lands (office land SID)" "${out%%$'\t'*}" 1 \
             "The id of the session whose response came back; the lines above are every session a folder records that is open."
           printf '%s\n' "$out" | cut -f1 | grep -qxF -- "$sid" && break
           printf '  one of the ids above\n' >&2
         done ;;
    esac
  fi

  # Where downloads land, when this machine says (never asked here: a
  # session on a project here has bale's own search; land_plan asks for
  # it, through needs_downloads, when the session is on a host).
  if downloads_known; then
    while IFS= read -r d; do [ -n "$d" ] && dl_args+=(--downloads "$d"); done <<< "$DOWNLOADS"
  else
    dl_args=(--no-downloads)
  fi
  reader land-plan "$root" ${sid:+--sid "$sid"} ${folder:+--folder "$folder"} ${response:+--response "$response"} \
    --cwd "$PWD" --plan "$plan" "${dl_args[@]}" || exit 1
  sid="$(plan_field "$plan" sid)"
  host="$(plan_field "$plan" place.host)"
  if [ -n "$(plan_field "$plan" needs_downloads)" ]; then
    downloads_setting "the response for $sid is found on this machine by name and carried to $host"
    dl_args=()
    while IFS= read -r d; do [ -n "$d" ] && dl_args+=(--downloads "$d"); done <<< "$DOWNLOADS"
    reader land-plan "$root" --sid "$sid" ${response:+--response "$response"} --cwd "$PWD" --plan "$plan" "${dl_args[@]}" || exit 1
  fi
  if [ -n "$(plan_field "$plan" needs_response)" ]; then
    default="$(plan_field "$plan" response_default)"
    if ! can_ask; then
      die "bale held $sid, so its corrected response lands with bale retry; give it: office land $sid --response FILE (a browser saves a second download of one name as 'response-$sid (1).tar.gz'${default:+; the downloads hold one copy, $default, which may be the held one}); piped input is never asked"
    fi
    if [ -n "$host" ]; then
      help_more="It is carried to $host from this machine: give its path${default:+, or a plain return for $default, the one copy in the downloads, which may be the held one}."
    else
      help_more="A plain return lets bale find response-$sid.tar.gz, which may be the held one."
    fi
    ask response "bale held $sid; the corrected response: a path, or a name$([ -n "$host" ] && printf ' in the downloads' || printf " bale's search finds") (--response FILE)" \
      "${default:-response-$sid.tar.gz}" 1 \
      "The response the worker sent after the HOLD. A browser saves a second download of the same name as 'response-$sid (1).tar.gz', so give the path of the new one. $help_more"
    reader land-plan "$root" --sid "$sid" --response "$response" --cwd "$PWD" --plan "$plan" "${dl_args[@]}" || exit 1
  fi
  plan_field "$plan" problems | while IFS= read -r line; do [ -n "$line" ] && warn "$line"; done
  plan_field "$plan" took | while IFS= read -r line; do [ -n "$line" ] && log "$line"; done
  verb="$(plan_field "$plan" verb)"; repo="$(plan_field "$plan" where)"; label="$(plan_field "$plan" label)"
  if [ "$behind" = 1 ]; then
    local reno
    reno="$(door door-folder "$root" renovation --version "$(skew_report "$root" | sed -n 2p | cut -f1)" 2>/dev/null)"
    if [ -n "$reno" ] && plan_field "$plan" folders | grep -qxF -- "$reno"; then
      log "this office is behind office-src $(install_version) while its renovation session lands; office upgrade checks the renovation after, and stamps the office"
    else
      require_current "$root"
    fi
  fi

  # A read-only sitting the office sent out lands nothing; landing it
  # ends it (the ruling of sitting 2026-10-03-plan-4b-sitting-001): bale
  # unlock in its repo, and the folder's History line. Nothing runs
  # after it and nothing is ratified.
  if [ "$verb" = unlock ]; then
    [ -z "$ratify$except" ] || log "a sitting lands nothing, so nothing is ratified"
    log "ending the read-only sitting $sid ($label; $(plan_field "$plan" folders | paste -sd, - | sed 's/,/, /g')): bale unlock $sid, in $repo"
    out="$(reader land-end "$root" --plan "$plan" --day "$day")" || exit 1
    printf '\n%s\n' "$(printf '%s' "$out" | python3 -c 'import json,sys; print(json.load(sys.stdin)["words"])')"
    printf '%s' "$out" | python3 -c 'import json,sys
for l in json.load(sys.stdin)["told"]:
    print(l)' | while IFS= read -r line; do log "$line"; done
    return 0
  fi
  log "landing $sid ($label; $(plan_field "$plan" folders | paste -sd, - | sed 's/,/, /g; s/^$/no folder records it/')): bale $verb $(plan_field "$plan" tarball), in $repo"
  [ -z "$host" ] || log "$label is on $host: the response travels there, bale runs in its repo there with this terminal, and the temporary directory it travels in is removed after"
  line="$(reader land-prepare "$root" --plan "$plan")" || exit 1
  [ -z "$line" ] || log "$line"

  reader land-run "$root" --plan "$plan" --capture "$capture"; code=$?
  if ! out="$(reader land-outcome "$root" --plan "$plan" --capture "$capture" --exit "$code" --day "$day")"; then
    [ -z "$line" ] || warn "the record of $sid may still be out of its folder; office sessions $(plan_field "$plan" folders | head -n 1 | sed 's#.*/##') $sid puts it back"
    die "could not read how $sid ended from bale's records (bale stats --sid $sid --json, in $repo, shows them)"
  fi
  words="$(printf '%s' "$out" | python3 -c 'import json,sys; print(json.load(sys.stdin)["words"])')"
  printf '\n%s\n' "$words"
  printf '%s' "$out" | python3 -c 'import json,sys
for l in json.load(sys.stdin)["told"]:
    print(l)' | while IFS= read -r line; do log "$line"; done

  # The blocks to carry: printed whole when bale did not print them (a
  # clarification's), and on the clipboard one at a time, in bale's order.
  relays="$(printf '%s' "$out" | python3 -c 'import json,sys; print(len(json.load(sys.stdin)["relays"]))')"
  i=0
  while [ "$i" -lt "$relays" ]; do
    local block to
    block="$(printf '%s' "$out" | python3 -c 'import json,sys; print("\n".join(json.load(sys.stdin)["relays"][int(sys.argv[1])]["lines"]))' "$i")"
    to="$(printf '%s' "$out" | python3 -c 'import json,sys; print(json.load(sys.stdin)["relays"][int(sys.argv[1])]["to"])' "$i")"
    if [ "$(printf '%s' "$out" | python3 -c 'import json,sys; print(json.load(sys.stdin)["outcome"])')" = clarification ]; then
      printf '\nFor the planner, whole:\n\n%s\n' "$block"
    fi
    if [ "$i" -gt 0 ] && [ -t 1 ] && can_ask; then
      ask ans "Return puts the block for the $to on the clipboard" "" 0 \
        "bale printed more than one block to carry; they go one at a time, in the order bale says to send them."
    fi
    to_clipboard "$block" "the block for the $to" || [ "$i" -gt 0 ] || [ ! -t 1 ] || log "copy the block for the $to from above"
    i=$((i + 1))
  done

  if [ -z "$(printf '%s' "$out" | python3 -c 'import json,sys; print("yes" if json.load(sys.stdin)["applied"] else "")')" ]; then
    [ -z "$ratify$except" ] || log "nothing landed, so nothing is ratified"
    [ "$LAND_CLOSE" != close ] || log "nothing landed, so no folder is closed"
    line="$(printf '%s' "$out" | python3 -c 'import json,sys; print(json.load(sys.stdin)["next"] or "")')"
    [ -z "$line" ] || printf 'Next: %s\n' "$line"
    [ "$(printf '%s' "$out" | python3 -c 'import json,sys; print(json.load(sys.stdin)["outcome"])')" = clarification ] && return 0
    return 1
  fi

  # After an applied landing, first what the session's notes.md says (the
  # folder's two pages, its Sort, answers and facts), then the desk moves
  # a sort earned, each said as it happens (0.20.0); then the project's
  # after-land actions.
  local folders
  folders="$(plan_field "$plan" folders | head -n 1)"
  land_files "$root" "$folders" "$sid" "$plan"
  land_moves "$root" "$sid"

  # The project's after-land actions, in order. What became of each is
  # said again as land's last lines, after the ratification, so it is
  # never lost above a long screen.
  local problem actions=() project
  AFTER_LAND_REPORT=()
  project="$(plan_field "$plan" project)"
  problem="$(plan_field "$plan" after_land_problem)"
  # An empty list prints one empty line; it is no action (0.7.0 and 0.8.0
  # ran it as `bash -c ""` and said "1 action(s) ran").
  mapfile -t actions < <(plan_field "$plan" after_land | grep -v '^$')
  if [ -n "$problem" ]; then
    warn "after-land actions not run: the project's declarations do not read ($problem; office projects set fixes them)"
    AFTER_LAND_REPORT+=("not run: $project's declarations do not read ($problem); office projects set $project fixes them")
    rc=1
  elif [ "${#actions[@]}" -gt 0 ] && [ -n "$host" ]; then
    run_after_land_hosted "$root" "$plan" "$repo" "${#actions[@]}" || rc=1
  elif [ "${#actions[@]}" -gt 0 ]; then
    run_after_land "$repo" "${actions[@]}" || rc=1
  elif [ -n "$project" ]; then
    log "after land: $project declares no after-land action, so nothing ran (office projects set $project --after-land CMD declares one)"
    AFTER_LAND_REPORT+=("none: $project declares no after-land action")
  else
    debug "after land: an office session runs no after-land actions"
  fi

  # The planner's ratification, through the same step as office sessions.
  if [ -z "$folders" ]; then
    log "no folder records $sid, so there is nothing to ratify in"
  else
    [ "$behind" = 0 ] || log "the renovation has landed; next: office upgrade, which checks its declaration and stamps the office"
    space="${folders%%/*}"; name="${folders#*/}"
    if [ -z "$ratify" ] && can_ask; then
      while :; do
        ask ans "Did the planner ratify $sid's judgment calls: yes, yes except TEXT, or not now (--ratified, --except TEXT, --not-now)" \
          "not now" 0 \
          "yes records that the planner ratified the session's judgment calls (the flagged decisions in its notes); yes except TEXT records what was corrected and where it went; not now records nothing, and office sessions $name $sid --ratified records it later."
        case "$ans" in
          y|Y|yes|Yes|YES) ratify=yes; break ;;
          "yes except "*|"Yes except "*|"except "*) ratify=yes; except="${ans#*except }"; has_except=1
            [ -n "${except//[[:space:]]/}" ] && break
            printf '  except what: the correction, and where it went\n' >&2; ratify="" ;;
          n|N|no|No|"not now"|"Not now") ratify=no; break ;;
          *) printf '  answer yes, yes except TEXT, or not now\n' >&2 ;;
        esac
      done
    fi
    if [ "$ratify" = yes ]; then
      md="$root/$space/$name/folder.md"
      if [ "$has_except" = 1 ]; then
        out="$(helper ratify "$md" "$sid" --day "$day" --except "$except")" || rc=1
      else
        out="$(helper ratify "$md" "$sid" --day "$day")" || rc=1
      fi
      if [ -n "$out" ]; then
        log "$name: $out"
        commit_paths "$root" "office sessions: $sid ratified in $name" "$space/$name/folder.md" || true
      fi
    else
      log "not ratified; when the planner rules: office sessions $name $sid --ratified (or --ratified --except TEXT)"
    fi
    close_founding_folder "$root" "$folders" "$sid" "$day"
    offer_close "$root" "$folders" "$sid"
  fi
  land_watches "$root" "$tz" "$day"
  after_land_summary "$repo"
  return "$rc"
}

# land_files ROOT FOLDER SID PLAN: after an applied landing, what the
# response's notes.md says, when the office found the response on this
# machine (a path, or the name in the downloads): a project session's
# folder pages, walkthrough.md and delivery.md (0.17.0), then any
# session's Sort, Questions and answers and Handbook (0.20.0, file_notes).
# When only bale's own search knew where the response was, land says the
# line that files them. Never fails the landing.
land_files() {
  local root="$1" folder="$2" sid="$3" plan="$4" response line
  response="$(plan_field "$plan" response_here)"
  if [ -n "$folder" ]; then line="office sessions ${folder#*/} $sid --pages FILE"
  else line="office sessions --in-tray $sid --pages FILE"; fi
  if [ -z "$response" ]; then
    log "the response's notes were not filed (the walkthrough and delivery pages, the Sort, answers and facts): bale found the response in its own search directories, which the office cannot list; $line files them from the response"
    return 0
  fi
  if [ -n "$(plan_field "$plan" project)" ] && [ -n "$folder" ]; then
    FILED_PAGES=""
    if file_pages "$root" "$folder" "$sid" "$response"; then
      log "the folder's pages: ${FILED_PAGES:-nothing filed}"
    else
      warn "the folder's pages were not filed (the lines above say why); office sessions ${folder#*/} $sid --pages $response files them"
    fi
  fi
  file_notes "$root" "$folder" "$sid" "$response" \
    || warn "the response's Sort, answers and facts were not filed (the lines above say why); ${line%FILE}$response files them"
  return 0
}

# land_moves ROOT SID: after the notes are filed, office moves runs when a
# sorted drop waits in the in-tray, or when the session was a standalone
# sort and its moves page holds pending lines, and the folders it minted
# are named before the after-land actions and the ratification question.
# Never fails the landing.
land_moves() {
  local root="$1" sid="$2" run=0 minted number rel page
  if sortx pending "$root"; then
    run=1
  elif sortx is-sort "$sid" && [ -f "$root/drafting-table/moves.md" ] \
      && [ -n "$(drafting moves-plan "$root" --shell 2>/dev/null)" ]; then
    run=1
  fi
  [ "$run" = 1 ] || return 0
  minted="$(mktemp)" || { warn "no temporary file for office moves; office moves applies the sorted drops"; return 0; }
  TMP_PATHS+=("$minted")
  log "office moves: the desk moves this landing earned"
  if ! ( OFFICE_ROOT="$root" MOVES_MINTED_FILE="$minted" cmd_moves ); then
    warn "office moves did not finish (the lines above say why); office moves runs it again"
  fi
  if [ -s "$minted" ]; then
    printf '\nFolders office moves minted:\n'
    while IFS=$'\t' read -r number rel page; do
      printf '  %s  %s  (from %s)\n' "$number" "$rel" "$page"
    done < "$minted"
  fi
  return 0
}

# close_founding_folder ROOT FOLDER SID DAY: after an applied landing, the
# founding folder closes with the founding: when the folder that records
# the session is this office's founding folder and the profile is now
# complete, it goes to the filing cabinet, done (office close's own code),
# and land says so. A profile still incomplete leaves it open, and land
# names what founds it. The folder is the office's, not the session's,
# so the office closes it. Never fails the landing.
close_founding_folder() {
  local root="$1" folder="$2" sid="$3" day="$4" founding missing
  [ "${folder%%/*}" = desk ] || return 0
  founding="$(door door-folder "$root" founding 2>/dev/null)" || return 0
  [ -n "$founding" ] && [ "$founding" = "$folder" ] || return 0
  if missing="$(helper profile-check "$root/$PROFILE_REL" "$SHAPE" 2>&1)"; then
    if ( OFFICE_ROOT="$root" MOVE_TEXT="office land: the founding landed at $sid, with the profile complete" cmd_close "${folder#desk/}" ); then
      log "the founding landed with the profile complete, so its folder is closed: ${folder#desk/} is in the filing cabinet, done"
      AFTER_LAND_REPORT+=("the founding folder ${folder#desk/}: closed, done (the profile is complete)")
    else
      warn "the founding landed with the profile complete, but its folder could not be closed (the lines above say why); office close ${folder#desk/} closes it"
      AFTER_LAND_REPORT+=("the founding folder ${folder#desk/}: NOT closed; office close ${folder#desk/} closes it")
    fi
  else
    log "the founding landed, but the profile is still incomplete, so its folder stays open (office status names the sections; office start ${folder#desk/} sends the founding session out again for what is missing)"
    AFTER_LAND_REPORT+=("the founding folder ${folder#desk/}: stays open, the profile is incomplete")
  fi
  return 0
}

# land_watches ROOT TZ DAY: after an applied landing, office watches check
# without --record, printing only the watches that fired, since a landing
# is what changes the counts a watch reads. An office with no watches
# register prints nothing for it (the standing lines are the digest's).
# It records nothing and never fails the landing.
land_watches() {
  local root="$1" tz="$2" day="$3" out rc
  out="$(watches_py check "$root" --day "$day" --tz "$tz" --fired-only)"; rc=$?
  case $rc in
    0|3) ;;
    *) warn "office watches check could not run after the landing (exit $rc; the lines above say why); office watches check runs it"
       return 0 ;;
  esac
  [ -n "$out" ] || { debug "after land: no watch fired"; return 0; }
  printf '\nWatches that fired after this landing (office watches check; --record records them):\n'
  printf '%s\n' "$out" | sed 's/^/  /'
  return 0
}

# land's last lines after an applied landing: what became of each
# after-land action (ran, failed, not run), on stdout, so the outcome of
# an install or a deploy is the last thing on the screen and never a
# guess afterwards.
after_land_summary() {
  local repo="$1" line
  [ "${#AFTER_LAND_REPORT[@]}" -gt 0 ] || return 0
  printf '\nAfter land, in %s:\n' "$repo"
  for line in "${AFTER_LAND_REPORT[@]}"; do printf '  %s\n' "$line"; done
}

# The projects this office scopes, and what bale records about them.
# The floor plan's [projects] table names each project and its repo on
# this machine; `office projects add` is the only writer. The renderings
# read bale's records through the read side and write nothing.
usage_projects() {
  cat <<'EOF'
usage: office projects                       list the projects this office scopes, where
                                             each is, what rides with it and runs after it lands
       office projects add [NAME] [PATH]     add one (asks for what it was not given)
                           [--name NAME] [--path PATH] [--prepare]
                           [--host HOST [--shell PREFIX] [--connect TEXT]
                            [--from CLONE [--from-dirty-ok]]]
                           [--audience REMOTE [--author "Name <email>"] [--base BRANCH]]
                           [--ride PATH]... [--after-land CMD]...
       office projects set [NAME]            declare where a project is, what rides beside
                           [--host HOST] [--shell PREFIX] [--connect TEXT] [--on-this-machine]
                           [--audience REMOTE] [--author "Name <email>"] [--base BRANCH]
                           [--no-audience] [--no-author] [--no-base]
                           [--ride PATH]... [--no-rides]            every session on it, and
                           [--after-land CMD]... [--no-after-land]  what runs after one lands
       office projects level-bale [NAME] [--yes]
                                             install on a hosted project's host the
                                             bale this machine runs, keeping its user/
       office projects [NAME] --ledger       trust ledger per work class
       office projects [NAME] --landed PATH  the last applied session that landed PATH
       office projects [NAME] --versions     the version trail
NAME narrows a rendering to one project; without it every project is read.
PATH for --landed is relative to the project's root, e.g. bin/office.
A project's repo is on this machine, or on a host the office reaches over
ssh: --host is the ssh target (user@host, or an ssh-config alias), PATH is
then the path as that host's shell sees it, --shell is the command prefix
that runs one command where the repo is (default: ssh HOST bash -lc; through
a container, something like: ssh HOST docker exec -i -u USER NAME bash -lc;
the office appends exactly one shell-quoted command), and --connect is
printed when the host does not answer: your own words for what brings it up
(default: connect to HOST). Before any step that needs the host the office
makes one short connection, and a host that does not answer is one line
and the command stops. The read side then runs bale through that shell; the
walk-in, office status, office sessions, --ledger, --landed, --versions,
watches check and the digest all read a hosted project, and office start
packs a session there and office land lands it there.
--from CLONE brings a clone on this machine to its host as the project's
repo: PATH must not exist there yet (add refuses before anything moves),
and a clone of CLONE is made at PATH with every local branch and tag, its
remote-tracking refs and its remotes and branch settings as CLONE has
them, carried from this machine as a git bundle through the shell (the
host need not reach CLONE's git host), then prepared as --prepare does.
Only what is committed travels: a CLONE with changes in its working tree
is named with its changed paths and add asks whether to go on (piped, it
refuses unless --from-dirty-ok). CLONE itself is never changed or
deleted; once you are satisfied with the clone on the host, you can
remove it. On a terminal, add asks after the host question.
level-bale installs on a hosted project's host the bale this machine
runs, the way bale's releases install: a release tarball of this
machine's install (its user/ left out) carried through the shell, and the
host's own upgrade.sh run on it, which keeps the host's user/ (its global
bale.toml and hook store) and runs install.sh and validate.sh; a host with
no bale gets it unpacked as ~/bale and its install.sh run. The host
fetches nothing from the network. It says what version was there and what
is there now; it never moves a bale back, and runs only when you ask
(start and land refuse a bale below the read side's floor and name it).
--prepare sets up a clone bale has not run in without a trace in git, here
or on the host: the four paths bale writes (.bale/, bale.toml, .baleignore
and bale's record directory) go into .git/info/exclude and an empty
bale.toml is written, so git status stays clean and git ls-files unchanged;
the repo's own .gitignore is never touched. On a terminal, add offers it;
piped, add refuses and names it.
The audience line (office deliver): --audience names the remote in the
workbench clone that points at the audience's git host (origin, usually;
checked against the clone's remotes); a project with none is never
delivered. --author is the identity the audience expects on the delivery
commits, Name <email>; unset, deliver authors as the clone's own identity,
read where the clone is. --base is the audience branch deliveries branch
from; unset, the audience remote's HEAD branch, read from the clone. On a
terminal the three are asked after the host, defaults read from the clone.
Declaring an audience installs the push guard in the clone's .git/hooks
(a pre-push hook outside what git tracks, as --prepare keeps everything
the office writes): a push to the audience from the clone by hand is
refused there, naming office deliver, which pushes one delivery branch.
A ride-along is a path on this machine, absolute or ~/: a directory inside
another repo, a whole repo, or a file. Its context rides beside every
session office start packs for the project. An after-land action is a
command run in the project's repo after one of its sessions lands: office
land runs them in order once bale has applied it. All of it lives in this
office's floor plan, never in the project's repo. --ride and --after-land
replace the list they name; on a terminal, set asks for what it was not
given.
Examples:
  office projects
  office projects add                          (asks for the path, where it is, the name, what rides)
  office projects add office-src ~/office-src
  office projects add api ~/development/api --host me@workhost --prepare
  office projects add api ~/development/api --host me@workhost --from ~/work/api
  office projects level-bale api
  office projects set api --shell "ssh me@workhost docker exec -i -u me box bash -lc"
  office projects set api --connect "start the VPN client, then retry"
  office projects set api --audience origin --author "Pat Example <pat@example.org>" --base main
  office projects set office-src --after-land ./install.sh
  office projects set office-src --ride ~/nisaba-src/blueprints
  office projects --landed bin/office
EOF
}

# ask_declaration ARRAY PROJECT KIND: on a terminal, one ride-along path
# (KIND ride) or after-land action (KIND after-land) per question until
# a plain return; each answer is checked as it is given and asked again
# with the reason when it does not check.
ask_declaration() {
  local -n __list="$1"
  local name="$2" kind="$3" answer out q flag help n=0
  case "$kind" in
    ride) flag=--ride; q="A path whose context rides beside every $name session"
          help="A path on this machine, absolute or ~/: a directory inside another repo (~/other-repo/docs), a whole repo, or a file. office start packs its context and puts it in the out tray beside every request for $name." ;;
    *) flag=--after-land; q="A command to run in $name's repo after one of its sessions lands"
       help="One line, run from the top of $name's repo once a session there has landed, e.g. ./install.sh. office land runs them in order after bale applies a session, and says loudly when one fails." ;;
  esac
  __list=()
  while :; do
    [ "$n" -eq 0 ] || q="Another"
    IFS= read -r -p "$q ($flag) [return ends the list]: " answer || die "no answer given to: $q"
    answer="$(printf '%s' "$answer" | sed 's/^[[:space:]]*//; s/[[:space:]]*$//')"
    if [ "$answer" = "?" ]; then printf '%s\n' "$help" | fold -s -w 76 | sed 's/^/  /' >&2; continue; fi
    [ -n "$answer" ] || return 0
    if out="$(helper check-declaration "$kind" -- "$answer" 2>&1)"; then
      __list+=("$out"); n=$((n + 1))
    else
      printf '  %s\n' "${out#\[office\] error: }" >&2
    fi
  done
}

HOST_HELP="An ssh target: user@host, or an alias from ~/.ssh/config. The repo's path is then the path as that host's shell sees it. A plain return means the repo is on this machine."
shell_help() { printf 'The command prefix that runs one command where the repo is. The office appends exactly one shell-quoted command to it, so it ends in the word that takes a command string: the default, ssh %s bash -lc, runs it in a login shell on the host; a repo inside a container is reached with something like: ssh %s docker exec -i -u USER NAME bash -lc.' "$1" "$1"; }
connect_help() { printf 'Printed when %s does not answer, in your own words: what brings the host up (a VPN client to start, a machine to wake). One line.' "$1"; }

# ask_host HOSTVAR SHELLVAR CONNECTVAR: on a terminal, whether the repo is
# on this machine or on a host (a plain return: this machine), then the
# shell prefix and the connect line with their defaults shown; each
# answer is checked as it is given.
ask_host() {
  local __h="$1" __s="$2" __c="$3" _host _shell _connect out
  while :; do
    ask _host "Where the repo is: this machine, or an ssh host (--host)" "" 0 "$HOST_HELP"
    [ -n "$_host" ] || { printf -v "$__h" ''; printf -v "$__s" ''; printf -v "$__c" ''; return 0; }
    if out="$(helper check-host-keys "$_host" 2>&1)"; then break; fi
    printf '  %s\n' "${out#\[office\] error: }" >&2
  done
  while :; do
    ask _shell "The shell that runs one command where the repo is (--shell)" "ssh $_host bash -lc" 0 "$(shell_help "$_host")"
    if out="$(helper check-host-keys "$_host" --shell "$_shell" 2>&1)"; then break; fi
    printf '  %s\n' "${out#\[office\] error: }" >&2
  done
  ask _connect "What brings $_host up when it does not answer (--connect)" "connect to $_host" 0 "$(connect_help "$_host")"
  printf -v "$__h" '%s' "$_host"; printf -v "$__s" '%s' "$_shell"; printf -v "$__c" '%s' "$_connect"
}

# host_args ARRAY HOST SHELL CONNECT: the reader's --host/--shell/--connect
# flags for a hosted project, none for one on this machine.
host_args() {
  local -n __a="$1"
  __a=()
  [ -n "$2" ] || return 0
  __a+=(--host "$2")
  [ -z "$3" ] || __a+=(--shell "$3")
  [ -z "$4" ] || __a+=(--connect "$4")
}

AUDIENCE_HELP="The name of the remote in the workbench clone that points at the audience's git host (origin, usually): office deliver fetches its base from there and pushes a delivery branch to it, and nothing else. none, or a plain return when the clone has no origin, leaves the project without an audience, and deliver refuses it by name."
AUTHOR_HELP="The identity the audience expects on the delivery commits, as git writes one: Name <email>. A plain return leaves it unset, and deliver authors each delivery as the clone's own identity, read where the clone is; set it once when that is not the name the audience knows."
BASE_HELP="The audience branch deliveries branch from (main, usually). A plain return leaves it unset, and deliver reads the audience remote's HEAD branch from the clone each time."

# clone_facts FACTSVAR PATH HOST SHELL CONNECT: what the audience line's
# questions default to, read from the clone where it is (one connection
# for a hosted one). Sets FACTSVAR to the reader's lines, empty when the
# clone could not be read (said).
clone_facts() {
  local __f="$1" hargs=() out
  host_args hargs "$3" "$4" "$5"
  if out="$(reader git-facts --path "$2" "${hargs[@]}" 2>&1)"; then printf -v "$__f" '%s' "$out"; return 0; fi
  printf '  %s\n' "${out#\[office\] error: }" >&2
  printf -v "$__f" ''
  return 1
}

# fact FACTS KEY [REMOTE]: one of clone_facts' values; for remote, the
# named remote's URL (fact FACTS remote-head NAME gives its HEAD branch).
clone_fact() {
  case "$2" in
    remote) printf '%s\n' "$1" | awk -F'\t' -v n="$3" '$1 == "remote" && $2 == n {print $3}' ;;
    remote-head) printf '%s\n' "$1" | awk -F'\t' -v n="$3" '$1 == "remote" && $2 == n {print $4}' ;;
    remotes) printf '%s\n' "$1" | awk -F'\t' '$1 == "remote" {print $2}' | paste -sd, - | sed 's/,/, /g' ;;
    *) printf '%s\n' "$1" | awk -F'\t' -v k="$2" '$1 == k {print $2}' ;;
  esac
}

# ask_audience_keys AUDVAR AUTHVAR BASEVAR NAME FACTS: on a terminal, the
# audience line's three questions, each with its flag twin, the defaults
# read from the clone. The author and base are asked only once the
# project has an audience.
ask_audience_keys() {
  local __a="$1" __u="$2" __b="$3" name="$4" facts="$5" _aud _auth _base def out url identity head
  if [ -n "$(clone_fact "$facts" remote origin)" ]; then def=origin; else def=""; fi
  while :; do
    ask _aud "The remote in $name's clone that points at its audience's git host, or none (--audience)" "${def:-none}" 0 "$AUDIENCE_HELP"
    case "$_aud" in none|None|"") printf -v "$__a" ''; printf -v "$__u" ''; printf -v "$__b" ''; return 0 ;; esac
    if ! out="$(helper check-audience-key audience "$_aud" 2>&1)"; then printf '  %s\n' "${out#\[office\] error: }" >&2; continue; fi
    url="$(clone_fact "$facts" remote "$out")"
    if [ -z "$url" ] && [ -n "$facts" ]; then printf '  the clone has no remote named %s (it has: %s)\n' "$out" "$(clone_fact "$facts" remotes)" >&2; continue; fi
    _aud="$out"; break
  done
  identity="$(clone_fact "$facts" name)"; [ -z "$identity" ] || identity="$identity <$(clone_fact "$facts" email)>"
  while :; do
    ask _auth "The identity the audience expects on the commits, Name <email>; a plain return leaves it the clone's own${identity:+, $identity} (--author)" "" 0 "$AUTHOR_HELP"
    [ -n "$_auth" ] || break
    if out="$(helper check-audience-key author "$_auth" 2>&1)"; then _auth="$out"; break; fi
    printf '  %s\n' "${out#\[office\] error: }" >&2
  done
  head="$(clone_fact "$facts" remote-head "$_aud")"
  while :; do
    ask _base "The audience branch deliveries branch from; a plain return leaves it $_aud's HEAD branch${head:+, $head} (--base)" "" 0 "$BASE_HELP"
    [ -n "$_base" ] || break
    if out="$(helper check-audience-key base "$_base" 2>&1)"; then _base="$out"; break; fi
    printf '  %s\n' "${out#\[office\] error: }" >&2
  done
  printf -v "$__a" '%s' "$_aud"; printf -v "$__u" '%s' "$_auth"; printf -v "$__b" '%s' "$_base"
}

# install_guard PATH HOST SHELL CONNECT AUDIENCE URL: the push guard into
# the clone's .git/hooks, where it is; said, never fatal to the declaration.
install_guard() {
  local hargs=() out
  host_args hargs "$2" "$3" "$4"
  if out="$(reader install-guard --path "$1" "${hargs[@]}" --audience "$5" --url "$6" 2>&1)"; then log "$out"; return 0; fi
  warn "${out#\[office\] error: }"
  warn "the push guard is not in place: office projects set NAME --audience $5 tries again, and office deliver installs it when it is missing"
  return 1
}

# check_project FOUNDVAR PATH HOST SHELL CONNECT PREPARE: the check office
# projects add makes, here or through the host's shell (reach first).
# Sets FOUNDVAR to what was found. A repo bale has not run in is prepared
# when PREPARE is yes, offered on a terminal otherwise (default yes), and
# refused piped with the flag named. Returns 1 when the path does not
# check, having said why.
check_project() {
  local __f="$1" path="$2" host="$3" shell="$4" connect="$5" prepare="$6" out rc ans hargs=()
  host_args hargs "$host" "$shell" "$connect"
  out="$(reader check-project --path "$path" "${hargs[@]}" 2>&1)"; rc=$?
  if [ "$rc" = 4 ]; then
    printf '  %s\n' "${out#\[office\] error: }" >&2
    if [ "$prepare" != yes ]; then
      if can_ask; then
        ask ans "Prepare it for bale without a trace in git? (--prepare) (y/n)" "y" 0 \
          "Writes the four paths bale makes (.bale/, bale.toml, .baleignore and bale's record directory) into the repo's .git/info/exclude and an empty bale.toml, so bale can run there and nothing it makes shows in git status or reaches the repo's audience; the repo's own .gitignore is never touched. n leaves the repo as it is and asks for another path."
        case "$ans" in y|Y|yes) prepare=yes ;; esac
      else
        printf '[office] error: office projects add --prepare sets it up; piped input is never asked\n' >&2
        return 1
      fi
    fi
    [ "$prepare" = yes ] || return 1
    reader prepare-project --path "$path" "${hargs[@]}" | sed 's/^/[office] /' >&2
    [ "${PIPESTATUS[0]}" = 0 ] || return 1
    out="$(reader check-project --path "$path" "${hargs[@]}" 2>&1)"; rc=$?
  fi
  if [ "$rc" != 0 ]; then printf '  %s\n' "${out#\[office\] error: }" >&2; return 1; fi
  printf -v "$__f" '%s' "$out"
}

# declaration_args ARRAY RIDES_SET RIDES... -- : the project-declare
# flags for one key, given its list and whether it was set at all.
declare_flags() {
  local -n __out="$1"; local key="$2" set="$3"; shift 3
  [ "$set" = 1 ] || return 0
  if [ $# -eq 0 ]; then __out+=("--no-$([ "$key" = ride ] && printf rides || printf after-land)"); return 0; fi
  local v; for v in "$@"; do __out+=("--$key" "$v"); done
}

FROM_HELP="A git clone on this machine to bring to the host as this project's repo: a clone of it is made at the path you named (which must not exist there yet), with every local branch and tag, its remote-tracking refs and its remotes as it has them, carried from this machine as a git bundle, then prepared for bale without a trace in git. Only what is committed travels. The clone here is not changed or deleted. A plain return: the repo is already on the host."

# bring_clone FROM PATH HOST SHELL CONNECT DIRTY_OK: --from's move. A
# clone with working-tree changes is named, with its changed paths, and
# the occupant is asked whether to go on (piped: refused unless
# --from-dirty-ok). Returns 0 once the clone is on the host and prepared,
# 2 when the occupant (or piped input) stopped it, 1 when it failed;
# what it says is on stderr.
bring_clone() {
  local from="$1" path="$2" host="$3" shell="$4" connect="$5" dirty_ok="$6" out ans n hargs=()
  case "$from" in "~"|"~/"*) from="$HOME${from#\~}" ;; esac
  out="$(reader clone-dirty --path "$path" --from "$from")" || return 1
  if [ -n "$out" ]; then
    n="$(printf '%s\n' "$out" | wc -l | tr -d ' ')"
    printf '[office] %s has %s changed path(s) in its working tree, and none of them travels (only what is committed does):\n' "$from" "$n" >&2
    printf '%s\n' "$out" | head -n 20 | sed 's/^/    /' >&2
    [ "$n" -le 20 ] || printf '    (and %s more)\n' "$((n - 20))" >&2
    if [ "$dirty_ok" != yes ]; then
      if can_ask; then
        ask ans "Bring the clone without them? (--from-dirty-ok) (y/n)" "n" 0 \
          "y makes the clone on the host from what is committed here, every branch and tag; the changes above stay here only, in $from. n stops before anything moves: commit or stash them first."
        case "$ans" in y|Y|yes) ;; *) printf '[office] nothing moved; commit or stash them in %s, or answer y (--from-dirty-ok)\n' "$from" >&2; return 2 ;; esac
      else
        printf '[office] error: nothing moved; --from-dirty-ok brings the clone without them; piped input is never asked\n' >&2
        return 2
      fi
    fi
  fi
  host_args hargs "$host" "$shell" "$connect"
  reader clone-to --path "$path" --from "$from" "${hargs[@]}" | sed 's/^/[office] /' >&2
  [ "${PIPESTATUS[0]}" = 0 ] || return 1
  log "$from was not changed; once you are satisfied with the clone on $host, you can remove it (the office never does)"
}

cmd_projects_add() {
  local name="" path="" root default missing=() rides=() afters=() set_r=0 set_a=0 args=()
  local host="" shell="" connect="" set_h=0 prepare=no found="" hargs=() from="" from_set=0 dirty_ok=no rc
  local audience="" author="" base="" set_aud=0 facts="" url=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --name) [ $# -ge 2 ] || die "--name needs a value"; name="$2"; shift 2 ;;
      --audience) [ $# -ge 2 ] || die "--audience needs a remote's name"; audience="$2"; set_aud=1; shift 2 ;;
      --author) [ $# -ge 2 ] || die "--author needs Name <email>"; author="$2"; set_aud=1; shift 2 ;;
      --base) [ $# -ge 2 ] || die "--base needs a branch name"; base="$2"; set_aud=1; shift 2 ;;
      --path) [ $# -ge 2 ] || die "--path needs a value"; path="$2"; shift 2 ;;
      --host) [ $# -ge 2 ] || die "--host needs an ssh target"; host="$2"; set_h=1; shift 2 ;;
      --shell) [ $# -ge 2 ] || die "--shell needs a command prefix"; shell="$2"; set_h=1; shift 2 ;;
      --connect) [ $# -ge 2 ] || die "--connect needs a line of text"; connect="$2"; set_h=1; shift 2 ;;
      --prepare) prepare=yes; shift ;;
      --from) [ $# -ge 2 ] || die "--from needs the path of a clone on this machine"; from="$2"; from_set=1; shift 2 ;;
      --from-dirty-ok) dirty_ok=yes; shift ;;
      --ride) [ $# -ge 2 ] || die "--ride needs a path"; rides+=("$2"); set_r=1; shift 2 ;;
      --after-land) [ $# -ge 2 ] || die "--after-land needs a command"; afters+=("$2"); set_a=1; shift 2 ;;
      -h|--help) usage_projects; return 0 ;;
      -*) usage_projects >&2; die "office projects add does not know $1; it takes a name and a path, as words or as --name and --path, --host, --shell, --connect, --from, --from-dirty-ok, --prepare, --audience, --author, --base, --ride and --after-land" ;;
      *) if [ -z "$name" ]; then name="$1"; elif [ -z "$path" ]; then path="$1"; else die "office projects add takes a name and a path, and got more: $1"; fi; shift ;;
    esac
  done
  if [ -z "$host" ] && { [ -n "$shell" ] || [ -n "$connect" ]; }; then die "--shell and --connect go with --host HOST"; fi
  if [ "$from_set" = 1 ] && [ -z "$host" ] && { [ "$set_h" = 1 ] || ! [ -t 0 ]; }; then die "--from brings a clone to a host; it goes with --host HOST"; fi
  [ "$dirty_ok" = no ] || [ "$from_set" = 1 ] || die "--from-dirty-ok goes with --from CLONE"
  [ -n "$audience" ] || { [ -z "$author" ] && [ -z "$base" ]; } || die "--author and --base go with --audience REMOTE"
  if [ -n "$host" ]; then helper check-host-keys "$host" ${shell:+--shell "$shell"} >/dev/null || exit 1; fi
  [ -z "$audience" ] || audience="$(helper check-audience-key audience "$audience")" || exit 1
  [ -z "$author" ] || author="$(helper check-audience-key author "$author")" || exit 1
  [ -z "$base" ] || base="$(helper check-audience-key base "$base")" || exit 1
  root="$(resolve_office)" || exit 1
  require_current "$root"
  if [ -z "$name" ] || [ -z "$path" ]; then
    if [ -t 0 ]; then
      # A wizard on a terminal: ask for what was not given (doctrine
      # section 7); every question has its flag twin.
      # The path is checked as soon as it is given (through the host's
      # shell when the repo is on one), so a wrong one is asked again
      # before the name and the declarations are.
      local path_given="$path"
      while [ -z "$found" ]; do
        if [ -z "$path" ]; then
          ask path "Path to the project's git repo (--path)" "" 1 \
            "The top of the project's git repo, absolute or under a home directory (~/...): on this machine, or, when the next question names a host, as that host's shell sees it. bale must run there: it needs a .bale/ directory or a bale.toml, or the office prepares it."
        fi
        if [ "$set_h" = 0 ]; then ask_host host shell connect; fi
        if [ -z "$host" ]; then case "$path" in "~"|"~/"*) path="$HOME${path#\~}" ;; esac; fi
        if [ -n "$host" ] && [ "$from_set" = 0 ]; then
          ask from "Is there a clone on this machine to bring there? Its path (--from)" "" 0 "$FROM_HELP"
          from_set=1
        fi
        [ -n "$host" ] || { [ -z "$from" ] || die "--from brings a clone to a host, and the repo is on this machine"; }
        if [ -n "$from" ]; then
          bring_clone "$from" "$path" "$host" "$shell" "$connect" "$dirty_ok"; rc=$?
          [ "$rc" != 2 ] || exit 1
          if [ "$rc" != 0 ]; then
            [ -z "$path_given" ] || exit 1
            path=""; continue
          fi
          from=""
        fi
        if ! check_project found "$path" "$host" "$shell" "$connect" "$prepare"; then
          # A path given as a flag or a word is not asked again: the
          # caller (office init, say) hears it was not added.
          [ -z "$path_given" ] || exit 1
          path=""; [ "$set_h" = 1 ] || { host=""; shell=""; connect=""; }
        fi
      done
      if [ -z "$name" ]; then
        default="$(slugify "$(basename "${path%/}")")"
        ask name "Name for it in this office (--name)" "$default" 0 \
          "What this office calls the project on the walk-in and in office projects: letters, digits, dash or underscore."
      fi
      if [ "$set_aud" = 0 ]; then
        clone_facts facts "$path" "$host" "$shell" "$connect" || true
        ask_audience_keys audience author base "$name" "$facts"
        set_aud=1
      fi
      if [ "$set_r" = 0 ]; then ask_declaration rides "$name" ride; set_r=1; fi
      if [ "$set_a" = 0 ]; then ask_declaration afters "$name" after-land; set_a=1; fi
    else
      [ -n "$name" ] || missing+=("--name NAME")
      [ -n "$path" ] || missing+=("--path PATH")
      die "stdin is not a terminal, so nothing is asked; give ${missing[*]}"
    fi
  fi
  [ -n "$name" ] && [ -n "$path" ] || die "a project needs a name and a path"
  if [ -z "$found" ]; then
    # Given everything: the clone brought first (--from), then the same
    # check, here or through the shell, and the same offer to prepare a
    # repo bale has not run in.
    if [ -z "$host" ]; then case "$path" in "~"|"~/"*) path="$HOME${path#\~}" ;; esac; fi
    if [ -n "$from" ]; then
      [ -n "$host" ] || die "--from brings a clone to a host; it goes with --host HOST"
      bring_clone "$from" "$path" "$host" "$shell" "$connect" "$dirty_ok" || exit 1
    fi
    check_project found "$path" "$host" "$shell" "$connect" "$prepare" || exit 1
  fi
  # Check the declarations before the table is touched, so a bad one
  # adds nothing.
  local v
  for v in "${rides[@]}"; do helper check-declaration ride -- "$v" >/dev/null || exit 1; done
  for v in "${afters[@]}"; do helper check-declaration after-land -- "$v" >/dev/null || exit 1; done
  # An audience given as a flag is a remote the clone has.
  if [ -n "$audience" ]; then
    [ -n "$facts" ] || clone_facts facts "$path" "$host" "$shell" "$connect" || die "the clone could not be read, so --audience $audience cannot be checked against its remotes"
    url="$(clone_fact "$facts" remote "$audience")"
    [ -n "$url" ] || die "the clone at $path has no remote named $audience (it has: $(clone_fact "$facts" remotes))"
  fi
  host_args hargs "$host" "$shell" "$connect"
  helper project-add "$root/$MANIFEST_REL" "$name" "$path" "${hargs[@]}" --checked "$found" || exit 1
  [ -z "$audience" ] || args+=(--audience "$audience")
  [ -z "$author" ] || args+=(--author "$author")
  [ -z "$base" ] || args+=(--base "$base")
  if [ "${#rides[@]}" -gt 0 ] || [ "${#afters[@]}" -gt 0 ] || [ "${#args[@]}" -gt 0 ]; then
    declare_flags args ride "$([ "${#rides[@]}" -gt 0 ] && echo 1 || echo 0)" "${rides[@]}"
    declare_flags args after-land "$([ "${#afters[@]}" -gt 0 ] && echo 1 || echo 0)" "${afters[@]}"
    helper project-declare "$root/$MANIFEST_REL" "$name" "${args[@]}" || die "added $name, but its declarations could not be written; office projects set $name tries again"
  fi
  commit_paths "$root" "office projects: add $name" "$MANIFEST_REL" || true
  [ -z "$audience" ] || install_guard "$path" "$host" "$shell" "$connect" "$audience" "$url" || true
}

cmd_projects_set() {
  local name="" root facts rides=() afters=() set_r=0 set_a=0 args=() current keep line
  local host="" shell="" connect="" set_h=0 hargs=() cur_host
  local audience="" author="" base="" set_aud=0 clear_aud=() gitfacts="" url="" cur_aud path k
  while [ $# -gt 0 ]; do
    case "$1" in
      --audience|--author|--base)
        [ $# -ge 2 ] || die "$1 needs a value"
        case "$1" in --audience) audience="$2" ;; --author) author="$2" ;; --base) base="$2" ;; esac
        set_aud=1; shift 2 ;;
      --no-audience) clear_aud+=(--no-audience --no-author --no-base); set_aud=1; shift ;;
      --no-author) clear_aud+=(--no-author); set_aud=1; shift ;;
      --no-base) clear_aud+=(--no-base); set_aud=1; shift ;;
      --host) [ $# -ge 2 ] || die "--host needs an ssh target"; host="$2"; set_h=1; shift 2 ;;
      --shell) [ $# -ge 2 ] || die "--shell needs a command prefix"; shell="$2"; set_h=1; shift 2 ;;
      --connect) [ $# -ge 2 ] || die "--connect needs a line of text"; connect="$2"; set_h=1; shift 2 ;;
      --on-this-machine) set_h=2; shift ;;
      --ride) [ $# -ge 2 ] || die "--ride needs a path"; rides+=("$2"); set_r=1; shift 2 ;;
      --no-rides) set_r=2; shift ;;
      --after-land) [ $# -ge 2 ] || die "--after-land needs a command"; afters+=("$2"); set_a=1; shift 2 ;;
      --no-after-land) set_a=2; shift ;;
      -h|--help) usage_projects; return 0 ;;
      -*) usage_projects >&2; die "office projects set does not know $1; it takes a project's name, --host, --shell, --connect, --on-this-machine, --audience, --author, --base, --no-audience, --no-author, --no-base, --ride, --no-rides, --after-land and --no-after-land" ;;
      *) [ -z "$name" ] || die "office projects set takes one project"; name="$1"; shift ;;
    esac
  done
  [ "$set_r" != 2 ] || [ "${#rides[@]}" -eq 0 ] || die "--ride and --no-rides contradict each other"
  [ "$set_a" != 2 ] || [ "${#afters[@]}" -eq 0 ] || die "--after-land and --no-after-land contradict each other"
  [ "$set_h" != 2 ] || { [ -z "$host" ] && [ -z "$shell" ] && [ -z "$connect" ]; } || die "--on-this-machine contradicts --host, --shell and --connect"
  root="$(resolve_office)" || exit 1
  require_current "$root"
  if [ -z "$name" ]; then
    can_ask || { usage_projects >&2; die "name the project: office projects set NAME; piped input is never asked"; }
    printf 'Projects: %s\n' "$(helper project-names "$root/$MANIFEST_REL" | paste -sd, - | sed 's/,/, /g')" >&2
    ask name "Which project (office projects set NAME)" "" 1 "One of the projects this office scopes, by the name office projects lists."
  fi
  facts="$(helper project-facts "$root/$MANIFEST_REL" "$name")" || exit 1
  cur_host="$(printf '%s\n' "$facts" | awk -F'\t' '$1 == "host" {print $2}')"
  if [ "$set_r" = 0 ] && [ "$set_a" = 0 ] && [ "$set_h" = 0 ] && [ "$set_aud" = 0 ] && ! can_ask; then
    die "nothing to set for $name; give --host HOST (with --shell PREFIX and --connect TEXT) or --on-this-machine, --audience REMOTE (with --author and --base) or --no-audience, --ride PATH (repeatable) or --no-rides, and --after-land CMD (repeatable) or --no-after-land; piped input is never asked"
  fi
  path="$(printf '%s\n' "$facts" | awk -F'\t' '$1 == "path" {print $2}')"
  cur_aud="$(printf '%s\n' "$facts" | awk -F'\t' '$1 == "audience" {print $2}')"
  for k in audience author base; do
    [ -z "${!k}" ] || printf -v "$k" '%s' "$(helper check-audience-key "$k" "${!k}")" || exit 1
  done
  { [ -z "$author" ] && [ -z "$base" ]; } || [ -n "$audience" ] || [ -n "$cur_aud" ] || die "$name has no audience; --author and --base go with --audience REMOTE"
  if [ "$set_h" = 1 ] && [ -z "$host" ]; then
    [ -n "$cur_host" ] || die "$name is on this machine; --shell and --connect go with --host HOST"
    host="$cur_host"
  fi
  if can_ask && [ "$set_h" = 0 ]; then
    # Where the project is: keep it, or ask the host questions again.
    if [ -n "$cur_host" ]; then
      ask keep "Keep $name on $cur_host, reached through: $(printf '%s\n' "$facts" | awk -F'\t' '$1 == "shell" {print $2}')? (y/n)" "y" 0 \
        "y keeps the host, the shell and the connect line as they are; n asks the three again, and a plain return to the host question puts the project on this machine."
    else
      ask keep "Keep $name on this machine? (y/n)" "y" 0 "y keeps it here; n asks for the host its repo is on, the shell that reaches it and what brings the host up."
    fi
    case "$keep" in y|Y|yes) ;; *) ask_host host shell connect; set_h=$([ -n "$host" ] && echo 1 || echo 2) ;; esac
    if [ "$set_h" = 2 ] && [ -z "$cur_host" ]; then set_h=0; fi
  fi
  # The audience line: kept as it is, or asked again, on a terminal.
  local eff_host="$host" eff_shell="$shell" eff_connect="$connect"
  if [ "$set_h" = 0 ]; then
    eff_host="$cur_host"; eff_shell="$(printf '%s\n' "$facts" | awk -F'\t' '$1 == "shell" {print $2}')"
    eff_connect="$(printf '%s\n' "$facts" | awk -F'\t' '$1 == "connect" {print $2}')"
  elif [ "$set_h" = 2 ]; then eff_host=""; eff_shell=""; eff_connect=""; fi
  if can_ask && [ "$set_aud" = 0 ]; then
    if [ -n "$cur_aud" ]; then
      local cur_author cur_base
      cur_author="$(printf '%s\n' "$facts" | awk -F'\t' '$1 == "author" {print $2}')"
      cur_base="$(printf '%s\n' "$facts" | awk -F'\t' '$1 == "base" {print $2}')"
      [ -n "$cur_author" ] || cur_author="the clone's own"
      [ -n "$cur_base" ] || cur_base="the audience's HEAD branch"
      ask keep "Keep $name's audience line: audience $cur_aud, author $cur_author, base $cur_base? (y/n)" "y" 0 \
        "y keeps the three as they are; n asks the three again, and none to the audience question takes the project off the audience line."
    else
      ask keep "Keep $name without an audience? (y/n)" "y" 0 "y keeps it so; n asks which remote in its clone points at the audience's git host, the author the audience expects and the base branch."
    fi
    case "$keep" in y|Y|yes) ;; *)
      clone_facts gitfacts "$path" "$eff_host" "$eff_shell" "$eff_connect" || true
      ask_audience_keys audience author base "$name" "$gitfacts"
      set_aud=1
      if [ -z "$audience" ]; then clear_aud=(--no-audience --no-author --no-base)
      else [ -n "$author" ] || clear_aud+=(--no-author); [ -n "$base" ] || clear_aud+=(--no-base); fi ;;
    esac
  fi
  if [ -n "$audience" ]; then
    [ -n "$gitfacts" ] || clone_facts gitfacts "$path" "$eff_host" "$eff_shell" "$eff_connect" || die "the clone could not be read, so --audience $audience cannot be checked against its remotes"
    url="$(clone_fact "$gitfacts" remote "$audience")"
    [ -n "$url" ] || die "the clone at $path has no remote named $audience (it has: $(clone_fact "$gitfacts" remotes))"
  fi
  if can_ask; then
    for line in ride after-land; do
      if [ "$line" = ride ] && [ "$set_r" != 0 ]; then continue; fi
      if [ "$line" = after-land ] && [ "$set_a" != 0 ]; then continue; fi
      current="$(printf '%s\n' "$facts" | awk -F'\t' -v k="$([ "$line" = ride ] && echo rides || echo after_land)" '$1 == k {print $2}' | paste -sd, - | sed 's/,/, /g')"
      if [ -n "$current" ]; then
        ask keep "Keep $([ "$line" = ride ] && echo "what rides with $name" || echo "what runs after $name lands"): $current? (y/n)" "y" 0 \
          "y keeps the list as it is; n asks for the new list, one per question, and a plain return at once clears it."
        case "$keep" in y|Y|yes) continue ;; esac
      fi
      if [ "$line" = ride ]; then ask_declaration rides "$name" ride; set_r=$([ "${#rides[@]}" -gt 0 ] && echo 1 || echo 2)
      else ask_declaration afters "$name" after-land; set_a=$([ "${#afters[@]}" -gt 0 ] && echo 1 || echo 2); fi
      if [ -z "$current" ] && [ "$line" = ride ] && [ "$set_r" = 2 ]; then set_r=0; fi
      if [ -z "$current" ] && [ "$line" = after-land ] && [ "$set_a" = 2 ]; then set_a=0; fi
    done
  fi
  [ "$set_r" != 0 ] || [ "$set_a" != 0 ] || [ "$set_h" != 0 ] || [ "$set_aud" != 0 ] || { log "nothing changed for $name"; return 0; }
  declare_flags args ride "$([ "$set_r" != 0 ] && echo 1 || echo 0)" "${rides[@]}"
  declare_flags args after-land "$([ "$set_a" != 0 ] && echo 1 || echo 0)" "${afters[@]}"
  if [ "$set_h" = 2 ]; then args+=(--on-this-machine)
  elif [ "$set_h" = 1 ]; then host_args hargs "$host" "$shell" "$connect"; args+=("${hargs[@]}"); fi
  [ -z "$audience" ] || args+=(--audience "$audience")
  [ -z "$author" ] || args+=(--author "$author")
  [ -z "$base" ] || args+=(--base "$base")
  args+=("${clear_aud[@]}")
  helper project-declare "$root/$MANIFEST_REL" "$name" "${args[@]}" || exit 1
  commit_paths "$root" "office projects: set $name" "$MANIFEST_REL" || true
  [ -z "$audience" ] || install_guard "$path" "$eff_host" "$eff_shell" "$eff_connect" "$audience" "$url" || true
}

# office projects level-bale NAME: the host's bale brought level with this
# machine's (lib/office_bale.py, level_bale). On a terminal it asks first,
# naming both versions; piped, it takes --yes.
cmd_projects_level_bale() {
  local name="" yes=0 root plan state there here host ans
  while [ $# -gt 0 ]; do
    case "$1" in
      --yes|-y) yes=1; shift ;;
      -h|--help) usage_projects; return 0 ;;
      -*) usage_projects >&2; die "office projects level-bale does not know $1; it takes a project's name and --yes" ;;
      *) [ -z "$name" ] || die "office projects level-bale takes one project"; name="$1"; shift ;;
    esac
  done
  root="$(resolve_office)" || exit 1
  require_current "$root"
  if [ -z "$name" ]; then
    can_ask || { usage_projects >&2; die "name the project: office projects level-bale NAME; piped input is never asked"; }
    printf 'Projects: %s\n' "$(helper project-names "$root/$MANIFEST_REL" | paste -sd, - | sed 's/,/, /g')" >&2
    ask name "Which project's host (office projects level-bale NAME)" "" 1 "A project on a host, by the name office projects lists: its host gets the bale this machine runs."
  fi
  log "reading the bale on $name's host and the one this machine runs"
  plan="$(reader level-plan "$root" --project "$name")" || exit 1
  IFS=$'\t' read -r state there here host <<< "$plan"
  case "$state" in
    level) printf '%s: bale %s on %s is level with this machine'"'"'s; nothing to do\n' "$name" "$there" "$host"; return 0 ;;
    ahead) reader level-bale "$root" --project "$name"; return 1 ;;
  esac
  if [ "$yes" = 0 ]; then
    local what
    if [ "$state" = absent ]; then what="Install this machine's bale $here on $host, which has none on its login PATH"
    else what="Replace bale $there on $host with this machine's $here, keeping its user/ settings"; fi
    can_ask || die "piped input is never asked: --yes does it ($what)"
    ask ans "$what? (--yes) (y/n)" "y" 0 \
      "y carries a release tarball of this machine's bale install (its user/ left out) to $host through $name's shell and runs the host's own upgrade.sh on it, which keeps the host's user/ (global bale.toml, hook store) and runs install.sh and validate.sh there; a host with no bale gets ~/bale and its install.sh. Nothing is fetched from the network. n changes nothing."
    case "$ans" in y|Y|yes) ;; *) log "nothing changed on $host"; return 0 ;; esac
  fi
  reader level-bale "$root" --project "$name" || exit 1
}

cmd_projects() {
  local name="" mode="" landed="" root rc
  case "${1:-}" in
    add) shift; cmd_projects_add "$@"; return ;;
    set) shift; cmd_projects_set "$@"; return ;;
    level-bale) shift; cmd_projects_level_bale "$@"; return ;;
  esac
  while [ $# -gt 0 ]; do
    case "$1" in
      --ledger|--versions) [ -z "$mode" ] || die "one rendering at a time: $mode or $1"; mode="$1"; shift ;;
      --landed) [ -z "$mode" ] || die "one rendering at a time: $mode or $1"
                [ $# -ge 2 ] || die "--landed needs a path, relative to the project's root"
                mode="$1"; landed="$2"; shift 2 ;;
      -h|--help) usage_projects; return 0 ;;
      -*) usage_projects >&2; die "office projects does not know $1" ;;
      *) [ -z "$name" ] || die "name one project, or none for all"; name="$1"; shift ;;
    esac
  done
  root="$(resolve_office)" || exit 1
  if [ -z "$mode" ]; then
    [ -z "$name" ] || die "a project name narrows a rendering: add --ledger, --landed PATH or --versions"
    helper projects "$root/$MANIFEST_REL"; rc=$?
  else
    case "$mode" in
      --ledger) reader ledger "$root" ${name:+--project "$name"} ;;
      --versions) reader versions "$root" ${name:+--project "$name"} ;;
      --landed) reader landed "$root" "$landed" ${name:+--project "$name"} ;;
    esac
    rc=$?
  fi
  case $rc in
    0) return 0 ;;
    3) die "some of this office's projects could not be read; the lines above say why" ;;
    *) exit 1 ;;
  esac
}

# --- the audience line: office deliver, office letterhead-check, office relay ----
#
# A project's workbench clone is where bale lands, and a coworker never
# reviews it (doctrine section 2). office deliver carries a folder's
# landed work to the audience's git host as curated commits:
# lib/office_deliver.py does the crossing in two steps, so this shell can
# show what leaves and ask once in between. office letterhead-check is
# the guard on what leaves, on any tree, and office relay carries a
# planner's answer to a clarification back to the session's repo.

DELIVER="$OFFICE_SRC/lib/office_deliver.py"
LETTERHEAD="$OFFICE_SRC/lib/office_letterhead.py"
RULES="$OFFICE_SRC/share/letterhead.toml"
deliver_py() { python3 -B "$DELIVER" "$@"; }

usage_deliver() {
  cat <<'USAGE'
usage: office deliver [FOLDER] [--on PROJECT] [--branch NAME] [--others-too] [--yes]
Carries a folder's landed work to its project's audience as curated
commits: a branch named from the folder (--branch NAME overrides), made
from the audience's base branch, holding the landed tree changes as one
commit (several only when delivery.md marks them) with the words from
desk/FOLDER/delivery.md, authored as the project's author, pushed to the
audience remote, and nothing else: no bale commit, merge, tag or branch,
no file bale's exclude list names, and never the workbench branch.
The project is the folder's lane's (--on PROJECT when the lane names
none); it must declare an audience (office projects set NAME --audience
REMOTE), and the folder must record at least one session applied there.
In order: the audience's base is fetched; the landed work since the last
delivery (or since the branch and the base parted) is read, and every
applied session in it is named by its id and its folder; sessions of
other folders ride in the same delivery, said and named, and you may stop
there (--others-too goes on; piped, it refuses without it); the words
come from delivery.md (missing, deliver stops and says what to write
where); the diff and the words go through the letterhead check, and one
hit refuses the delivery with nothing pushed; then the diff's stat, the
sessions covered, the author, the branch and the words are shown and
deliver asks once before anything leaves (--yes answers it; piped, it
refuses without it). After the push the folder's History gains a dated
delivered line (branch, sessions, workbench commit, delivery commit), and
deliver prints what you do next: open the review (a URL when the git
host's compare-URL shape is known, GitHub or GitLab; the branch's name
otherwise) and whom to send it to, when the words name a reviewer. A
second delivery for the same folder adds to the same branch.
The delivery is built on this machine, where the audience answers with
your credentials: for a project on a host, the landed commits come here
as a git bundle through the project's shell, into a temporary repo
removed after. The push guard (a pre-push hook in the clone, installed
with the audience declaration and by deliver when it is missing) refuses
any push to the audience from the clone that deliver did not make.
  FOLDER           the folder, by name, part of it, or folder N; asked on a terminal
  --on PROJECT     the project, when the folder's lane names none
  --branch NAME    the delivery branch's name (default: the folder's slug)
  --others-too     deliver other folders' sessions riding in the landed work
  --yes            do not ask before pushing
Under the hood: git fetch of the audience's base and branch, a thin git
bundle of the clone's HEAD carried back for a hosted project, git merge
--squash in a temporary worktree, office letterhead-check on it and on
delivery.md, git commit as the author, git push AUDIENCE
refs/office/delivery:refs/heads/BRANCH with OFFICE_DELIVERY=BRANCH set
for the push guard. OFFICE_DEBUG=1 shows every git call and connection.
Examples:
  office deliver health-route
  office deliver 14 --yes
  office deliver health-route --branch api-health --others-too
USAGE
}

# deliver_show PLAN: what leaves, on stdout, before the question.
deliver_show() {
  local plan="$1" line
  printf '\nDelivery of %s to %s (%s):\n' "$(plan_field "$plan" folder)" "$(plan_field "$plan" audience)" "$(plan_field "$plan" url)"
  printf '  branch:   %s%s, from %s\n' "$(plan_field "$plan" branch)" "$([ -n "$(plan_field "$plan" continuing)" ] && printf ' (adding to the branch on the audience)')" "$(plan_field "$plan" base)"
  printf '  author:   %s\n' "$(plan_field "$plan" author)"
  printf '  sessions: %s' "$(plan_field "$plan" sessions | paste -sd, - | sed 's/,/, /g')"
  printf '  (%s commit(s) on the workbench since %s)\n' "$(plan_field "$plan" commits)" "$(plan_field "$plan" since_why)"
  if [ -n "$(plan_field "$plan" others_lines)" ]; then
    printf '  and of other folders: %s\n' "$(plan_field "$plan" others_lines | paste -sd ';' - | sed 's/;/; /g')"
  fi
  printf '  changes:\n'; plan_field "$plan" stat | sed 's/^/   /'
  printf '  words (desk/%s/delivery.md):\n' "$(plan_field "$plan" folder_name)"
  python3 -c 'import json, sys
w = json.load(open(sys.argv[1]))["words"]
for n, c in enumerate(w["commits"], 1):
    print(f"    commit {n}: " + c["subject"])
    for l in (c["body"] or "").splitlines():
        print("      " + l)
    if c["paths"]:
        print("      (takes: " + ", ".join(c["paths"]) + ")")
print("    review: " + w["review"]["title"])
for l in (w["review"]["body"] or "").splitlines():
    print("      " + l)
if w.get("to"):
    print("    to: " + w["to"])' "$plan"
  printf '\n'
}

cmd_deliver() {
  local want="" project="" branch="" others=0 yes=0 root name space tmp plan out line ans rc=0 url
  while [ $# -gt 0 ]; do
    case "$1" in
      --on) [ $# -ge 2 ] || die "--on needs the project's name"; project="$2"; shift 2 ;;
      --branch) [ $# -ge 2 ] || die "--branch needs a name"; branch="$2"; shift 2 ;;
      --others-too) others=1; shift ;;
      --yes|-y) yes=1; shift ;;
      -h|--help) usage_deliver; return 0 ;;
      -*) usage_deliver >&2; die "office deliver does not know $1; the flags above are what it takes" ;;
      *) [ -z "$want" ] || die "office deliver takes one folder"; want="$1"; shift ;;
    esac
  done
  root="$(resolve_office)" || exit 1
  require_current "$root"
  require_tools git
  if [ -z "$want" ]; then
    can_ask || { usage_deliver >&2; die "name the folder: office deliver FOLDER; piped input is never asked"; }
    ask_folder want "$root" desk "deliver"
  fi
  space=desk
  if ! name="$( (find_folder "$root" desk "$want") 2>/dev/null)"; then
    space=filing-cabinet; name="$(find_folder "$root" filing-cabinet "$want")" || exit 1
  fi
  tmp="$(mktemp -d)" || die "cannot make temp space for the delivery"
  TMP_PATHS+=("$tmp")
  plan="$tmp/plan.json"
  log "planning the delivery of $space/$name: the audience's base, the landed work, the words, the letterhead check"
  deliver_py plan "$root" "$name" --plan "$plan" ${branch:+--branch "$branch"} ${project:+--on "$project"} \
    $([ "$others" = 1 ] && printf -- --others-too) $(can_ask && printf -- --interactive) || exit 1
  plan_field "$plan" guard | while IFS= read -r line; do [ -n "$line" ] && log "$line"; done
  deliver_show "$plan"
  if [ -n "$(plan_field "$plan" others_lines)" ] && [ "$others" = 0 ]; then
    # Here only on a terminal: piped, the plan refused and named --others-too.
    ask ans "Sessions of other folders ride in this delivery (the office does not split one branch's history by folder); deliver them too? (--others-too) (y/n)" "y" 0 \
      "y carries them in the same branch and names them in this folder's History; n stops here, with nothing pushed."
    case "$ans" in y|Y|yes) ;; *) deliver_py abandon "$root" --plan "$plan"; log "stopped before anything left"; return 0 ;; esac
  fi
  if [ "$yes" = 0 ]; then
    if ! can_ask; then
      deliver_py abandon "$root" --plan "$plan"
      die "nothing left: office deliver $name --yes pushes it; piped input is never asked"
    fi
    ask ans "Push $(plan_field "$plan" branch) to $(plan_field "$plan" audience) as shown? (--yes) (y/n)" "y" 0 \
      "y makes the commit(s) above as the author shown and pushes that branch, and only it, to the audience; n stops here with nothing pushed. The letterhead check has already passed on the diff and the words."
    case "$ans" in y|Y|yes) ;; *) deliver_py abandon "$root" --plan "$plan"; log "stopped before anything left"; return 0 ;; esac
  fi
  out="$(deliver_py run "$root" --plan "$plan" --day "$(office_date "$(office_tz "$root")")")" || exit 1
  printf '\n%s\n' "$(printf '%s' "$out" | python3 -c 'import json,sys; print(json.load(sys.stdin)["words"])')"
  printf '%s' "$out" | python3 -c 'import json,sys
for l in json.load(sys.stdin)["told"]:
    print(l)' | while IFS= read -r line; do log "$line"; done
  printf '\nNext:\n'
  printf '%s' "$out" | python3 -c 'import json,sys
for l in json.load(sys.stdin)["next"]:
    print("  " + l)'
  url="$(printf '%s' "$out" | python3 -c 'import json,sys
for l in json.load(sys.stdin)["next"]:
    if l.startswith("open the review: "): print(l[len("open the review: "):]); break')"
  [ -z "$url" ] || to_clipboard "$url" "the review's URL" || true
  return 0
}

usage_letterhead_check() {
  cat <<'USAGE'
usage: office letterhead check [PATH | --on PROJECT] [--all] [--range A..B] [--words FILE]...
The letterhead's guard on what leaves the office, run by hand: names
every line that holds what the letterhead refuses, as file:line: what,
and exits 1 with a hit, 0 clean. What it refuses is one list in the
install, share/letterhead.toml (model, vendor and product names;
tell-tale phrasing an assistant writes; bale's marks: its commit
subjects, applied/ tags, bale/ branches and session ids) plus, when this
office has letterhead/forbidden.txt, each non-blank, non-comment line of
it as a fixed string (read when the file exists; never written).
Scope: the files a range changed and the range's commit messages
(--range A..B, as office deliver checks a delivery); else the files a
dirty tree changed, as they are; else the whole tree, with --all or when
the directory is not a git repo (said so). --words FILE checks a text as
it is (a delivery's words). Binary files are skipped by name and by a
NUL byte; OFFICE_DEBUG=1 names every file read.
  PATH             a tree on this machine (default: here)
  --on PROJECT     a project this office scopes, in its repo: on its host, through
                   its shell (the check travels there; nothing is written)
Examples:
  office letterhead check
  office letterhead check --all ~/work/api
  office letterhead check --on api --range origin/main..HEAD
  office letterhead check --words desk/14-health-route/delivery.md
USAGE
}

cmd_letterhead_check() {
  local path="" project="" args=() root="" forbidden=() w
  while [ $# -gt 0 ]; do
    case "$1" in
      --on) [ $# -ge 2 ] || die "--on needs the project's name"; project="$2"; shift 2 ;;
      --all) args+=(--all); shift ;;
      --range) [ $# -ge 2 ] || die "--range needs A..B"; args+=(--range "$2"); shift 2 ;;
      --words) [ $# -ge 2 ] || die "--words needs a file"; [ -f "$2" ] || die "--words $2: no such file"; args+=(--words "$(readlink -f "$2")"); shift 2 ;;
      -h|--help) usage_letterhead_check; return 0 ;;
      -*) usage_letterhead_check >&2; die "office letterhead check does not know $1; the flags above are what it takes" ;;
      *) [ -z "$path" ] || die "office letterhead check takes one path"; path="$1"; shift ;;
    esac
  done
  [ -z "$project" ] || [ -z "$path" ] || die "--on PROJECT and a path are two trees; give one"
  # The office's own forbidden strings ride when there is an office here.
  root="$( (resolve_office) 2>/dev/null)" || root=""
  [ -z "$root" ] || [ ! -f "$root/letterhead/forbidden.txt" ] || forbidden=(--forbidden "$root/letterhead/forbidden.txt")
  if [ -n "$project" ]; then
    [ -n "$root" ] || die "--on PROJECT needs an office (OFFICE_ROOT, the office around here, or the default)"
    deliver_py check "$root" --project "$project" "${args[@]}"
    return $?
  fi
  path="${path:-.}"
  [ -d "$path" ] || die "no such directory: $path"
  python3 -B "$LETTERHEAD" --rules "$RULES" "${forbidden[@]}" "${args[@]}" "$path"
}

cmd_letterhead() {
  case "${1:-}" in
    check) shift; cmd_letterhead_check "$@" ;;
    -h|--help|"") usage_letterhead_check; [ -n "${1:-}" ] || return 1 ;;
    *) usage_letterhead_check >&2; die "office letterhead knows check, not $1" ;;
  esac
}

usage_relay() {
  cat <<'USAGE'
usage: office relay SID [ANSWER-FILE]
Carries a planner's answer to a clarification back to the session's
repo: bale relay SID in the repo the session is open in, for a project
on this machine, and through the project's shell for one on a host, the
answer file on this machine piped to it (bale reads it from stdin there).
The answer is the file's path, or its name, found here and then in this
machine's downloads (machine.toml's downloads, asked once on a terminal).
The block bale prints for the worker is printed whole and, on WSL, put
on the clipboard, as office land does with a relay.
  SID              the suspended session, open in a project this office scopes
                   or in the office itself
  ANSWER-FILE      the planner's answer: an exchange record, a clarification
                   manifest, or the paste block wrapping either; asked on a
                   terminal when not given
Under the hood: bale relay SID - with the file on its stdin, where the
session is open; bale verifies the block's trailer and records the round.
Examples:
  office relay 2026-10-09-fix-login-001 answer.md
  office relay 2026-10-09-fix-login-001 "exchange-2026-10-09-fix-login-001-002.md"
USAGE
}

cmd_relay() {
  local sid="" answer="" root dl_args=() d out rc block
  while [ $# -gt 0 ]; do
    case "$1" in
      -h|--help) usage_relay; return 0 ;;
      -*) usage_relay >&2; die "office relay does not know $1" ;;
      *) if [ -z "$sid" ]; then sid="$1"; elif [ -z "$answer" ]; then answer="$1"; else die "office relay takes a session id and an answer file"; fi; shift ;;
    esac
  done
  root="$(resolve_office)" || exit 1
  require_current "$root"
  command -v bale >/dev/null 2>&1 || die "bale is not on PATH; office relay runs bale relay"
  if [ -z "$sid" ]; then
    can_ask || { usage_relay >&2; die "name the session: office relay SID ANSWER-FILE; piped input is never asked"; }
    ask_field sid sid "SID" "The suspended session's id" "" 1
  fi
  [[ "$sid" =~ ^[0-9]{4}-[0-9]{2}-[0-9]{2}-[a-z0-9]+(-[a-z0-9]+)*-[0-9]{3}$ ]] || die "not a session id (YYYY-MM-DD-slug-NNN): $sid"
  if [ -z "$answer" ]; then
    can_ask || die "give the planner's answer: office relay $sid ANSWER-FILE; piped input is never asked"
    ask answer "The planner's answer: a path, or a name in the downloads (ANSWER-FILE)" "" 1 \
      "The file the planner sent back: an exchange record, a clarification manifest, or the paste block wrapping either. A bare name is looked for here and then in this machine's downloads."
  fi
  if [ ! -f "$answer" ] && [[ "$answer" != */* ]]; then
    downloads_setting "the answer $answer is found on this machine by name"
    while IFS= read -r d; do [ -n "$d" ] && dl_args+=(--downloads "$d"); done <<< "$DOWNLOADS"
  fi
  out="$(reader relay "$root" --sid "$sid" --answer "$answer" --cwd "$PWD" "${dl_args[@]}")"; rc=$?
  [ -z "$out" ] || printf '%s\n' "$out"
  [ "$rc" = 0 ] || return "$rc"
  block="$(printf '%s' "$out" | python3 -c 'import sys
lines = sys.stdin.read().splitlines()
a = next((i for i, l in enumerate(lines) if l.startswith("BALE EXCHANGE BEGIN ")), None)
b = next((i for i, l in enumerate(lines) if l.startswith("BALE EXCHANGE END")), None)
if a is not None and b is not None and b > a:
    print("\n".join(lines[a:b + 1]))')"
  if [ -n "$block" ]; then
    to_clipboard "$block" "the block for the worker" || [ ! -t 1 ] || log "copy the block for the worker from above"
  fi
  return 0
}

# --- a worker's probe, run where the project lives: office probe (0.18.0) --------------------
#
# A probe is a tool call whose courier is a role (TARBALL.md 4.6), and the
# office is the occupant's hands at the terminal: office probe runs a
# worker's probe block where the folder's project lives (its repo here,
# through its shell on a host, the office root for the office itself), so
# nobody opens a VPN, an ssh and a docker exec by hand to paste a block in
# and the output back out. It shows the block's purpose header and asks
# once before anything runs, refuses by name a block that is not a probe
# or does not say it is read-only, puts the block that comes back on this
# machine's clipboard, carries the fallback's probe-output/ to the out
# tray, and writes one History line. The work is lib/office_probe.py's;
# this is the wizard around it.

PROBE="$OFFICE_SRC/lib/office_probe.py"
probe_py() { python3 -B "$PROBE" "$@"; }

# How this machine reads its clipboard: machine.toml's paste_command, the
# office's own setting beside clipboard_command (which writes it) and
# downloads. Asked once, on a terminal, the first time a verb needs it
# (this machine's likely command offered, ? explaining it), kept, and
# never asked again; piped, the verb refuses and names the key.
# paste_setting WHY [OTHERWISE] sets PASTE; WHY says what needs it, and
# OTHERWISE how to give the text without the clipboard (office probe's
# words when it is not given).
PASTE=""
PASTE_HELP="One command line whose output is the text on this machine's clipboard: office probe reads a worker's probe block from it, and office drop a message, when either is given no file. On WSL it is PowerShell's Get-Clipboard through powershell.exe (offered when it is on the PATH); on Linux, wl-paste or xclip -selection clipboard -o; on a Mac, pbpaste. The answer is kept as paste_command in this machine's machine.toml (the office's own settings, never bale's config) and is not asked again; edit that file to change it, and \"\" there turns reading the clipboard off."
paste_setting() {
  local why="$1" otherwise="${2:-give the block as a file (office probe FOLDER FILE) or on stdin (office probe FOLDER -)}" out rc cand ans
  out="$(helper paste-command "$MACHINE_FILE")"; rc=$?
  case "$rc" in
    0) [ -n "$out" ] || die "paste_command in $MACHINE_FILE is \"\", which turns reading the clipboard off: $otherwise"
       PASTE="$out"; return 0 ;;
    3) ;;
    *) die "paste_command in $MACHINE_FILE does not read (the line above says why); fix it there" ;;
  esac
  can_ask || die "$why, so the office needs to know how this machine reads its clipboard: set paste_command in $MACHINE_FILE, one command line whose output is the clipboard's text (paste_command = \"pbpaste\"), or ${2:-give the block as FILE or -}; piped input is never asked"
  cand="$(helper paste-command "$MACHINE_FILE" --candidate 2>/dev/null)"
  printf 'How does this machine read its clipboard? %s; this is asked once and kept as paste_command in %s.\n' "$why" "$MACHINE_FILE" >&2
  [ -n "$cand" ] || printf '  (no clipboard reader found on this machine; give the command)\n' >&2
  ask ans "The command whose output is the clipboard's text (paste_command in machine.toml)" "$cand" 1 "$PASTE_HELP"
  helper paste-command "$MACHINE_FILE" --set "$ans" >/dev/null \
    || die "paste_command could not be written to $MACHINE_FILE (the line above says why)"
  log "kept in $MACHINE_FILE: paste_command = $ans; it is not asked again (edit the file to change it)"
  PASTE="$ans"
}

usage_probe() {
  cat <<'USAGE'
usage: office probe [FOLDER] [FILE | -] [--project NAME] [--sid SID] [--yes]
Runs a worker's probe block where the folder's project lives and hands
the output back. The block comes from FILE, from stdin (-), or, with
neither, from the clipboard, read with paste_command in this machine's
~/.config/office-src/machine.toml (asked once on a terminal, with this
machine's likely command offered). Before anything runs it shows the
block's purpose header (the comment lines before its first blank line)
and asks once, default no. A block with no PROBE BEGIN line, or whose
header does not say it is read-only, is refused by name and nothing runs.
The block runs with stdin closed: in the project's repo for a project on
this machine; through the project's shell, in its path, for a project on
a host (the plain form, with no terminal: a probe never waits on one); in
the office root for the office itself. One reach of the host, as every
verb reaches. Its output, stdout and stderr, comes back whole; the lines
from PROBE BEGIN to PROBE END go on this machine's clipboard
(clipboard_command; on WSL clip.exe), since the block's own closing
clipboard step runs where no clipboard is, and the office says how many
lines came back and whether the integrity trailer's count matches them.
A probe-output/ directory the run leaves (the file-based fallback) is
carried to the session's out tray, ~/out-tray/SID/probe-output/, and
removed where it ran. The folder's History gains `- DATE probe: SID, N
lines`.
  FOLDER         the job whose session asked for the probe: its name, a
                 unique part of it, or folder N; asked on a terminal
  FILE           the block as the worker returned it (a chat's code fence
                 around it is fine); - reads it from stdin, which then
                 cannot answer the question, so --yes goes with it
  --project NAME where it runs: one of the office's projects, or office
                 for the office itself. Default: the project the folder's
                 lane names; asked on a terminal when the lane names none
  --sid SID      the session the probe is for, when the folder has several
                 open where it runs and the block's slug names none
  --yes          run it without asking; piped, nothing runs without it
The session is the folder's recorded session open where the project
lives: a folder with none gets no probe run, since a probe is a session's
and its output is kept under that session's out tray.
Under the hood: bale status --json where the project lives (which sessions
are open), then the block through bash -c there; OFFICE_DEBUG=1 shows every
shell call, and OFFICE_PROBE_TIMEOUT=<seconds> (default 1800) stops a block
that runs longer.
Examples:
  office probe 13                              (the block on the clipboard; asks where when the lane does not say)
  office probe fix-login probe.sh --project web-api
  office probe 13 - --project office-src --yes < probe.sh
USAGE
}

# ask_probe_project VAR NAMES: where the probe runs, office or one of the
# projects (NAMES, one per line), asked on a terminal; the flag twin is
# --project.
ask_probe_project() {
  local __var="$1" known="$2" ans list
  list="$(printf '%s' "$known" | paste -sd, - | sed 's/,/, /g')"
  while :; do
    ask ans "Where it runs: office, or the project ($list) (--project)" "" 1 \
      "The project whose environment the worker asked about: the block runs in its repo, through its shell when it is on a host. office runs it in this office's root. The folder's lane names a project when it has one, and then this is not asked."
    if [ "$ans" = office ] || printf '%s\n' "$known" | grep -qxF -- "$ans"; then printf -v "$__var" '%s' "$ans"; return 0; fi
    printf '  office, or one of this office'"'"'s projects: %s\n' "$list" >&2
  done
}

cmd_probe() {
  local want="" file="" project="" sid="" yes=0 root name md tmp block_file plan_file result_file out rc ans
  local names cands=() c tray_root tz day where block held
  while [ $# -gt 0 ]; do
    case "$1" in
      -h|--help) usage_probe; return 0 ;;
      --yes) yes=1; shift ;;
      --project) [ $# -ge 2 ] || die "--project needs a project's name, or office for the office itself"; project="$2"; shift 2 ;;
      --sid) [ $# -ge 2 ] || die "--sid needs the session's id"; sid="$2"; shift 2 ;;
      -) [ -z "$file" ] || die "office probe takes one block"; file="-"; shift ;;
      -*) usage_probe >&2; die "office probe does not know $1; the flags above are what it takes" ;;
      *) if [ -z "$want" ]; then want="$1"; elif [ -z "$file" ]; then file="$1"
         else die "office probe takes a folder and one block (FILE, or - for stdin)"; fi; shift ;;
    esac
  done
  root="$(resolve_office)" || exit 1
  require_current "$root"
  if [ -n "$sid" ]; then
    [[ "$sid" =~ ^[0-9]{4}-[0-9]{2}-[0-9]{2}-[a-z0-9]+(-[a-z0-9]+)*-[0-9]{3}$ ]] || die "--sid $sid: not a session id (YYYY-MM-DD-slug-NNN)"
  fi

  # Which job.
  if [ -z "$want" ]; then
    can_ask || { usage_probe >&2; die "name the folder: office probe FOLDER; piped input is never asked"; }
    ask_folder want "$root" desk probe
  fi
  name="$(find_folder "$root" desk "$want")" || exit 1
  md="$root/desk/$name/folder.md"
  [ -f "$md" ] || die "desk/$name has no folder.md"

  # The block: a file, stdin, or the clipboard.
  tmp="$(mktemp -d "${TMPDIR:-/tmp}/office-probe.XXXXXXXX")" || die "no temporary directory for the block"
  TMP_PATHS+=("$tmp")
  block_file="$tmp/block.sh"
  if [ "$file" = "-" ]; then
    [ ! -t 0 ] || die "office probe FOLDER - reads the block from stdin, and stdin is this terminal: pipe the block in, give it as a file, or leave it on the clipboard and give neither"
    cat > "$block_file" || die "could not read the block from stdin"
  elif [ -n "$file" ]; then
    [ -f "$file" ] || die "$file: no such file (the block is a file, - for stdin, or neither for the clipboard)"
    cp -- "$file" "$block_file" || die "could not read $file"
  else
    paste_setting "office probe reads the block from the clipboard when it is given no file"
    log "reading the block from the clipboard ($PASTE)"
    timeout 15 bash -c "$PASTE" < /dev/null > "$block_file" 2> "$tmp/paste.err"; rc=$?
    [ "$rc" = 0 ] || die "the clipboard could not be read: $PASTE exited $rc ($(tail -n 1 "$tmp/paste.err")); paste_command in $MACHINE_FILE"
    grep -q '[^[:space:]]' "$block_file" \
      || die "the clipboard is empty ($PASTE printed nothing): copy the worker's probe block first, or give it as FILE or -"
  fi
  # A block the office does not run is refused by name before anything is
  # reached: no PROBE BEGIN line, no purpose header, or a header that
  # does not say it is read-only.
  probe_py check "$block_file" > /dev/null || exit 1

  # Where it runs: the folder's lane, --project, or asked.
  if [ -z "$project" ]; then
    project="$(probe_py lane "$root" "desk/$name")" || exit 1
    if [ -n "$project" ]; then
      log "desk/$name's lane names $project, so the probe runs where $project lives (--project says otherwise)"
    else
      names="$(helper project-names "$root/$MANIFEST_REL" 2>/dev/null)"
      can_ask || die "say where the probe runs: --project NAME ($(printf '%s' "$names" | paste -sd, - | sed 's/,/, /g')), or --project office for the office itself; desk/$name's lane names no project, and piped input is never asked"
      ask_probe_project project "$names"
    fi
  fi

  # The session it is for, and nothing at probe-output/ there already:
  # one reach of a host.
  plan_file="$tmp/plan.json"
  while :; do
    out="$(probe_py plan "$root" "desk/$name" --project "$project" --block "$block_file" ${sid:+--sid "$sid"})"; rc=$?
    case "$rc" in
      0) printf '%s\n' "$out" > "$plan_file"; break ;;
      5) mapfile -t cands <<< "$out"
         can_ask || die "desk/$name has ${#cands[@]} sessions open where the probe runs ($(printf '%s\n' "${cands[@]}" | paste -sd, - | sed 's/,/, /g')), and the block's slug names none of them: --sid SID says which; piped input is never asked"
         printf 'Sessions desk/%s records that are open where the probe runs:\n' "$name" >&2
         for c in "${cands[@]}"; do printf '  %s\n' "$c" >&2; done
         while :; do
           ask sid "Which session asked for this probe (--sid)" "" 1 \
             "The probe's output belongs to the session whose worker returned the block: its id names the out tray a fallback probe's files go to, and the folder's History line counts the probe against it."
           printf '%s\n' "${cands[@]}" | grep -qxF -- "$sid" && break
           printf '  one of the sessions above\n' >&2
         done ;;
      *) exit 1 ;;
    esac
  done
  probe_field() { python3 -c 'import json,sys
v = json.load(open(sys.argv[1]))[sys.argv[2]]
print("\n".join(v) if isinstance(v, list) else ("" if v is None else v))' "$1" "$2"; }
  sid="$(probe_field "$plan_file" sid)"; where="$(probe_field "$plan_file" where)"

  # The header, and one question before anything runs.
  printf 'The probe block, as its purpose header says:\n' >&2
  probe_field "$plan_file" header | sed 's/^/  /' >&2
  printf 'It runs %s, stdin closed, for %s (desk/%s).\n' "$where" "$sid" "$name" >&2
  if [ "$yes" = 0 ]; then
    can_ask || die "a probe runs only once its header has been seen and said yes to: --yes says it, and piped input is never asked; nothing ran"
    ask ans "Run it? y or N (--yes)" "N" 0 \
      "y runs the block where it says above, with stdin closed, and hands its output back. N, or a plain return, runs nothing. A worker's probe is read-only (its header says so, or the office would have refused it); read the header before saying y."
    case "$ans" in
      y|Y|yes|Yes|YES) ;;
      *) log "not run: nothing was written, and the block is not kept"; return 0 ;;
    esac
  fi

  # The run: the output to this terminal whole, the fallback's directory
  # to the out tray.
  tray_root="$(machine_setting out_tray "$HOME/out-tray")"
  case "$tray_root" in "~"|"~/"*) tray_root="$HOME${tray_root#\~}" ;; esac
  result_file="$tmp/result.json"
  probe_py run --plan "$plan_file" --block "$block_file" --tray-root "$tray_root" --result "$result_file" || exit 1
  log "$(probe_field "$result_file" words)"
  if [ "$(probe_field "$result_file" closed)" = True ]; then
    block="$(probe_field "$result_file" block)"
    if [ -t 1 ]; then
      to_clipboard "$block" "the probe block (PROBE BEGIN to PROBE END)" \
        || log "the block is not on the clipboard (no clipboard_command here); copy it from above, PROBE BEGIN to PROBE END"
    else
      log "not on a terminal, so the block was not copied to the clipboard; it is above, PROBE BEGIN to PROBE END"
    fi
  fi
  if [ -n "$(probe_field "$result_file" carried)" ]; then
    log "the run left probe-output/ $where (the file-based fallback): carried to $(probe_field "$result_file" carried) ($(probe_field "$result_file" carried_files) file(s)) and removed there; attach those files with the paste"
  fi
  [ -z "$(probe_field "$result_file" carry_problem)" ] || warn "$(probe_field "$result_file" carry_problem)"

  # One History line, so a sitting can count a session's probes. The
  # one-writer rule holds: an open session in the office's own registry
  # whose forecast holds the folder keeps the line out, said.
  tz="$(office_tz "$root")"; day="$(office_date "$tz")"
  local line="$sid, $(probe_field "$result_file" count) lines"
  held="$(reader writers "$root" "desk/$name/folder.md" 2>/dev/null)"; rc=$?
  if [ "$rc" = 3 ]; then
    printf '%s\n' "$held" | sed 's/^/[office]   /' >&2
    warn "the History line was not written, since an open session holds desk/$name/folder.md (the one-writer rule): - $day probe: $line"
  else
    [ "$rc" = 0 ] || warn "bale's registry in this office could not be read; the History line is written without the one-writer check"
    folder_event "$md" "$day" probe "$line"
    commit_paths "$root" "office probe: $sid in $name" "desk/$name/folder.md" || true
  fi
  [ "$(probe_field "$result_file" closed)" = True ] || return 1
  return 0
}

# --- the toy drawer: office tour ----------------------------------------------------
#
# A throwaway office to play in before committing to real work (the
# construction sitting's toy drawer). It is built in a temp directory and
# every command runs with OFFICE_ROOT pointing at it, its own config and
# state directories (so neither this machine's default office nor the
# walk-in record is read or written), git's global config switched off,
# and a stand-in bale first on the PATH that refuses everything, so no
# bale registry is ever touched. start and land are shown and explained,
# never run. At the end, or when interrupted, the office is deleted and
# the tour says so.

usage_tour() {
  cat <<'USAGE'
usage: office tour [--no-pause] [--play | --no-play]
Builds a throwaway office in a temp directory, with sample folders, notes, a
slip and a calendar with a gap, and walks you through the verbs on it: each
step runs one command, shows what it printed, and says what it did and why
you would type it. office start and office land are shown and explained,
never run. At the end it deletes the office and says so; stopped early or
interrupted, it deletes it too. It never touches your offices, this
machine's default office, the walk-in record, or bale.
  --no-pause   run every step without waiting for a return between them
  --play       at the end, open a shell where every office command acts on
               the tour office, to try things yourself; exit ends it and
               the office is deleted then. On a terminal the tour asks.
  --no-play    end without asking
Piped, it pauses for nothing and asks nothing.
Examples:
  office tour
  office tour --no-pause --no-play
  office tour --play
USAGE
}

TOUR_DIR=""
TOUR_ENV=()
TOUR_PAUSE=1

# The office command in the tour office: its environment, never asking.
tour_office() {
  env "${TOUR_ENV[@]}" "$OFFICE_SRC/bin/office" "$@" </dev/null
}

# A paragraph: a blank line, then the words wrapped and indented.
tour_say() {
  printf '\n'
  printf '%s\n' "$*" | fold -s -w 74 | sed 's/ *$//; s/^/  /'
}

# tour_show ARGS...: the command line as you would type it, then what it
# printed (stderr's lines too, as a terminal shows them), indented.
tour_show() {
  local shown="office" w
  for w in "$@"; do
    case "$w" in ""|*[!A-Za-z0-9_./:=@-]*) shown+=" $(shq "$w")" ;; *) shown+=" $w" ;; esac
  done
  printf '\n  $ %s\n' "$shown"
  tour_office "$@" 2>&1 | sed 's/^/    /; s/ *$//'
}

# Between steps, on a terminal: return goes on, q ends the tour early.
# Returns 1 when the occupant asked to end.
tour_pause() {
  local ans rc prompt="  [return: the next step; q: end the tour] "
  [ "$TOUR_PAUSE" = 1 ] || return 0
  printf '\n' >&2
  # A read that waits forever would hold a signal that lands just before
  # it until the next keystroke; one-second reads let the traps run at
  # once. The terminal hands over a line only on return, so a timeout
  # loses nothing typed.
  while :; do
    IFS= read -r -t 1 -p "$prompt" ans && break
    rc=$?
    [ "$rc" -gt 128 ] || return 1
    prompt=""
  done
  case "$ans" in q|Q|quit|exit) return 1 ;; esac
  return 0
}

tour_step() {  # tour_step N TOTAL TITLE
  printf '\n== Step %s of %s: %s ==\n' "$1" "$2" "$3"
}

# The sample office: a written profile (a real one is written in the
# founding session), a calendar with a gap, three folders, notes and a
# slip, each made the way the verbs make them.
tour_furnish() {
  local office="$TOUR_DIR/office" tz today gap_day
  python3 - "$SHAPE" > "$office/$PROFILE_REL" <<'PY' || return 1
import sys, tomllib
with open(sys.argv[1], "rb") as f:
    shape = tomllib.load(f)
print("# Profile: tour\n")
print("A sample profile written by office tour. A real office writes its own in its")
print("founding session, with you, section by section.\n")
for s in shape["section"]:
    print(f"## {s['heading']}\n\nThe tour's sample. In a real office this says: {s['asks']}\n")
PY
  # A renovation adds the calendar to a real office; the tour adds it so
  # office week has something to show.
  printf '\n[spaces.calendar]\npath = "calendar"\nhung = true\nfiled = false\n' >> "$office/$MANIFEST_REL" || return 1
  tz="$(OFFICE_ROOT="$office" office_tz "$office")"; today="$(office_date "$tz")"
  # The gap is planned for yesterday, or, on a Monday, for the first
  # minute of today: always in the past, always this week.
  gap_day="$today"
  [ "$(TZ="$tz" date +%u)" = 1 ] || gap_day="$(TZ="$tz" date -d "$today -1 day" +%F)"
  mkdir -p "$office/calendar" || return 1
  printf '# Plan\n\nWhat should happen, one bullet per line.\n\n- %s 00:00 call the electrician about the porch light\n- %s 00:00 water the tomatoes\n' \
    "$gap_day" "$today" > "$office/calendar/plan.md" || return 1
  printf '# Record\n\nWhat happened, one bullet per line.\n\n- %s 00:00 water the tomatoes: done before breakfast\n' \
    "$today" > "$office/calendar/record.md" || return 1
  env "${TOUR_ENV[@]}" git -C "$office" add -A -- "$PROFILE_REL" "$MANIFEST_REL" calendar >/dev/null 2>>"$TOUR_DIR/furnish.log" \
    && env "${TOUR_ENV[@]}" git -C "$office" commit -q -m "office tour: a sample profile and a calendar" >/dev/null 2>>"$TOUR_DIR/furnish.log" || return 1
  tour_office open fix-the-porch-light --title "Fix the porch light" --size small --source "a note on the notepad" >/dev/null 2>>"$TOUR_DIR/furnish.log" || return 1
  tour_office open paint-the-fence --title "Paint the fence" --size medium --after "folder 1" >/dev/null 2>>"$TOUR_DIR/furnish.log" || return 1
  tour_office open build-a-shed --title "Build a shed" --candidate >/dev/null 2>>"$TOUR_DIR/furnish.log" || return 1
  tour_office note "bought bulbs; the porch light still flickers" >/dev/null 2>>"$TOUR_DIR/furnish.log" || return 1
  tour_office slip --about office "the tour should come with snacks" >/dev/null 2>>"$TOUR_DIR/furnish.log" || return 1
  # A message for step 2 to drop, as a neighbour might send it.
  printf 'Could you look at the gate latch this week?\nIt swings open in the wind and the dog gets out.\n' \
    > "$TOUR_DIR/message.txt" || return 1
}

tour_end() {
  rm -rf "$TOUR_DIR"
  trap - INT TERM HUP
  printf '\nThe tour office is deleted (%s). Nothing else was touched: your offices, this machine'"'"'s default office, the walk-in record and bale are as they were.\n' "$TOUR_DIR"
  if [ -n "$(office_default_exists)" ]; then
    printf '\nNext: office  (walk into your own office; office help lists every verb by what you want to do)\n'
  else
    printf '\nNext: office init  (build a real office; it asks where, what to call it and which projects it watches)\n'
  fi
}

# Whether this machine has a default office or the working directory is
# inside one (the tour's own office is gone by now): any output means yes.
office_default_exists() {
  if find_office_from "$PWD" >/dev/null 2>&1 || [ -f "$DEFAULT_FILE" ] || [ -n "${OFFICE_ROOT:-}" ]; then printf yes; fi
}

cmd_tour() {
  local play="" porch ans total=6
  while [ $# -gt 0 ]; do
    case "$1" in
      --no-pause) TOUR_PAUSE=0; shift ;;
      --play) [ "$play" != no ] || die "--play and --no-play contradict each other"; play=yes; shift ;;
      --no-play) [ "$play" != yes ] || die "--play and --no-play contradict each other"; play=no; shift ;;
      -h|--help) usage_tour; return 0 ;;
      *) usage_tour >&2; die "office tour does not know $1; it takes --no-pause, --play and --no-play" ;;
    esac
  done
  if ! can_ask; then
    [ "$play" != yes ] || die "--play opens a shell in the tour office, which needs a terminal; piped input is never asked"
    TOUR_PAUSE=0; play=no
  fi
  require_tools git python3 timeout
  TOUR_DIR="$(mktemp -d "${TMPDIR:-/tmp}/office-tour.XXXXXX")" || die "cannot make a temp directory for the tour"
  TMP_PATHS+=("$TOUR_DIR")
  # Interrupted, the EXIT trap deletes the tour office; say so first.
  trap 'printf "\n[office] the tour was interrupted; deleting the tour office at %s\n" "$TOUR_DIR" >&2; exit 130' INT
  trap 'printf "\n[office] the tour was stopped; deleting the tour office at %s\n" "$TOUR_DIR" >&2; exit 143' TERM HUP
  mkdir -p "$TOUR_DIR/bin" "$TOUR_DIR/config" "$TOUR_DIR/state" || die "cannot furnish $TOUR_DIR"
  cat > "$TOUR_DIR/bin/bale" <<'STUB'
#!/usr/bin/env bash
# office tour's stand-in for bale: the tour never runs the real one, so no
# bale registry anywhere is touched.
printf 'bale, in the office tour: the tour never runs bale; in a real office, office start and office land run it for you\n' >&2
exit 97
STUB
  chmod +x "$TOUR_DIR/bin/bale" && ln -s "$OFFICE_SRC/bin/office" "$TOUR_DIR/bin/office" || die "cannot furnish $TOUR_DIR/bin"
  # The tour's machine settings: an out tray inside the tour, and no
  # clipboard or file manager, so even a start tried in the play shell
  # leaves nothing on this machine.
  mkdir -p "$TOUR_DIR/config/office-src" \
    && printf 'out_tray = %s\nclipboard_command = ""\nopen_command = ""\n' "\"$TOUR_DIR/out-tray\"" \
       > "$TOUR_DIR/config/office-src/machine.toml" || die "cannot furnish $TOUR_DIR/config"
  TOUR_ENV=("OFFICE_ROOT=$TOUR_DIR/office" "XDG_CONFIG_HOME=$TOUR_DIR/config" "XDG_STATE_HOME=$TOUR_DIR/state"
            "PATH=$TOUR_DIR/bin:$PATH" "GIT_CONFIG_GLOBAL=/dev/null" "GIT_CONFIG_NOSYSTEM=1"
            "GIT_AUTHOR_NAME=office tour" "GIT_AUTHOR_EMAIL=tour@office.invalid"
            "GIT_COMMITTER_NAME=office tour" "GIT_COMMITTER_EMAIL=tour@office.invalid" "OFFICE_TOUR=1")

  printf 'office tour: a throwaway office to try the verbs on.\n'
  tour_say "It lives in $TOUR_DIR and is deleted at the end, or as soon as you stop the tour. It never touches your offices, this machine's default office, the walk-in record, or bale: a stand-in bale that refuses everything is first on its PATH."
  if ! tour_office init "$TOUR_DIR/office" --name tour --no-default --no-projects --no-founding >/dev/null 2>"$TOUR_DIR/init.log"; then
    sed 's/^/  /' "$TOUR_DIR/init.log" >&2
    die "could not build the tour office; it is deleted"
  fi
  if ! tour_furnish; then
    [ -f "$TOUR_DIR/furnish.log" ] && tail -n 15 "$TOUR_DIR/furnish.log" | sed 's/^/  /' >&2
    die "could not furnish the tour office (the lines above say why); it is deleted"
  fi
  tour_say "Built with: office init $TOUR_DIR/office --name tour --no-default --no-projects --no-founding. That made the spaces (desk, filing cabinet, notepad, suggestion box, drawer), a profile, a survey of this machine and a first commit. A real office init then asks the profile's questions and sends the founding session out; the tour sends none, and wrote a sample profile itself, added a calendar with a gap, opened three folders, noted a line and dropped a slip."
  tour_pause || { tour_end; return 0; }

  tour_step 1 "$total" "walk in"
  tour_show
  tour_say "What it did: showed the room. The header says which office, the time in its timezone, and whether it is founded and current. In flight lists the sessions out (none: the tour sends none). On the desk counts the folders and shows the first ready ones. This week lays the calendar against what happened. Then the last notepad lines and the slips."
  tour_say "The last line, Next, is the one command to type now, with its arguments filled in. It is worked out from the office on every walk-in and never written down: land a session when one is out, start the first ready folder, and so on down to nothing to do."
  tour_say "Why you would type it: it is the front door. Walk in, read the last line, type it."
  tour_pause || { tour_end; return 0; }

  tour_step 2 "$total" "capture a thought"
  tour_show note "the electrician can come Thursday"
  tour_say "What it did: appended a timed line to today's notepad page and committed that page alone. office slip does the same for a friction slip, each its own page in the suggestion box."
  tour_say "Why you would type it: capture is instant and dumb. A phone call, a decision, a thought: one line, no session, and it works even in an office that is unfounded or out of date."
  (cd "$TOUR_DIR" && tour_show drop message.txt --project "the garden")
  tour_say "What it did: dropped a whole message in the in-tray as one page, unsorted, with the project in your own words, and committed it alone; the in-tray arrived with this first drop. With no file, on a terminal, office drop takes the message from the clipboard and asks the project."
  tour_say "Why you would type it: a message asks for work, and nobody should have to read it, decide what it means and file it before it is safe. Every session office start sends out carries the unsorted drops and sorts what it can; office start --drop sends one straight out as its own job."
  tour_pause || { tour_end; return 0; }

  tour_step 3 "$total" "start a job"
  tour_show open fix-the-gate --title "Fix the garden gate" --size small
  tour_say "What it did: opened a folder on the desk, numbered one more than any folder before it, status queued, with the fields it was given. On a terminal, office open with nothing after it asks for the title, size, lane and source, and ? explains each; the tour gave them as flags, so nothing was asked."
  tour_say "Why you would type it: a job gets a folder. The folder holds why the job exists, the questions and answers, and the ids of the sessions that worked on it."
  tour_pause || { tour_end; return 0; }

  tour_step 4 "$total" "look at the desk"
  tour_show desk
  tour_say "What it did: put every folder in order, computed from what the folders say. Ready comes small first, then by number. Paint the fence is parked: it waits for folder 1, the porch light. Build a shed is a candidate, an idea not yet queued."
  tour_say "Why you would type it: nobody writes the order. The desk works it out each time, and says what each parked folder waits for."
  tour_pause || { tour_end; return 0; }

  tour_step 5 "$total" "this week"
  tour_show week
  tour_say "What it did: laid this week's plan against the record. Watering the tomatoes was planned and recorded; calling the electrician was planned for earlier this week and nothing was recorded, so it is a gap."
  tour_say "Why you would type it: to see what slipped. A session reads the same calendar and can ask about a gap."
  tour_pause || { tour_end; return 0; }

  porch="$(cd "$TOUR_DIR/office/desk" 2>/dev/null && ls -d -- *-fix-the-porch-light 2>/dev/null | head -n 1)"
  tour_step 6 "$total" "send a session out, and bring it back (shown, not run)"
  printf '\n  $ office start %s --in-office --goal %s\n' "${porch:-FOLDER}" "$(shq "Plan the porch light fix")"
  printf '    (not run: the tour never runs bale)\n'
  tour_say "In a real office this is the command the Next line names for a ready folder. It asks what it was not given (which job, whether the work lands in the office or on one of its projects, and the goal), then packs the session with bale where the work lands, records the session id in the folder, and puts everything to attach in one out tray, ~/out-tray/SID: the request, the doctrine, the office's context and whatever rides with the project. It prints the opener: attach the tray's files to a fresh chat and paste it. You never type a session id or an include list. A real office's founding session went out the same way: office init asked the profile's questions, opened the founding folder and handed it to office start, with the answers in the brief."
  printf '\n  $ office land\n'
  printf '    (not run: the tour never runs bale)\n'
  tour_say "When the response comes back: it finds the session out, runs bale apply in the repo it belongs to (bale asks its own questions, and only you answer them), says how it ended, prints the relay to carry back to the planner, runs the project's after-land steps (an install, say), and records whether the planner ratified the session. You never forget a landing step."
  tour_pause || { tour_end; return 0; }

  printf '\n== That is the tour ==\n'
  tour_say "office help lists every verb by what you want to do, and office VERB --help explains one, with examples."
  if [ -z "$play" ] && can_ask; then
    printf '\n'
    ask ans "Play in the tour office yourself before it goes? A shell where every office command acts on it; exit ends it (--play or --no-play)" "n" 0 \
      "y opens a shell inside the tour office with the tour's settings: office note, open, desk, week, close and the rest act on the tour office, never on yours, and start and land meet the stand-in bale. Type exit to leave; the tour office is deleted then. n ends the tour now."
    case "$ans" in y|Y|yes|Yes|YES) play=yes ;; *) play=no ;; esac
  fi
  if [ "$play" = yes ]; then
    cat > "$TOUR_DIR/tourrc" <<RC
PS1='(office tour) \W \\\$ '
HISTFILE=$(shq "$TOUR_DIR/history")
cd $(shq "$TOUR_DIR/office") || exit 1
printf '%s\n' "You are in the tour office. Every office command acts on it. Type exit to end the tour."
RC
    # A trap that does nothing, not an ignore: commands run in the shell
    # can still be interrupted, and the tour is not.
    trap ':' INT
    env "${TOUR_ENV[@]}" bash --rcfile "$TOUR_DIR/tourrc" -i
    trap 'printf "\n[office] the tour was interrupted; deleting the tour office at %s\n" "$TOUR_DIR" >&2; exit 130' INT
  fi
  tour_end
}

# Walking in: `office` with no arguments.
walk_in() {
  local root name tz report state skew slips notes founded is_founded next_file next
  if ! root="$(resolve_office 2>/dev/null)"; then
    usage
    printf '\nNot inside an office, and this machine has no default office. office init PATH builds one.\n'
    printf '\nNext: office tour  (a throwaway office to try every verb on; then office init PATH builds a real one)\n'
    return 0
  fi
  name="$(helper get "$root/$MANIFEST_REL" office.name --default "(unnamed)")"
  tz="$(office_tz "$root")"
  local tz_named tz_shown
  tz_named="$(office_tz_named "$root")"
  tz_shown="$tz"
  [ "$tz_named" = "$tz" ] || tz_shown="$tz (the floor plan's $tz_named does not resolve here; office status says what fixes it)"
  report="$(skew_report "$root" 2>/dev/null)" && state="$(printf '%s\n' "$report" | head -n 1)" || state="unreadable"
  case "$state" in current|behind|ahead) skew="$state" ;; *) skew=unreadable ;; esac
  if helper profile-check "$root/$PROFILE_REL" "$SHAPE" >/dev/null 2>&1; then founded="founded"; is_founded=yes
  else founded="UNFOUNDED (profile incomplete: office status)"; is_founded=no; fi
  case "$state" in
    current) state="current with office-src $(install_version)" ;;
    behind) state="BEHIND office-src $(install_version) (run: office upgrade)" ;;
    ahead) state="AHEAD of office-src $(install_version) (install a newer office-src)" ;;
    *) state="version stamp unreadable" ;;
  esac
  printf 'The %s office, %s\n' "$name" "$root"
  printf '%s, %s %s. %s; %s.\n' "$(TZ="$tz" date '+%A %F')" "$(office_time "$tz")" "$tz_shown" "$founded" "$state"
  # When this office scopes the project the install came from: the install
  # behind its source, one line in office status's words (start and land
  # run the install, so the Next line names the install line too); and the
  # latest detached run of the source's suite when its verdict is not OK
  # (FAILED, BROKEN, or RUNNING for over an hour), one line (0.17.2).
  local install_lines
  install_lines="$(reader install-lines "$root" 2>/dev/null)" || install_lines=""
  [ -z "$install_lines" ] || printf '%s\n' "$install_lines"
  printf '\n'

  # In flight: one line per session open in the projects this office
  # scopes and in the office itself, and the folder that names it; then
  # the desk's count and its first three ready folders. A gate cleared
  # since the last walk-in says so. Never fails the walk-in.
  local desk today since
  today="$(office_date "$tz")"; since="$(last_walk_in "$root")"
  # The Next line is worked out from the same reading as the desk, so
  # bale is asked each question once; it is printed last.
  next_file="$(mktemp)" || die "cannot make a temp file for the walk-in"
  TMP_PATHS+=("$next_file")
  desk="$(reader desk "$root" --walk-in --today "$today" ${since:+--since "$since"} \
    --next-file "$next_file" --skew "$skew" --founded "$is_founded")"
  case $? in
    0|3) printf '%s\n' "$desk" ;;
    *) printf 'In flight:\n  could not be read (OFFICE_DEBUG=1 office for why)\n\nOn the desk:\n  could not be read; office desk says why\n' ;;
  esac
  next="$(head -n 1 "$next_file" 2>/dev/null)"
  [ -n "$next" ] || next="Next: office desk  (the next move could not be worked out; OFFICE_DEBUG=1 office says why)"
  record_walk_in "$root" "$today"
  printf '\nThis week:\n'
  OFFICE_ROOT="$root" cmd_week | sed 's/^/  /'
  printf '\nNotepad, last lines:\n'
  notes="$(helper recent-notes "$root/notepad" 3 2>/dev/null)"
  if [ -n "$notes" ]; then printf '%s\n' "$notes" | sed 's/^/  /'; else printf '  nothing noted yet\n'; fi
  slips="$(find "$root/suggestion-box" -maxdepth 1 -type f -name '*.md' 2>/dev/null | wc -l | tr -d ' ')"
  printf '\nSuggestion box: %s slip(s).\n' "$slips"
  printf '\nFrom here: office start, office land, office note TEXT, office slip TEXT, office drop, office open, office close FOLDER, office desk, office week, office projects, office status. office help lists everything by what you want to do; office tour tries it all on a throwaway office.\n'
  printf '\n%s\n' "$next"
}

usage_where() {
  cat <<'USAGE'
usage: office where
Prints the office a command run here acts on: OFFICE_ROOT if set, else the
office around the working directory, else this machine's default.
Examples:
  office where
  cd ~/somewhere && office where
USAGE
}

cmd_where() {
  case "${1:-}" in -h|--help) usage_where; return 0 ;; esac
  [ $# -eq 0 ] || { usage_where >&2; die "office where takes no arguments"; }
  resolve_office; printf '\n'
}

usage_default() {
  cat <<'USAGE'
usage: office default [PATH]
Shows this machine's default office, the one a command acts on outside any
office, or makes PATH the default. The first office init on a machine sets
it. It is kept in ~/.config/office-src/default-office, outside every office.
Examples:
  office default
  office default ~/offices/home
USAGE
}

cmd_default() {
  local root
  case "${1:-}" in -h|--help) usage_default; return 0 ;; esac
  [ $# -le 1 ] || { usage_default >&2; die "office default takes one path"; }
  if [ $# -eq 0 ]; then
    [ -f "$DEFAULT_FILE" ] || die "this machine has no default office (set one with: office default PATH)"
    head -n 1 "$DEFAULT_FILE"; return 0
  fi
  root="$(readlink -f "$1" 2>/dev/null)" || die "no such path: $1"
  [ -f "$root/$MANIFEST_REL" ] || die "not an office (no $MANIFEST_REL): $root"
  mkdir -p "$CONFIG_DIR" && printf '%s\n' "$root" > "$DEFAULT_FILE" || die "cannot write $DEFAULT_FILE"
  log "this machine's default office is now $root"
}

usage_version() {
  cat <<'USAGE'
usage: office version
Prints the installed office-src version, where the install is, and where it
was installed from (the commit and the working copy).
Examples:
  office version
  office --version
USAGE
}

cmd_version() {
  case "${1:-}" in -h|--help) usage_version; return 0 ;; esac
  printf 'office-src %s (%s)\n' "$(install_version)" "$OFFICE_SRC"
  [ -f "$OFFICE_SRC/INSTALLED" ] && sed 's/^/  /' "$OFFICE_SRC/INSTALLED"
  return 0
}

usage_init() {
  load_sections
  cat <<EOF
usage: office init [PATH | --path PATH] [--name NAME] [--no-default]
                   [--project [NAME=]PATH]... [--no-projects]
                   $(section_flags_usage 19)
                   [--timezone ZONE] [--no-founding]
Builds an office at PATH (new or empty): the base spaces, a profile stub,
the version stamp, a first survey and a first commit. Then, on a terminal,
it asks which projects the office watches, one at a time through the same
questions as office projects add, until a plain return. Then the founding:
it asks the profile's questions, one per section of the profile's required
shape in its order (an answer may run to several lines, and a blank line
ends it; ? explains each; a plain return at once leaves a section for the
founding session to ask about), and the timezone you live in after
Site, defaulting to this machine's when that resolves, checked against the
zone database and, when it resolves, written to the floor plan. It opens
the founding folder on the desk (founding, source office init), keeps your
answers in it as answers.md, and sends the founding session out through
office start: an out tray, the opener to paste, the session recorded in
the folder, and office land SID when it comes back. Each question has a
flag twin, so a piped init asks nothing and sends what it was given.
Makes PATH this machine's default office when there is none yet, unless
--no-default. On a terminal it asks for the path and the name when it was
given no path. It refuses to build from an install whose catalogs have a
defect.
  --project [NAME=]PATH  a project the office watches: the top of a git repo
                         bale runs in; NAME defaults to the directory's name.
                         Repeatable; each is checked before anything is built.
  --no-projects          ask no project question on a terminal
  --PROFILE-SECTION TEXT your answer to that section's question (the flags
                         above, one per section; the Founding section is the
                         founding session's to write and is never asked)
  --timezone ZONE        the zone you live in, such as America/Chicago
  --no-founding          build only: no questions, no founding folder, no
                         session (office found sends it later)
Under the hood, for the founding: office open, then office start's own code
(bale pack --json, bale pack --context for each context tarball).
Examples:
  office init                                  (asks where, the name, the projects and the profile's questions)
  office init ~/offices/home
  office init ~/offices/home --project ~/office-src --project tools=~/bale-src
  office init ~/offices/home --purpose "My own tools" --timezone America/Chicago < /dev/null
  office init ~/offices/try --no-founding
  office tour                                  (try an office first, on a throwaway one)
EOF
}

usage() {
  cat <<EOF
office-src $(install_version): builds and keeps offices.

usage: office [VERB [args]]

New here? office tour builds a throwaway office, walks you through it, and
deletes it at the end. Nothing real is touched.

What you want to do, and the command for it:

Walk in and look around
  office                    walk in: sessions out, what is ready, this week, the last
                            notes, slips, and the one command to type next
  office desk               in flight, ready in order, parked under what each waits
                            for, candidates, orphaned riders, pending desk moves
  office week               this week's calendar and its gaps
  office sessions FOLDER    the sessions that worked on a job, and how each went
  office projects           the projects this office watches; --ledger, --landed PATH
                            and --versions show what bale records about them

Capture a thought or a friction
  office note TEXT          a timed line on today's notepad page
  office slip TEXT          a friction slip in the suggestion box (--about the office,
                            a tool or a project)
  office drop [FILE]        a message or a thread, from the clipboard, a file or stdin,
                            as one page in the in-tray (--project, in any words); the
                            sessions start sends out carry it until it is sorted

Start a job, and finish one
  office open               a numbered folder on the desk; asks for what it needs
  office close FOLDER       to the filing cabinet: done, or --into N, --split A,B,
                            --retired WHY
  office reopen FOLDER      a done folder back on the desk, history and all

Plan work too big for one folder (the drafting table)
  office blueprint open SLUG
                            draft a blueprint: one arc, its charter and its
                            decomposition into folders
  office blueprint ratify ID
                            freeze its charter, pointing at the ratifying words
  office blueprint close ID send out the sitting that writes its close report
  office moves              apply the desk moves: the in-tray's sorted drops, each into
                            its folder, then the moves a sitting wrote: open, queue,
                            gate, close or retire folders, each ticked with its folder
  office rider add TITLE    small work with a named carrier, on the riders page
  office rider carry N      moved into the folder that carries it (--folder M)
  office rider consumed N SID
                            consumed at a session
  office riders             the riders, where each is, and the orphans;
                            --forecast PATH... the ones a pack would carry
  office agenda add TEXT    a question for a sitting to rule on
  office rulings [ID]       the rulings ledger, or one ruling with its amendments;
                            --check resolves every citation
  office evidence [N]       the evidence ledger, or one entry with its occurrences
  office watches            the watches and where each stands; --all with the closed
  office watches check      run every query watch over its window, and the standing
                            lines; --record appends a fired record for each that fired
  office digest             write the sitting-open page and print it: versions, since
                            the last sitting, watches, standing lines, desk, agenda

Send a session out
  office start [FOLDER]     asks which job, where the work lands and the goal; packs
                            the session, records it in the folder, and puts every file
                            to attach in one out tray beside the opener
  office start --drop in-tray/PAGE
                            a dropped message straight out as a project session: a
                            folder minted from the drop, the drop moved into it, and a
                            brief that tells the session to sort it, then do it
  office start --sort       the drops nothing carried, to a session of their own: it
                            reads them all with the desk, and land files its Sort

Bring one back
  office land [SID]         applies the response in the right repo, says how it ended,
                            hands you the relay, runs the after-land steps, records the
                            planner's ratification, files the walkthrough and delivery
                            pages in the folder, the Sort on each drop, the answers and
                            the handbook's facts, moves the sorted drops, and ends
                            saying how each step went;
                            given a read-only sitting's id, ends the sitting
  office relay SID FILE     carries the planner's answer to a clarification back to the
                            session's repo (bale relay there), and hands you bale's block
  office probe FOLDER [FILE]
                            runs a worker's probe block where the folder's project lives
                            (on its host, in its container), after showing its header and
                            asking once; the output back whole and the block on the clipboard

Deliver it to the audience
  office deliver [FOLDER]   the folder's landed work to its project's audience as
                            curated commits on a branch named from the folder, the words
                            from the folder's delivery.md; asks once before pushing
  office letterhead check   what the letterhead refuses, in a tree, a range or a file:
                            names, phrasing, bale's marks, the office's forbidden words

Look after the office
  office init PATH          build an office; asks which projects it watches and the
                            profile's questions, and sends the founding session out
  office found              send an unfounded office's founding session out: the
                            profile's questions, the founding folder, office start
  office projects add       watch a project; set NAME says what rides with its sessions,
                            what runs after one lands, and its audience, author and base
  office status             version, the install against its source, profile, survey
                            age, timezone, hung items, catalogs, folders, filed pages,
                            bale (read-only)
  office survey             rewrite floor-plan/survey.md and say what changed
  office upgrade            take a breaking release: dry run, then one commit; a
                            renovation goes out through office start
  office where              the office a command here acts on
  office default [PATH]     show or set this machine's default office
  office version            the installed version
  office tour               try every verb on a throwaway office

Why the office, if you already use bale: you never type a session id, never
assemble an include list, and never forget a landing step. start knows the
folder's lane, the forecast, the work class and what rides with each project;
land knows which repo, which response, and what to do after it applies. bale
stays visible: start and land run bale's own pack, open, apply, retry and
unlock (only to end a read-only sitting the office sent out), bale
asks its own questions and only you answer them, office start --help and
office land --help name the bale commands they run, and OFFICE_DEBUG=1 shows
every bale call. Any bale command still works by hand beside the office.

office help VERB (or office VERB --help) explains one verb, with examples.
A command acts on OFFICE_ROOT if set, else the office around the working
directory, else this machine's default. The doctrine is
$DOCTRINE_DIR/OFFICE.md.
EOF
}

# The verbs office help VERB explains, each through its own --help.
HELP_VERBS=" init found survey status upgrade where default note slip drop open desk week close reopen sessions projects start land tour version moves blueprint rider riders agenda rulings evidence watches digest deliver letterhead relay probe "
# The two-word verbs, as office help VERB WORD (or VERB-WORD, the key
# share/verbs.toml gives them) explains them.
HELP_PAIRS=" blueprint-open blueprint-ratify blueprint-close rider-add rider-carry rider-consumed agenda-add watches-check letterhead-check "

# office help [VERB [WORD]]: everything by task, or one verb's own help.
cmd_help() {
  [ $# -gt 0 ] || { usage; return 0; }
  local pair="${1}${2:+-$2}"
  case "$HELP_PAIRS" in
    *" $pair "*) main "${pair%%-*}" "${pair#*-}" --help; return ;;
  esac
  [ $# -le 1 ] || { usage >&2; die "office help knows no verb $*; the list above is every verb"; }
  case "$HELP_VERBS" in
    *" $1 "*) main "$1" --help ;;
    *) usage >&2; die "office help knows no verb $1; the list above is every verb" ;;
  esac
}

main() {
  # The line a host that does not answer tells the occupant to rerun:
  # this command, as typed (the reader prints it in the reach line).
  if [ -z "${OFFICE_RERUN:-}" ]; then
    local w rerun="office"
    for w in "$@"; do
      case "$w" in *[!A-Za-z0-9_./:@=+,-]*|"") rerun="$rerun $(shq "$w")" ;; *) rerun="$rerun $w" ;; esac
    done
    export OFFICE_RERUN="$rerun"
  fi
  # One command reaches a host once: each reader process appends the
  # shell prefixes that answered to this file, and the next reads it
  # before its first connection (lib/office_host.py). A nested office
  # call inherits it, being part of the same command.
  if [ -z "${OFFICE_REACHED_FILE:-}" ]; then
    local reached
    if reached="$(mktemp "${TMPDIR:-/tmp}/office-reached.XXXXXXXX" 2>/dev/null)"; then
      TMP_PATHS+=("$reached")
      export OFFICE_REACHED_FILE="$reached"
    else
      debug "no temporary file for the reach: each step of this command reaches a host again"
    fi
  fi
  if [ $# -eq 0 ]; then walk_in; return; fi
  local verb="$1"; shift
  case "$verb" in
    init) cmd_init "$@" ;;
    found) cmd_found "$@" ;;
    survey) cmd_survey "$@" ;;
    status) cmd_status "$@" ;;
    upgrade) cmd_upgrade "$@" ;;
    where) cmd_where "$@" ;;
    default) cmd_default "$@" ;;
    note) cmd_note "$@" ;;
    slip) cmd_slip "$@" ;;
    drop) cmd_drop "$@" ;;
    open) cmd_open "$@" ;;
    desk) cmd_desk "$@" ;;
    week) cmd_week "$@" ;;
    close) cmd_close "$@" ;;
    reopen) cmd_reopen "$@" ;;
    sessions) cmd_sessions "$@" ;;
    projects) cmd_projects "$@" ;;
    start) cmd_start "$@" ;;
    land) cmd_land "$@" ;;
    version|--version|-V) cmd_version "$@" ;;
    help|--help|-h) cmd_help "$@" ;;
    tour) cmd_tour "$@" ;;
    moves) cmd_moves "$@" ;;
    blueprint) cmd_blueprint "$@" ;;
    rider) cmd_rider "$@" ;;
    riders) cmd_riders "$@" ;;
    agenda) cmd_agenda "$@" ;;
    rulings) cmd_rulings "$@" ;;
    evidence) cmd_evidence "$@" ;;
    watches) cmd_watches "$@" ;;
    digest) cmd_digest "$@" ;;
    deliver) cmd_deliver "$@" ;;
    letterhead) cmd_letterhead "$@" ;;
    relay) cmd_relay "$@" ;;
    probe) cmd_probe "$@" ;;
    *) usage >&2; die "unknown verb: $verb" ;;
  esac
}

main "$@"
